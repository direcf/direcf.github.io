---
import "../styles/global.css";
import posts from "../data/posts.json";
import diary from "../data/diary.json";
import { COURSES, chapterSlug } from "../lib/courses";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  activeSlug?: string;       // "home" | category slug
  crumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = "AI 시대를 살아가며 공부한 것들과 가끔의 사적인 단상.",
  ogImage,
  activeSlug = "home",
  crumbs = [],
} = Astro.props;

const counts: Record<string, number> = {};
for (const p of posts.posts) counts[p.category] = (counts[p.category] || 0) + 1;

const studySlugs = [
  "computer-science",
  "engineering-philosophy",
  "cloud-infra",
  "computer-vision",
  "multimodal-ai",
  "ai-engineering",
];
const catBy = (slug: string) => posts.categories.find((c) => c.slug === slug)!;
const fullTitle = title === "direcf" ? "direcf — direct fun, deep study" : `${title} — direcf`;
const ogRelative = ogImage || "/og-default.svg";
const og = new URL(ogRelative, Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// ── Study nav SVG icon paths (Heroicons v2, stroke style) ─────────
const STUDY_ICONS: Record<string, string> = {
  "computer-science":
    `<path d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/>`,
  "engineering-philosophy":
    `<path d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/>`,
  "cloud-infra":
    `<path d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z"/>`,
  "computer-vision":
    `<path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>`,
  "multimodal-ai":
    `<path d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3"/>`,
  "ai-engineering":
    `<path d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z"/>`,
};
const LOCK_ICON = `<path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>`;
const HOME_ICON = `<path d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>`;

// ── Build the search index that ships to the client ────────────────
const searchIndex: { type: string; category: string; title: string; excerpt: string; url: string }[] = [];

for (const p of posts.posts) {
  const cat = catBy(p.category);
  searchIndex.push({
    type: p.type,
    category: cat.name,
    title: p.title,
    excerpt: p.excerpt,
    url: p.url,
  });
}

for (const entry of diary.entries) {
  searchIndex.push({
    type: "diary",
    category: "Diary",
    title: entry.title,
    excerpt: entry.excerpt,
    url: `/diary/${entry.slug}/`,
  });
}

for (const [slug, course] of Object.entries(COURSES)) {
  const cat = posts.categories.find((c) => c.slug === course.categorySlug);
  for (const ch of course.chapters) {
    const keywords = [
      ch.titleKr,
      ...(ch.topics || []),
      ...(ch.learningGoals || []),
    ].filter(Boolean).join(" · ");
    searchIndex.push({
      type: "chapter",
      category: cat ? cat.name : course.topic,
      title: `Ch${String(ch.number).padStart(2, "0")} · ${ch.title}`,
      excerpt: ch.tldr,
      url: `/posts/${slug}/${chapterSlug(ch.number)}/`,
      keywords,
    } as any);
  }
}
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="fTbJIAxvJzgaiyuC276uAjaL4oYdM7g_iyoXdtwhQWw" />
  <meta name="naver-site-verification" content="d1f97a1558a64466e7b1e01c5d2d179d82438cf0" />
  <title>{fullTitle}</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="canonical" href={canonicalURL.toString()} />
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.toString()} />
  <meta property="og:image" content={og} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SKV1H2YCK1"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-SKV1H2YCK1');
  </script>

  <!-- inline early to prevent flash of wrong theme -->
  <script is:inline>
    (function () {
      try {
        const KEY = "direcf:theme";
        const saved = localStorage.getItem(KEY);
        const sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved || (sysDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <!-- gradient def — referenced by all nav SVG icons -->
  <svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
    <defs>
      <linearGradient id="direcf-nav-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#8b5cf6"/>
        <stop offset="100%" stop-color="#06b6d4"/>
      </linearGradient>
    </defs>
  </svg>
  <div class="app" id="app">

    <!-- Sidebar -->
    <aside class="sidebar">
      <a class="sidebar-brand" href="/">
        <img src="/favicon.ico" class="logo" alt="direcf" />
        <span class="brand-text">direcf</span>
      </a>
      <nav class="nav">
        <a class={`nav-item ${activeSlug === "home" ? "active" : ""}`} href="/">
          <span class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="url(#direcf-nav-grad)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
              <Fragment set:html={HOME_ICON} />
            </svg>
          </span>
          <span class="label">Home</span>
          <span class="count">{posts.posts.length}</span>
        </a>
        <div class="nav-section">Study</div>
        {studySlugs.map((slug) => {
          const c = catBy(slug);
          return (
            <a class={`nav-item ${slug === activeSlug ? "active" : ""}`} href={`/category/${slug}/`}>
              <span class="icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="url(#direcf-nav-grad)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                  <Fragment set:html={STUDY_ICONS[slug] ?? ''} />
                </svg>
              </span>
              <span class="label">{c.name}</span>
              <span class="count">{counts[slug] || 0}</span>
            </a>
          );
        })}
        <div class="nav-section">Personal</div>
        <a class={`nav-item ${activeSlug === "portfolio" ? "active" : ""}`} href="/portfolio/">
          <span class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="url(#direcf-nav-grad)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
              <Fragment set:html={LOCK_ICON} />
            </svg>
          </span>
          <span class="label">Portfolio</span>
          <span class="count" style="font-size:9px;opacity:0.6">PRV</span>
        </a>
        <a class={`nav-item ${activeSlug === "property" ? "active" : ""}`} href="/property/">
          <span class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="url(#direcf-nav-grad)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
              <Fragment set:html={LOCK_ICON} />
            </svg>
          </span>
          <span class="label">Property</span>
          <span class="count" style="font-size:9px;opacity:0.6">PRV</span>
        </a>
      </nav>
      <div class="sidebar-foot">
        <span>© Seung Jun Lee</span>
      </div>
    </aside>

    <!-- Floating sidebar toggle — sits between sidebar and main so it's
         never clipped no matter the collapsed state -->
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <!-- Main -->
    <div class="main">
      <header class="header">
        <div class="crumbs">
          <a href="/"><strong>direcf</strong></a>
          {crumbs.map((c) => (
            <>
              <span class="sep"> / </span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </div>
        <div class="header-actions">
          <button class="search-trigger" id="searchTrigger" aria-label="Open search">
            <span class="search-icon">🔍</span>
            <span class="search-label">Search…</span>
            <span class="search-kbd">⌘K</span>
          </button>
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
            <span class="sun">☀️</span>
            <span class="moon">🌙</span>
          </button>
          <a class="gh-link" href="https://github.com/direcf" target="_blank" aria-label="GitHub">GitHub ↗</a>
        </div>
      </header>
      <slot />
    </div>

  </div>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay" role="dialog" aria-modal="true">
    <div class="search-modal">
      <div class="search-input-wrap">
        <span class="search-input-icon">🔍</span>
        <input
          class="search-input"
          id="searchInput"
          type="text"
          placeholder="제목·키워드·카테고리 검색…"
          autocomplete="off"
        />
      </div>
      <div class="search-results" id="searchResults"></div>
      <div class="search-footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> 이동 <kbd>↵</kbd> 열기 <kbd>esc</kbd> 닫기</span>
        <span>powered by Fuse.js</span>
      </div>
    </div>
  </div>

  <!-- Search data — emitted server-side -->
  <script id="searchData" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <!-- Sidebar toggle + theme toggle (inline, no bundle needed) -->
  <script is:inline>
    (function () {
      const app = document.getElementById("app");
      const sbBtn = document.getElementById("sidebarToggle");
      const SB_KEY = "direcf:sb-collapsed";
      const apply = (c) => {
        app.classList.toggle("collapsed", c);
        localStorage.setItem(SB_KEY, c ? "1" : "0");
      };
      apply(localStorage.getItem(SB_KEY) === "1");
      if (sbBtn) sbBtn.addEventListener("click", () => apply(!app.classList.contains("collapsed")));

      const themeBtn = document.getElementById("themeToggle");
      const T_KEY = "direcf:theme";
      if (themeBtn) themeBtn.addEventListener("click", () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem(T_KEY, next);
      });
    })();
  </script>

  <!-- Search (bundled) -->
  <script>
    import Fuse from "fuse.js";

    const data = JSON.parse(document.getElementById("searchData").textContent || "[]");
    const fuse = new Fuse(data, {
      keys: [
        { name: "title", weight: 0.45 },
        { name: "keywords", weight: 0.25 },
        { name: "excerpt", weight: 0.20 },
        { name: "category", weight: 0.10 },
      ],
      threshold: 0.4,
      includeScore: true,
      ignoreLocation: true,
    });

    const overlay = document.getElementById("searchOverlay");
    const input = document.getElementById("searchInput") as HTMLInputElement;
    const resultsEl = document.getElementById("searchResults");
    const trigger = document.getElementById("searchTrigger");
    let activeIdx = 0;

    function open() {
      overlay.classList.add("open");
      input.value = "";
      render([]);
      setTimeout(() => input.focus(), 30);
    }
    function close() {
      overlay.classList.remove("open");
    }
    function render(items: any[]) {
      activeIdx = 0;
      if (input.value && items.length === 0) {
        resultsEl.innerHTML = '<div class="search-empty">결과 없음</div>';
        return;
      }
      if (items.length === 0) {
        const recent = data.slice(0, 6);
        resultsEl.innerHTML = '<div class="search-empty" style="text-align:left;padding:8px 12px;">최근 등록 글</div>'
          + recent.map((d, i) => card(d, i)).join("");
        return;
      }
      resultsEl.innerHTML = items.map((it, i) => card(it.item, i)).join("");
    }
    function card(d: any, i: number) {
      return `
        <a class="search-result ${i === activeIdx ? "active" : ""}" href="${d.url}" data-i="${i}">
          <div class="sr-cat">${d.category.toUpperCase()} · ${d.type.toUpperCase()}</div>
          <div class="sr-title">${escape(d.title)}</div>
          <div class="sr-excerpt">${escape(d.excerpt || "")}</div>
        </a>`;
    }
    function escape(s: string) {
      return s.replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]!));
    }
    function setActive(idx: number) {
      const cards = resultsEl.querySelectorAll(".search-result");
      if (cards.length === 0) return;
      activeIdx = (idx + cards.length) % cards.length;
      cards.forEach((c, i) => c.classList.toggle("active", i === activeIdx));
      const target = cards[activeIdx] as HTMLElement;
      target.scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("input", () => {
      const q = input.value.trim();
      render(q ? fuse.search(q).slice(0, 12) : []);
    });

    trigger?.addEventListener("click", open);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });

    document.addEventListener("keydown", (e) => {
      const meta = e.metaKey || e.ctrlKey;
      if (meta && e.key.toLowerCase() === "k") {
        e.preventDefault();
        overlay.classList.contains("open") ? close() : open();
        return;
      }
      if (!overlay.classList.contains("open")) return;
      if (e.key === "Escape") { close(); return; }
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(activeIdx + 1); }
      if (e.key === "ArrowUp")   { e.preventDefault(); setActive(activeIdx - 1); }
      if (e.key === "Enter") {
        const link = resultsEl.querySelectorAll(".search-result")[activeIdx] as HTMLAnchorElement;
        if (link) window.location.href = link.href;
      }
    });
  </script>
</body>
</html>
