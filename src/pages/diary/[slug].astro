---
import BaseLayout from "../../layouts/BaseLayout.astro";
import diary from "../../data/diary.json";
import { md } from "../../lib/courses";

interface DiaryEntry {
  slug: string;
  title: string;
  date: string;
  excerpt: string;
  lead?: string;
  quote?: string;
  body: string;
  image?: { url: string; alt: string; maxWidth?: string };
}

export function getStaticPaths() {
  return (diary as { entries: DiaryEntry[] }).entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: DiaryEntry };
---
<BaseLayout
  title={entry.title}
  description={entry.excerpt}
  activeSlug="diary"
  crumbs={[
    { label: "Diary", href: "/category/diary/" },
    { label: entry.date },
  ]}
>
  <div class="diary-page">
    <a class="back-link" href="/category/diary/">← back to Diary</a>
    <div class="diary-meta">✍️ DIARY · {entry.date}</div>
    <h1>{entry.title}</h1>
    <div class="diary-body">
      {entry.lead && <p><strong>{entry.lead}</strong></p>}
      {entry.quote && <blockquote>{entry.quote}</blockquote>}
      <p set:html={md(entry.body)} />
      {entry.image && (
        <a href={entry.image.url} target="_blank">
          <img
            src={entry.image.url}
            alt={entry.image.alt}
            style={entry.image.maxWidth ? `max-width:${entry.image.maxWidth}` : undefined}
          />
        </a>
      )}
    </div>
  </div>
</BaseLayout>
