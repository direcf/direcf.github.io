  document.getElementById('dashboard').style.display = 'block';
}

// ── KPI Ticker ────────────────────────────────────────────────
function updateKpiTicker(sm, prev, goalTarget) {
  const fmt = v => { const a=Math.abs(v); if(a>=1e8) return (v/1e8).toFixed(2)+'억'; if(a>=1e4) return Math.round(v/1e4).toLocaleString('ko-KR')+'만'; return v.toLocaleString('ko-KR'); };
  const nwDelta = prev!=null ? sm.netWorth-prev.netWorth : null;
  const goalPct = ((sm.netWorth/goalTarget)*100).toFixed(1);
  const gainPos = sm.investmentGainRate>=0;
  const gainColor = gainPos?'#10d4a0':'#ff4d6d';
  const kpis = [
    { label:'순자산', val:fmt(sm.netWorth), color:'#e2e8f0', delta:nwDelta!==null?(nwDelta>=0?'+':'')+fmt(nwDelta):null, dc:nwDelta>=0?'#10d4a0':'#ff4d6d' },
    { label:'총자산', val:fmt(sm.totalAssets), color:'#c8d8f0', delta:null },
    { label:'투자수익률', val:(gainPos?'+':'')+sm.investmentGainRate.toFixed(2)+'%', color:gainColor, delta:null },
    { label:'목표달성률', val:goalPct+'%', color:'#c9a84c', delta:null },
  ];
  const el = document.getElementById('kpiItems');
  if (!el) return;
  el.innerHTML = kpis.map((k,i) => `
    <div class="kpi-item">
      <span class="kpi-label">${k.label}</span>
      <div style="display:flex;align-items:center;gap:7px;">
        <span class="kpi-val" style="color:${k.color}">${k.val}</span>
        ${k.delta?`<span style="font-size:10px;font-weight:700;color:${k.dc};padding:1px 5px;border-radius:4px;background:${k.dc==='#10d4a0'?'rgba(16,212,160,0.1)':'rgba(255,77,109,0.1)'};">${k.delta}</span>`:''}
      </div>
    </div>`).join('');
  const upd = document.getElementById('kpiUpdated');
  if (upd) upd.textContent = new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})+' 기준';
}

