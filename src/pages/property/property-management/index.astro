---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import propertyData from "../../../data/property.json";

const propFiles = import.meta.glob('../../../data/properties/*.json', { eager: true });
const analyzedProps = Object.values(propFiles).map((m: any) => m.default || m);
---
<BaseLayout title="자산 현황" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property",href:"/property/"},{label:"자산 현황"}]}>

<!-- is:global → JS로 생성된 DOM에도 CSS 적용 -->
<style is:global>
@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.css');

/* ── Financial semantic colors ──────────────────────────────── */
:root {
  --fp:#059669; --fp-bg:rgba(5,150,105,.09); --fp-bd:rgba(5,150,105,.22);
  --fn:#dc2626; --fn-bg:rgba(220,38,38,.08);  --fn-bd:rgba(220,38,38,.22);
  --fg:#d97706; --fg-bg:rgba(217,119,6,.08);  --fg-bd:rgba(217,119,6,.22);
}
[data-theme="dark"] {
  --fp:#10b981; --fp-bg:rgba(16,185,129,.12); --fp-bd:rgba(16,185,129,.3);
  --fn:#f87171; --fn-bg:rgba(248,113,113,.1); --fn-bd:rgba(248,113,113,.3);
  --fg:#fbbf24; --fg-bg:rgba(251,191,36,.1);  --fg-bd:rgba(251,191,36,.3);
}

/* ── Font ───────────────────────────────────────────────────── */
#pmWrap, #lockScreen {
  font-family: 'Pretendard', -apple-system, 'Apple SD Gothic Neo', 'SF Pro Text', sans-serif;
}

/* ── KPI Ticker ─────────────────────────────────────────────── */
#kpiTicker {
  position:sticky; top:var(--header-h,58px); z-index:9; height:56px;
  display:flex; align-items:center;
  background:var(--bg-card);
  border-bottom:1.5px solid var(--border);
  box-shadow:0 2px 10px rgba(0,0,0,.06);
}
.pm-kbrand {
  display:flex; align-items:center; gap:9px; padding:0 22px;
  border-right:1.5px solid var(--border); height:100%; flex-shrink:0;
}
.pm-kbdot { width:22px;height:22px;border-radius:7px;background:var(--accent);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.pm-kbtxt { font-size:11px;font-weight:900;letter-spacing:.18em;color:var(--text); }
.pm-kslots { display:flex; flex:1; height:100%; }
.pm-kslot {
  display:flex; flex-direction:column; justify-content:center; gap:2px;
  padding:0 20px; border-right:1px solid var(--border); flex-shrink:0; min-width:115px;
}
.pm-kslot:last-child { border-right:none; }
.pm-klbl { font-size:9px;font-weight:700;color:var(--muted);letter-spacing:1.1px;text-transform:uppercase; }
.pm-krow { display:flex;align-items:center;gap:6px; }
.pm-kval { font-size:15px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.4px; }
.pm-kdelta { font-size:10px;font-weight:700;padding:1px 6px;border-radius:5px; }
.pm-kts { font-size:9px;color:var(--muted);padding:0 16px;flex-shrink:0; }

/* ── Lock Screen ────────────────────────────────────────────── */
#lockScreen { position:fixed;inset:0;z-index:9999;background:#060c1a;display:flex;align-items:center;justify-content:center;overflow:hidden; }
.pm-orb { position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none; }
.pm-orb-a { width:560px;height:560px;background:radial-gradient(circle,rgba(29,78,216,.22),transparent 65%);top:-180px;left:-120px;animation:pmOrba 13s ease-in-out infinite; }
.pm-orb-b { width:480px;height:480px;background:radial-gradient(circle,rgba(8,145,178,.13),transparent 65%);bottom:-160px;right:-100px;animation:pmOrbb 16s ease-in-out infinite; }
.pm-lkcard { position:relative;z-index:1;width:360px;background:rgba(10,18,40,.92);border:1px solid rgba(255,255,255,.08);border-radius:24px;padding:48px 44px 40px;text-align:center;backdrop-filter:blur(32px);box-shadow:0 0 80px rgba(29,78,216,.12),0 24px 80px rgba(0,0,0,.65);animation:pmFadeUp .5s cubic-bezier(.16,1,.3,1) both; }
.pm-lkshine { position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,76,.55),transparent);border-radius:24px 24px 0 0; }
.pm-lkicon { width:68px;height:68px;border-radius:50%;background:rgba(29,78,216,.1);border:1px solid rgba(29,78,216,.18);display:flex;align-items:center;justify-content:center;margin:0 auto 22px; }
.pm-lktitle { font-size:12px;font-weight:900;letter-spacing:.32em;color:#e6edf7;text-transform:uppercase;margin-bottom:5px; }
.pm-lksub { font-size:12px;color:rgba(126,138,163,.8);margin-bottom:32px; }
.pm-lkinp { width:100%;padding:13px 4px;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,.12);color:#e6edf7;font-size:20px;text-align:center;letter-spacing:6px;outline:none;transition:border-color .2s;caret-color:#60a5fa;font-family:inherit; }
.pm-lkinp:focus { border-bottom-color:#60a5fa; }
.pm-lkinp::placeholder { color:rgba(126,138,163,.45);letter-spacing:4px;font-size:14px; }
.pm-lkbtn { width:100%;margin-top:22px;padding:13px;background:linear-gradient(135deg,#1d4ed8,#1e40af);border:none;border-radius:12px;color:#fff;font-size:14px;font-weight:700;cursor:pointer;letter-spacing:.05em;transition:all .2s;box-shadow:0 4px 20px rgba(29,78,216,.35);font-family:inherit; }
.pm-lkbtn:hover { filter:brightness(1.1);transform:translateY(-1px); }
.pm-lkerr { font-size:12px;color:#f87171;margin-top:10px;min-height:18px; }

/* ── Cards ──────────────────────────────────────────────────── */
.pm-card {
  background:var(--bg-card); border:1px solid var(--border); border-radius:14px;
  padding:22px 24px; box-shadow:0 1px 4px rgba(0,0,0,.05);
  transition:box-shadow .18s; position:relative; overflow:hidden;
}
.pm-card:hover { box-shadow:0 4px 18px rgba(0,0,0,.1); }
.pm-stripe { position:absolute;top:0;left:0;right:0;height:3px;border-radius:14px 14px 0 0; }

/* ── Section heading ─────────────────────────────────────────── */
.pm-sh { font-size:15px;font-weight:800;color:var(--text);margin-bottom:18px;display:flex;align-items:center;gap:10px;letter-spacing:-.3px; }
.pm-shbar { width:3px;height:16px;background:var(--accent);border-radius:2px;flex-shrink:0; }

/* ── Grids ──────────────────────────────────────────────────── */
.pm-g3  { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:18px; }
.pm-g2  { display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px; }
.pm-g12 { display:grid;grid-template-columns:1fr 1.9fr;gap:16px;margin-bottom:18px; }
.pm-g21 { display:grid;grid-template-columns:1.9fr 1fr;gap:16px;margin-bottom:18px; }
@media(max-width:900px) { .pm-g3,.pm-g2,.pm-g12,.pm-g21 { grid-template-columns:1fr; } }

/* ── Goal Hero ──────────────────────────────────────────────── */
.pm-hero {
  background:var(--bg-card); border:1px solid var(--border); border-radius:16px;
  padding:30px; margin-bottom:18px; position:relative;
  box-shadow:0 2px 10px rgba(0,0,0,.07);
}
.pm-hero::before { content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--fp),transparent);border-radius:16px 16px 0 0; }
.pm-hgrid { display:grid;grid-template-columns:160px 1fr 200px;gap:32px;align-items:start; }
@media(max-width:900px) { .pm-hgrid { grid-template-columns:1fr; } }
.pm-gwrap { position:relative;width:155px;height:155px; }
.pm-gctr { position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;z-index:2; }
.pm-gpct { font-size:26px;font-weight:900;line-height:1;color:var(--accent); }
.pm-glbl { font-size:10px;color:var(--muted);margin-top:3px; }
.pm-nwlbl { font-size:10px;font-weight:700;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase;margin-bottom:7px; }
.pm-nwval { font-size:42px;font-weight:900;letter-spacing:-1.5px;color:var(--text);line-height:1; }
.pm-nwsub { font-size:12px;color:var(--muted);margin-top:7px; }
/* Progress bar */
.pm-pbar-wrap { margin-top:20px; }
.pm-pbar-bg { height:10px;background:var(--bg-soft);border-radius:5px;position:relative;overflow:visible; }
.pm-pbar-fill { height:100%;border-radius:5px;background:linear-gradient(90deg,var(--accent),var(--fp));transition:width 1s cubic-bezier(.16,1,.3,1);position:relative;z-index:1; }
.pm-pticks { position:absolute;inset:0; }
.pm-ptick { position:absolute;top:-6px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px; }
.pm-tickline { width:1.5px;border-radius:1px; }
.pm-ticklbl { font-size:9px;font-weight:700;white-space:nowrap; }
.pm-pends { display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:14px; }
.pm-pills { display:flex;gap:7px;flex-wrap:wrap;margin-top:12px; }
.pm-pill { background:var(--bg-soft);border:1px solid var(--border);border-radius:7px;padding:5px 11px;font-size:11px;color:var(--text-2);display:flex;align-items:center;gap:5px;white-space:nowrap; }
.pm-pdot { width:6px;height:6px;border-radius:50%;flex-shrink:0; }
.pm-gscol { display:flex;flex-direction:column;gap:10px; }
.pm-gs { background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:13px 15px; }
.pm-gsl { font-size:9px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px; }
.pm-gsv { font-size:15px;font-weight:800;color:var(--text); }

/* ── Badges ─────────────────────────────────────────────────── */
.pm-bd { display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;white-space:nowrap; }
.pm-bdp { background:var(--fp-bg);color:var(--fp); }
.pm-bdn { background:var(--fn-bg);color:var(--fn); }
.pm-bdg { background:var(--fg-bg);color:var(--fg); }
.pm-bda { background:rgba(219,234,254,.8);color:var(--accent); }
[data-theme="dark"] .pm-bda { background:rgba(96,165,250,.12);color:var(--accent); }

/* ── Asset bar ──────────────────────────────────────────────── */
.pm-abar { height:12px;border-radius:6px;overflow:hidden;border:1px solid var(--border);margin-top:14px;display:flex; }
.pm-aseg { height:100%; }
.pm-aleg { display:flex;gap:13px;margin-top:8px;flex-wrap:wrap; }
.pm-aitem { display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted); }
.pm-adot { width:9px;height:9px;border-radius:3px;flex-shrink:0; }

/* ── Live Market ─────────────────────────────────────────────── */
.pm-lmrow { display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);gap:12px; }
.pm-lmrow:last-child { border-bottom:none; }
.pm-lmname { font-size:13px;font-weight:700;color:var(--text); }
.pm-lmtk { font-size:10px;color:var(--muted);margin-left:5px; }
.pm-lmprice { font-size:13px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums; }

/* ── AI Insight ─────────────────────────────────────────────── */
.pm-aibox { background:var(--bg-soft);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:0 12px 12px 0;padding:15px 18px;margin-top:14px; }
.pm-aititle { font-size:10px;font-weight:700;color:var(--accent);letter-spacing:1px;text-transform:uppercase;margin-bottom:11px; }
.pm-airow { display:flex;gap:10px;margin-bottom:7px;font-size:12px;line-height:1.55; }
.pm-aik { color:var(--muted);min-width:90px;font-weight:700;flex-shrink:0; }
.pm-aiv { color:var(--text-2); }

/* ── Comparison ─────────────────────────────────────────────── */
.pm-cmpbtn { padding:5px 13px;border-radius:7px;cursor:pointer;font-size:12px;font-weight:600;border:1px solid var(--border);color:var(--muted);background:var(--bg-card);transition:all .15s;font-family:inherit; }
.pm-cmpbtn.active { background:var(--accent);border-color:var(--accent);color:#fff; }
.pm-cmpbtn:hover:not(.active) { border-color:var(--accent);color:var(--accent); }
.pm-cmpmc { background:var(--bg-soft);border:1px solid var(--border);border-radius:9px;padding:11px 13px; }
.pm-cmpl { font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px; }

/* ── Health ─────────────────────────────────────────────────── */
.pm-hm { background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:12px 14px; }
.pm-hml { font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px; }
.pm-hmbar { height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:4px; }
.pm-hmfill { height:100%;border-radius:2px; }
.pm-hmtxt { font-size:10px;color:var(--muted); }

/* ── Table ──────────────────────────────────────────────────── */
.pm-tbl { width:100%;border-collapse:collapse;font-size:13px; }
.pm-tbl th { padding:8px 10px;font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);background:var(--bg-soft);text-align:left; }
.pm-tbl th.r { text-align:right; }
.pm-tbl td { padding:10px 10px;border-bottom:1px solid var(--border);color:var(--text-2);vertical-align:middle; }
.pm-tbl td.r { text-align:right;font-variant-numeric:tabular-nums; }
.pm-tbl tbody tr:hover td { background:var(--bg-soft); }
.pm-tbl tbody tr:last-child td { border-bottom:none; }
.pm-tbl tfoot td { border-top:1.5px solid var(--border);background:var(--bg-soft);font-weight:700;padding:9px 10px; }

/* ── Sim Slider ─────────────────────────────────────────────── */
.pm-sl { -webkit-appearance:none;appearance:none;width:100%;height:4px;border-radius:2px;background:var(--bg-soft);outline:none;cursor:pointer; }
.pm-sl::-webkit-slider-thumb { -webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:var(--accent);border:2px solid var(--bg-card);cursor:pointer;box-shadow:0 0 6px rgba(29,78,216,.3); }
.pm-sl::-moz-range-thumb { width:16px;height:16px;border-radius:50%;background:var(--accent);border:2px solid var(--bg-card); }

/* ── Animations ─────────────────────────────────────────────── */
@keyframes pmOrba { 0%,100%{transform:translate(0,0)} 50%{transform:translate(28px,-22px)} }
@keyframes pmOrbb { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-22px,28px)} }
@keyframes pmFadeUp { from{opacity:0;transform:translateY(10px) scale(.97)} to{opacity:1;transform:none} }
@keyframes pmShake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(7px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(4px)} }
@keyframes pmIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
.pm-sa { animation:pmIn .4s cubic-bezier(.16,1,.3,1) both; }
</style>

<!-- Lock Screen ─────────────────────────────────────────────── -->
<div id="lockScreen">
  <div class="pm-orb pm-orb-a"></div>
  <div class="pm-orb pm-orb-b"></div>
  <div class="pm-lkcard">
    <div class="pm-lkshine"></div>
    <div class="pm-lkicon">
      <svg width="32" height="32" viewBox="0 0 48 48" fill="none" stroke="#60a5fa" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-7a9 9 0 0 1 18 0v7"/><rect x="9" y="22" width="30" height="21" rx="5"/>
        <circle cx="24" cy="33" r="3" fill="#60a5fa" stroke="none"/>
        <line x1="24" y1="36" x2="24" y2="40.5" stroke="#60a5fa" stroke-width="2.2"/>
      </svg>
    </div>
    <div class="pm-lktitle">PRIVATE</div>
    <div class="pm-lksub">자산 현황 · 비밀번호 입력</div>
    <input id="pwInput" class="pm-lkinp" type="password" placeholder="· · · · · · · ·" autocomplete="off"/>
    <button class="pm-lkbtn" id="unlockBtn">잠금 해제</button>
    <div class="pm-lkerr" id="pwErr"></div>
  </div>
</div>

<!-- Dashboard ───────────────────────────────────────────────── -->
<div id="pmWrap" style="display:none">

  <!-- KPI Ticker -->
  <div id="kpiTicker">
    <div class="pm-kbrand">
      <div class="pm-kbdot">
        <svg width="12" height="10" viewBox="0 0 14 12" fill="none"><polyline points="1,6 4,6 6,1 9,11 11,6 14,6" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <span class="pm-kbtxt">WEALTH</span>
    </div>
    <div class="pm-kslots" id="kpiSlots"></div>
    <div class="pm-kts" id="kpiTs"></div>
  </div>

  <!-- View -->
  <div class="view" id="propView" style="padding-top:22px">

    <!-- Date selector -->
    <div style="position:relative;display:inline-block;margin-bottom:22px">
      <button id="dateBtn" style="display:inline-flex;align-items:center;gap:10px;padding:9px 18px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;cursor:pointer;font-size:14px;font-weight:700;color:var(--text);box-shadow:0 1px 4px rgba(0,0,0,.05);font-family:inherit">
        <span>📅</span><span id="dateLbl">—</span><span style="color:var(--muted);font-size:12px">▾</span>
      </button>
      <div id="dateDd" style="display:none;position:absolute;top:calc(100% + 6px);left:0;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.1);z-index:50;min-width:240px;padding:6px"></div>
    </div>

    <!-- Goal Hero -->
    <div class="pm-hero pm-sa" style="animation-delay:.04s">
      <div class="pm-hgrid">
        <div>
          <div class="pm-gwrap">
            <div id="gaugeChart" style="position:absolute;inset:0"></div>
            <div class="pm-gctr"><div class="pm-gpct" id="gaugePct">0%</div><div class="pm-glbl">달성률</div></div>
          </div>
        </div>
        <div>
          <div class="pm-nwlbl">현재 순자산</div>
          <div class="pm-nwval" id="heroNW">—</div>
          <div class="pm-nwsub" id="heroSub"></div>
          <div class="pm-pbar-wrap">
            <div class="pm-pbar-bg">
              <div class="pm-pbar-fill" id="pbarFill" style="width:0%"></div>
              <div class="pm-pticks" id="pbarTicks"></div>
            </div>
            <div class="pm-pends">
              <span>0</span>
              <span id="pbarMid" style="font-weight:700;color:var(--accent)"></span>
              <span style="font-weight:700;color:var(--fg)">5억 목표</span>
            </div>
          </div>
          <div class="pm-pills" id="goalPills"></div>
        </div>
        <div class="pm-gscol" id="gsCol"></div>
      </div>
    </div>

    <!-- 3 Stat cards -->
    <div class="pm-g3 pm-sa" style="animation-delay:.08s">
      <div class="pm-card">
        <div class="pm-stripe" style="background:var(--accent)"></div>
        <div style="font-size:9px;font-weight:700;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase;margin-bottom:10px;margin-top:4px">총 자산</div>
        <div id="s-ta" style="font-size:26px;font-weight:900;letter-spacing:-1px;color:var(--text)"></div>
        <div id="s-ta-sub" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
        <div id="s-ta-bar"></div>
      </div>
      <div class="pm-card">
        <div class="pm-stripe" style="background:var(--fn)"></div>
        <div style="font-size:9px;font-weight:700;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase;margin-bottom:10px;margin-top:4px">총 부채</div>
        <div id="s-td" style="font-size:26px;font-weight:900;letter-spacing:-1px;color:var(--fn)"></div>
        <div id="s-td-sub" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
        <div id="s-td-det"></div>
      </div>
      <div class="pm-card">
        <div class="pm-stripe" style="background:var(--fp)"></div>
        <div style="font-size:9px;font-weight:700;color:var(--muted);letter-spacing:1.4px;text-transform:uppercase;margin-bottom:10px;margin-top:4px">투자 수익</div>
        <div id="s-ig" style="font-size:26px;font-weight:900;letter-spacing:-1px"></div>
        <div id="s-ig-sub" style="font-size:12px;color:var(--muted);margin-top:4px"></div>
        <div style="margin-top:10px"><div id="retGauge"></div></div>
        <div id="retGaugeLbl" style="text-align:center;margin-top:4px;font-size:11px;color:var(--muted)"></div>
        <div id="cagrRow" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--border);font-size:11px;color:var(--muted)"></div>
      </div>
    </div>

    <!-- Trend -->
    <div class="pm-card pm-sa" style="margin-bottom:18px;animation-delay:.12s">
      <div class="pm-sh"><div class="pm-shbar"></div>순자산 추이</div>
      <div style="position:relative;height:320px"><div id="trendChart"></div></div>
    </div>

    <!-- Live Market -->
    <div class="pm-card pm-sa" style="margin-bottom:18px;animation-delay:.15s">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
