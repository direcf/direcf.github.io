}

function buildSparkline(closes, isPositive) {
  if (!closes||closes.length<2) return '<svg width="60" height="24"></svg>';
  const valid=closes.filter(v=>v!==null&&!isNaN(v));
  if (valid.length<2) return '<svg width="60" height="24"></svg>';
  const min=Math.min(...valid), max=Math.max(...valid), range=max-min||1;
  const W=60,H=24,PAD=2;
  const pts=valid.map((v,i)=>`${(PAD+(i/(valid.length-1))*(W-PAD*2)).toFixed(1)},${(H-PAD-((v-min)/range)*(H-PAD*2)).toFixed(1)}`);
  const lc=isPositive?'#10d4a0':'#ff4d6d', ac=isPositive?'rgba(16,212,160,0.12)':'rgba(255,77,109,0.1)';
  const [lx,ly]=pts[pts.length-1].split(',');
  return `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" fill="none"><path d="M ${pts[0]} L ${pts.join(' L ')} L ${W-PAD},${H-PAD} L ${PAD},${H-PAD} Z" fill="${ac}"/><path d="M ${pts.join(' L ')}" stroke="${lc}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="${lx}" cy="${ly}" r="2" fill="${lc}"/></svg>`;
}

function fmtKRW(v) { const a=Math.abs(v); if(a>=1e8) return (v/1e8).toFixed(2)+'억'; if(a>=1e4) return Math.round(v/1e4).toLocaleString()+'만'; return Math.round(v).toLocaleString(); }

async function fetchRealtime() {
  const invs=_currentInvestments; if(!invs||!invs.length) return;
  const top5=[...invs].sort((a,b)=>b.eval-a.eval).slice(0,5);
  const lr=document.getElementById('liveRows'), le=document.getElementById('liveError');
  if (!lr) return;
  lr.innerHTML=renderSkeletons(top5.length); le.style.display='none';
  const rb=document.getElementById('liveRefreshBtn');
  if(rb){rb.disabled=true;rb.textContent='조회 중…';}
  const settled=await Promise.allSettled(top5.map(async inv=>{
    const ticker=TICKER_MAP[inv.name]??null;
    if(!ticker) return{inv,ticker:null,currentPrice:null,changePercent:null,closes:[],error:'no ticker'};
    try{
      const r=await fetch(`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(ticker)}?interval=1d&range=5d`,{signal:AbortSignal.timeout(8000),headers:{Accept:'application/json'}});
      if(!r.ok) throw new Error(`HTTP ${r.status}`);
      const j=await r.json(); const res=j.chart?.result?.[0]; if(!res) throw new Error('no result');
      const meta=res.meta, cp=meta.regularMarketPrice, pc=meta.previousClose??meta.chartPreviousClose??null;
      const chg=pc?((cp-pc)/pc*100):null, closes=res.indicators?.quote?.[0]?.close??[];
      const isKRW=ticker.endsWith('.KS');
      const evalChange=chg!==null?(inv.eval*chg/100):null;
      return{inv,ticker,currentPrice:cp,changePercent:chg,closes,evalChange,newEval:evalChange!==null?inv.eval+evalChange:null,isKRW,error:null};
    }catch(e){return{inv,ticker,currentPrice:null,changePercent:null,closes:[],error:e.message};}
  }));
  let anyOk=false;
  lr.innerHTML=settled.map(s=>{
    const d=s.status==='fulfilled'?s.value:{inv:top5[0],error:String(s.reason),currentPrice:null};
    if(d.error||d.currentPrice===null){
      const sc=d.inv.rate>=0,sco=sc?'#10d4a0':'#ff4d6d';
      return `<div style="display:flex;align-items:center;gap:0;padding:13px 0;border-bottom:1px solid rgba(255,255,255,0.04);"><div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:700;color:#c8d8f0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${d.inv.name}</div><div style="font-size:10px;color:#4a6080;margin-top:2px;">${TICKER_MAP[d.inv.name]||'—'} · 조회 실패</div></div><div style="text-align:right;min-width:70px;padding:0 12px;"><span style="font-size:12px;font-weight:700;color:${sco};">${sc?'+':''}${d.inv.rate.toFixed(1)}%</span></div><div style="text-align:right;min-width:80px;"><span style="font-size:13px;font-weight:800;color:#c8d8f0;">${fmtKRW(d.inv.eval)}</span></div><div style="margin-left:16px;">${buildSparkline([],sc)}</div></div>`;
    }
    anyOk=true;
    const pos=d.changePercent>=0, co=pos?'#10d4a0':'#ff4d6d';
    const pd=d.isKRW?Math.round(d.currentPrice).toLocaleString()+'원':'$'+d.currentPrice.toFixed(2);
    const ed=d.newEval?fmtKRW(d.newEval):fmtKRW(d.inv.eval);
    const delta=d.evalChange!==null?`<div style="font-size:10px;color:${co};margin-top:1px;">${d.evalChange>=0?'+':''}${fmtKRW(d.evalChange)}</div>`:'';
    return `<div style="display:flex;align-items:center;gap:0;padding:13px 0;border-bottom:1px solid rgba(255,255,255,0.04);"><div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:700;color:#c8d8f0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${d.inv.name}</div><div style="font-size:10px;color:#4a6080;margin-top:2px;">${d.ticker}</div></div><div style="text-align:right;min-width:90px;padding:0 12px;"><span style="font-size:13px;font-weight:700;color:#e2e8f0;font-variant-numeric:tabular-nums;">${pd}</span></div><div style="text-align:right;min-width:65px;padding:0 8px;"><span style="display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:${pos?'rgba(16,212,160,0.12)':'rgba(255,77,109,0.12)'};color:${co};">${pos?'+':''}${d.changePercent.toFixed(2)}%</span></div><div style="text-align:right;min-width:85px;padding:0 12px;"><div style="font-size:13px;font-weight:800;color:#e2e8f0;font-variant-numeric:tabular-nums;">${ed}</div>${delta}</div><div style="margin-left:8px;">${buildSparkline(d.closes,pos)}</div></div>`;
  }).join('');
  if(!anyOk) le.style.display='block';
  if(rb){rb.disabled=false;rb.textContent='새로고침';}
  const ua=document.getElementById('liveUpdatedAt');
  if(ua) ua.textContent=new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit'})+' 기준';
}

function initLiveMarket(investments) { _currentInvestments=Array.isArray(investments)?investments:[]; fetchRealtime(); }

// ── Health Scorecard ──────────────────────────────────────────
function buildHealthSection(sm, invs, loans, data, curIdx) {
  const SECTOR_MAP={'SK하이닉스':'반도체','삼성전자':'반도체','KODEX 미국S&P500':'ETF','ACE 미국S&P500':'ETF','TIGER KRX금현물':'ETF·대안','테슬라':'빅테크·EV','애플':'빅테크·EV','NAVER':'인터넷플랫폼','유니티 소프트웨어':'게임·SW','쿠팡':'이커머스'};
  const SECTOR_COLORS={'반도체':'#6366f1','ETF':'#10d4a0','ETF·대안':'#22d4b0','빅테크·EV':'#c9a84c','인터넷플랫폼':'#818cf8','게임·SW':'#ff4d6d','이커머스':'#f97316'};
  const USD_STOCKS=['테슬라','애플','쿠팡','유니티 소프트웨어'];
  const debtRatio=sm.totalAssets>0?sm.totalDebt/sm.totalAssets:1;
  let sA=debtRatio<0.20?25:debtRatio<0.30?20:debtRatio<0.40?15:debtRatio<0.50?10:5;
  const cov=sm.monthlyInterest>0?(sm.cash+sm.savings)/sm.monthlyInterest:99;
  let sB=cov>=6?25:cov>=4?20:cov>=2?15:cov>=1?10:5;
  const te=invs.reduce((s,i)=>s+(i.eval||0),0);
  const hhi=te>0?invs.reduce((s,i)=>{const w=(i.eval||0)/te;return s+w*w;},0):1;
  let sC=hhi<=0.25?25:hhi<=0.35?20:hhi<=0.50?15:hhi<=0.70?10:5;
  const fn=data.snapshots[0], cn=data.snapshots[curIdx];
  const mob=(a,b)=>{const da=new Date(a),db=new Date(b);return(db.getFullYear()-da.getFullYear())*12+(db.getMonth()-da.getMonth());};
  const em=Math.max(1,mob(fn.snapshotDate,cn.snapshotDate));
  const amg=(sm.netWorth-(fn.summary?fn.summary.netWorth:fn.netWorth))/em;
  const rem=Math.max(1,Math.ceil((new Date(data.goal.deadline)-new Date(cn.snapshotDate))/(1000*60*60*24*30.5)));
  const mn=(data.goal.target-sm.netWorth)/rem;
  let sD=mn>0?(amg/mn>=1.2?25:amg/mn>=1.0?20:amg/mn>=0.8?15:amg/mn>=0.5?10:5):25;
  const tot=sA+sB+sC+sD;
  const grade=tot>=80?'우수':tot>=60?'양호':tot>=40?'주의':'위험';
  const gc=tot>=80?'#10d4a0':tot>=60?'#6366f1':tot>=40?'#c9a84c':'#ff4d6d';
  const ac=s=>s>=20?'#10d4a0':s>=15?'#6366f1':s>=10?'#c9a84c':'#ff4d6d';
  const fmtP=v=>v.toFixed(1)+'%';
  const fmt=v=>{const a=Math.abs(v);if(a>=1e8)return(v/1e8).toFixed(2)+'억';if(a>=1e4)return Math.round(v/1e4).toLocaleString()+'만';return Math.round(v).toLocaleString();};
  const mBar=(label,score,detail,a)=>`<div style="background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.055);border-radius:10px;padding:12px 14px;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><span style="font-size:11px;color:#4a6080;font-weight:600;">${label}</span><span style="font-size:13px;font-weight:900;color:${a};">${score}<span style="font-size:9px;color:#4a6080;">/25</span></span></div><div style="height:4px;background:rgba(255,255,255,0.07);border-radius:2px;overflow:hidden;margin-bottom:6px;"><div style="width:${(score/25)*100}%;height:100%;background:${a};border-radius:2px;"></div></div><div style="font-size:10px;color:#4a6080;">${detail}</div></div>`;
  const sectorMap={};invs.forEach(inv=>{const s=SECTOR_MAP[inv.name]||'기타';sectorMap[s]=(sectorMap[s]||0)+(inv.eval||0);});
  const st=Object.values(sectorMap).reduce((s,v)=>s+v,0);
  const sEntries=Object.entries(sectorMap).map(([k,v])=>({name:k,val:v,pct:st>0?v/st*100:0})).sort((a,b)=>b.val-a.val);
  const semiPct=sEntries.find(e=>e.name==='반도체')?.pct||0;
  let usd=0,krw=0;invs.forEach(i=>{if(USD_STOCKS.includes(i.name))usd+=(i.eval||0);else krw+=(i.eval||0);});
  const ct=usd+krw,up=ct>0?usd/ct*100:0,kp=100-up;
  const me=sm.monthlyInterest*3,ft=me*12*25,fp=ft>0?Math.min(100,(sm.netWorth/ft)*100):0;
  const fbc=fp>=100?'#10d4a0':fp>=60?'#6366f1':fp>=30?'#c9a84c':'#ff4d6d';
  const fLabel=fp>=100?`FIRE 달성! 순자산이 월지출 추정의 ${Math.round(fp)}배`:`FIRE 달성까지 ${fp.toFixed(1)}% — 목표 ${fmt(ft)}`;
  return `<div class="card" style="margin-bottom:0;"><div class="sh">재무 건전성 분석</div>
  <div style="display:grid;grid-template-columns:160px 1fr;gap:28px;align-items:start;margin-bottom:24px;">
    <div style="text-align:center;">
      <div style="width:120px;height:120px;border-radius:50%;margin:0 auto;background:conic-gradient(${gc} ${tot}%,rgba(255,255,255,0.06) 0%);display:flex;align-items:center;justify-content:center;">
        <div style="width:88px;height:88px;border-radius:50%;background:rgba(10,16,36,0.95);display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <span style="font-size:28px;font-weight:900;color:#e2e8f0;line-height:1;">${tot}</span>
          <span style="font-size:10px;color:#4a6080;">/ 100</span>
        </div>
      </div>
      <div style="margin-top:12px;font-size:16px;font-weight:800;color:${gc};">${grade}</div>
      <div style="font-size:10px;color:#4a6080;margin-top:3px;">종합 건전성 등급</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      ${mBar('부채비율',sA,`부채율 ${fmtP(debtRatio*100)}`,ac(sA))}
      ${mBar('유동성',sB,`이자 ${fmt(sm.monthlyInterest)}/월 대비 ${cov>=99?'충분':cov.toFixed(1)+'개월'}`,ac(sB))}
      ${mBar('포트폴리오 분산',sC,`HHI ${hhi.toFixed(3)} (낮을수록 분산)`,ac(sC))}
      ${mBar('목표 달성 페이스',sD,`월필요 ${fmt(mn)} · 실적 ${fmt(amg)}`,ac(sD))}
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:20px;">
    <div style="background:rgba(255,255,255,0.018);border:1px solid rgba(255,255,255,0.055);border-radius:12px;padding:16px 18px;">
      <div style="font-size:11px;font-weight:700;color:#4a6080;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;">섹터 분포</div>
      ${sEntries.map(e=>{const c=SECTOR_COLORS[e.name]||'#6a85a8';return`<div style="margin-bottom:8px;"><div style="display:flex;justify-content:space-between;margin-bottom:4px;"><span style="font-size:11px;color:#c8d8f0;font-weight:600;">${e.name}</span><span style="font-size:11px;color:${c};font-weight:700;">${fmtP(e.pct)}</span></div><div style="height:5px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;"><div style="width:${e.pct}%;height:100%;background:${c};border-radius:3px;"></div></div></div>`;}).join('')}
      ${semiPct>40?`<div style="margin-top:10px;padding:8px 12px;background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.2);border-radius:8px;font-size:10px;color:#c9a84c;">⚠ 반도체 비중 ${fmtP(semiPct)} — 집중 리스크 주의</div>`:''}
    </div>
    <div style="background:rgba(255,255,255,0.018);border:1px solid rgba(255,255,255,0.055);border-radius:12px;padding:16px 18px;">
      <div style="font-size:11px;font-weight:700;color:#4a6080;letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;">통화 익스포저</div>
      <div style="display:flex;height:10px;border-radius:5px;overflow:hidden;margin-bottom:10px;"><div style="width:${kp}%;background:#6366f1;"></div><div style="width:${up}%;background:#c9a84c;"></div></div>
      <div style="display:flex;gap:16px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:6px;"><div style="width:10px;height:10px;border-radius:2px;background:#6366f1;"></div><span style="font-size:11px;color:#c8d8f0;">KRW</span><span style="font-size:11px;font-weight:700;color:#6366f1;">${fmtP(kp)}</span></div>
        <div style="display:flex;align-items:center;gap:6px;"><div style="width:10px;height:10px;border-radius:2px;background:#c9a84c;"></div><span style="font-size:11px;color:#c8d8f0;">USD</span><span style="font-size:11px;font-weight:700;color:#c9a84c;">${fmtP(up)}</span></div>
      </div>
      ${invs.map(i=>{const iu=USD_STOCKS.includes(i.name);return`<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid rgba(255,255,255,0.035);"><span style="font-size:10px;color:#c8d8f0;">${i.name}</span><span style="font-size:10px;font-weight:700;color:${iu?'#c9a84c':'#6366f1'};background:${iu?'rgba(201,168,76,0.1)':'rgba(99,102,241,0.1)'};padding:2px 6px;border-radius:4px;">${iu?'USD':'KRW'}</span></div>`;}).join('')}
    </div>
  </div>
  <div style="background:rgba(99,102,241,0.05);border:1px solid rgba(99,102,241,0.12);border-radius:12px;padding:16px 20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
      <span style="font-size:11px;font-weight:700;color:#4a6080;letter-spacing:1px;text-transform:uppercase;">FIRE 지수</span>
      <span style="font-size:18px;font-weight:900;color:${fbc};">${fp.toFixed(1)}%</span>
    </div>
    <div style="height:8px;background:rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;margin-bottom:10px;"><div style="width:${Math.min(100,fp)}%;height:100%;background:linear-gradient(90deg,${fbc}aa,${fbc});border-radius:4px;"></div></div>
    <div style="font-size:11px;color:#4a6080;">${fLabel}</div>
  </div>
</div>`;
}

// ── Goal Simulator ────────────────────────────────────────────
let _simInitialized = false;

function projectNetWorth(startNW, monthlySavings, annualRate, months) {
  const mr=annualRate/12/100; let nw=startNW;
  for(let i=0;i<months;i++) nw=nw*(1+mr)+monthlySavings;
  return nw;
}

function findGoalMonth(startNW, monthlySavings, annualRate, goalTarget, startDate, maxM) {
  const mr=annualRate/12/100; let nw=startNW;
  for(let i=0;i<=maxM;i++){
    if(nw>=goalTarget){const d=new Date(startDate);d.setMonth(d.getMonth()+i);return{month:i,date:d,achieved:true,nw};}
    nw=nw*(1+mr)+monthlySavings;
  }
  return{achieved:false,nw};
}

function initSimulator(currentSnapshot, goalData) {
  if (_simInitialized) return;
  _simInitialized = true;
  const sm=currentSnapshot.summary, sd=new Date(currentSnapshot.snapshotDate), GOAL=goalData.target;
  const fmt=v=>{const a=Math.abs(v);if(a>=1e8)return(v/1e8).toFixed(2)+'억';if(a>=1e4)return Math.round(v/1e4).toLocaleString()+'만';return Math.round(v).toLocaleString();};
  function updateSimulator(){
    const sav=parseInt(document.getElementById('simSavings').value,10);
    const rate=parseFloat(document.getElementById('simRate').value);
    document.getElementById('simSavingsDisplay').textContent=sav===0?'0만원':(sav/10000).toLocaleString()+'만원';
    document.getElementById('simRateDisplay').textContent=rate.toFixed(1)+'%';
    const scens=[{id:'scenConservative',rate:Math.max(0,rate*0.5),color:'#ff4d6d'},{id:'scenRealistic',rate,color:'#818cf8'},{id:'scenOptimistic',rate:rate*1.5,color:'#10d4a0'}];
    const MAX=60;
    scens.forEach(sc=>{
      const res=findGoalMonth(sm.netWorth,sav,sc.rate,GOAL,sd,MAX);
      const el=document.getElementById(sc.id); const hdr=el.children[0].outerHTML;
      if(res.achieved){const d=res.date,ds=`${d.getFullYear()}년 ${d.getMonth()+1}월`,fn=projectNetWorth(sm.netWorth,sav,sc.rate,res.month);
        el.innerHTML=hdr+`<div style="font-size:22px;font-weight:900;color:${sc.color};letter-spacing:-0.5px;margin:8px 0 4px;">${ds}</div><div style="font-size:11px;color:#4a6080;">목표 달성</div><div style="font-size:13px;font-weight:700;color:#c8d8f0;margin-top:8px;">${fmt(fn)}</div><div style="font-size:10px;color:${sc.color};margin-top:2px;">+${fmt(fn-GOAL)} 초과 · 연 ${sc.rate.toFixed(1)}%</div>`;
      } else {const fn=projectNetWorth(sm.netWorth,sav,sc.rate,MAX);
        el.innerHTML=hdr+`<div style="font-size:18px;font-weight:900;color:#ff4d6d;margin:8px 0 4px;">목표 미달</div><div style="font-size:11px;color:#4a6080;">5년 내 달성 불가</div><div style="font-size:12px;font-weight:700;color:#ff4d6d;margin-top:8px;">-${fmt(GOAL-fn)} 부족</div><div style="font-size:10px;color:#4a6080;margin-top:2px;">연 ${sc.rate.toFixed(1)}%</div>`;
      }
    });
    const dd=new Date(goalData.deadline), mtd=Math.ceil((dd-sd)/(1000*60*60*24*30.5)), cm=Math.max(mtd+6,24);
    const labels=[]; const co=[],re=[],op=[];
    let nc=sm.netWorth,nr=sm.netWorth,no=sm.netWorth;
    const mc=scens[0].rate/12/100,mr=scens[1].rate/12/100,mo=scens[2].rate/12/100;
    for(let i=0;i<=cm;i++){const d=new Date(sd);d.setMonth(d.getMonth()+i);labels.push(d.toLocaleDateString('ko-KR',{year:'2-digit',month:'short'}));co.push(Math.round(nc/1e4));re.push(Math.round(nr/1e4));op.push(Math.round(no/1e4));nc=nc*(1+mc)+sav;nr=nr*(1+mr)+sav;no=no*(1+mo)+sav;}
    const gl=Array(labels.length).fill(Math.round(GOAL/1e4));
    const opts={series:[{name:'보수적',data:co},{name:'현실적',data:re},{name:'낙관적',data:op},{name:'목표',data:gl}],chart:{type:'line',height:220,background:'transparent',toolbar:{show:false},zoom:{enabled:false},animations:{enabled:true,speed:400}},colors:['#ff4d6d','#6366f1','#10d4a0','#c9a84c'],theme:{mode:'dark'},stroke:{width:[2,2.5,2,1.5],curve:'smooth',dashArray:[0,0,0,6]},fill:{type:['solid','gradient','solid','solid'],gradient:{shade:'dark',type:'vertical',shadeIntensity:0.5,gradientToColors:['#6366f100'],opacityFrom:0.12,opacityTo:0}},grid:{borderColor:'rgba(255,255,255,0.04)',strokeDashArray:3},xaxis:{categories:labels,labels:{rotate:-45,style:{colors:'#4a6080',fontSize:'10px'},formatter:(v,i)=>i%3===0?v:''},axisBorder:{color:'rgba(255,255,255,0.04)'},axisTicks:{color:'rgba(255,255,255,0.04)'}},yaxis:{labels:{style:{colors:'#4a6080',fontSize:'10px'},formatter:v=>(v/10000).toFixed(1)+'억'}},legend:{labels:{colors:'#6a85a8'},fontSize:'11px'},tooltip:{theme:'dark',y:{formatter:v=>Math.round(v/100).toLocaleString()+'만원'}},markers:{size:0},annotations:{xaxis:[{x:labels[Math.min(mtd,cm)],borderColor:'#c9a84c',borderWidth:1.5,strokeDashArray:4,label:{text:'목표일',style:{color:'#c9a84c',background:'rgba(10,16,36,0.9)',fontSize:'10px',fontWeight:700},position:'top',orientation:'horizontal'}}]}};
    if(simChartInst){simChartInst.updateOptions(opts,true,true);}else{simChartInst=new ApexCharts(document.getElementById('simChart'),opts);simChartInst.render();}
  }
  if(!document.getElementById('simSliderStyle')){const s=document.createElement('style');s.id='simSliderStyle';s.textContent=`.sim-slider{-webkit-appearance:none;appearance:none;width:100%;height:4px;border-radius:2px;background:rgba(255,255,255,0.08);outline:none;cursor:pointer;}.sim-slider::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:#6366f1;border:2px solid rgba(255,255,255,0.3);cursor:pointer;box-shadow:0 0 6px rgba(99,102,241,0.6);}.sim-slider::-webkit-slider-thumb:hover{box-shadow:0 0 12px rgba(99,102,241,0.9);}.sim-slider::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#6366f1;border:2px solid rgba(255,255,255,0.3);}`;document.head.appendChild(s);}
  document.getElementById('simSavings').addEventListener('input', updateSimulator);
  document.getElementById('simRate').addEventListener('input', updateSimulator);
  updateSimulator();
}

// ── Helpers ───────────────────────────────────────────────────
const fmt = v => { const a=Math.abs(v); if(a>=1e8) return (v/1e8).toFixed(2)+'억'; if(a>=1e4) return Math.round(v/1e4).toLocaleString()+'만'; return v.toLocaleString(); };
const fmtPct = v => (v>=0?'+':'')+v.toFixed(1)+'%';
const dSign  = v => v>0?'+':'';
const dColor = v => v>=0?'#10d4a0':'#ff4d6d';

let curIdx = data.snapshots.length - 1;
let cmpFromIdx = 0;
if (cmpFromIdx === curIdx) cmpFromIdx = curIdx>0?0:(data.snapshots.length>1?1:0);

// ── Init ──────────────────────────────────────────────────────
function init() {
  if (typeof ApexCharts === 'undefined') { setTimeout(init, 100); return; }
  buildTabs();
  buildTrendChart();
  render(curIdx);
}

// ── Date Selector ─────────────────────────────────────────────
function buildTabs() {
  const el = document.getElementById('snapTabs');
  el.style.cssText = 'position:relative;margin-bottom:28px;display:inline-block;';
  const s = data.snapshots[curIdx];
  const prev = curIdx>0?data.snapshots[curIdx-1]:null;
  const delta = prev?s.summary.netWorth-prev.summary.netWorth:null;
  let deltaHtml = '';
  if (delta!==null) {
    const co=delta>=0?'#10d4a0':'#ff4d6d', bg=delta>=0?'rgba(16,212,160,0.12)':'rgba(255,77,109,0.12)';
    deltaHtml=`<span style="font-size:11px;font-weight:700;padding:3px 8px;border-radius:6px;background:${bg};color:${co};margin-left:8px;">${delta>=0?'+':''}${fmt(delta)}</span>`;
  }
  const opts = data.snapshots.map((ss,i)=>{
    const sp=i>0?data.snapshots[i-1]:null;
    const sd=sp?ss.summary.netWorth-sp.summary.netWorth:null;
    const act=i===curIdx;
    let sdH='';
    if(sd!==null){const c2=sd>=0?'#10d4a0':'#ff4d6d',b2=sd>=0?'rgba(16,212,160,0.12)':'rgba(255,77,109,0.12)';sdH=`<span style="font-size:10px;font-weight:700;padding:2px 6px;border-radius:5px;background:${b2};color:${c2};margin-left:8px;">${sd>=0?'+':''}${fmt(sd)}</span>`;}
    return `<div onclick="selectDate(${i})" onmouseover="this.style.background='rgba(99,102,241,0.06)'" onmouseout="this.style.background='${act?'rgba(99,102,241,0.08)':'transparent'}'"
      style="display:flex;align-items:center;padding:10px 14px;cursor:pointer;border-radius:8px;background:${act?'rgba(99,102,241,0.08)':'transparent'};">
      <span style="font-size:13px;font-weight:${act?700:500};color:${act?'#818cf8':'#6a85a8'};">${ss.snapshotDate}</span>
      ${sdH}${act?'<span style="margin-left:auto;color:#6366f1;font-size:12px;padding-left:8px;">✓</span>':''}
    </div>`;
  }).join('');
  el.innerHTML=`<button id="datePickerBtn" onclick="toggleDateDropdown()"
    style="display:inline-flex;align-items:center;gap:10px;padding:10px 20px;background:rgba(10,16,36,0.85);border:1px solid rgba(255,255,255,0.055);border-radius:12px;cursor:pointer;font-size:14px;font-weight:700;color:#e2e8f0;box-shadow:0 4px 24px rgba(0,0,0,0.4);font-family:inherit;backdrop-filter:blur(20px);">
    <span>📅</span><span>${s.snapshotDate}</span>${deltaHtml}<span style="color:#4a6080;font-size:13px;margin-left:4px;">▾</span>
  </button>
  <div id="dateDropdown" style="display:none;position:absolute;top:calc(100% + 6px);left:0;background:rgba(10,16,36,0.95);border:1px solid rgba(255,255,255,0.055);border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,0.6);z-index:200;min-width:280px;padding:8px;backdrop-filter:blur(20px);">
    ${opts}
  </div>`;
  if(!el._ok){document.addEventListener('click',ev=>{const dd=document.getElementById('dateDropdown'),btn=document.getElementById('datePickerBtn');if(dd&&btn&&!btn.contains(ev.target)&&!dd.contains(ev.target))dd.style.display='none';});el._ok=true;}
}

// ── Main Render ───────────────────────────────────────────────
function render(idx) {
  curIdx = idx;
  const s = data.snapshots[idx];
  const sm = s.summary;
  const prev = idx>0?data.snapshots[idx-1]:null;
  const pct = (sm.netWorth/data.goal.target*100).toFixed(1);

  updateKpiTicker(sm, prev?prev.summary:null, data.goal.target);

  document.getElementById('heroNetWorth').textContent = fmt(sm.netWorth);
  document.getElementById('gaugePct').textContent = pct+'%';
  document.getElementById('goalBarFill').style.width = Math.min(pct,100)+'%';
  document.getElementById('goalBarMid').textContent = `현재 ${fmt(sm.netWorth)} (${pct}%)`;

  const remain=data.goal.target-sm.netWorth;
  const months=Math.round((new Date(data.goal.deadline)-new Date(s.snapshotDate))/(1000*60*60*24*30.5));
  const _pill=(c,t)=>`<span class="gpill"><span class="dot" style="background:${c}"></span>${t}</span>`;
  document.getElementById('goalPills').innerHTML=_pill('#6366f1','총자산 '+fmt(sm.totalAssets))+_pill('#ff4d6d','총부채 '+fmt(sm.totalDebt))+_pill('#c9a84c','목표까지 '+fmt(remain));
  const mNeed=months>0?Math.round(remain/months):0;
  document.getElementById('goalStats').innerHTML=`
    <div class="gstat"><div class="gstat-label">목표까지 남은 금액</div><div class="gstat-val" style="color:#ff4d6d;">−${fmt(remain)}</div></div>
    <div class="gstat"><div class="gstat-label">목표 기간 (2027-02)</div><div class="gstat-val" style="color:#6a85a8;">${months>0?'약 '+months+'개월':'마감 지남'}</div></div>
    <div class="gstat"><div class="gstat-label">월 필요 증가액</div><div class="gstat-val" style="color:#6366f1;">${fmt(mNeed)}/월</div></div>`;

  buildGoalGauge(pct);

  // 총자산
  const taD=prev?sm.totalAssets-prev.summary.totalAssets:null;
  document.getElementById('statTotal').innerHTML=`<span style="font-size:28px;font-weight:900;letter-spacing:-1.5px;color:#e2e8f0;">${fmt(sm.totalAssets)}</span>${taD!==null?` <span style="font-size:14px;font-weight:700;color:${dColor(taD)}">${dSign(taD)}${fmt(taD)}</span>`:''}`;
  document.getElementById('statTotalSub').textContent=`순자산 ${fmt(sm.netWorth)}`;
  const rePct=sm.realEstate/sm.totalAssets*100, invPct=sm.investmentTotal/sm.totalAssets*100, cashPct=(sm.cash+sm.savings)/sm.totalAssets*100;
  document.getElementById('statTotalBars').innerHTML=`<div class="sbar" style="margin-top:14px;"><div style="flex:${rePct};background:#6366f1;"></div><div style="flex:${invPct};background:#10d4a0;"></div><div style="flex:${cashPct};background:#c9a84c;"></div></div><div class="sbar-legend"><span class="sbar-lbl"><span class="sbar-dot" style="background:#6366f1"></span>부동산 ${rePct.toFixed(1)}%</span><span class="sbar-lbl"><span class="sbar-dot" style="background:#10d4a0"></span>투자 ${invPct.toFixed(1)}%</span><span class="sbar-lbl"><span class="sbar-dot" style="background:#c9a84c"></span>현금 ${cashPct.toFixed(1)}%</span></div>`;

  // 총부채
  const tdD=prev?sm.totalDebt-prev.summary.totalDebt:null;
  document.getElementById('statDebt').innerHTML=`<span style="font-size:28px;font-weight:900;letter-spacing:-1.5px;color:#ff4d6d;">${fmt(sm.totalDebt)}</span>${tdD!==null&&tdD!==0?` <span style="font-size:14px;font-weight:700;color:${tdD<=0?'#10d4a0':'#ff4d6d'}">${dSign(tdD)}${fmt(tdD)}</span>`:''}`;
  document.getElementById('statDebtSub').textContent=`부채비율 ${(sm.totalDebt/sm.totalAssets*100).toFixed(1)}%`;
  const lco=['#ff4d6d','#c9a84c','#818cf8','#6366f1'];
  const ti2=s.loans.reduce((a,l)=>a+l.balance*(l.rate||0)/100/12,0);
  document.getElementById('statDebtItems').innerHTML=`<div style="display:flex;height:10px;border-radius:5px;overflow:hidden;margin-top:12px;margin-bottom:14px;border:1px solid rgba(255,255,255,0.055);">${s.loans.map((l,i)=>`<div style="flex:${l.balance};background:${lco[i%4]};height:100%;"></div>`).join('')}</div>${s.loans.map((l,i)=>{const mi=Math.round(l.balance*(l.rate||0)/100/12),nm=l.name.length>14?l.name.slice(0,14)+'…':l.name;return`<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,0.04);"><div><div style="font-size:12px;font-weight:700;margin-bottom:2px;color:${lco[i%4]}">${nm}</div><div style="font-size:10px;color:#4a6080;">${l.bank} · ${l.type}</div>${l.rate?`<div style="font-size:11px;color:#4a6080;margin-top:3px;">금리 <strong style="color:#c9a84c">${l.rate}%</strong></div>`:''}</div><div><div style="font-size:14px;font-weight:900;color:#ff4d6d;text-align:right;">${fmt(l.balance)}</div><div style="font-size:10px;color:#4a6080;text-align:right;margin-top:2px;">월이자 ${mi.toLocaleString()}원</div></div></div>`;}).join('')}<div style="font-size:11px;color:#4a6080;margin-top:8px;text-align:right;">월 이자 합계: <strong style="color:#ff4d6d">${Math.round(ti2).toLocaleString()}원</strong></div>`;

  // 투자수익
  const isPos=sm.investmentGain>=0, gainColor=isPos?'#10d4a0':'#ff4d6d';
  document.getElementById('statGain').innerHTML=`<span style="color:${gainColor}">${dSign(sm.investmentGain)}${fmt(sm.investmentGain)}</span>`;
  document.getElementById('statGainSub').innerHTML=`수익률 <span style="color:${gainColor}">${fmtPct(sm.investmentGainRate)}</span>`;
  buildReturnGauge(parseFloat(sm.investmentGainRate)||0);
  document.getElementById('returnGaugePct').innerHTML=`<span style="color:${gainColor}">${fmtPct(sm.investmentGainRate)}</span>`;
  document.getElementById('returnAmounts').innerHTML=`<div style="text-align:center;"><div style="font-size:10px;color:#4a6080;margin-bottom:3px;">투자원금</div><div style="font-size:12px;font-weight:700;color:#6a85a8;">${fmt(sm.investmentCost)}</div></div><div style="text-align:center;"><div style="font-size:10px;color:#4a6080;margin-bottom:3px;">현재 평가</div><div style="font-size:12px;font-weight:700;color:${gainColor};">${fmt(sm.investmentTotal)}</div></div>`;

  buildDonutChart(sm);

  // Investment table
  const invs=s.investments;
  const te=invs.reduce((a,x)=>a+x.eval,0), tc=invs.reduce((a,x)=>a+x.cost,0);
  const _bdg=pos=>pos?'display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(16,212,160,0.12);color:#10d4a0;':'display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(255,77,109,0.12);color:#ff4d6d;';
  const _bb='display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(99,102,241,0.1);color:#818cf8;';
  const _td='padding:11px 12px;border-bottom:1px solid rgba(255,255,255,0.04);vertical-align:middle;color:#c8d8f0;';
  document.getElementById('invTable').innerHTML=invs.map(inv=>{const pnl=inv.eval-inv.cost,pos=pnl>=0,w=(inv.eval/te*100).toFixed(1);return`<tr><td style="${_td}"><strong style="color:#e2e8f0">${inv.name}</strong></td><td style="${_td}"><span style="${_bb}">${inv.broker}</span></td><td style="${_td}text-align:right;color:#6a85a8;font-variant-numeric:tabular-nums;">${inv.cost.toLocaleString()}</td><td style="${_td}text-align:right;font-variant-numeric:tabular-nums;"><strong style="color:#6366f1">${inv.eval.toLocaleString()}</strong></td><td style="${_td}text-align:right;font-variant-numeric:tabular-nums;"><span style="color:${pos?'#10d4a0':'#ff4d6d'}">${pnl>=0?'+':''}${Math.round(pnl).toLocaleString()}</span></td><td style="${_td}text-align:right;"><span style="${_bdg(pos)}">${fmtPct(inv.rate)}</span></td><td style="${_td}"><div style="display:flex;align-items:center;gap:8px;"><div style="flex:1;height:4px;background:rgba(255,255,255,0.06);border-radius:99px;overflow:hidden;"><div style="height:100%;width:${w}%;background:${pos?'#10d4a0':'#ff4d6d'};border-radius:99px;"></div></div><span style="font-size:11px;min-width:38px;text-align:right;color:#6a85a8;">${w}%</span></div></td></tr>`;}).join('');
  const tg=te-tc,tp=tc>0?tg/tc*100:0,gp=tg>=0;
  document.getElementById('invTotalCost').textContent=tc.toLocaleString();
  document.getElementById('invTotalEval').textContent=te.toLocaleString();
  document.getElementById('invTotalGain').innerHTML=`<span style="color:${gp?'#10d4a0':'#ff4d6d'}">${tg>=0?'+':''}${Math.round(tg).toLocaleString()}</span>`;
  document.getElementById('invTotalRate').innerHTML=`<span style="${_bdg(gp)}">${fmtPct(tp)}</span>`;

  buildTop5Chart(invs);
  buildReturnChart(invs);
  buildGrowthChart();

  // AI Opinion
  const sEval=[...invs].sort((a,b)=>b.eval-a.eval), top=sEval[0], topW=te>0?(top.eval/te*100):0;
  const worst=[...invs].sort((a,b)=>a.rate-b.rate)[0], best=[...invs].sort((a,b)=>b.rate-a.rate)[0];
  const conc=topW>=50, loss=worst&&worst.rate<-30;
  const snapDt=new Date(s.snapshotDate), wd=Math.floor((snapDt-new Date('2023-01-01'))/(86400000));
  const wy=Math.floor(wd/365), wm=Math.floor((wd%365)/30);
  const gn=sm.netWorth/data.goal.target*100, dl=new Date(data.goal.deadline);
  const rm=Math.max(0,Math.round((dl-snapDt)/(1000*60*60*24*30.5)));
  const mng=rm>0?Math.round((data.goal.target-sm.netWorth)/rm):0;
  const f0=data.snapshots[0], em2=Math.max(1,Math.round((snapDt-new Date(f0.snapshotDate))/(1000*60*60*24*30.5)));
  const amg2=curIdx>0?Math.round((sm.netWorth-f0.summary.netWorth)/em2):0;
  let enc=gn>=70?`목표의 ${gn.toFixed(1)}% 달성! 🚀 만 31세, 투자 경력 ${wy}년 ${wm}개월 만에 이룬 성과입니다. 현 페이스라면 목표 기간보다 빠른 달성도 가능합니다.`:gn>=50?`목표 절반 돌파! 만 31세에 이 속도는 동세대 상위권입니다. 월 평균 ${fmt(amg2)}씩 성장 중.`:gn>=30?`투자 ${wy}년 ${wm}개월 차, 착실한 성장 중. 월 평균 ${fmt(amg2)} 성장 — 목표까지 월 ${fmt(mng)} 필요.`:`${wy}년 ${wm}개월 동안 꾸준히 자산을 쌓아왔습니다. 복리의 힘이 시작됩니다.`;
  let risk=conc&&loss?`${top.name} 집중(${topW.toFixed(1)}%) + ${worst.name} 깊은 손실(${fmtPct(worst.rate)}) — 분산 확대 시급`:conc?`${top.name} 비중 ${topW.toFixed(1)}% — 단일 종목 집중 리스크 주시`:loss?`${worst.name} 손실 ${fmtPct(worst.rate)} — 추가 매수 전 실적 확인 필수`:`리스크 적정. 최고수익 ${best?best.name+' '+fmtPct(best.rate):''} — 정기 리밸런싱 권장`;
  const inv_dir=sm.investmentGainRate>=0?`+${sm.investmentGainRate.toFixed(2)}% 수익 — 원금 ${fmt(sm.investmentCost)} → 평가 ${fmt(sm.investmentTotal)} (+${fmt(sm.investmentGain)})`:`${sm.investmentGainRate.toFixed(2)}% 손실 — 원금 ${fmt(sm.investmentCost)} → 평가 ${fmt(sm.investmentTotal)} (${fmt(sm.investmentGain)})`;
  const onP=amg2>=mng;
  const _air=(l,v,c)=>`<div style="display:flex;gap:8px;margin-bottom:9px;font-size:12px;"><span style="color:#4a6080;min-width:100px;font-weight:700;flex-shrink:0;">${l}</span><span style="color:${c};flex:1;line-height:1.5;">${v}</span></div>`;
  document.getElementById('aiOpinion').innerHTML=`<div class="ai-opinion-title"><span>🤖</span>AI 투자 의견 · ${s.snapshotDate} 기준</div>${_air('투자 경력',`${wy}년 ${wm}개월 (2023.01 시작, 만 31세)`,'#6a85a8')}${_air('목표 달성률',`${gn.toFixed(1)}% · 잔여 ${rm}개월 · 월 ${fmt(mng)} 필요`,gn>=60?'#10d4a0':gn>=40?'#6366f1':'#ff4d6d')}${_air('월 성장 추이',`평균 ${fmt(amg2)}/월 ${onP?'✅ 목표 이상':'⚠️ 목표 미달'}`,onP?'#10d4a0':'#c9a84c')}${_air('투자 현황',inv_dir,sm.investmentGainRate>=0?'#10d4a0':'#ff4d6d')}${_air('리스크',risk,conc||loss?'#c9a84c':'#10d4a0')}<div style="font-size:12px;color:#4a6080;margin-top:12px;line-height:1.8;border-top:1px solid rgba(255,255,255,0.055);padding-top:12px;">${enc}</div>`;

  // Health section
  document.getElementById('healthSection').innerHTML = buildHealthSection(sm, s.investments, s.loans, data, curIdx);

  // Snapshot comparison
  buildSnapCmp();

  // Loan section
  const loanEl=document.getElementById('loanSection');
  const lt=s.loans.reduce((a,l)=>a+l.balance,0);
  const ti3=s.loans.reduce((a,l)=>a+l.balance*(l.rate||0)/100/12,0);
  loanEl.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:rgba(255,77,109,0.05);border:1px solid rgba(255,77,109,0.12);border-radius:12px;margin-bottom:16px;"><div><div style="font-size:11px;color:#4a6080;font-weight:600">총 대출 잔액</div><div style="font-size:26px;font-weight:900;color:#ff4d6d">${fmt(lt)}</div></div><div style="text-align:right"><div style="font-size:11px;color:#4a6080;font-weight:600">월 이자 합계</div><div style="font-size:18px;font-weight:700;color:#ff4d6d">${Math.round(ti3).toLocaleString()}원</div></div></div>${s.loans.map(l=>{const rp=l.principal-l.balance,rpP=(rp/l.principal*100).toFixed(1),mi=Math.round(l.balance*(l.rate||0)/100/12);return`<div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.055);border-radius:12px;padding:16px 20px;margin-bottom:12px;"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;"><div><div style="font-weight:700;font-size:14px;color:#e2e8f0;">${l.name.slice(0,22)}${l.name.length>22?'…':''}</div><div style="font-size:11px;color:#4a6080;margin-top:2px;">${l.bank} · ${l.type}</div></div><div style="font-size:20px;font-weight:900;color:#ff4d6d;">${fmt(l.balance)}</div></div><div style="display:flex;gap:16px;font-size:12px;color:#4a6080;margin:8px 0;flex-wrap:wrap;"><span>원금: <strong style="color:#c8d8f0;">${fmt(l.principal)}</strong></span>${l.rate?`<span style="color:#c9a84c;font-weight:700">금리 ${l.rate}%</span>`:''}${l.maturityDate?`<span>만기 <strong style="color:#c9a84c">${l.maturityDate}</strong></span>`:''}</div><div style="font-size:12px;color:#4a6080;">월 이자: <strong style="color:#ff4d6d">${mi.toLocaleString()}원</strong></div><div style="height:5px;margin-top:8px;background:rgba(255,255,255,0.06);border-radius:99px;overflow:hidden;"><div style="height:100%;width:${100-parseFloat(rpP)}%;background:#ff4d6d;border-radius:99px;"></div></div><div style="font-size:11px;color:#4a6080;margin-top:4px;">상환 진행 ${rpP}% (${fmt(rp)} 상환)</div></div>`;}).join('')}`;

  // Live Market
  initLiveMarket(s.investments);

  // Simulator
  initSimulator(s, data.goal);

  // Update tabs
  buildTabs();
}

// ── Snapshot Comparison ───────────────────────────────────────
function buildSnapCmp() {
  const btnsEl=document.getElementById('cmpBtns'), panelEl=document.getElementById('cmpPanel');
  if (data.snapshots.length<2) { panelEl.innerHTML='<div style="color:#4a6080;font-size:13px;text-align:center;padding:20px;">비교할 데이터가 없습니다.</div>'; btnsEl.innerHTML=''; return; }
  if (cmpFromIdx===curIdx||cmpFromIdx>=data.snapshots.length) cmpFromIdx=curIdx>0?0:1;
  btnsEl.innerHTML=data.snapshots.map((ss,i)=>{if(i===curIdx)return'';const act=i===cmpFromIdx;return`<button class="cmp-date-btn ${act?'active':''}" onclick="setCmpFrom(${i})">${ss.snapshotDate}</button>`;}).join('');
  const from=data.snapshots[cmpFromIdx], to=data.snapshots[curIdx];
  const nwD=to.summary.netWorth-from.summary.netWorth, taD2=to.summary.totalAssets-from.summary.totalAssets;
  const tdD2=to.summary.totalDebt-from.summary.totalDebt, invD=to.summary.investmentTotal-from.summary.investmentTotal;
  const nwP=from.summary.netWorth>0?nwD/from.summary.netWorth*100:0;
  const dc=v=>v>=0?'#10d4a0':'#ff4d6d', ds=v=>v>=0?'+':'';
  const _mc=(label,fv,tv,diff,inv2)=>{const c=inv2?dc(-diff):dc(diff);return`<div style="background:rgba(6,9,18,0.7);border:1px solid rgba(255,255,255,0.055);border-radius:10px;padding:14px;"><div style="font-size:10px;color:#4a6080;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;margin-bottom:8px;">${label}</div><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;"><span style="font-size:13px;color:#6a85a8;">${fmt(fv)}</span><span style="color:#4a6080;font-size:11px;">→</span><span style="font-size:13px;font-weight:700;color:#e2e8f0;">${fmt(tv)}</span><span style="font-size:12px;font-weight:800;margin-left:auto;color:${c}">${ds(diff)}${fmt(diff)}</span></div></div>`;};
  panelEl.innerHTML=`<div class="cmp-panel" style="display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;"><div><div style="font-size:10px;color:#4a6080;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:6px;">기준 스냅샷</div><div style="font-size:26px;font-weight:900;color:#e2e8f0;letter-spacing:-0.5px;">${fmt(from.summary.netWorth)}</div><div style="font-size:12px;color:#4a6080;margin-top:5px;">${from.snapshotDate}</div><div style="font-size:12px;color:#4a6080;">총자산 ${fmt(from.summary.totalAssets)}</div></div><div style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:0 8px;"><span style="font-size:22px;color:#6366f1;">→</span><div style="font-size:15px;font-weight:800;color:${dc(nwD)}">${ds(nwD)}${fmt(nwD)}</div><div style="font-size:11px;font-weight:700;color:${dc(nwD)}">(${ds(nwP)}${nwP.toFixed(1)}%)</div></div><div><div style="font-size:10px;color:#4a6080;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:6px;display:flex;align-items:center;gap:6px;">현재 선택 <span style="background:#6366f1;color:#fff;font-size:9px;padding:1px 7px;border-radius:4px;">NOW</span></div><div style="font-size:26px;font-weight:900;color:#6366f1;letter-spacing:-0.5px;">${fmt(to.summary.netWorth)}</div><div style="font-size:12px;color:#4a6080;margin-top:5px;">${to.snapshotDate}</div><div style="font-size:12px;color:#4a6080;">총자산 ${fmt(to.summary.totalAssets)}</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;">${_mc('총자산',from.summary.totalAssets,to.summary.totalAssets,taD2,false)}${_mc('순자산',from.summary.netWorth,to.summary.netWorth,nwD,false)}${_mc('총부채',from.summary.totalDebt,to.summary.totalDebt,tdD2,true)}${_mc('투자 평가',from.summary.investmentTotal,to.summary.investmentTotal,invD,false)}</div>`;
}

window.toggleDateDropdown = function() { const dd=document.getElementById('dateDropdown'); if(!dd) return; dd.style.display=dd.style.display==='none'?'block':'none'; };
window.selectDate = function(i) { curIdx=i; if(cmpFromIdx===curIdx) cmpFromIdx=curIdx>0?0:(data.snapshots.length>1?1:0); buildTabs(); render(i); };
window.setCmpFrom = function(i) { cmpFromIdx=i; buildSnapCmp(); };

if (sessionStorage.getItem(SESSION_KEY)==='1') init();
</script>
</BaseLayout>
