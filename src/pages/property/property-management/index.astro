---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import propertyData from "../../../data/property.json";
---
<BaseLayout title="자산 현황" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property",href:"/property/"},{label:"자산 현황"}]}>
<style>
@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-dynamic-subset.css');

/* ── Brand accent vars (light / dark) ─────────────────────── */
:root {
  --clr-pos: #065f46; --clr-pos-bg: rgba(6,95,70,0.1);
  --clr-neg: #991b1b; --clr-neg-bg: rgba(153,27,27,0.08);
  --clr-goal: #92400e; --clr-goal-bg: rgba(146,64,14,0.08);
  --clr-teal: #0891b2; --clr-teal-bg: rgba(8,145,178,0.08);
}
[data-theme="dark"] {
  --clr-pos: #10d4a0; --clr-pos-bg: rgba(16,212,160,0.12);
  --clr-neg: #ff4d6d; --clr-neg-bg: rgba(255,77,109,0.12);
  --clr-goal: #c9a84c; --clr-goal-bg: rgba(201,168,76,0.12);
  --clr-teal: #22d3ee; --clr-teal-bg: rgba(34,211,238,0.1);
}

/* ── Base overrides ────────────────────────────────────────── */
#pmDashboard { font-family: 'Pretendard', -apple-system, 'Apple SD Gothic Neo', sans-serif; }

/* ── KPI Ticker ────────────────────────────────────────────── */
#kpiTicker {
  position: sticky;
  top: var(--header-h, 58px);
  z-index: 9;
  height: 50px;
  background: var(--header-blur-bg, rgba(238,244,251,.95));
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 32px;
  gap: 0;
}
.kpi-brand { display:flex; align-items:center; gap:8px; margin-right:20px; padding-right:20px; border-right:1px solid var(--border); flex-shrink:0; }
.kpi-brand-dot { width:18px; height:18px; border-radius:5px; background:var(--accent); flex-shrink:0; }
.kpi-brand-txt { font-size:11px; font-weight:900; letter-spacing:0.15em; color:var(--text); text-transform:uppercase; }
.kpi-items { display:flex; flex:1; overflow:hidden; }
.kpi-item { display:flex; flex-direction:column; justify-content:center; padding:0 18px; border-right:1px solid var(--border); flex-shrink:0; }
.kpi-item:last-child { border-right:none; }
.kpi-lbl { font-size:9px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; color:var(--muted); margin-bottom:1px; }
.kpi-val { font-size:14px; font-weight:800; color:var(--text); font-variant-numeric:tabular-nums; letter-spacing:-0.3px; }
.kpi-delta { font-size:10px; font-weight:700; padding:0 5px; border-radius:4px; margin-left:5px; }
#kpiUpdated { font-size:9px; color:var(--muted); flex-shrink:0; letter-spacing:0.3px; }

/* ── Lock Screen ───────────────────────────────────────────── */
#lockScreen { position:fixed; inset:0; z-index:9999; background:#060c1a; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.orb { position:absolute; border-radius:50%; filter:blur(90px); pointer-events:none; }
.orb-1 { width:560px; height:560px; background:radial-gradient(circle,rgba(29,78,216,0.22),transparent 65%); top:-180px; left:-120px; animation:orb1 13s ease-in-out infinite; }
.orb-2 { width:480px; height:480px; background:radial-gradient(circle,rgba(8,145,178,0.13),transparent 65%); bottom:-160px; right:-100px; animation:orb2 16s ease-in-out infinite; }
.orb-3 { width:380px; height:380px; background:radial-gradient(circle,rgba(146,64,14,0.08),transparent 65%); top:55%; left:55%; animation:orb3 20s ease-in-out infinite; }
.lock-grid { position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,0.014) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.014) 1px,transparent 1px); background-size:56px 56px; pointer-events:none; }
.lock-card { position:relative; z-index:1; width:360px; background:rgba(10,18,40,0.92); border:1px solid rgba(255,255,255,0.08); border-radius:24px; padding:48px 44px 40px; text-align:center; backdrop-filter:blur(32px); -webkit-backdrop-filter:blur(32px); box-shadow:0 0 80px rgba(29,78,216,0.12),0 24px 80px rgba(0,0,0,0.65); animation:fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) forwards; }
.lock-shine-top { position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(201,168,76,0.55),transparent); border-radius:24px 24px 0 0; }
.lock-shine-bot { position:absolute; bottom:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(29,78,216,0.35),transparent); border-radius:0 0 24px 24px; }
.lock-icon { width:68px; height:68px; border-radius:50%; background:rgba(29,78,216,0.1); border:1px solid rgba(29,78,216,0.18); display:flex; align-items:center; justify-content:center; margin:0 auto 22px; }
.lock-title { font-size:12px; font-weight:900; letter-spacing:0.32em; color:#e6edf7; text-transform:uppercase; margin-bottom:5px; }
.lock-sub { font-size:12px; color:rgba(126,138,163,0.8); margin-bottom:34px; }
.lock-input { width:100%; padding:13px 4px; background:transparent; border:none; border-bottom:1px solid rgba(255,255,255,0.1); color:#e6edf7; font-size:20px; text-align:center; letter-spacing:6px; outline:none; transition:border-color .2s; caret-color:#60a5fa; font-family:inherit; }
.lock-input:focus { border-bottom-color:#60a5fa; }
.lock-input::placeholder { color:rgba(126,138,163,0.45); letter-spacing:4px; font-size:15px; }
.lock-btn { width:100%; margin-top:22px; padding:13px; background:linear-gradient(135deg,#1d4ed8,#1e40af); border:none; border-radius:12px; color:#fff; font-size:14px; font-weight:700; cursor:pointer; letter-spacing:0.05em; transition:all .2s; box-shadow:0 4px 20px rgba(29,78,216,0.35); font-family:inherit; }
.lock-btn:hover { filter:brightness(1.1); transform:translateY(-1px); }
.lock-err { font-size:12px; color:#ff4d6d; margin-top:10px; min-height:18px; }
.lock-hint { font-size:10px; color:rgba(42,53,80,0.6); margin-top:18px; letter-spacing:0.1em; }

/* ── Cards ─────────────────────────────────────────────────── */
.pcard {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px;
  box-shadow: var(--shadow-sm);
  transition: border-color .18s, box-shadow .18s;
  position: relative;
  overflow: hidden;
}
.pcard:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
.pcard-accent { position:absolute; top:0; left:0; right:0; height:3px; }
.pcard-accent.a { background:linear-gradient(90deg,var(--accent),transparent); }
.pcard-accent.p { background:linear-gradient(90deg,var(--clr-pos),transparent); }
.pcard-accent.n { background:linear-gradient(90deg,var(--clr-neg),transparent); }
.pcard-accent.g { background:linear-gradient(90deg,var(--clr-goal),transparent); }

/* ── Section heading ────────────────────────────────────────── */
.sh { font-size:15px; font-weight:800; color:var(--text); margin-bottom:18px; display:flex; align-items:center; gap:10px; letter-spacing:-0.3px; }
.sh::before { content:''; display:block; width:3px; height:15px; background:var(--accent); border-radius:2px; flex-shrink:0; }

/* ── Grids ──────────────────────────────────────────────────── */
.pg3  { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:18px; }
.pg2  { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:18px; }
.pg12 { display:grid; grid-template-columns:1fr 1.9fr; gap:16px; margin-bottom:18px; }
.pg21 { display:grid; grid-template-columns:1.9fr 1fr; gap:16px; margin-bottom:18px; }
@media(max-width:900px) { .pg3,.pg2,.pg12,.pg21 { grid-template-columns:1fr; } }

/* ── Goal hero ──────────────────────────────────────────────── */
.goal-hero { background:var(--bg-card); border:1px solid var(--border); border-radius:16px; padding:32px; margin-bottom:18px; position:relative; overflow:hidden; box-shadow:var(--shadow-sm); }
.goal-hero::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--accent),var(--clr-pos),transparent); }
.goal-grid { display:grid; grid-template-columns:170px 1fr 210px; gap:36px; align-items:center; }
@media(max-width:900px) { .goal-grid { grid-template-columns:1fr; } }
.gauge-wrap { position:relative; width:160px; height:160px; }
.gauge-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; z-index:2; }
.gauge-pct { font-size:26px; font-weight:900; color:var(--clr-goal); line-height:1; }
.gauge-lbl { font-size:11px; color:var(--muted); margin-top:3px; }
.goal-label { font-size:10px; color:var(--muted); letter-spacing:1.4px; text-transform:uppercase; font-weight:700; margin-bottom:8px; }
.goal-nw { font-size:46px; font-weight:900; letter-spacing:-3px; color:var(--text); line-height:1; }
.goal-target { font-size:13px; color:var(--muted); margin-top:8px; }
.goal-bar-outer { margin-top:16px; }
.goal-bar-bg { height:8px; background:var(--bg-soft); border-radius:4px; overflow:visible; position:relative; }
.goal-bar-fill { height:100%; border-radius:4px; background:linear-gradient(90deg,var(--accent),var(--clr-pos)); transition:width 1s cubic-bezier(.16,1,.3,1); }
.goal-milestones { position:absolute; top:0; left:0; right:0; height:8px; }
.ms { position:absolute; top:-6px; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:2px; }
.ms-line { width:1.5px; height:20px; border-radius:1px; }
.ms-lbl { font-size:9px; font-weight:700; white-space:nowrap; }
.goal-bar-labels { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); margin-top:5px; }
.goal-pills { display:flex; gap:7px; flex-wrap:wrap; margin-top:12px; }
.gpill { display:inline-flex; align-items:center; gap:5px; background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:4px 10px; font-size:11px; color:var(--text-2); }
.gstat-col { display:flex; flex-direction:column; gap:10px; }
.gstat { background:var(--bg-soft); border:1px solid var(--border); border-radius:10px; padding:13px 16px; }
.gstat-lbl { font-size:9px; color:var(--muted); margin-bottom:3px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; }
.gstat-val { font-size:16px; font-weight:800; color:var(--text); }

/* ── Stat badges & bars ─────────────────────────────────────── */
.badge { display:inline-block; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:700; }
.b-pos { background:var(--clr-pos-bg); color:var(--clr-pos); }
.b-neg { background:var(--clr-neg-bg); color:var(--clr-neg); }
.b-goal { background:var(--clr-goal-bg); color:var(--clr-goal); }
.b-acc { background:var(--accent-soft); color:var(--accent); }
.sbar { display:flex; height:10px; border-radius:5px; overflow:hidden; border:1px solid var(--border); margin-top:12px; }
.sbar-leg { display:flex; gap:10px; margin-top:7px; flex-wrap:wrap; }
.sbar-dot { width:8px; height:8px; border-radius:2px; display:inline-block; flex-shrink:0; }
.sbar-lbl { font-size:11px; color:var(--muted); display:flex; align-items:center; gap:4px; }
.mbar { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.mbar-lbl { font-size:11px; color:var(--muted); min-width:64px; font-weight:500; }
.mbar-bg { flex:1; height:5px; background:var(--bg-soft); border-radius:99px; overflow:hidden; }
.mbar-fill { height:100%; border-radius:99px; }
.mbar-val { font-size:11px; min-width:36px; text-align:right; color:var(--text-2); font-variant-numeric:tabular-nums; }

/* ── Chart wrappers ─────────────────────────────────────────── */
.ch { position:relative; height:280px; }
.ch-sm { position:relative; height:230px; }
.ch-mini { position:relative; height:80px; }
.ch-growth { position:relative; height:240px; margin-top:18px; }

/* ── Table ──────────────────────────────────────────────────── */
.dtbl { width:100%; border-collapse:collapse; font-size:13px; }
.dtbl th { padding:9px 11px; font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--muted); border-bottom:1px solid var(--border); background:var(--bg-soft); text-align:left; }
.dtbl th.r { text-align:right; }
.dtbl td { padding:10px 11px; border-bottom:1px solid var(--border); vertical-align:middle; color:var(--text-2); }
.dtbl td.r { text-align:right; font-variant-numeric:tabular-nums; }
.dtbl tbody tr:hover td { background:var(--bg-soft); }
.dtbl tbody tr:last-child td { border-bottom:none; }
.dtbl tfoot td { border-top:1px solid var(--border); background:var(--bg-soft); font-weight:700; padding:10px 11px; }

/* ── Live market (compact) ──────────────────────────────────── */
.lm-row { display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--border); gap:10px; }
.lm-row:last-child { border-bottom:none; }
.lm-name { font-size:13px; font-weight:700; color:var(--text); }
.lm-ticker { font-size:10px; color:var(--muted); margin-left:5px; }
.lm-price { font-size:13px; font-weight:700; color:var(--text); font-variant-numeric:tabular-nums; }
.lm-skel { height:13px; border-radius:4px; background:var(--bg-soft); animation:shimmer 1.4s linear infinite; background-size:200% 100%; }
[data-theme="dark"] .lm-skel { background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%); background-size:200% 100%; }

/* ── AI opinion ─────────────────────────────────────────────── */
.ai-box { background:var(--bg-soft); border:1px solid var(--border); border-left:3px solid var(--accent); border-radius:0 12px 12px 0; padding:16px 18px; margin-top:16px; }
.ai-title { font-size:10px; font-weight:700; color:var(--accent); letter-spacing:1px; text-transform:uppercase; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
.ai-row { display:flex; gap:8px; margin-bottom:8px; font-size:12px; }
.ai-key { color:var(--muted); min-width:88px; font-weight:700; flex-shrink:0; }
.ai-val { color:var(--text-2); flex:1; line-height:1.55; }

/* ── Cmp panel ──────────────────────────────────────────────── */
.cmp-btn { padding:5px 13px; border-radius:7px; cursor:pointer; font-size:12px; font-weight:600; border:1px solid var(--border); color:var(--muted); background:var(--bg-card); transition:all .15s; font-family:inherit; }
.cmp-btn.active { background:var(--accent); border-color:var(--accent); color:#fff; }
.cmp-btn:hover:not(.active) { border-color:var(--accent); color:var(--accent); }

/* ── Health section ─────────────────────────────────────────── */
.h-score-wrap { display:flex; flex-direction:column; align-items:center; }
.h-score-ring { position:relative; width:120px; height:120px; }
.h-score-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.h-metric { background:var(--bg-soft); border:1px solid var(--border); border-radius:10px; padding:12px 14px; }
.h-metric-lbl { font-size:10px; color:var(--muted); font-weight:700; margin-bottom:7px; text-transform:uppercase; letter-spacing:0.5px; }
.h-mbar { height:4px; background:var(--border); border-radius:2px; overflow:hidden; margin-top:5px; }
.h-mbar-fill { height:100%; border-radius:2px; }

/* ── Sim slider ─────────────────────────────────────────────── */
.sim-sl { -webkit-appearance:none; appearance:none; width:100%; height:4px; border-radius:2px; background:var(--bg-soft); outline:none; cursor:pointer; }
.sim-sl::-webkit-slider-thumb { -webkit-appearance:none; width:16px; height:16px; border-radius:50%; background:var(--accent); border:2px solid var(--bg-card); cursor:pointer; box-shadow:0 0 6px rgba(29,78,216,0.4); }
.sim-sl::-moz-range-thumb { width:16px; height:16px; border-radius:50%; background:var(--accent); border:2px solid var(--bg-card); }

/* ── Keyframes ──────────────────────────────────────────────── */
@keyframes orb1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(28px,-22px)} }
@keyframes orb2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-22px,28px)} }
@keyframes orb3 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(18px,18px)} }
@keyframes fadeUp { from{opacity:0;transform:translateY(10px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
@keyframes shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(7px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(4px)} }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
@keyframes sectIn { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
.sect-anim { animation: sectIn .45s cubic-bezier(.16,1,.3,1) both; }
</style>

<!-- Lock Screen ─────────────────────────────────────────────── -->
<div id="lockScreen">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="lock-grid"></div>
  <div class="lock-card">
    <div class="lock-shine-top"></div>
    <div class="lock-icon">
      <svg width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="#60a5fa" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-7a9 9 0 0 1 18 0v7"/>
        <rect x="9" y="22" width="30" height="21" rx="5"/>
        <circle cx="24" cy="33" r="3" fill="#60a5fa" stroke="none"/>
        <line x1="24" y1="36" x2="24" y2="40.5" stroke="#60a5fa" stroke-width="2.2"/>
      </svg>
    </div>
    <div class="lock-title">PRIVATE</div>
    <div class="lock-sub">자산 현황 · 비밀번호 입력</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="· · · · · · · ·" autocomplete="off"/>
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io · property</div>
    <div class="lock-shine-bot"></div>
  </div>
</div>

<!-- Dashboard (hidden until auth) ───────────────────────────── -->
<div id="pmDashboard" style="display:none">

  <!-- KPI Ticker (sticky, inside .main flow, never covers sidebar/header) -->
  <div id="kpiTicker">
    <div class="kpi-brand">
      <div class="kpi-brand-dot"></div>
      <span class="kpi-brand-txt">WEALTH</span>
    </div>
    <div class="kpi-items" id="kpiItems"></div>
    <div id="kpiUpdated"></div>
  </div>

  <!-- Content -->
  <div class="view" id="propView" style="padding-top:24px">

    <!-- Date Selector -->
    <div style="position:relative;display:inline-block;margin-bottom:24px;" id="snapTabWrap">
      <button id="datePickerBtn" style="display:inline-flex;align-items:center;gap:10px;padding:9px 18px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;cursor:pointer;font-size:14px;font-weight:700;color:var(--text);box-shadow:var(--shadow-sm);font-family:inherit;">
        <span>📅</span><span id="datePickerLabel">—</span><span style="color:var(--muted);font-size:13px;">▾</span>
      </button>
      <div id="dateDropdown" style="display:none;position:absolute;top:calc(100% + 5px);left:0;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-lg);z-index:50;min-width:260px;padding:6px;" id="dateDropdown"></div>
    </div>

    <!-- Goal Hero -->
    <div class="goal-hero sect-anim" style="animation-delay:.05s">
      <div class="goal-grid">
        <div>
          <div class="gauge-wrap">
            <div id="gaugeChart" style="position:absolute;inset:0;"></div>
            <div class="gauge-center">
              <div class="gauge-pct" id="gaugePct">0%</div>
              <div class="gauge-lbl">달성률</div>
            </div>
          </div>
        </div>
        <div>
          <div class="goal-label">현재 순자산</div>
          <div class="goal-nw" id="heroNW">—</div>
          <div class="goal-target" id="heroTarget"></div>
          <div class="goal-bar-outer">
            <div class="goal-bar-bg">
              <div class="goal-bar-fill" id="goalBarFill" style="width:0%"></div>
              <div class="goal-milestones" id="goalMilestones"></div>
            </div>
            <div class="goal-bar-labels"><span>0</span><span id="goalBarMid" style="color:var(--accent)"></span><span style="color:var(--clr-goal)">5억 목표</span></div>
          </div>
          <div class="goal-pills" id="goalPills"></div>
        </div>
        <div class="gstat-col" id="goalStats"></div>
      </div>
    </div>

    <!-- 3 Stat Cards -->
    <div class="pg3 sect-anim" style="animation-delay:.1s">
      <div class="pcard">
        <div class="pcard-accent a"></div>
        <div style="font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;">총 자산</div>
        <div id="statTotal" style="font-size:26px;font-weight:900;letter-spacing:-1px;color:var(--text);"></div>
        <div id="statTotalSub" style="font-size:12px;color:var(--muted);margin-top:4px;"></div>
        <div id="statTotalBars"></div>
      </div>
      <div class="pcard">
        <div class="pcard-accent n"></div>
        <div style="font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;">총 부채</div>
        <div id="statDebt" style="font-size:26px;font-weight:900;letter-spacing:-1px;color:var(--clr-neg);"></div>
