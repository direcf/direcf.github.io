/* ── Auth ─────────────────────────────────────────────────── */
const PW_HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SK = 'prop:auth';
async function sha256(s) {
  const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
  return Array.from(new Uint8Array(b)).map(x => x.toString(16).padStart(2,'0')).join('');
}
async function tryUnlock() {
  const v = document.getElementById('pwInput').value, e = document.getElementById('pwErr');
  if (!v) { e.textContent = '비밀번호를 입력하세요'; return; }
  if (await sha256(v) === PW_HASH) {
    sessionStorage.setItem(SK, '1');
    const ls = document.getElementById('lockScreen');
    ls.style.transition = 'opacity .4s'; ls.style.opacity = '0'; ls.style.pointerEvents = 'none';
    setTimeout(() => ls.style.display = 'none', 450);
    const wr = document.getElementById('pmWrap');
    wr.style.display = 'block'; wr.style.opacity = '0'; wr.style.transition = 'opacity .35s';
    setTimeout(() => wr.style.opacity = '1', 30);
    init();
  } else {
    e.textContent = '비밀번호가 올바르지 않습니다';
    document.querySelector('.pm-lkcard').style.animation = 'none';
    void document.querySelector('.pm-lkcard').offsetWidth;
    document.querySelector('.pm-lkcard').style.animation = 'pmShake .45s ease';
    const inp = document.getElementById('pwInput');
    inp.value = ''; inp.style.borderBottomColor = '#f87171';
    setTimeout(() => { inp.style.borderBottomColor = 'rgba(255,255,255,.12)'; e.textContent = ''; }, 1500);
  }
}
document.getElementById('unlockBtn').addEventListener('click', tryUnlock);
document.getElementById('pwInput').addEventListener('keydown', e => { if (e.key === 'Enter') tryUnlock(); });
setTimeout(() => { const p = document.getElementById('pwInput'); if (p) p.focus(); }, 80);
if (sessionStorage.getItem(SK) === '1') {
