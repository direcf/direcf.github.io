}
const PC = v => v >= 0 ? 'var(--fp)' : 'var(--fn)';
const BC = v => v >= 0 ? 'var(--fp-bg)' : 'var(--fn-bg)';

/* ── Formatters ───────────────────────────────────────────── */
const fW = v => { const a = Math.abs(v); return a >= 1e8 ? (v/1e8).toFixed(2)+'억' : a >= 1e4 ? Math.round(v/1e4).toLocaleString()+'만' : Math.round(v).toLocaleString(); };
const fP = v => (v >= 0 ? '+' : '') + v.toFixed(2) + '%';

/* ── Chart registry ───────────────────────────────────────── */
const charts = {};
function mk(id, opts) {
  if (charts[id]) { try { charts[id].destroy(); } catch(e) {} delete charts[id]; }
  const el = document.getElementById(id); if (!el) return null;
  const c = new ApexCharts(el, opts); c.render(); charts[id] = c; return c;
}
function apexBase(extra = {}) {
  const c = CC();
