const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
}
async function tryUnlock() {
  const pwInput = document.getElementById('pwInput');
  const errEl   = document.getElementById('pwErr');
  const pw = pwInput.value;
  if (!pw) { errEl.textContent='비밀번호를 입력해 주세요.'; return; }
  const h = await sha256(pw);
  if (h === HASH) {
    sessionStorage.setItem(SESSION_KEY, '1');
    const ls = document.getElementById('lockScreen');
    ls.style.transition = 'opacity 0.5s ease';
    ls.style.opacity = '0';
    ls.style.pointerEvents = 'none';
    setTimeout(() => { ls.style.display='none'; }, 520);
    const dash = document.getElementById('dashboard');
    dash.style.display = 'block';
    dash.style.opacity = '0';
    dash.style.transition = 'opacity 0.4s ease';
    setTimeout(() => { dash.style.opacity='1'; }, 30);
    if (typeof init === 'function') init();
  } else {
    const card = document.querySelector('.lock-card');
    errEl.textContent = '비밀번호가 올바르지 않습니다.';
    pwInput.value = '';
    pwInput.focus();
    card.style.animation = 'none';
    void card.offsetWidth;
    card.style.animation = 'shake 0.5s ease';
    pwInput.style.borderBottomColor = '#ff4d6d';
    setTimeout(() => { pwInput.style.borderBottomColor='rgba(255,255,255,0.12)'; errEl.textContent=''; }, 1500);
  }
}
document.getElementById('unlockBtn').addEventListener('click', tryUnlock);
document.getElementById('pwInput').addEventListener('keydown', e => { if(e.key==='Enter') tryUnlock(); });
document.getElementById('lockScreen').addEventListener('click', e => { if(e.target.id!=='unlockBtn') document.getElementById('pwInput').focus(); });
