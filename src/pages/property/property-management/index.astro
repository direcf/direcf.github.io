}

/* ── Charts ───────────────────────────────────────────────── */
function buildGauge(pct) {
  const c = CC(), col = c.acc;
  mk('gaugeChart', {
    ...apexBase({ type: 'radialBar', height: 155 }),
    series: [parseFloat(pct)],
    plotOptions: { radialBar: { startAngle: -135, endAngle: 135, hollow: { size: '68%', background: 'transparent' }, dataLabels: { show: false }, track: { background: c.soft, strokeWidth: '100%' } } },
    colors: [col], stroke: { lineCap: 'round' }, legend: { show: false }, tooltip: { enabled: false },
  });
}
function buildRetGauge(rate) {
  const el = document.getElementById('retGauge'); if (!el) return;
  const c = CC(), col = rate >= 0 ? c.pos : c.neg;
  const p = Math.min(Math.max((rate + 50) / 150, 0), 1);
  const R = 68, cx = 100, cy = 80;
  const len = +(Math.PI * R).toFixed(2);
  const dash = +(len * p).toFixed(2);
  // dot position on arc (fraction p from left end)
  const dotA = Math.PI * (1 - p);
  const dotX = +(cx + R * Math.cos(dotA)).toFixed(1);
  const dotY = +(cy - R * Math.sin(dotA)).toFixed(1);
  el.innerHTML = `<svg viewBox="0 0 200 96" style="width:100%;max-height:96px;display:block">
    <path d="M${cx-R} ${cy} A${R} ${R} 0 0 1 ${cx+R} ${cy}"
      fill="none" stroke="${c.soft}" stroke-width="13" stroke-linecap="round"/>
    <path d="M${cx-R} ${cy} A${R} ${R} 0 0 1 ${cx+R} ${cy}"
      fill="none" stroke="${col}" stroke-width="13" stroke-linecap="round"
      stroke-dasharray="${dash} ${len}"/>
    <circle cx="${dotX}" cy="${dotY}" r="5.5" fill="${c.bg}" stroke="${col}" stroke-width="2.5"/>
    <text x="${cx-R}" y="${cy+13}" text-anchor="middle"
      fill="${c.text}" font-size="8" font-family="Pretendard,sans-serif" opacity="0.38">−50%</text>
    <text x="${cx+R}" y="${cy+13}" text-anchor="middle"
      fill="${c.text}" font-size="8" font-family="Pretendard,sans-serif" opacity="0.38">+100%</text>
  </svg>`;
}
function buildTrend() {
