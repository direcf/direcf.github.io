}

/* ── Theme & hex colors for ApexCharts ─────────────────────── */
const dark = () => document.documentElement.dataset.theme === 'dark';
function CC() {
  const d = dark();
  return {
    pos:  d ? '#10b981' : '#059669',
    neg:  d ? '#f87171' : '#dc2626',
    acc:  d ? '#60a5fa' : '#1d4ed8',
