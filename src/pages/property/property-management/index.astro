// ── Real-time (allorigins.win CORS proxy) ─────────────────────
const TMAP = {'SK하이닉스':'000660.KS','삼성전자':'005930.KS','테슬라':'TSLA','KODEX 미국S&P500':'069500.KS','NAVER':'035420.KS','TIGER KRX금현물':'132030.KS','ACE 미국S&P500':'360750.KS','애플':'AAPL','쿠팡':'CPNG','유니티 소프트웨어':'U'};
let _invs = [];
async function fetchTk(ticker) {
  const yaUrl = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(ticker)}?interval=1d&range=1d`;
  const url = `https://api.allorigins.win/get?url=${encodeURIComponent(yaUrl)}`;
  const resp = await fetch(url, { signal: AbortSignal.timeout(12000) });
  if (!resp.ok) throw new Error(`proxy ${resp.status}`);
  const wrap = await resp.json();
  if (!wrap.contents) throw new Error('no contents');
  const json = JSON.parse(wrap.contents);
  const result = json.chart?.result?.[0];
  if (!result) throw new Error('no result');
  const meta = result.meta;
  const price = meta.regularMarketPrice;
  const prev = meta.previousClose ?? meta.chartPreviousClose ?? null;
  const changePct = prev ? (price - prev) / prev * 100 : null;
  return { price, changePct, isKRW: ticker.endsWith('.KS') };
}
async function fetchRealtime() {
  const el = document.getElementById('liveRows'); if (!el || !_invs.length) return;
  const top5 = [..._invs].sort((a,b)=>b.eval-a.eval).slice(0,5);
  const rb = document.getElementById('liveRefBtn');
  if (rb) { rb.disabled=true; rb.textContent='조회 중…'; }
  // Show skeleton
  el.innerHTML = top5.map(()=>`<div class="lm-row"><div class="lm-skel" style="width:110px"></div><div class="lm-skel" style="width:80px"></div></div>`).join('');
  const results = await Promise.allSettled(top5.map(async inv => {
    const ticker = TMAP[inv.name] ?? null;
    if (!ticker) return { inv, ticker: null, price: null, changePct: null, error: 'no ticker' };
    try {
      const d = await fetchTk(ticker);
      return { inv, ticker, ...d, error: null };
    } catch(e) {
      return { inv, ticker, price: null, changePct: null, error: e.message };
    }
  }));
  el.innerHTML = results.map(r => {
    const d = r.status==='fulfilled' ? r.value : { inv: top5[0], price: null, changePct: null };
    const pos = d.changePct != null && d.changePct >= 0;
    const priceStr = d.price != null
      ? (d.isKRW ? Math.round(d.price).toLocaleString('ko-KR')+'원' : '$'+d.price.toFixed(2))
      : '—';
    const pctStr = d.changePct != null
      ? `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:${dBg(d.changePct)};color:${dC(d.changePct)};">${d.changePct>=0?'+':''}${d.changePct.toFixed(2)}%</span>`
      : `<span style="font-size:11px;color:var(--muted);">—</span>`;
    return `<div class="lm-row">
      <div><span class="lm-name">${d.inv.name}</span><span class="lm-ticker">${d.ticker||''}</span></div>
      <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <span class="lm-price">${priceStr}</span>${pctStr}
      </div>
    </div>`;
  }).join('');
  if (rb) { rb.disabled=false; rb.textContent='새로고침'; }
  const ua = document.getElementById('liveUpdated');
  if (ua) ua.textContent = new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit'})+' 기준';
}
function initLive(invs) { _invs = Array.isArray(invs) ? invs : []; fetchRealtime(); }

// ── KPI Ticker ────────────────────────────────────────────────
function updateKPI(sm, prev) {
  const nwD = prev ? sm.netWorth - prev.netWorth : null;
  const gP = (sm.netWorth/data.goal.target*100).toFixed(1);
  const kpis = [
    { l:'순자산', v:fmtW(sm.netWorth), delta:nwD, vc:'var(--text)' },
    { l:'총자산', v:fmtW(sm.totalAssets), delta:null, vc:'var(--text)' },
    { l:'투자수익률', v:fmtP(sm.investmentGainRate||0), delta:null, vc:sm.investmentGainRate>=0?'var(--clr-pos)':'var(--clr-neg)' },
    { l:'목표달성률', v:gP+'%', delta:null, vc:'var(--clr-goal)' },
  ];
  const items = document.getElementById('kpiItems');
  if (items) items.innerHTML = kpis.map(k=>`<div class="kpi-item"><div class="kpi-lbl">${k.l}</div><div style="display:flex;align-items:center;"><span class="kpi-val" style="color:${k.vc}">${k.v}</span>${k.delta!=null?`<span class="kpi-delta" style="background:${dBg(k.delta)};color:${dC(k.delta)};">${k.delta>=0?'+':''}${fmtW(k.delta)}</span>`:''}</div></div>`).join('');
  const upd = document.getElementById('kpiUpdated');
  if (upd) upd.textContent = new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})+' 기준';
}

// ── Health Scorecard ──────────────────────────────────────────
function buildHealth(sm, invs, loans, idx) {
  const SECTORS = {'SK하이닉스':'반도체','삼성전자':'반도체','KODEX 미국S&P500':'ETF·글로벌','ACE 미국S&P500':'ETF·글로벌','TIGER KRX금현물':'대안·금','테슬라':'빅테크·EV','애플':'빅테크·EV','NAVER':'인터넷','유니티 소프트웨어':'게임·SW','쿠팡':'이커머스'};
  const SCOLS = {'반도체':'var(--accent)','ETF·글로벌':'var(--clr-pos)','대안·금':'var(--clr-goal)','빅테크·EV':'#f59e0b','인터넷':'#8b5cf6','게임·SW':'var(--clr-neg)','이커머스':'#f97316'};
  const USD = ['테슬라','애플','쿠팡','유니티 소프트웨어'];
  const dr = sm.totalDebt/sm.totalAssets;
  const sA = dr<.20?25:dr<.30?20:dr<.40?15:dr<.50?10:5;
  const cov = sm.monthlyInterest>0?(sm.cash+sm.savings)/sm.monthlyInterest:99;
  const sB = cov>=6?25:cov>=4?20:cov>=2?15:cov>=1?10:5;
  const te = invs.reduce((s,x)=>s+(x.eval||0),0);
  const hhi = te>0?invs.reduce((s,x)=>{const w=(x.eval||0)/te;return s+w*w;},0):1;
  const sC = hhi<=.25?25:hhi<=.35?20:hhi<=.50?15:hhi<=.70?10:5;
  const f0 = data.snapshots[0], cur = data.snapshots[idx];
  const em = Math.max(1,Math.round((new Date(cur.snapshotDate)-new Date(f0.snapshotDate))/(1e3*60*60*24*30.5)));
  const amg = idx>0?(sm.netWorth-f0.summary.netWorth)/em:0;
  const rem = Math.max(1,Math.ceil((new Date(data.goal.deadline)-new Date(cur.snapshotDate))/(1e3*60*60*24*30.5)));
  const mn = (data.goal.target-sm.netWorth)/rem;
  const sD = mn>0?(amg/mn>=1.2?25:amg/mn>=1.0?20:amg/mn>=.8?15:amg/mn>=.5?10:5):25;
  const tot = sA+sB+sC+sD;
  const grade = tot>=80?'우수':tot>=60?'양호':tot>=40?'주의':'위험';
  const gc = tot>=80?'var(--clr-pos)':tot>=60?'var(--accent)':tot>=40?'var(--clr-goal)':'var(--clr-neg)';
  const ac = s => s>=20?'var(--clr-pos)':s>=15?'var(--accent)':s>=10?'var(--clr-goal)':'var(--clr-neg)';
  const sm2 = {};
  invs.forEach(i=>{const s=SECTORS[i.name]||'기타';sm2[s]=(sm2[s]||0)+(i.eval||0);});
  const st = Object.values(sm2).reduce((s,v)=>s+v,0);
  const sE = Object.entries(sm2).map(([k,v])=>({n:k,v,p:st>0?v/st*100:0})).sort((a,b)=>b.v-a.v);
  let usd=0,krw=0;invs.forEach(i=>{if(USD.includes(i.name))usd+=(i.eval||0);else krw+=(i.eval||0);});
  const ct=usd+krw;const up=ct>0?usd/ct*100:0;
  const me = sm.monthlyInterest*3, fp = me*12*25>0?Math.min(100,sm.netWorth/(me*12*25)*100):0;
  const fbc = fp>=100?'var(--clr-pos)':fp>=60?'var(--accent)':fp>=30?'var(--clr-goal)':'var(--clr-neg)';
  const mRow=(l,s,d)=>`<div class="h-metric"><div class="h-metric-lbl">${l} <span style="float:right;color:${ac(s)};font-weight:900">${s}<span style="font-size:9px;color:var(--muted)">/25</span></span></div><div class="h-mbar"><div class="h-mbar-fill" style="width:${s/25*100}%;background:${ac(s)};"></div></div><div style="font-size:10px;color:var(--muted);margin-top:5px;">${d}</div></div>`;
  document.getElementById('healthSection').innerHTML = `<div class="pcard">
    <div class="sh">재무 건전성 분석</div>
    <div style="display:grid;grid-template-columns:140px 1fr;gap:24px;margin-bottom:20px;align-items:start;">
      <div class="h-score-wrap">
        <div style="width:110px;height:110px;border-radius:50%;background:conic-gradient(${gc} ${tot}%,var(--bg-soft) 0%);display:flex;align-items:center;justify-content:center;">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--bg-card);display:flex;flex-direction:column;align-items:center;justify-content:center;">
            <span style="font-size:26px;font-weight:900;color:var(--text);line-height:1;">${tot}</span>
            <span style="font-size:9px;color:var(--muted);">/ 100</span>
          </div>
        </div>
        <div style="margin-top:10px;font-size:15px;font-weight:800;color:${gc};">${grade}</div>
        <div style="font-size:10px;color:var(--muted);margin-top:2px;">종합 등급</div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        ${mRow('부채비율',sA,`부채 ${(dr*100).toFixed(1)}% (권장 30% 미만)`)}
        ${mRow('유동성',sB,`이자 대비 ${cov>=99?'충분':cov.toFixed(1)+'개월'} 준비금`)}
        ${mRow('포트폴리오 분산',sC,`HHI ${hhi.toFixed(3)} — 낮을수록 분산`)}
        ${mRow('목표 페이스',sD,`월 실적 ${fmtW(amg)} / 필요 ${fmtW(mn)}`)}
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
      <div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:14px 16px;">
        <div style="font-size:10px;font-weight:700;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;">섹터 분포</div>
        ${sE.map(e=>{const c=SCOLS[e.n]||'var(--muted)';return`<div style="margin-bottom:7px;"><div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;"><span style="color:var(--text-2);font-weight:600;">${e.n}</span><span style="color:${c};font-weight:700;">${e.p.toFixed(1)}%</span></div><div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden;"><div style="width:${e.p}%;height:100%;background:${c};"></div></div></div>`;}).join('')}
        ${sE[0]&&sE[0].p>40?`<div style="margin-top:8px;padding:7px 10px;background:var(--clr-goal-bg);border:1px solid var(--clr-goal);border-radius:7px;font-size:10px;color:var(--clr-goal);">⚠ ${sE[0].n} ${sE[0].p.toFixed(1)}% — 집중 리스크</div>`:''}
      </div>
      <div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:14px 16px;">
        <div style="font-size:10px;font-weight:700;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;">통화 익스포저</div>
        <div style="display:flex;height:8px;border-radius:4px;overflow:hidden;margin-bottom:8px;"><div style="width:${100-up}%;background:var(--accent);"></div><div style="width:${up}%;background:var(--clr-goal);"></div></div>
        <div style="display:flex;gap:14px;font-size:11px;margin-bottom:10px;"><span style="color:var(--accent);font-weight:700;">● KRW ${(100-up).toFixed(1)}%</span><span style="color:var(--clr-goal);font-weight:700;">● USD ${up.toFixed(1)}%</span></div>
        <div style="margin-top:8px;padding:10px 12px;background:var(--clr-goal-bg);border:1px solid var(--clr-goal);border-radius:8px;">
          <div style="font-size:10px;font-weight:700;color:var(--clr-goal);margin-bottom:5px;text-transform:uppercase;letter-spacing:0.8px;">FIRE 지수</div>
          <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:5px;"><div style="width:${Math.min(100,fp)}%;height:100%;background:${fbc};"></div></div>
          <div style="font-size:11px;color:${fbc};font-weight:700;">${fp.toFixed(1)}% 달성${fp>=100?' — FIRE 가능':' — 계속 성장 중'}</div>
        </div>
      </div>
    </div>
  </div>`;
}

// ── Simulator ─────────────────────────────────────────────────
let _simDone = false;
function simProject(nw, sav, rate, m) { const mr=rate/12/100; let v=nw; for(let i=0;i<m;i++) v=v*(1+mr)+sav; return v; }
function simFind(nw, sav, rate, goal, sd, max) {
  const mr=rate/12/100; let v=nw;
  for(let i=0;i<=max;i++){if(v>=goal){const d=new Date(sd);d.setMonth(d.getMonth()+i);return{ok:true,month:i,date:d,nw:v};}v=v*(1+mr)+sav;}
  return{ok:false,nw:v};
}
function initSim(snap, goal) {
  if (_simDone) return; _simDone = true;
  const sm = snap.summary, sd = new Date(snap.snapshotDate), G = goal.target;
  function upd() {
    const sav = parseInt(document.getElementById('simSav').value,10);
    const rate = parseFloat(document.getElementById('simRate').value);
    document.getElementById('simSavDisp').textContent = sav===0?'0만원':(sav/10000).toLocaleString()+'만원';
    document.getElementById('simRateDisp').textContent = rate.toFixed(1)+'%';
    const scens = [
      {id:'scenC',rate:Math.max(-5,rate*.5),color:'var(--clr-neg)'},
      {id:'scenR',rate,color:'var(--accent)'},
      {id:'scenO',rate:rate*1.5,color:'var(--clr-pos)'},
    ];
    const MAX = 72;
    scens.forEach(sc => {
      const r = simFind(sm.netWorth, sav, sc.rate, G, sd, MAX);
      const hdr = document.getElementById(sc.id).children[0].outerHTML;
      const el = document.getElementById(sc.id);
      if (r.ok) {
        const ds = `${r.date.getFullYear()}년 ${r.date.getMonth()+1}월`;
        el.innerHTML = hdr+`<div style="font-size:20px;font-weight:900;color:${sc.color};letter-spacing:-.5px;margin:6px 0 3px">${ds}</div><div style="font-size:11px;color:var(--muted);">목표 달성 · 연 ${sc.rate.toFixed(1)}%</div><div style="font-size:12px;font-weight:700;color:var(--text);margin-top:7px">${fmtW(r.nw)}</div>`;
      } else {
        el.innerHTML = hdr+`<div style="font-size:16px;font-weight:900;color:var(--clr-neg);margin:6px 0 3px">6년 내 미달</div><div style="font-size:11px;color:var(--muted);">연 ${sc.rate.toFixed(1)}%로 부족</div><div style="font-size:12px;font-weight:700;color:var(--clr-neg);margin-top:7px">-${fmtW(G-r.nw)}</div>`;
      }
    });
    const dl = new Date(goal.deadline), mtd = Math.ceil((dl-sd)/(1e3*60*60*24*30.5));
    const cm = Math.max(mtd+6,24), labels=[], ca=[], ra=[], oa=[];
    let nc=sm.netWorth,nr=sm.netWorth,no=sm.netWorth;
    const mc=Math.max(-5,rate*.5)/12/100,mr=rate/12/100,mo=rate*1.5/12/100;
    for(let i=0;i<=cm;i++){const d=new Date(sd);d.setMonth(d.getMonth()+i);labels.push(d.toLocaleDateString('ko-KR',{year:'2-digit',month:'short'}));ca.push(Math.round(nc/1e4));ra.push(Math.round(nr/1e4));oa.push(Math.round(no/1e4));nc=nc*(1+mc)+sav;nr=nr*(1+mr)+sav;no=no*(1+mo)+sav;}
    const gl = Array(labels.length).fill(Math.round(G/1e4));
    const opts = { ...chartCfg(),
      series:[{name:'보수적',data:ca},{name:'현실적',data:ra},{name:'낙관적',data:oa},{name:'목표',data:gl}],
      chart:{...chartCfg().chart,type:'line',height:200,animations:{speed:300}},
      colors:['var(--clr-neg)','var(--accent)','var(--clr-pos)','var(--clr-goal)'],
      stroke:{width:[2,2.5,2,1.5],curve:'smooth',dashArray:[0,0,0,6]},
      fill:{type:'gradient',gradient:{shadeIntensity:.5,type:'vertical',opacityFrom:.1,opacityTo:0}},
      xaxis:{categories:labels,labels:{rotate:-45,style:{fontSize:'9px'},formatter:(v,i)=>i%Math.ceil(cm/8)===0?v:''},axisBorder:{show:false},axisTicks:{show:false}},
      yaxis:{labels:{style:{fontSize:'10px'},formatter:v=>(v/10000).toFixed(1)+'억'}},
      legend:{fontSize:'11px'},tooltip:{...chartCfg().tooltip,y:{formatter:v=>Math.round(v*10000/10000).toLocaleString()+'만원'}},
      markers:{size:0},
      annotations:{xaxis:[{x:labels[Math.min(mtd,cm)],borderColor:'var(--clr-goal)',borderWidth:1.5,strokeDashArray:4,label:{text:'목표일',style:{color:'var(--clr-goal)',background:isDark()?'rgba(10,18,40,.9)':'rgba(255,255,255,.9)',fontSize:'10px'},orientation:'horizontal',position:'top'}}]},
    };
    if (simC) simC.updateOptions(opts,true,true);
    else { simC = new ApexCharts(document.getElementById('simChart'),opts); simC.render(); }
  }
  document.getElementById('simSav').addEventListener('input', upd);
  document.getElementById('simRate').addEventListener('input', upd);
  upd();
}

// ── Main render ───────────────────────────────────────────────
let curIdx = data.snapshots.length - 1;
let cmpFrom = 0;

function render(idx) {
  curIdx = idx;
  const s = data.snapshots[idx];
  const sm = s.summary;
  const prev = idx > 0 ? data.snapshots[idx-1].summary : null;
  const pct = (sm.netWorth/data.goal.target*100).toFixed(1);
  const firstSnap = data.snapshots[0];
  const months = Math.max(1, Math.round((new Date(s.snapshotDate)-new Date(firstSnap.snapshotDate))/(1e3*60*60*24*30.5)));
  const cagr = idx > 0 ? calcCAGR(firstSnap.summary.netWorth, sm.netWorth, months) : null;

  // KPI
  updateKPI(sm, prev);

  // Date button label
  const nwD = prev ? sm.netWorth-prev.netWorth : null;
  const dl = document.getElementById('datePickerLabel');
  if (dl) dl.innerHTML = s.snapshotDate + (nwD!=null ? ` <span style="font-size:11px;font-weight:700;padding:1px 7px;border-radius:5px;margin-left:5px;background:${dBg(nwD)};color:${dC(nwD)}">${nwD>=0?'+':''}${fmtW(nwD)}</span>` : '');

  // Goal hero
  document.getElementById('heroNW').textContent = fmtW(sm.netWorth);
  document.getElementById('gaugePct').textContent = pct+'%';
  document.getElementById('goalBarFill').style.width = Math.min(pct,100)+'%';
  document.getElementById('heroTarget').innerHTML = `목표 <strong style="color:var(--clr-goal)">5억원</strong> · <span style="color:var(--accent)">2027년 2월까지</span>`;
  document.getElementById('goalBarMid').textContent = `현재 ${pct}%`;

  // Milestone markers
  const milestones = [{v:1e8,l:'1억'},{v:2e8,l:'2억'},{v:3e8,l:'3억'},{v:4e8,l:'4억'}];
  document.getElementById('goalMilestones').innerHTML = milestones.map(m=>{
    const p=m.v/data.goal.target*100, reached=sm.netWorth>=m.v;
    const col=reached?'var(--clr-pos)':'var(--muted)';
    return `<div class="ms" style="left:${p}%"><div class="ms-line" style="background:${col}"></div><div class="ms-lbl" style="color:${col}">${m.l}</div></div>`;
  }).join('');

  // Goal pills
  const remain = data.goal.target - sm.netWorth;
  const remMo = Math.max(0, Math.ceil((new Date(data.goal.deadline)-new Date(s.snapshotDate))/(1e3*60*60*24*30.5)));
  const mneed = remMo > 0 ? Math.round(remain/remMo) : 0;
  document.getElementById('goalPills').innerHTML = [
    ['var(--accent)',`총자산 ${fmtW(sm.totalAssets)}`],
    ['var(--clr-neg)',`총부채 ${fmtW(sm.totalDebt)}`],
    ['var(--clr-goal)',`목표까지 ${fmtW(remain)}`],
    ['var(--muted)',`월 필요 ${fmtW(mneed)}`],
  ].map(([c,t])=>`<span class="gpill"><span style="width:6px;height:6px;border-radius:50%;background:${c};display:inline-block;"></span>${t}</span>`).join('');

  // Goal stats
  document.getElementById('goalStats').innerHTML = [
    ['목표까지','<span style="color:var(--clr-neg)">−'+fmtW(remain)+'</span>'],
    ['남은 기간',remMo>0?`약 ${remMo}개월`:'마감'],
    ['월 필요 증가',`<span style="color:var(--accent)">${fmtW(mneed)}/월</span>`],
  ].map(([l,v])=>`<div class="gstat"><div class="gstat-lbl">${l}</div><div class="gstat-val">${v}</div></div>`).join('');

  buildGauge(pct);

  // Stat: 총자산
  const taD = prev ? sm.totalAssets-prev.totalAssets : null;
  document.getElementById('statTotal').innerHTML = fmtW(sm.totalAssets)+(taD!=null?` <span style="font-size:14px;font-weight:700;color:${dC(taD)};">${taD>=0?'+':''}${fmtW(taD)}</span>`:'');
  document.getElementById('statTotalSub').innerHTML = `순자산 ${fmtW(sm.netWorth)} · 부채비율 ${(sm.totalDebt/sm.totalAssets*100).toFixed(1)}%`;
  const re=sm.realEstate/sm.totalAssets*100, inv2=sm.investmentTotal/sm.totalAssets*100, cs=(sm.cash+sm.savings)/sm.totalAssets*100;
  document.getElementById('statTotalBars').innerHTML = `<div class="sbar"><div style="flex:${re};background:var(--accent)"></div><div style="flex:${inv2};background:var(--clr-pos)"></div><div style="flex:${cs};background:var(--clr-goal)"></div></div><div class="sbar-leg"><span class="sbar-lbl"><span class="sbar-dot" style="background:var(--accent)"></span>부동산 ${re.toFixed(0)}%</span><span class="sbar-lbl"><span class="sbar-dot" style="background:var(--clr-pos)"></span>투자 ${inv2.toFixed(0)}%</span><span class="sbar-lbl"><span class="sbar-dot" style="background:var(--clr-goal)"></span>현금 ${cs.toFixed(0)}%</span></div>`;

  // Stat: 총부채
  const tdD = prev ? sm.totalDebt-prev.totalDebt : null;
  document.getElementById('statDebt').innerHTML = fmtW(sm.totalDebt)+(tdD!=null&&tdD!==0?` <span style="font-size:14px;font-weight:700;color:${dC(-tdD)};">${tdD>=0?'+':''}${fmtW(tdD)}</span>`:'');
  document.getElementById('statDebtSub').textContent = `부채비율 ${(sm.totalDebt/sm.totalAssets*100).toFixed(1)}%`;
  const lco = ['var(--clr-neg)','var(--clr-goal)','var(--accent)'];
  const ti = s.loans.reduce((a,l)=>a+l.balance*(l.rate||0)/100/12,0);
  document.getElementById('statDebtDetail').innerHTML = `<div class="sbar" style="margin-top:12px">${s.loans.map((l,i)=>`<div style="flex:${l.balance};background:${lco[i%3]};height:100%"></div>`).join('')}</div>${s.loans.map((l,i)=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px"><div><span style="font-weight:700;color:${lco[i%3]}">${l.name.slice(0,16)}</span>${l.rate?`<span style="margin-left:6px;font-size:10px;color:var(--clr-goal);font-weight:700">${l.rate}%</span>`:''}</div><span style="font-weight:700;color:var(--clr-neg)">${fmtW(l.balance)}</span></div>`).join('')}<div style="font-size:11px;color:var(--muted);margin-top:7px;text-align:right">월 이자 합계 <strong style="color:var(--clr-neg)">${Math.round(ti).toLocaleString()}원</strong></div>`;

  // Stat: 투자수익
  const isPos = sm.investmentGain >= 0;
  document.getElementById('statGain').innerHTML = `<span style="color:${isPos?'var(--clr-pos)':'var(--clr-neg)'}">${sm.investmentGain>=0?'+':''}${fmtW(sm.investmentGain)}</span>`;
  document.getElementById('statGainSub').innerHTML = `수익률 <span style="color:${isPos?'var(--clr-pos)':'var(--clr-neg)'};">${fmtP(sm.investmentGainRate||0)}</span>`;
  buildReturnGauge(parseFloat(sm.investmentGainRate)||0);
  document.getElementById('returnGaugeLabel').innerHTML = `<span style="font-size:16px;font-weight:900;color:${isPos?'var(--clr-pos)':'var(--clr-neg)'};">${fmtP(sm.investmentGainRate||0)}</span> <span style="font-size:10px;color:var(--muted);">수익률</span>`;
  if (cagr !== null) {
    document.getElementById('cagrRow').innerHTML = `연환산 CAGR <strong style="color:${cagr>=0?'var(--clr-pos)':'var(--clr-neg)'};">${cagr>=0?'+':''}${cagr.toFixed(1)}%</strong> · 투자 ${Math.floor(months/12)}년 ${months%12}개월`;
  } else {
    document.getElementById('cagrRow').style.display = 'none';
  }

  // Charts
  buildTrend();
  buildDonut(sm);

  // Investment table
  const invs = s.investments;
  const te = invs.reduce((a,x)=>a+(x.eval||0),0), tc = invs.reduce((a,x)=>a+(x.cost||0),0);
  document.getElementById('invTable').innerHTML = invs.map(inv=>{
    const pnl=inv.eval-inv.cost, w=(inv.eval/te*100).toFixed(1);
    return `<tr><td style="color:var(--text);font-weight:700">${inv.name}</td><td><span class="badge b-acc" style="font-size:10px">${inv.broker}</span></td><td class="r" style="color:var(--muted)">${inv.cost.toLocaleString()}</td><td class="r" style="color:var(--accent);font-weight:700">${inv.eval.toLocaleString()}</td><td class="r"><span style="color:${dC(pnl)};font-weight:700">${pnl>=0?'+':''}${Math.round(pnl).toLocaleString()}</span></td><td class="r"><span class="badge" style="background:${dBg(inv.rate)};color:${dC(inv.rate)}">${fmtP(inv.rate)}</span></td><td><div style="display:flex;align-items:center;gap:7px"><div style="flex:1;height:4px;background:var(--bg-soft);border-radius:99px;overflow:hidden"><div style="height:100%;width:${w}%;background:${dC(inv.rate)};border-radius:99px"></div></div><span style="font-size:10px;color:var(--muted)">${w}%</span></div></td></tr>`;
  }).join('');
  const tg=te-tc,tp=tc>0?tg/tc*100:0;
  document.getElementById('invTc').textContent=tc.toLocaleString();
  document.getElementById('invTe').textContent=te.toLocaleString();
  document.getElementById('invTg').innerHTML=`<span style="color:${dC(tg)};font-weight:700">${tg>=0?'+':''}${Math.round(tg).toLocaleString()}</span>`;
  document.getElementById('invTr').innerHTML=`<span class="badge" style="background:${dBg(tp)};color:${dC(tp)}">${fmtP(tp)}</span>`;

  buildTop5(invs);
  buildReturn(invs);
  buildGrowth();

  // AI Opinion
  const sEval=[...invs].sort((a,b)=>b.eval-a.eval), top=sEval[0], topW=te>0?top.eval/te*100:0;
  const worst=[...invs].sort((a,b)=>a.rate-b.rate)[0];
  const best=[...invs].sort((a,b)=>b.rate-a.rate)[0];
  const conc=topW>=50, loss=worst&&worst.rate<-30;
  const snapDt=new Date(s.snapshotDate), wd=Math.floor((snapDt-new Date('2023-01-01'))/86400000);
  const wy=Math.floor(wd/365), wm=Math.floor((wd%365)/30);
  const gn=sm.netWorth/data.goal.target*100;
  const onP = months>1 && (sm.netWorth-firstSnap.summary.netWorth)/Math.max(1,months) >= mneed;
  let riskTxt = conc&&loss?`${top.name} 집중(${topW.toFixed(1)}%) + ${worst.name} 손실(${fmtP(worst.rate)}) 이중 리스크`:conc?`${top.name} ${topW.toFixed(1)}% 집중 — 분산 필요`:loss?`${worst.name} ${fmtP(worst.rate)} 손실 주의`:best?`리스크 적정 — 최고 ${best.name} ${fmtP(best.rate)}`:'균형 잡힌 포트폴리오';
  const cagrTxt = cagr!=null ? `CAGR ${cagr>=0?'+':''}${cagr.toFixed(1)}% ·` : '';
  document.getElementById('aiBox').innerHTML = `<div class="ai-title">🤖 AI 투자 의견 · ${s.snapshotDate} 기준</div>
    <div class="ai-row"><span class="ai-key">투자 경력</span><span class="ai-val">${wy}년 ${wm}개월 (2023.01 시작)</span></div>
    <div class="ai-row"><span class="ai-key">성장 속도</span><span class="ai-val" style="color:${onP?'var(--clr-pos)':'var(--clr-goal)'}">${cagrTxt} ${onP?'목표 페이스 초과 ✓':'목표 페이스 미달 ⚠'}</span></div>
    <div class="ai-row"><span class="ai-key">목표 달성률</span><span class="ai-val" style="color:${gn>=70?'var(--clr-pos)':gn>=40?'var(--accent)':'var(--muted)'};">${gn.toFixed(1)}% · 잔여 ${remMo}개월 · 월 ${fmtW(mneed)} 필요</span></div>
    <div class="ai-row"><span class="ai-key">리스크 진단</span><span class="ai-val" style="color:${conc||loss?'var(--clr-goal)':'var(--text-2)'}">${riskTxt}</span></div>
    <div style="font-size:12px;color:var(--text-2);margin-top:10px;padding-top:10px;border-top:1px solid var(--border);line-height:1.75">${gn>=70?`목표의 ${gn.toFixed(1)}%를 달성했습니다. 현 CAGR을 유지하면 목표 기간 내 충분히 도달 가능합니다.`:gn>=40?`절반을 넘어선 시점입니다. 월 ${fmtW(mneed)} 이상의 꾸준한 성장이 핵심입니다.`:`복리가 본격적으로 힘을 발휘할 시점입니다. 분산과 꾸준함이 무기입니다.`}</div>`;

  // Health
  buildHealth(sm, s.investments, s.loans, idx);

  // Snapshot comparison
  buildCmp();

  // Loans
  const sortedLoans = [...s.loans].sort((a,b)=>(b.rate||0)-(a.rate||0));
  const ti2 = s.loans.reduce((a,l)=>a+l.balance*(l.rate||0)/100/12,0);
  document.getElementById('loanSection').innerHTML = `<div style="display:flex;justify-content:space-between;padding:12px 16px;background:var(--clr-neg-bg);border:1px solid var(--clr-neg);border-radius:10px;margin-bottom:14px"><div><div style="font-size:10px;color:var(--muted);font-weight:700;margin-bottom:3px">총 대출</div><div style="font-size:22px;font-weight:900;color:var(--clr-neg)">${fmtW(s.loans.reduce((a,l)=>a+l.balance,0))}</div></div><div style="text-align:right"><div style="font-size:10px;color:var(--muted);font-weight:700;margin-bottom:3px">월 이자</div><div style="font-size:16px;font-weight:700;color:var(--clr-neg)">${Math.round(ti2).toLocaleString()}원</div></div></div>
  ${sortedLoans.map((l,i)=>{const mi=Math.round(l.balance*(l.rate||0)/100/12),rp=l.principal>0?Math.round((l.principal-l.balance)/l.principal*100):0;return`<div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:7px"><div><div style="font-size:13px;font-weight:700;color:var(--text)">${l.name.slice(0,24)}</div><div style="font-size:10px;color:var(--muted);margin-top:2px">${l.bank} · ${l.type}</div></div><div style="font-size:18px;font-weight:900;color:var(--clr-neg);text-align:right">${fmtW(l.balance)}</div></div><div style="display:flex;gap:14px;font-size:11px;color:var(--muted);flex-wrap:wrap;margin-bottom:8px">${l.rate?`<span style="color:var(--clr-goal);font-weight:700">금리 ${l.rate}%</span>`:''}${l.maturityDate?`<span>만기 <strong style="color:var(--text-2)">${l.maturityDate}</strong></span>`:''}<span>월 이자 <strong style="color:var(--clr-neg)">${mi.toLocaleString()}원</strong></span></div><div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden"><div style="height:100%;width:${100-rp}%;background:var(--clr-neg)"></div></div><div style="font-size:10px;color:var(--muted);margin-top:3px">잔여 ${(100-rp)}% · 상환 ${rp}%</div>${i===0?`<div style="margin-top:8px;padding:6px 10px;background:var(--accent-soft);border:1px solid var(--accent);border-radius:6px;font-size:10px;color:var(--accent);font-weight:700">📌 상환 우선순위 1위 — 금리가 가장 높습니다 (${l.rate}%)</div>`:''}</div>`;}).join('')}
  <div style="margin-top:10px;padding:10px 14px;background:var(--bg-soft);border:1px solid var(--border);border-radius:8px;font-size:11px;color:var(--text-2)">💡 <strong style="color:var(--accent)">Avalanche 전략 추천:</strong> ${sortedLoans[0].name}(${sortedLoans[0].rate}%)을 먼저 갚으면 연 ${Math.round(sortedLoans[0].balance*((sortedLoans[0].rate||0)-(sortedLoans[sortedLoans.length-1].rate||0))/100/100*100).toLocaleString()}만원 이자 절감</div>`;

  // Live market
  initLive(s.investments);

  // Simulator
  initSim(s, data.goal);

  // Date dropdown update
  buildDateDd();
}

// ── Date dropdown ─────────────────────────────────────────────
function buildDateDd() {
  const dd = document.getElementById('dateDropdown'); if (!dd) return;
  dd.innerHTML = data.snapshots.map((ss,i)=>{
    const pv = i>0?data.snapshots[i-1]:null, d2=pv?ss.summary.netWorth-pv.summary.netWorth:null;
    const act = i===curIdx;
    return `<div onclick="selectDate(${i})" style="display:flex;align-items:center;justify-content:space-between;padding:9px 12px;cursor:pointer;border-radius:8px;background:${act?'var(--accent-soft)':'transparent'};transition:background .12s" onmouseover="this.style.background='var(--bg-soft)'" onmouseout="this.style.background='${act?'var(--accent-soft)':'transparent'}'">
      <span style="font-size:13px;font-weight:${act?700:500};color:${act?'var(--accent)':'var(--text-2)'};">${ss.snapshotDate}</span>
      ${d2!=null?`<span style="font-size:11px;font-weight:700;padding:2px 7px;border-radius:5px;background:${dBg(d2)};color:${dC(d2)}">${d2>=0?'+':''}${fmtW(d2)}</span>`:''}
      ${act?'<span style="color:var(--accent);font-size:12px;margin-left:4px">✓</span>':''}
    </div>`;
  }).join('');
}

// ── Snapshot comparison ───────────────────────────────────────
function buildCmp() {
  if (data.snapshots.length < 2) return;
  if (cmpFrom === curIdx) cmpFrom = curIdx > 0 ? 0 : 1;
  const btns = document.getElementById('cmpBtns');
  if (btns) btns.innerHTML = data.snapshots.map((ss,i)=>{if(i===curIdx)return'';const a=i===cmpFrom;return`<button class="cmp-btn ${a?'active':''}" onclick="setCmp(${i})">${ss.snapshotDate}</button>`;}).join('');
  const from = data.snapshots[cmpFrom], to = data.snapshots[curIdx];
  const nwD=to.summary.netWorth-from.summary.netWorth, nwP=from.summary.netWorth>0?nwD/from.summary.netWorth*100:0;
  const mc=(l,fv,tv,d,inv2)=>`<div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:9px;padding:12px 14px"><div style="font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.6px;margin-bottom:7px">${l}</div><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:5px"><div style="font-size:11px;color:var(--muted)">${fmtW(fv)} <span style="color:var(--muted)">→</span> <span style="font-weight:700;color:var(--text)">${fmtW(tv)}</span></div><span style="font-size:12px;font-weight:800;color:${dC(inv2?-d:d)}">${d>=0?'+':''}${fmtW(d)}</span></div></div>`;
  const panel = document.getElementById('cmpPanel');
  if (panel) panel.innerHTML = `<div style="display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center;margin-bottom:12px;background:var(--bg-soft);border:1px solid var(--border);border-radius:12px;padding:16px">
    <div><div style="font-size:9px;color:var(--muted);font-weight:700;letter-spacing:.8px;text-transform:uppercase;margin-bottom:4px">기준</div><div style="font-size:22px;font-weight:900;color:var(--text)">${fmtW(from.summary.netWorth)}</div><div style="font-size:11px;color:var(--muted);margin-top:3px">${from.snapshotDate}</div></div>
    <div style="text-align:center"><div style="font-size:18px;color:var(--accent)">→</div><div style="font-size:13px;font-weight:800;color:${dC(nwD)}">${nwD>=0?'+':''}${fmtW(nwD)}</div><div style="font-size:10px;color:${dC(nwD)}">${nwP>=0?'+':''}${nwP.toFixed(1)}%</div></div>
    <div><div style="font-size:9px;color:var(--accent);font-weight:700;letter-spacing:.8px;text-transform:uppercase;margin-bottom:4px">현재 <span style="background:var(--accent);color:#fff;padding:1px 6px;border-radius:3px;font-size:8px">NOW</span></div><div style="font-size:22px;font-weight:900;color:var(--accent)">${fmtW(to.summary.netWorth)}</div><div style="font-size:11px;color:var(--muted);margin-top:3px">${to.snapshotDate}</div></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
    ${mc('총자산',from.summary.totalAssets,to.summary.totalAssets,to.summary.totalAssets-from.summary.totalAssets,false)}
    ${mc('순자산',from.summary.netWorth,to.summary.netWorth,nwD,false)}
    ${mc('총부채',from.summary.totalDebt,to.summary.totalDebt,to.summary.totalDebt-from.summary.totalDebt,true)}
    ${mc('투자평가',from.summary.investmentTotal,to.summary.investmentTotal,to.summary.investmentTotal-from.summary.investmentTotal,false)}
  </div>`;
}

// ── Init ──────────────────────────────────────────────────────
window.selectDate = i => { curIdx=i; if(cmpFrom===curIdx)cmpFrom=curIdx>0?0:1; render(i); const dd=document.getElementById('dateDropdown'); if(dd)dd.style.display='none'; };
window.setCmp     = i => { cmpFrom=i; buildCmp(); };

document.getElementById('datePickerBtn').addEventListener('click', () => {
  const dd = document.getElementById('dateDropdown');
  dd.style.display = dd.style.display==='none' ? 'block' : 'none';
});
document.addEventListener('click', e => {
  const dd=document.getElementById('dateDropdown'), btn=document.getElementById('datePickerBtn');
  if (dd&&btn&&!btn.contains(e.target)&&!dd.contains(e.target)) dd.style.display='none';
});

function init() {
  if (typeof ApexCharts === 'undefined') { setTimeout(init, 100); return; }
  buildDateDd();
  render(curIdx);
}

// Re-render charts on theme toggle
const _tObs = new MutationObserver(() => {
  if (document.getElementById('pmDashboard').style.display !== 'none') {
    destroyAll();
    const s = data.snapshots[curIdx];
    buildGauge((s.summary.netWorth/data.goal.target*100).toFixed(1));
    buildReturnGauge(parseFloat(s.summary.investmentGainRate)||0);
    buildTrend(); buildDonut(s.summary); buildTop5(s.investments);
    buildReturn(s.investments); buildGrowth();
    if (simC) { try{simC.destroy();}catch(e){} simC=null; _simDone=false; initSim(s, data.goal); }
  }
});
_tObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

if (sessionStorage.getItem(SESSION_KEY) === '1') init();
</script>
</BaseLayout>
