---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import propertyData from "../../../data/property.json";
---
<BaseLayout title="자산 현황" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property",href:"/property/"},{label:"자산 현황"}]}>
<style>
/* ============================================================
   PRIVATE WEALTH MANAGEMENT DASHBOARD — PREMIUM DARK THEME
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; background: #060912; color: #c8d8f0; }

/* ── 1. ROOT ──────────────────────────────────────────────── */
#prop-root { background: #060912; color: #c8d8f0; min-height: 100vh; padding: 68px 32px 64px; }

/* ── 2. KPI TICKER ────────────────────────────────────────── */
#kpiTicker { position:fixed; top:0; left:0; right:0; z-index:900; height:52px; background:rgba(6,9,18,0.95); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border-bottom:1px solid rgba(255,255,255,0.055); display:flex; align-items:center; padding:0 32px; }
.kpi-item { display:flex; flex-direction:column; justify-content:center; padding:0 22px; border-right:1px solid rgba(255,255,255,0.055); }
.kpi-item:last-child { border-right:none; }
.kpi-label { font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#4a6080; margin-bottom:2px; white-space:nowrap; }
.kpi-val   { font-size:15px; font-weight:800; letter-spacing:-0.5px; font-variant-numeric:tabular-nums; }

/* ── 3. LOCK SCREEN ───────────────────────────────────────── */
#lockScreen { position:fixed; inset:0; z-index:9999; background:#060912; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; }
.orb-1 { width:600px; height:600px; background:radial-gradient(circle,rgba(99,102,241,0.18),transparent 65%); top:-200px; left:-150px; animation:float1 12s ease-in-out infinite; }
.orb-2 { width:500px; height:500px; background:radial-gradient(circle,rgba(16,212,160,0.10),transparent 65%); bottom:-180px; right:-120px; animation:float2 15s ease-in-out infinite; }
.orb-3 { width:400px; height:400px; background:radial-gradient(circle,rgba(201,168,76,0.08),transparent 65%); top:50%; left:60%; animation:float3 18s ease-in-out infinite; }
.lock-grid-bg { position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,0.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.012) 1px,transparent 1px); background-size:60px 60px; pointer-events:none; }
.lock-card { position:relative; z-index:1; width:360px; background:rgba(10,16,36,0.9); border:1px solid rgba(255,255,255,0.08); border-radius:24px; padding:48px 44px 40px; text-align:center; backdrop-filter:blur(32px); -webkit-backdrop-filter:blur(32px); box-shadow:0 0 80px rgba(99,102,241,0.1),0 24px 80px rgba(0,0,0,0.6); animation:fadeInScale 0.5s cubic-bezier(0.16,1,0.3,1) forwards; }
.lock-card-top-line { position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(201,168,76,0.5),transparent); border-radius:24px 24px 0 0; }
.lock-card-bot-line { position:absolute; bottom:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(99,102,241,0.3),transparent); border-radius:0 0 24px 24px; }
.lock-icon-bg { width:72px; height:72px; border-radius:50%; background:rgba(99,102,241,0.08); border:1px solid rgba(99,102,241,0.15); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; }
.lock-title { font-size:13px; font-weight:800; letter-spacing:0.3em; color:#e2e8f0; text-transform:uppercase; margin-bottom:6px; }
.lock-sub   { font-size:12px; color:#4a6080; letter-spacing:0.05em; margin-bottom:36px; }
.lock-input { width:100%; padding:14px 4px; background:transparent; border:none; border-bottom:1px solid rgba(255,255,255,0.12); color:#e2e8f0; font-size:20px; text-align:center; letter-spacing:6px; outline:none; transition:border-color 0.2s; caret-color:#6366f1; font-family:inherit; }
.lock-input:focus { border-bottom-color:#6366f1; }
.lock-input::placeholder { color:rgba(74,96,128,0.5); letter-spacing:4px; font-size:16px; }
.lock-btn { width:100%; margin-top:24px; padding:14px; background:linear-gradient(135deg,#6366f1,#4f46e5); border:none; border-radius:12px; color:#fff; font-size:14px; font-weight:700; cursor:pointer; letter-spacing:0.05em; transition:all 0.2s; box-shadow:0 4px 20px rgba(99,102,241,0.3); font-family:inherit; }
.lock-btn:hover { filter:brightness(1.1); transform:translateY(-1px); box-shadow:0 8px 28px rgba(99,102,241,0.45); }
.lock-err  { font-size:12px; color:#ff4d6d; margin-top:12px; min-height:18px; }
.lock-hint { font-size:10px; color:#2a3a50; margin-top:20px; letter-spacing:0.1em; }

/* ── 4. DASHBOARD BASE ────────────────────────────────────── */
#dashboard { display:none; }
.view { padding-bottom:0; }

/* ── 5. CARDS ─────────────────────────────────────────────── */
.card { background:rgba(10,16,36,0.85); border:1px solid rgba(255,255,255,0.055); border-radius:16px; padding:24px; backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); box-shadow:0 4px 24px rgba(0,0,0,0.5); transition:border-color 0.2s,box-shadow 0.2s; position:relative; overflow:hidden; }
.card:hover { border-color:rgba(99,102,241,0.2); box-shadow:0 0 40px rgba(99,102,241,0.06),0 4px 24px rgba(0,0,0,0.5); }
.card-label { font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#4a6080; margin-bottom:12px; }
.accent-bar { position:absolute; top:0; left:0; right:0; height:3px; }
.accent-bar.indigo { background:linear-gradient(90deg,#6366f1,rgba(99,102,241,0)); }
.accent-bar.coral  { background:linear-gradient(90deg,#ff4d6d,rgba(255,77,109,0)); }
.accent-bar.teal   { background:linear-gradient(90deg,#10d4a0,rgba(16,212,160,0)); }
.stat-card .big    { font-size:28px; font-weight:900; letter-spacing:-1.5px; color:#e2e8f0; }
.stat-card .sub    { font-size:12px; color:#4a6080; margin-top:5px; }

/* ── 6. GOAL HERO ─────────────────────────────────────────── */
.goal-hero { background:rgba(10,16,36,0.85); border:1px solid rgba(255,255,255,0.055); border-radius:20px; padding:36px; margin-bottom:20px; position:relative; overflow:hidden; backdrop-filter:blur(20px); }
.goal-hero::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#6366f1,#10d4a0,rgba(16,212,160,0)); }
.goal-hero::after  { content:''; position:absolute; top:-80px; right:-80px; width:300px; height:300px; background:radial-gradient(circle,rgba(99,102,241,0.08),transparent 65%); border-radius:50%; pointer-events:none; }
.goal-grid { display:grid; grid-template-columns:180px 1fr 220px; gap:40px; align-items:center; position:relative; }
@media(max-width:900px){ .goal-grid{ grid-template-columns:1fr; text-align:center; } }
.gauge-wrap { position:relative; width:160px; height:160px; }
.gauge-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none; z-index:2; }
.gauge-pct { font-size:26px; font-weight:900; color:#c9a84c; line-height:1; }
.gauge-lbl { font-size:11px; color:#4a6080; margin-top:3px; }
.goal-main h3 { font-size:10px; color:#4a6080; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:8px; font-weight:700; }
.goal-networth { font-size:48px; font-weight:900; letter-spacing:-3px; color:#e2e8f0; line-height:1; }
.goal-target   { font-size:13px; color:#6a85a8; margin-top:8px; }
.goal-target strong { color:#c9a84c; }
.goal-bar-wrap { margin-top:16px; }
.goal-bar-bg   { height:8px; background:rgba(255,255,255,0.06); border-radius:4px; overflow:hidden; }
.goal-bar-fill { height:100%; border-radius:4px; background:linear-gradient(90deg,#6366f1,#10d4a0); transition:width 1s cubic-bezier(0.16,1,0.3,1); }
.goal-bar-labels { display:flex; justify-content:space-between; font-size:11px; color:#4a6080; margin-top:6px; }
.goal-pills { display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; }
.gpill { display:inline-flex; align-items:center; gap:5px; background:rgba(99,102,241,0.07); border:1px solid rgba(255,255,255,0.055); border-radius:8px; padding:4px 10px; font-size:11px; color:#6a85a8; }
.dot { width:6px; height:6px; border-radius:50%; display:inline-block; }
.goal-stats { display:flex; flex-direction:column; gap:12px; }
.gstat { background:rgba(6,9,18,0.7); border:1px solid rgba(255,255,255,0.055); border-radius:12px; padding:14px 16px; }
.gstat-label { font-size:10px; color:#4a6080; margin-bottom:4px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; }
.gstat-val   { font-size:17px; font-weight:800; color:#e2e8f0; }

/* ── 7. GRIDS ─────────────────────────────────────────────── */
.g3  { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:20px; }
.g2  { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:20px; }
.g12 { display:grid; grid-template-columns:1fr 1.8fr; gap:18px; margin-bottom:20px; }
.g21 { display:grid; grid-template-columns:1.8fr 1fr; gap:18px; margin-bottom:20px; }
@media(max-width:900px){ .g3,.g2,.g12,.g21{ grid-template-columns:1fr; } }

/* ── 8. RETURN GAUGE ──────────────────────────────────────── */
.return-gauge-wrap   { position:relative; width:160px; height:80px; margin:10px auto 0; }
.return-gauge-center { text-align:center; margin-top:4px; }
.return-gauge-pct    { font-size:20px; font-weight:900; line-height:1; }
.return-amounts      { display:flex; justify-content:space-around; margin-top:10px; }
.return-amt-label    { font-size:10px; color:#4a6080; margin-bottom:3px; }
.return-amt-val      { font-size:12px; font-weight:700; }

/* ── 9. SECTION HEADING ───────────────────────────────────── */
.sh { font-size:15px; font-weight:800; color:#e2e8f0; margin-bottom:20px; display:flex; align-items:center; gap:10px; letter-spacing:-0.3px; }
.sh::before { content:''; display:block; width:3px; height:16px; background:linear-gradient(180deg,#6366f1,rgba(99,102,241,0)); border-radius:2px; flex-shrink:0; }

/* ── 10. TABLE ────────────────────────────────────────────── */
.dtable { width:100%; border-collapse:collapse; font-size:13px; color:#c8d8f0; }
.dtable th { padding:10px 12px; font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#4a6080; border-bottom:1px solid rgba(255,255,255,0.055); background:rgba(6,9,18,0.5); text-align:left; }
.dtable th.r { text-align:right; }
.dtable td { padding:11px 12px; border-bottom:1px solid rgba(255,255,255,0.04); vertical-align:middle; }
.dtable td.r { text-align:right; font-variant-numeric:tabular-nums; }
.dtable tbody tr:hover { background:rgba(99,102,241,0.04); }
.dtable tbody tr:last-child td { border-bottom:none; }
.dtable tfoot tr td { border-top:1px solid rgba(255,255,255,0.055); background:rgba(6,9,18,0.5); font-weight:700; }

/* ── 11. BADGES & DELTA ───────────────────────────────────── */
.badge { display:inline-block; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:700; }
.badge-green  { background:rgba(16,212,160,0.12); color:#10d4a0; }
.badge-red    { background:rgba(255,77,109,0.12);  color:#ff4d6d; }
.badge-blue   { background:rgba(99,102,241,0.1);   color:#818cf8; }
.badge-gold   { background:rgba(201,168,76,0.12);  color:#c9a84c; }
.delta.pos  { color:#10d4a0; font-size:12px; font-weight:700; }
.delta.neg  { color:#ff4d6d; font-size:12px; font-weight:700; }
.delta.zero { color:#4a6080; font-size:12px; }

/* ── 12. STACKED / MINI BARS ──────────────────────────────── */
.sbar { display:flex; height:12px; border-radius:6px; overflow:hidden; border:1px solid rgba(255,255,255,0.055); }
.sbar-legend { display:flex; gap:12px; margin-top:8px; flex-wrap:wrap; }
.sbar-lbl { font-size:11px; color:#6a85a8; display:flex; align-items:center; gap:5px; font-weight:500; }
.sbar-dot { width:9px; height:9px; border-radius:3px; display:inline-block; flex-shrink:0; }
.mbar { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.mbar-lbl { font-size:11px; color:#4a6080; min-width:68px; font-weight:500; }
.mbar-bg  { flex:1; height:5px; background:rgba(255,255,255,0.06); border-radius:99px; overflow:hidden; }
.mbar-fill { height:100%; border-radius:99px; }
.mbar-val { font-size:11px; min-width:38px; text-align:right; font-variant-numeric:tabular-nums; color:#c8d8f0; }

/* ── 13. CHART WRAPPERS ───────────────────────────────────── */
.chart-wrap      { position:relative; height:280px; }
.chart-sm        { position:relative; height:230px; }
.top5-chart-wrap { position:relative; height:230px; margin-bottom:16px; }
.growth-chart-wrap{ position:relative; height:250px; margin-top:20px; }

/* ── 14. SNAP TABS / DATE DROPDOWN ───────────────────────── */
.snap-tabs { display:flex; gap:8px; margin-bottom:28px; flex-wrap:wrap; }
.snap-delta.pos { background:rgba(16,212,160,0.12); color:#10d4a0; }
.snap-delta.neg { background:rgba(255,77,109,0.12);  color:#ff4d6d; }

/* ── 15. LOAN CARDS ───────────────────────────────────────── */
.loan-item { background:rgba(255,77,109,0.04); border:1px solid rgba(255,77,109,0.1); border-radius:12px; padding:16px 20px; margin-bottom:12px; }

/* ── 16. AI OPINION ───────────────────────────────────────── */
.ai-opinion { background:rgba(99,102,241,0.05); border:1px solid rgba(99,102,241,0.15); border-radius:12px; padding:18px 20px; margin-top:18px; }
.ai-opinion-title { font-size:11px; font-weight:700; color:#818cf8; letter-spacing:0.8px; text-transform:uppercase; margin-bottom:14px; display:flex; align-items:center; gap:6px; }

/* ── 17. CMP PANEL ────────────────────────────────────────── */
.cmp-panel { background:rgba(6,9,18,0.7); border:1px solid rgba(255,255,255,0.055); border-radius:14px; padding:22px; margin-bottom:12px; }
.cmp-date-btn { padding:6px 14px; border-radius:8px; cursor:pointer; font-size:12px; font-weight:600; border:1px solid rgba(255,255,255,0.055); color:#6a85a8; background:rgba(10,16,36,0.85); transition:all 0.18s; font-family:inherit; }
.cmp-date-btn.active { background:#6366f1; border-color:#6366f1; color:#fff; box-shadow:0 2px 8px rgba(99,102,241,0.3); }
.cmp-date-btn:hover:not(.active) { border-color:#6366f1; color:#818cf8; }

/* ── 18. LIVE MARKET ──────────────────────────────────────── */
.live-pulse { width:7px; height:7px; border-radius:50%; background:#10d4a0; animation:pulse 2s infinite; flex-shrink:0; }
.skeleton { background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:4px; }

/* ── 19. KEYFRAMES ────────────────────────────────────────── */
@keyframes float1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(30px,-20px) scale(1.05)} }
@keyframes float2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-20px,30px) scale(0.95)} }
@keyframes float3 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(20px,20px) scale(1.02)} }
@keyframes fadeInScale { from{opacity:0;transform:scale(0.96) translateY(8px)} to{opacity:1;transform:scale(1) translateY(0)} }
@keyframes shake { 0%,100%{transform:translateX(0)} 15%{transform:translateX(-8px)} 30%{transform:translateX(8px)} 45%{transform:translateX(-5px)} 60%{transform:translateX(5px)} 80%{transform:translateX(-2px)} }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.85)} }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
@keyframes countUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
</style>

<!-- ── KPI Ticker ───────────────────────────────────────────── -->
<div id="kpiTicker">
  <div style="display:flex;align-items:center;gap:8px;margin-right:28px;flex-shrink:0;">
    <div style="width:20px;height:20px;background:linear-gradient(135deg,#6366f1,#10d4a0);border-radius:5px;"></div>
    <span style="font-size:11px;font-weight:800;letter-spacing:0.15em;color:#e2e8f0;text-transform:uppercase;">WEALTH</span>
  </div>
  <div style="width:1px;height:28px;background:rgba(255,255,255,0.055);margin-right:4px;flex-shrink:0;"></div>
  <div id="kpiItems" style="display:flex;flex:1;"></div>
  <div id="kpiUpdated" style="font-size:10px;color:#4a6080;flex-shrink:0;letter-spacing:0.5px;"></div>
</div>

<!-- ── Lock Screen ─────────────────────────────────────────── -->
<div id="lockScreen">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="lock-grid-bg"></div>
  <div class="lock-card">
    <div class="lock-card-top-line"></div>
    <div class="lock-icon-bg">
      <svg width="36" height="36" viewBox="0 0 48 48" fill="none" stroke="#6366f1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 22v-7a9 9 0 0 1 18 0v7"/>
        <rect x="9" y="22" width="30" height="21" rx="5"/>
        <circle cx="24" cy="33" r="3" fill="#6366f1" stroke="none"/>
        <line x1="24" y1="36" x2="24" y2="40" stroke="#6366f1" stroke-width="2.2"/>
      </svg>
    </div>
    <div class="lock-title">PRIVATE</div>
    <div class="lock-sub">자산 현황 · 비밀번호 입력</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="· · · · · · · ·" autocomplete="off"/>
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io · property</div>
    <div class="lock-card-bot-line"></div>
  </div>
</div>

<!-- ── Dashboard ───────────────────────────────────────────── -->
<div id="prop-root">
<div id="dashboard">
<div class="view">

  <!-- Date Selector -->
  <div class="snap-tabs" id="snapTabs"></div>

  <!-- Goal Hero -->
  <div class="goal-hero">
    <div class="goal-grid">
      <div>
        <div class="gauge-wrap">
          <div id="gaugeChart" style="position:absolute;inset:0;"></div>
          <div class="gauge-center">
            <div class="gauge-pct" id="gaugePct">0%</div>
            <div class="gauge-lbl">달성</div>
          </div>
        </div>
      </div>
      <div class="goal-main">
        <h3>현재 순자산</h3>
        <div class="goal-networth" id="heroNetWorth">—</div>
        <div class="goal-target">목표: <strong>5억원</strong> &nbsp;·&nbsp; <span style="color:#6366f1">2027년 2월까지</span></div>
        <div class="goal-bar-wrap">
          <div class="goal-bar-bg"><div class="goal-bar-fill" id="goalBarFill" style="width:0%"></div></div>
          <div class="goal-bar-labels"><span>0</span><span id="goalBarMid" style="color:#6366f1"></span><span style="color:#c9a84c">5억 목표</span></div>
        </div>
        <div class="goal-pills" id="goalPills"></div>
      </div>
      <div class="goal-stats" id="goalStats"></div>
    </div>
  </div>

  <!-- Top 3 Stat Cards -->
  <div class="g3">
    <div class="card stat-card">
      <div class="accent-bar indigo"></div>
      <div class="card-label">총 자산</div>
      <div class="big" id="statTotal">—</div>
      <div class="sub" id="statTotalSub"></div>
      <div class="sbar-wrap" id="statTotalBars"></div>
    </div>
    <div class="card stat-card">
      <div class="accent-bar coral"></div>
      <div class="card-label">총 부채</div>
      <div class="big" id="statDebt" style="color:#ff4d6d">—</div>
      <div class="sub" id="statDebtSub"></div>
      <div id="statDebtItems"></div>
    </div>
    <div class="card stat-card">
      <div class="accent-bar teal"></div>
      <div class="card-label">투자 수익</div>
      <div class="big" id="statGain">—</div>
      <div class="sub" id="statGainSub"></div>
      <div class="return-gauge-wrap">
        <div id="returnGaugeChart" style="position:absolute;inset:0;"></div>
      </div>
      <div class="return-gauge-center">
        <div class="return-gauge-pct" id="returnGaugePct">—</div>
        <div style="font-size:10px;color:#4a6080;margin-top:2px;">수익률</div>
      </div>
      <div class="return-amounts" id="returnAmounts"></div>
    </div>
  </div>

  <!-- Trend + Donut -->
  <div class="g12">
    <div class="card">
      <div class="sh">순자산 추이</div>
      <div class="chart-wrap"><div id="trendChart"></div></div>
    </div>
    <div class="card">
      <div class="sh">자산 구성</div>
      <div class="chart-sm"><div id="donutChart"></div></div>
      <div id="donutLegend"></div>
    </div>
  </div>

  <!-- Live Market -->
