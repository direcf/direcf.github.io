/* ── Simulator ────────────────────────────────────────────── */
let simChart = null, _simDone = false;
function simFind(nw, sav, rate, goal, sd, max) {
  const mr = rate / 1200; let v = nw;
  for (let i = 0; i <= max; i++) {
    if (v >= goal) { const d = new Date(sd); d.setMonth(d.getMonth() + i); return { ok: true, m: i, date: d, nw: v }; }
    v = v * (1 + mr) + sav;
  }
  return { ok: false, nw: v };
}
function buildSimChart(snap, goal, sav, rate) {
  const c = CC(), sm = snap.summary, sd = new Date(snap.snapshotDate), G = goal.target;
  const dl = new Date(goal.deadline), mtd = Math.ceil((dl - sd) / (864e5 * 30.5)), cm = Math.max(mtd + 6, 24);
  const labels = [], ca = [], ra = [], oa = [], gl = [];
  let nc = sm.netWorth, nr = sm.netWorth, no_ = sm.netWorth;
  const mc = Math.max(-5, rate * .5) / 1200, mr = rate / 1200, mo = rate * 1.5 / 1200;
  for (let i = 0; i <= cm; i++) {
    const d = new Date(sd); d.setMonth(d.getMonth() + i);
    labels.push(d.toLocaleDateString('ko-KR', { year: '2-digit', month: 'short' }));
    ca.push(Math.round(nc / 1e6)); ra.push(Math.round(nr / 1e6)); oa.push(Math.round(no_ / 1e6)); gl.push(Math.round(G / 1e6));
    nc = nc * (1 + mc) + sav; nr = nr * (1 + mr) + sav; no_ = no_ * (1 + mo) + sav;
  }
  const goalLbl = labels[Math.min(mtd, cm)];
  const opts = {
    ...apexBase({ type: 'line', height: 220, animations: { enabled: true, speed: 300 } }),
    series: [{ name: '보수적', data: ca }, { name: '현실적', data: ra }, { name: '낙관적', data: oa }, { name: '목표', data: gl }],
    colors: [c.neg, c.acc, c.pos, c.goal],
    stroke: { show: true, width: [2.5, 3, 2.5, 1.5], curve: 'smooth', dashArray: [0, 0, 0, 5] },
    xaxis: {
      categories: labels,
      tickAmount: 6,
      labels: { rotate: -30, style: { fontSize: '10px', colors: c.text } },
      axisBorder: { show: false }, axisTicks: { show: false },
    },
    yaxis: { labels: { style: { fontSize: '10px', colors: c.text }, formatter: v => (v / 100).toFixed(1) + '억' } },
    legend: { fontSize: '12px', fontFamily: "'Pretendard',sans-serif", labels: { colors: c.text } },
    markers: { size: 0 },
    tooltip: { ...apexBase().tooltip, y: { formatter: v => (v * 1e6 / 1e8).toFixed(2) + '억원' } },
    annotations: { xaxis: [{ x: goalLbl, borderColor: c.goal, borderWidth: 2, strokeDashArray: 4, label: { text: '목표일', style: { color: c.goal, background: c.bg, fontSize: '10px', fontWeight: 700 }, orientation: 'horizontal', position: 'top', offsetY: 8 } }] },
  };
  if (simChart) {
    try { simChart.destroy(); } catch(e) {}
    simChart = null;
  }
  const el = document.getElementById('simChart');
  if (el) { el.innerHTML = ''; simChart = new ApexCharts(el, opts); simChart.render(); charts['simChart'] = simChart; }
}
function updateSim(snap, goal) {
  const c = CC(), sm = snap.summary, sd = new Date(snap.snapshotDate), G = goal.target;
  const sav = parseInt(document.getElementById('simSav').value, 10);
  const rate = parseFloat(document.getElementById('simRate').value);
  document.getElementById('simSavD').textContent = sav === 0 ? '0만원' : (sav / 10000).toLocaleString() + '만원';
  document.getElementById('simRateD').textContent = rate.toFixed(1) + '%';
  const scens = [
    { lbl: '보수적', rate: Math.max(-5, rate * .5), col: c.neg, bdCol: 'var(--fn)', bgCol: 'var(--fn-bg)' },
    { lbl: '현실적', rate, col: c.acc, bdCol: 'var(--accent)', bgCol: 'rgba(219,234,254,.6)' },
    { lbl: '낙관적', rate: rate * 1.5, col: c.pos, bdCol: 'var(--fp)', bgCol: 'var(--fp-bg)' },
  ];
  const el = document.getElementById('scenCards');
  el.innerHTML = scens.map((sc, i) => {
    const r = simFind(sm.netWorth, sav, sc.rate, G, sd, 84);
    const cw = i === 1 ? '2px' : '1px';
    const body = r.ok
      ? `<div style="font-size:21px;font-weight:900;color:${sc.bdCol};letter-spacing:-.5px;margin:6px 0 3px">${r.date.getFullYear()}년 ${r.date.getMonth() + 1}월</div><div style="font-size:10px;color:var(--muted)">달성 · 연 ${sc.rate.toFixed(1)}%</div><div style="font-size:13px;font-weight:700;color:var(--text);margin-top:7px">${fW(r.nw)}</div>`
      : `<div style="font-size:16px;font-weight:900;color:var(--fn);margin:6px 0 3px">84개월 내 미달</div><div style="font-size:10px;color:var(--muted)">연 ${sc.rate.toFixed(1)}%</div><div style="font-size:12px;font-weight:700;color:var(--fn);margin-top:6px">-${fW(G - r.nw)}</div>`;
    return `<div style="border:${cw} solid ${sc.bdCol};border-radius:12px;padding:16px;text-align:center;background:${sc.bgCol}"><div style="font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:${sc.bdCol};margin-bottom:2px">${sc.lbl}</div>${body}</div>`;
  }).join('');
  buildSimChart(snap, goal, sav, rate);
}
function initSim(snap, goal) {
  if (_simDone) return; _simDone = true;
  const up = () => updateSim(snap, goal);
  document.getElementById('simSav').addEventListener('input', up);
  document.getElementById('simRate').addEventListener('input', up);
  up();
}

/* ── 분석 매물 접근 가능성 ─────────────────────────────────── */
function buildPropReach(snap) {
  const card = document.getElementById('propReachCard');
  const body = document.getElementById('propReachBody');
  if (!card || !body || !analyzedProps.length) return;
  card.style.display = '';
  const sm = snap.summary;
  const liquid = sm.cash + sm.savings;
  const invest = sm.investmentTotal;
  const scens = [
    { key:'A', label:'현금만', budget: liquid, color:'var(--muted)' },
    { key:'B', label:'주식 30%', budget: liquid + invest * 0.3, color:'var(--fp)' },
    { key:'C', label:'주식 60%', budget: liquid + invest * 0.6, color:'var(--accent)' },
    { key:'D', label:'영끌', budget: liquid + 1e8 + 6e8, color:'var(--fg)' },
  ];
  function parseGap(s) {
    if (!s) return null;
    const v = parseFloat(String(s).replace('억',''));
    return isNaN(v) ? null : v * 1e8;
  }
  function scenBadge(propGapW) {
    for (const sc of scens) {
      if (propGapW <= sc.budget) {
        return `<span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:5px;background:${sc.key==='A'?'var(--bg-soft)':sc.key==='B'?'var(--fp-bg)':sc.key==='C'?'rgba(219,234,254,.7)':'var(--fg-bg)'};color:${sc.color}">${sc.label} 진입 가능</span>`;
      }
    }
    return `<span style="font-size:10px;color:var(--fn);font-weight:700">자금 부족</span>`;
  }
  body.innerHTML = `
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:var(--bg-soft);border-radius:10px;">
      ${scens.map(sc => `<div style="font-size:10px;font-weight:700;padding:3px 9px;border-radius:6px;background:var(--bg-card);border:1px solid var(--border);color:${sc.color}">${sc.label}: ${fW(sc.budget)}</div>`).join('')}
    </div>
    ${analyzedProps.map(p => {
      const gapW = parseGap(p.gap);
      if (!gapW) return '';
      const rateColor = (p.gapRate||0) >= 60 ? 'var(--fp)' : (p.gapRate||0) >= 50 ? 'var(--fg)' : 'var(--fn)';
      return `<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border:1px solid var(--border);border-radius:12px;margin-bottom:8px;gap:12px;flex-wrap:wrap;">
        <div style="flex:1;min-width:160px;">
          <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px;">${p.name}</div>
          <div style="font-size:10px;color:var(--muted);">${p.districtName} · ${p.mainSize} · 전세가율 <span style="font-weight:700;color:${rateColor}">${p.gapRate}%</span></div>
        </div>
        <div style="text-align:right;flex-shrink:0;">
          <div style="font-size:16px;font-weight:900;color:var(--fg);letter-spacing:-.5px;">${p.gap}</div>
          <div style="font-size:10px;color:var(--muted);margin-top:2px;margin-bottom:4px;">갭 필요금액</div>
          ${scenBadge(gapW)}
        </div>
      </div>`;
    }).join('')}
    <div style="text-align:right;margin-top:4px;">
      <a href="/property/property-analysis/" style="font-size:11px;color:var(--accent);text-decoration:none;font-weight:600;">매물 분석 전체 보기 →</a>
    </div>`;
}

/* ── 통합 타임라인 ────────────────────────────────────────── */
function buildTimeline(snap) {
  const card = document.getElementById('timelineCard');
  const body = document.getElementById('timelineBody');
  if (!card || !body) return;
  card.style.display = '';
  const events = [];
  // 대출 만기
  (snap.loans || []).forEach(l => {
    if (l.maturityDate) events.push({ date: l.maturityDate, label: `${l.name} 만기`, sub: `${fW(l.balance)} · ${l.rate}%`, color:'var(--fn)', icon:'💳' });
  });
  // 목표 달성 예상 (현재 페이스)
  const sm = snap.summary, sd = new Date(snap.snapshotDate), G = data.goal.target;
  const remain = Math.max(0, Math.ceil((new Date(data.goal.deadline) - sd) / (864e5 * 30.5)));
  if (remain > 0) {
    const dl = new Date(data.goal.deadline);
    events.push({ date: data.goal.deadline, label: '목표 달성 데드라인', sub: `5억 목표 · 현재 ${(sm.netWorth/1e8).toFixed(2)}억 (${Math.round(sm.netWorth/G*100)}%)`, color:'var(--fg)', icon:'🎯' });
  }
  // 분석 매물 재건축 연한
  analyzedProps.forEach(p => {
    if (p.completionYear) {
      const reconYear = p.completionYear + 30;
      events.push({ date: reconYear + '-01-01', label: `${p.name} 재건축 연한`, sub: `${p.completionYear}년 준공 → ${reconYear}년 도래`, color:'var(--accent)', icon:'🔨' });
    }
  });
  // 정렬
  events.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
  const now = new Date();
  body.innerHTML = `<div style="position:relative;padding-left:28px;">
    <div style="position:absolute;left:10px;top:0;bottom:0;width:2px;background:var(--border);border-radius:1px;"></div>
    ${events.map(ev => {
      const evDate = new Date(ev.date);
      const isPast = evDate < now;
      const isCurrent = Math.abs(evDate.getFullYear() - now.getFullYear()) < 1;
      const yr = evDate.getFullYear(), mo = evDate.getMonth()+1;
      const dLabel = `${yr}.${String(mo).padStart(2,'0')}`;
      const dotColor = isPast ? '#6b7280' : ev.color;
      return `<div style="position:relative;margin-bottom:18px;">
        <div style="position:absolute;left:-22px;top:2px;width:10px;height:10px;border-radius:50%;background:${dotColor};border:2px solid var(--bg-card);${isCurrent?'box-shadow:0 0 0 3px '+dotColor+'40':''};"></div>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap;">
          <div>
            <div style="font-size:9px;font-weight:700;color:${isPast?'var(--muted)':dotColor};letter-spacing:.5px;margin-bottom:2px;">${dLabel}${isPast?' · 완료':''}</div>
            <div style="font-size:13px;font-weight:700;color:${isPast?'var(--muted)':'var(--text)'};">${ev.icon} ${ev.label}</div>
            <div style="font-size:11px;color:var(--muted);margin-top:1px;">${ev.sub}</div>
          </div>
        </div>
      </div>`;
    }).join('')}
  </div>`;
}

/* ── Live Market ──────────────────────────────────────────── */
const TMAP = { 'SK하이닉스': '000660.KS', '삼성전자': '005930.KS', '테슬라': 'TSLA', 'KODEX 미국S&P500': '069500.KS', 'NAVER': '035420.KS', 'TIGER KRX금현물': '132030.KS', 'ACE 미국S&P500': '360750.KS', '애플': 'AAPL', '쿠팡': 'CPNG', '유니티 소프트웨어': 'U' };
let _liveInvs = [], _liveDone = false;

/* CORS proxy 순서대로 시도 — 하나라도 성공하면 반환 */
async function _proxyFetch(yahooUrl) {
  const strategies = [
    async () => {
      const r = await fetch(`https://corsproxy.io/?${encodeURIComponent(yahooUrl)}`, { signal: AbortSignal.timeout(8000) });
      if (!r.ok) throw new Error('http ' + r.status);
      return r.json();
    },
    async () => {
      const r = await fetch(`https://api.allorigins.win/get?url=${encodeURIComponent(yahooUrl)}`, { signal: AbortSignal.timeout(8000) });
      const w = await r.json();
      return JSON.parse(w.contents);
    },
    async () => {
      const r = await fetch(`https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(yahooUrl)}`, { signal: AbortSignal.timeout(8000) });
      if (!r.ok) throw new Error('http ' + r.status);
      return r.json();
    },
  ];
  for (const fn of strategies) {
    try { const j = await fn(); if (j) return j; } catch(e) {}
  }
  throw new Error('all proxies failed');
}

async function _fetchTicker(tk) {
  const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(tk)}?interval=1d&range=1d`;
  const j = await _proxyFetch(url);
  const m = j.chart?.result?.[0]?.meta;
  if (!m) throw new Error('no meta');
  const price = m.regularMarketPrice;
  const prev = m.previousClose ?? m.chartPreviousClose ?? null;
  return { price, pct: prev ? (price - prev) / prev * 100 : null, isKRW: tk.endsWith('.KS') };
}

async function fetchRealtime() {
  const el = document.getElementById('liveRows'); if (!el || !_liveInvs.length) return;
  const seen = new Set();
  const top5 = _liveInvs
    .filter(inv => { const tk = TMAP[inv.name]; if (!tk || seen.has(tk)) return false; seen.add(tk); return true; })
    .sort((a, b) => b.eval - a.eval).slice(0, 5);
  const rb = document.getElementById('liveRefBtn');
  if (rb) { rb.disabled = true; rb.textContent = '조회 중…'; }
  el.innerHTML = top5.map(() => `<div class="pm-lmrow" style="opacity:.4"><div style="height:12px;width:110px;background:var(--bg-soft);border-radius:4px;animation:pmIn .8s ease infinite alternate"></div><div style="height:12px;width:70px;background:var(--bg-soft);border-radius:4px"></div></div>`).join('');

  const res = await Promise.allSettled(top5.map(async inv => {
    const tk = TMAP[inv.name]; if (!tk) return { inv, tk: null, price: null, pct: null, isKRW: false };
    try {
      const d = await _fetchTicker(tk);
      return { inv, tk, ...d };
    } catch(e) {
      return { inv, tk, price: null, pct: null, isKRW: tk.endsWith('.KS') };
    }
  }));

  let anyOk = false;
  el.innerHTML = res.map((r, i) => {
    const d = r.status === 'fulfilled' ? r.value : { inv: top5[i], tk: null, price: null, pct: null, isKRW: false };
    const ok = d.price != null;
    if (ok) anyOk = true;
    const pos = d.pct != null && d.pct >= 0;
    const ps = ok ? (d.isKRW ? Math.round(d.price).toLocaleString('ko-KR') + '원' : '$' + d.price.toFixed(2)) : `<span style="font-size:10px;color:var(--muted)">스냅샷 ${fW(d.inv.eval)}</span>`;
    const bc = pos ? '#059669' : '#dc2626', bbc = pos ? 'rgba(5,150,105,.09)' : 'rgba(220,38,38,.08)';
    const badge = d.pct != null
      ? `<span style="font-size:11px;font-weight:700;padding:2px 9px;border-radius:6px;background:${bbc};color:${bc}">${d.pct >= 0 ? '+' : ''}${d.pct.toFixed(2)}%</span>`
      : (ok ? '' : `<span style="font-size:10px;color:var(--fn-bd);background:var(--fn-bg);padding:2px 7px;border-radius:5px">조회실패</span>`);
    return `<div class="pm-lmrow"><div style="min-width:0;flex:1"><span class="pm-lmname">${d.inv.name}</span><span class="pm-lmtk">${d.tk || ''}</span></div><div style="display:flex;align-items:center;gap:10px;flex-shrink:0"><span class="pm-lmprice">${ps}</span>${badge}</div></div>`;
  }).join('');

  if (!anyOk) {
    el.insertAdjacentHTML('beforeend', `<div style="text-align:center;padding:10px;font-size:11px;color:var(--fn);background:var(--fn-bg);border-radius:8px;margin-top:8px">⚠ CORS 제한으로 시세 조회 실패 — 스냅샷 데이터 표시 중</div>`);
  }
  if (rb) { rb.disabled = false; rb.textContent = '새로고침'; }
  const ts = document.getElementById('liveTs');
  if (ts) ts.textContent = new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' 기준';
}

function initLive(invs) {
  _liveInvs = Array.isArray(invs) ? invs : [];
  if (!_liveDone) { _liveDone = true; fetchRealtime(); }
}

/* ── KPI Ticker ───────────────────────────────────────────── */
function updateKPI(sm, prev) {
  const nwD = prev ? sm.netWorth - prev.netWorth : null;
  const gP = (sm.netWorth / data.goal.target * 100).toFixed(1);
  const items = [
    { l: '순자산', v: fW(sm.netWorth), d: nwD, vc: 'var(--text)' },
    { l: '총자산', v: fW(sm.totalAssets), d: null, vc: 'var(--text)' },
    { l: '투자수익률', v: fP(sm.investmentGainRate || 0), d: null, vc: sm.investmentGainRate >= 0 ? 'var(--fp)' : 'var(--fn)' },
    { l: '목표달성률', v: gP + '%', d: null, vc: 'var(--accent)' },
  ];
  const sl = document.getElementById('kpiSlots');
  if (sl) sl.innerHTML = items.map(k => `<div class="pm-kslot"><div class="pm-klbl">${k.l}</div><div class="pm-krow"><span class="pm-kval" style="color:${k.vc}">${k.v}</span>${k.d != null ? `<span class="pm-kdelta" style="background:${BC(k.d)};color:${PC(k.d)}">${k.d >= 0 ? '+' : ''}${fW(k.d)}</span>` : ''}</div></div>`).join('');
  const ts = document.getElementById('kpiTs');
  if (ts) ts.textContent = new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' }) + ' 기준';
}

/* ── Health ───────────────────────────────────────────────── */
function buildHealth(sm, invs, idx) {
  const c = CC();
  const dr = sm.totalDebt / sm.totalAssets;
  const sA = dr < .20 ? 25 : dr < .30 ? 20 : dr < .40 ? 15 : dr < .50 ? 10 : 5;
  const cov = sm.monthlyInterest > 0 ? (sm.cash + sm.savings) / sm.monthlyInterest : 99;
  const sB = cov >= 6 ? 25 : cov >= 4 ? 20 : cov >= 2 ? 15 : cov >= 1 ? 10 : 5;
  const te = invs.reduce((s, x) => s + (x.eval || 0), 0);
  const hhi = te > 0 ? invs.reduce((s, x) => { const w = (x.eval || 0) / te; return s + w * w; }, 0) : 1;
  const sC = hhi <= .25 ? 25 : hhi <= .35 ? 20 : hhi <= .50 ? 15 : hhi <= .70 ? 10 : 5;
  const f0 = data.snapshots[0], cur = data.snapshots[idx];
  const em = Math.max(1, Math.round((new Date(cur.snapshotDate) - new Date(f0.snapshotDate)) / (864e5 * 30.5)));
  const amg = idx > 0 ? (sm.netWorth - f0.summary.netWorth) / em : 0;
  const rem = Math.max(1, Math.ceil((new Date(data.goal.deadline) - new Date(cur.snapshotDate)) / (864e5 * 30.5)));
  const mn = (data.goal.target - sm.netWorth) / rem;
  const sD = mn > 0 ? (amg / mn >= 1.2 ? 25 : amg / mn >= 1.0 ? 20 : amg / mn >= .8 ? 15 : amg / mn >= .5 ? 10 : 5) : 25;
  const tot = sA + sB + sC + sD;
  const grade = tot >= 80 ? '우수' : tot >= 60 ? '양호' : tot >= 40 ? '주의' : '위험';
  const gc = tot >= 80 ? c.pos : tot >= 60 ? c.acc : tot >= 40 ? c.goal : c.neg;
  const gcv = tot >= 80 ? 'var(--fp)' : tot >= 60 ? 'var(--accent)' : tot >= 40 ? 'var(--fg)' : 'var(--fn)';
  const aC = s => s >= 20 ? c.pos : s >= 15 ? c.acc : s >= 10 ? c.goal : c.neg;
  const aCv = s => s >= 20 ? 'var(--fp)' : s >= 15 ? 'var(--accent)' : s >= 10 ? 'var(--fg)' : 'var(--fn)';
  const mRow = (l, s, desc) => `<div class="pm-hm"><div class="pm-hml">${l} <span style="float:right;color:${aCv(s)};font-weight:900">${s}<span style="font-size:9px;opacity:.7">/25</span></span></div><div class="pm-hmbar"><div class="pm-hmfill" style="width:${s / 25 * 100}%;background:${aC(s)}"></div></div><div class="pm-hmtxt">${desc}</div></div>`;
  document.getElementById('healthSection').innerHTML = `<div class="pm-card"><div class="pm-sh"><div class="pm-shbar"></div>재무 건전성</div>
  <div style="display:grid;grid-template-columns:130px 1fr;gap:20px;align-items:start">
    <div style="display:flex;flex-direction:column;align-items:center;gap:8px">
      <div style="width:100px;height:100px;border-radius:50%;background:conic-gradient(${gc} ${tot}%,var(--bg-soft) 0);display:flex;align-items:center;justify-content:center">
        <div style="width:72px;height:72px;border-radius:50%;background:var(--bg-card);display:flex;flex-direction:column;align-items:center;justify-content:center">
          <span style="font-size:24px;font-weight:900;color:var(--text);line-height:1">${tot}</span>
          <span style="font-size:9px;color:var(--muted)">/100</span>
        </div>
      </div>
      <div style="font-size:16px;font-weight:800;color:${gcv}">${grade}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px">
      ${mRow('부채비율', sA, `부채 ${(dr * 100).toFixed(1)}% · 권장 30% 미만`)}
      ${mRow('유동성', sB, `준비금 ${cov >= 99 ? '충분' : cov.toFixed(1) + '개월'}`)}
      ${mRow('포트폴리오 분산', sC, `HHI ${hhi.toFixed(3)}`)}
      ${mRow('목표 달성 페이스', sD, `실적 ${fW(amg)}/월 · 필요 ${fW(mn)}/월`)}
    </div>
  </div></div>`;
}

/* ── Render ───────────────────────────────────────────────── */
let curIdx = data.snapshots.length - 1, cmpFrom = 0;

function render(idx) {
  curIdx = idx;
  const s = data.snapshots[idx], sm = s.summary;
  const prev = idx > 0 ? data.snapshots[idx - 1].summary : null;
  const pct = sm.netWorth / data.goal.target * 100;
  const c = CC();

  // KPI
  updateKPI(sm, prev);

  // Date label
  const nwD = prev ? sm.netWorth - prev.netWorth : null;
  const dlEl = document.getElementById('dateLbl');
  if (dlEl) dlEl.innerHTML = s.snapshotDate + (nwD != null ? ` <span style="font-size:11px;font-weight:700;padding:1px 7px;border-radius:5px;background:${BC(nwD)};color:${PC(nwD)}">${nwD >= 0 ? '+' : ''}${fW(nwD)}</span>` : '');

  // Gauge
  document.getElementById('gaugePct').textContent = pct.toFixed(1) + '%';
  buildGauge(pct);

  // Hero
  document.getElementById('heroNW').textContent = fW(sm.netWorth);
  document.getElementById('heroSub').innerHTML = `목표 <strong style="color:var(--fg)">5억원</strong> · <span style="color:var(--accent)">2027년 2월</span>`;
  document.getElementById('pbarFill').style.width = Math.min(pct, 100) + '%';
  document.getElementById('pbarMid').textContent = `현재 ${pct.toFixed(1)}%`;

  // Milestone ticks
  const ms = [{ v: 1e8, l: '1억' }, { v: 2e8, l: '2억' }, { v: 3e8, l: '3억' }, { v: 4e8, l: '4억' }];
  document.getElementById('pbarTicks').innerHTML = ms.map(m => {
    const p = m.v / data.goal.target * 100, hit = sm.netWorth >= m.v;
    return `<div class="pm-ptick" style="left:${p}%"><div class="pm-tickline" style="height:18px;background:${hit ? c.pos : '#9ca3af'}"></div><div class="pm-ticklbl" style="color:${hit ? c.pos : '#9ca3af'}">${m.l}</div></div>`;
  }).join('');

  // Pills
  const dlDate = new Date(data.goal.deadline), rem = Math.max(0, Math.ceil((dlDate - new Date(s.snapshotDate)) / (864e5 * 30.5)));
  const needMo = rem > 0 ? Math.round((data.goal.target - sm.netWorth) / rem) : 0;
  document.getElementById('goalPills').innerHTML = [
    ['var(--accent)', fW(sm.totalAssets), '총자산'],
    ['var(--fn)', fW(sm.totalDebt), '총부채'],
    ['var(--fg)', fW(data.goal.target - sm.netWorth), '목표까지'],
    ['var(--muted)', fW(needMo) + '/월', '월 필요'],
  ].map(([col, val, lbl]) => `<div class="pm-pill"><span class="pm-pdot" style="background:${col}"></span><span style="color:var(--muted)">${lbl}</span><strong style="color:var(--text)">${val}</strong></div>`).join('');
  document.getElementById('gsCol').innerHTML = [
    ['목표까지', `<span style="color:var(--fn);font-weight:800">−${fW(data.goal.target - sm.netWorth)}</span>`],
    ['남은 기간', rem > 0 ? `약 ${rem}개월` : '마감'],
    ['월 필요액', `<span style="color:var(--accent);font-weight:800">${fW(needMo)}/월</span>`],
  ].map(([l, v]) => `<div class="pm-gs"><div class="pm-gsl">${l}</div><div class="pm-gsv">${v}</div></div>`).join('');

  // 총자산 card
  const taD = prev ? sm.totalAssets - prev.totalAssets : null;
  const re = sm.realEstate / sm.totalAssets * 100, in2 = sm.investmentTotal / sm.totalAssets * 100, cs = (sm.cash + sm.savings) / sm.totalAssets * 100;
  document.getElementById('s-ta').innerHTML = fW(sm.totalAssets) + (taD != null ? ` <span style="font-size:14px;font-weight:700;color:${PC(taD)}">${taD >= 0 ? '+' : ''}${fW(taD)}</span>` : '');
  document.getElementById('s-ta-sub').textContent = `순자산 ${fW(sm.netWorth)} · 부채비율 ${(sm.totalDebt / sm.totalAssets * 100).toFixed(1)}%`;
  document.getElementById('s-ta-bar').innerHTML = `<div class="pm-abar"><div class="pm-aseg" style="width:${re.toFixed(1)}%;background:${c.acc}" title="부동산 ${fW(sm.realEstate)} (${re.toFixed(1)}%)"></div><div class="pm-aseg" style="width:${in2.toFixed(1)}%;background:${c.pos}" title="투자 ${fW(sm.investmentTotal)} (${in2.toFixed(1)}%)"></div><div class="pm-aseg" style="width:${cs.toFixed(1)}%;background:${c.goal}" title="현금·저축 ${fW(sm.cash + sm.savings)} (${cs.toFixed(1)}%)"></div></div><div class="pm-aleg"><span class="pm-aitem"><span class="pm-adot" style="background:${c.acc}"></span>부동산 ${re.toFixed(0)}% <span style="color:var(--text-2);font-weight:700">${fW(sm.realEstate)}</span></span><span class="pm-aitem"><span class="pm-adot" style="background:${c.pos}"></span>투자 ${in2.toFixed(0)}% <span style="color:var(--text-2);font-weight:700">${fW(sm.investmentTotal)}</span></span><span class="pm-aitem"><span class="pm-adot" style="background:${c.goal}"></span>현금 ${cs.toFixed(0)}% <span style="color:var(--text-2);font-weight:700">${fW(sm.cash + sm.savings)}</span></span></div>`;

  // 총부채 card
  const tdD = prev ? sm.totalDebt - prev.totalDebt : null;
  const ti = s.loans.reduce((a, l) => a + l.balance * (l.rate || 0) / 100 / 12, 0);
  document.getElementById('s-td').innerHTML = fW(sm.totalDebt) + (tdD != null && tdD !== 0 ? ` <span style="font-size:14px;font-weight:700;color:${PC(-tdD)}">${tdD >= 0 ? '+' : ''}${fW(tdD)}</span>` : '');
  document.getElementById('s-td-sub').textContent = `부채비율 ${(sm.totalDebt / sm.totalAssets * 100).toFixed(1)}%`;
  const lco = [c.neg, c.goal, c.acc];
  document.getElementById('s-td-det').innerHTML = `<div class="pm-abar">${s.loans.map((l, i) => `<div class="pm-aseg" style="width:${(l.balance/sm.totalDebt*100).toFixed(1)}%;background:${lco[i%3]}"></div>`).join('')}</div>${s.loans.map((l, i) => `<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px"><div><span style="font-weight:700;color:var(--text)">${l.name.slice(0, 18)}</span>${l.rate ? `<span style="margin-left:6px;font-size:10px;color:${c.goal};font-weight:700">${l.rate}%</span>` : ''}</div><span style="font-weight:700;color:var(--fn)">${fW(l.balance)}</span></div>`).join('')}<div style="font-size:11px;color:var(--muted);margin-top:7px;text-align:right">월 이자 합계 <strong style="color:var(--fn)">${Math.round(ti).toLocaleString()}원</strong></div>`;

  // 투자수익 card
  const isPos = sm.investmentGain >= 0;
  document.getElementById('s-ig').innerHTML = `<span style="color:${isPos ? 'var(--fp)' : 'var(--fn)'}">${sm.investmentGain >= 0 ? '+' : ''}${fW(sm.investmentGain)}</span>`;
  document.getElementById('s-ig-sub').innerHTML = `수익률 <span style="font-weight:700;color:${isPos ? 'var(--fp)' : 'var(--fn)'}">${fP(sm.investmentGainRate || 0)}</span>`;
  buildRetGauge(parseFloat(sm.investmentGainRate) || 0);
  const invCost = sm.investmentTotal - sm.investmentGain;
  document.getElementById('retGaugeLbl').innerHTML = `<span style="color:var(--muted)">원금 <strong style="color:var(--text-2)">${fW(invCost)}</strong> · 평가 <strong style="color:${isPos ? 'var(--fp)' : 'var(--fn)'}">${fW(sm.investmentTotal)}</strong></span>`;
  const f0 = data.snapshots[0];
  const mon = Math.max(1, Math.round((new Date(s.snapshotDate) - new Date(f0.snapshotDate)) / (864e5 * 30.5)));
  const cagrEl = document.getElementById('cagrRow');
  if (idx >= 2 && mon >= 6) {
    const cagr = (Math.pow(sm.netWorth / f0.summary.netWorth, 12 / mon) - 1) * 100;
    const pt = mon >= 12 ? `${Math.floor(mon/12)}년 ${mon % 12 ? mon % 12 + '개월' : ''}` : `${mon}개월`;
    cagrEl.innerHTML = `CAGR <strong style="color:${cagr >= 0 ? 'var(--fp)' : 'var(--fn)'}">${cagr >= 0 ? '+' : ''}${cagr.toFixed(1)}%</strong> · ${pt} 기준`;
    cagrEl.style.display = '';
  } else { cagrEl.style.display = 'none'; }

  // Charts
  buildTrend(); buildDonut(sm);

  // Investment table
  const invs = s.investments;
  const tE = invs.reduce((a, x) => a + (x.eval || 0), 0), tC = invs.reduce((a, x) => a + (x.cost || 0), 0);
  document.getElementById('invBody').innerHTML = invs.map(inv => {
    const pnl = inv.eval - inv.cost, w = (inv.eval / tE * 100).toFixed(1);
    return `<tr><td style="color:var(--text);font-weight:700">${inv.name}</td><td><span class="pm-bd pm-bda" style="font-size:10px">${inv.broker}</span></td><td class="r" style="color:var(--muted)">${inv.cost.toLocaleString()}</td><td class="r" style="color:var(--accent);font-weight:700">${inv.eval.toLocaleString()}</td><td class="r"><span style="color:${PC(pnl)};font-weight:700">${pnl >= 0 ? '+' : ''}${Math.round(pnl).toLocaleString()}</span></td><td class="r"><span class="pm-bd ${inv.rate >= 0 ? 'pm-bdp' : 'pm-bdn'}">${fP(inv.rate)}</span></td><td><div style="display:flex;align-items:center;gap:7px"><div style="flex:1;height:4px;background:var(--bg-soft);border-radius:99px;overflow:hidden"><div style="height:100%;width:${w}%;background:${inv.rate >= 0 ? c.pos : c.neg};border-radius:99px"></div></div><span style="font-size:10px;color:var(--muted)">${w}%</span></div></td></tr>`;
  }).join('');
  const tG = tE - tC, tP = tC > 0 ? tG / tC * 100 : 0;
  document.getElementById('inv-tc').textContent = tC.toLocaleString();
  document.getElementById('inv-te').textContent = tE.toLocaleString();
  document.getElementById('inv-tg').innerHTML = `<span style="color:${PC(tG)};font-weight:700">${tG >= 0 ? '+' : ''}${Math.round(tG).toLocaleString()}</span>`;
  document.getElementById('inv-tr').innerHTML = `<span class="pm-bd ${tP >= 0 ? 'pm-bdp' : 'pm-bdn'}">${fP(tP)}</span>`;

  buildTop5(invs); buildReturn(invs); buildGrowth();

  // AI insight
  const top = [...invs].sort((a, b) => b.eval - a.eval)[0];
  const worst = [...invs].sort((a, b) => a.rate - b.rate)[0];
  const best = [...invs].sort((a, b) => b.rate - a.rate)[0];
  const topW = tE > 0 ? top.eval / tE * 100 : 0, conc = topW >= 50;
  const onP = mon > 1 && (sm.netWorth - f0.summary.netWorth) / Math.max(1, mon) >= needMo;
  document.getElementById('aiBox').innerHTML = `<div class="pm-aibox"><div class="pm-aititle">🤖 AI 자산 진단 · ${s.snapshotDate}</div><div class="pm-airow"><span class="pm-aik">최대 보유</span><span class="pm-aiv" style="color:${conc ? 'var(--fg)' : 'var(--text-2)'}">${top.name} ${topW.toFixed(1)}%${conc ? ' — 집중 리스크' : ''}</span></div><div class="pm-airow"><span class="pm-aik">베스트 종목</span><span class="pm-aiv" style="color:var(--fp)">${best.name} ${fP(best.rate)}</span></div>${worst.rate < 0 ? `<div class="pm-airow"><span class="pm-aik">손실 종목</span><span class="pm-aiv" style="color:var(--fn)">${worst.name} ${fP(worst.rate)}</span></div>` : ''}<div class="pm-airow"><span class="pm-aik">목표 페이스</span><span class="pm-aiv" style="color:${onP ? 'var(--fp)' : 'var(--fg)'}">${onP ? '✅ 초과 달성 중' : '⚠ 페이스 미달 — 적립 늘리기 권장'}</span></div><div class="pm-airow"><span class="pm-aik">달성률</span><span class="pm-aiv">${pct.toFixed(1)}% · 잔여 ${rem}개월 · 월 ${fW(needMo)} 필요</span></div></div>`;

  // Health
  buildHealth(sm, invs, idx);

  // Comparison
  buildCmp();

  // Loans
  const sortedL = [...s.loans].sort((a, b) => (b.rate || 0) - (a.rate || 0));
  const totalL = s.loans.reduce((a, l) => a + l.balance, 0);
  document.getElementById('loanSect').innerHTML = `<div style="display:flex;justify-content:space-between;padding:12px 16px;background:var(--fn-bg);border:1px solid var(--fn-bd);border-radius:10px;margin-bottom:12px"><div><div style="font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;margin-bottom:3px">총 대출</div><div style="font-size:21px;font-weight:900;color:var(--fn)">${fW(totalL)}</div></div><div style="text-align:right"><div style="font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;margin-bottom:3px">월 이자</div><div style="font-size:15px;font-weight:700;color:var(--fn)">${Math.round(ti).toLocaleString()}원</div></div></div>${sortedL.map((l, i) => { const mi = Math.round(l.balance * (l.rate || 0) / 100 / 12); const rp = l.principal > 0 ? Math.round((l.principal - l.balance) / l.principal * 100) : 0; return `<div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:13px 15px;margin-bottom:9px"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px"><div><div style="font-size:13px;font-weight:700;color:var(--text)">${l.name}</div><div style="font-size:10px;color:var(--muted);margin-top:2px">${l.bank} · ${l.type}</div></div><div style="font-size:17px;font-weight:900;color:var(--fn)">${fW(l.balance)}</div></div><div style="display:flex;gap:12px;font-size:11px;margin-bottom:8px">${l.rate ? `<span style="color:var(--fg);font-weight:700">금리 ${l.rate}%</span>` : ''}<span style="color:var(--muted)">월 이자 <strong style="color:var(--fn)">${mi.toLocaleString()}원</strong></span></div><div style="height:5px;background:var(--border);border-radius:3px;overflow:hidden"><div style="height:100%;width:${100 - rp}%;background:var(--fn)"></div></div>${i === 0 && sortedL.length > 1 ? `<div style="margin-top:8px;padding:5px 10px;background:rgba(29,78,216,.07);border:1px solid rgba(29,78,216,.2);border-radius:6px;font-size:10px;color:var(--accent);font-weight:700">📌 Avalanche 추천 — 최고 금리 ${l.rate}%</div>` : ''}</div>`; }).join('')}`;

  // Live + Simulator
  initLive(invs);
  initSim(s, data.goal);
  buildDateDd();
  buildPropReach(s);
  buildTimeline(s);
}

/* ── Date dropdown ────────────────────────────────────────── */
function buildDateDd() {
  const dd = document.getElementById('dateDd'); if (!dd) return;
  dd.innerHTML = data.snapshots.map((ss, i) => {
    const pv = i > 0 ? data.snapshots[i - 1] : null, d2 = pv ? ss.summary.netWorth - pv.summary.netWorth : null;
    const act = i === curIdx;
    return `<div onclick="selectDate(${i})" style="display:flex;align-items:center;justify-content:space-between;padding:9px 12px;cursor:pointer;border-radius:8px;background:${act ? 'rgba(219,234,254,.7)' : 'transparent'}" onmouseover="this.style.background='var(--bg-soft)'" onmouseout="this.style.background='${act ? 'rgba(219,234,254,.7)' : 'transparent'}'">
      <span style="font-size:13px;font-weight:${act ? 700 : 500};color:${act ? 'var(--accent)' : 'var(--text-2)'}">${ss.snapshotDate}</span>
      <div style="display:flex;align-items:center;gap:6px">${d2 != null ? `<span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:5px;background:${BC(d2)};color:${PC(d2)}">${d2 >= 0 ? '+' : ''}${fW(d2)}</span>` : ''}${act ? '<span style="color:var(--accent)">✓</span>' : ''}</div>
    </div>`;
  }).join('');
}

/* ── Snapshot comparison ──────────────────────────────────── */
function buildCmp() {
  if (data.snapshots.length < 2) return;
  if (cmpFrom === curIdx) cmpFrom = curIdx > 0 ? 0 : 1;
  const btns = document.getElementById('cmpBtns');
  if (btns) btns.innerHTML = data.snapshots.map((ss, i) => { if (i === curIdx) return ''; const a = i === cmpFrom; return `<button class="pm-cmpbtn${a ? ' active' : ''}" onclick="setCmp(${i})">${ss.snapshotDate}</button>`; }).join('');
  const from = data.snapshots[cmpFrom], to = data.snapshots[curIdx];
  const nwD = to.summary.netWorth - from.summary.netWorth, nwP = from.summary.netWorth > 0 ? nwD / from.summary.netWorth * 100 : 0;
  const mc = (l, fv, tv, inv) => { const d = tv - fv; const col = (inv ? -d : d) >= 0 ? 'var(--fp)' : 'var(--fn)'; const bc = (inv ? -d : d) >= 0 ? 'var(--fp-bg)' : 'var(--fn-bg)'; return `<div class="pm-cmpmc"><div class="pm-cmpl">${l}</div><div style="display:flex;align-items:center;justify-content:space-between;gap:8px"><span style="font-size:11px;color:var(--muted)">${fW(fv)} → <strong style="color:var(--text)">${fW(tv)}</strong></span><span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;background:${bc};color:${col}">${d >= 0 ? '+' : ''}${fW(d)}</span></div></div>`; };
  const panel = document.getElementById('cmpPanel');
  if (panel) panel.innerHTML = `<div style="display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center;background:var(--bg-soft);border:1px solid var(--border);border-radius:12px;padding:15px;margin-bottom:12px">
    <div><div style="font-size:9px;color:var(--muted);font-weight:700;text-transform:uppercase;margin-bottom:4px">기준</div><div style="font-size:21px;font-weight:900;color:var(--text)">${fW(from.summary.netWorth)}</div><div style="font-size:10px;color:var(--muted);margin-top:2px">${from.snapshotDate}</div></div>
    <div style="text-align:center"><div style="font-size:16px;color:var(--accent)">→</div><div style="font-size:12px;font-weight:800;padding:2px 8px;border-radius:6px;background:${BC(nwD)};color:${PC(nwD)};margin-top:3px">${nwD >= 0 ? '+' : ''}${fW(nwD)}</div><div style="font-size:10px;color:${PC(nwD)};margin-top:2px">${nwP >= 0 ? '+' : ''}${nwP.toFixed(1)}%</div></div>
    <div><div style="font-size:9px;color:var(--accent);font-weight:700;text-transform:uppercase;margin-bottom:4px">현재 <span style="background:var(--accent);color:#fff;padding:1px 6px;border-radius:3px;font-size:8px">NOW</span></div><div style="font-size:21px;font-weight:900;color:var(--accent)">${fW(to.summary.netWorth)}</div><div style="font-size:10px;color:var(--muted);margin-top:2px">${to.snapshotDate}</div></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
    ${mc('총자산', from.summary.totalAssets, to.summary.totalAssets, false)}
    ${mc('순자산', from.summary.netWorth, to.summary.netWorth, false)}
    ${mc('총부채', from.summary.totalDebt, to.summary.totalDebt, true)}
    ${mc('투자평가', from.summary.investmentTotal, to.summary.investmentTotal, false)}
  </div>`;
}

/* ── Globals ──────────────────────────────────────────────── */
window.selectDate = i => { curIdx = i; if (cmpFrom === curIdx) cmpFrom = curIdx > 0 ? 0 : 1; _liveDone = false; render(i); document.getElementById('dateDd').style.display = 'none'; };
window.setCmp = i => { cmpFrom = i; buildCmp(); };

document.getElementById('dateBtn').addEventListener('click', () => {
  const dd = document.getElementById('dateDd'); dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
});
document.addEventListener('click', e => {
  const dd = document.getElementById('dateDd'), btn = document.getElementById('dateBtn');
  if (dd && btn && !btn.contains(e.target) && !dd.contains(e.target)) dd.style.display = 'none';
});

/* ── Init ─────────────────────────────────────────────────── */
function init() {
  if (typeof ApexCharts === 'undefined') { setTimeout(init, 100); return; }
  buildDateDd(); render(curIdx);
}

// Re-render all charts on theme toggle
const _tObs = new MutationObserver(() => {
  if (document.getElementById('pmWrap').style.display !== 'none') {
    Object.keys(charts).forEach(id => { try { charts[id]?.destroy(); } catch(e) {} delete charts[id]; });
    simChart = null;
    const s = data.snapshots[curIdx], sm = s.summary;
    buildGauge((sm.netWorth / data.goal.target * 100).toFixed(1));
    buildRetGauge(parseFloat(sm.investmentGainRate) || 0);
    buildTrend(); buildDonut(sm);
    buildTop5(s.investments); buildReturn(s.investments); buildGrowth();
    _simDone = false; initSim(s, data.goal);
  }
});
_tObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

if (sessionStorage.getItem(SK) === '1') init();
</script>
</BaseLayout>
