---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Property" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property"}]}>
<style>
#prop-root {
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 28px 32px 56px;
}

/* Lock Screen */
#lockScreen {
  position: fixed; inset: 0; z-index: 9999;
  background: radial-gradient(ellipse at 30% 40%, rgba(20,60,130,0.6), transparent 65%),
              radial-gradient(ellipse at 75% 70%, rgba(10,40,100,0.45), transparent 60%),
              #060d1e;
  display: flex; align-items: center; justify-content: center;
}
.lock-card {
  background: rgba(12,28,65,0.88);
  border: 1px solid rgba(130,200,255,0.35);
  border-radius: 24px; padding: 52px 48px; width: 400px; text-align: center;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 80px rgba(50,120,255,0.15), 0 8px 48px rgba(0,0,0,0.7);
  position: relative; overflow: hidden;
}
.lock-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background: linear-gradient(90deg, transparent, rgba(130,200,255,0.7), transparent);
}
.lock-icon { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,0.6)); }
.lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
.lock-sub { font-size:13px; color:#92bfdf; margin-bottom:32px; }
.lock-input {
  width:100%; padding:14px 18px; box-sizing:border-box;
  background:rgba(8,22,58,0.9); border:1px solid rgba(130,200,255,0.35);
  border-radius:12px; color:#d8eeff; font-size:16px;
  outline:none; text-align:center; letter-spacing:3px;
  transition: border-color .2s, box-shadow .2s;
}
.lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,0.2); }
.lock-btn {
  width:100%; margin-top:14px; padding:14px;
  background:linear-gradient(135deg,#1a60d0,#0d3d9e);
  border:1px solid rgba(80,170,255,0.4); border-radius:12px;
  color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer;
  transition:all .2s; letter-spacing:0.5px;
}
.lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px); box-shadow:0 4px 24px rgba(30,100,255,0.4); }
.lock-err { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
.lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

/* Dashboard */
#dashboard { display:none; }
</style>

<div id="prop-root">

<!-- Lock Screen -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Private — Property</div>
    <div class="lock-sub">자산 현황에 접근하려면 비밀번호를 입력하세요.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / property</div>
  </div>
</div>

<!-- Listing -->
<div id="dashboard">
  <div style="margin-bottom:32px;">
    <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Personal · Private</div>
    <h1 style="font-size:28px;font-weight:900;color:var(--text);letter-spacing:-1px;margin:0 0 6px;">Property</h1>
    <p style="font-size:14px;color:var(--muted);margin:0;">자산 현황과 부동산 매물 분석을 관리합니다.</p>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;">

    <!-- 자산 현황 -->
    <a href="/property/property-management/" style="text-decoration:none;">
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:32px 28px;box-shadow:var(--shadow-sm);transition:all .2s;cursor:pointer;"
        onmouseover="this.style.boxShadow='0 8px 32px rgba(37,116,228,0.14)';this.style.borderColor='rgba(37,116,228,0.35)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.boxShadow='0 2px 16px rgba(80,140,220,0.06)';this.style.borderColor='rgba(100,160,240,0.2)';this.style.transform='translateY(0)'">
        <div style="width:48px;height:48px;background:linear-gradient(135deg,#2574e4,#1a5cc8);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:20px;box-shadow:0 4px 14px rgba(37,116,228,0.3);">📊</div>
        <div style="font-size:18px;font-weight:800;color:var(--text);margin-bottom:8px;">자산 현황</div>
        <div style="font-size:13px;color:var(--muted);line-height:1.6;">순자산 추이, 투자 포트폴리오,<br>대출 현황 및 목표 달성률</div>
        <div style="margin-top:20px;display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#2574e4;">
          보기 <span style="font-size:14px;">→</span>
        </div>
      </div>
    </a>

    <!-- 지역 분석 -->
    <a href="/property/region-analysis/" style="text-decoration:none;">
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:32px 28px;box-shadow:var(--shadow-sm);transition:all .2s;cursor:pointer;"
        onmouseover="this.style.boxShadow='0 8px 32px rgba(37,116,228,0.14)';this.style.borderColor='rgba(37,116,228,0.35)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.boxShadow='0 2px 16px rgba(80,140,220,0.06)';this.style.borderColor='rgba(100,160,240,0.2)';this.style.transform='translateY(0)'">
        <div style="width:48px;height:48px;background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:20px;box-shadow:0 4px 14px rgba(124,58,237,0.3);">🗺️</div>
        <div style="font-size:18px;font-weight:800;color:var(--text);margin-bottom:8px;">지역 분석</div>
        <div style="font-size:13px;color:var(--muted);line-height:1.6;">서울 25개구 공급·입지·소득<br>등급 분석 및 지도 시각화</div>
        <div style="margin-top:20px;display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#7c3aed;">
          보기 <span style="font-size:14px;">→</span>
        </div>
      </div>
    </a>

    <!-- 매물 분석 -->
    <a href="/property/property-analysis/" style="text-decoration:none;">
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:32px 28px;box-shadow:var(--shadow-sm);transition:all .2s;cursor:pointer;"
        onmouseover="this.style.boxShadow='0 8px 32px rgba(37,116,228,0.14)';this.style.borderColor='rgba(37,116,228,0.35)';this.style.transform='translateY(-2px)'"
        onmouseout="this.style.boxShadow='0 2px 16px rgba(80,140,220,0.06)';this.style.borderColor='rgba(100,160,240,0.2)';this.style.transform='translateY(0)'">
        <div style="width:48px;height:48px;background:linear-gradient(135deg,#16a34a,#15803d);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:20px;box-shadow:0 4px 14px rgba(22,163,74,0.3);">🏠</div>
        <div style="font-size:18px;font-weight:800;color:var(--text);margin-bottom:8px;">매물 분석</div>
        <div style="font-size:13px;color:var(--muted);line-height:1.6;">매물별 투자 검토 및<br>수익성 분석 리포트</div>
        <div style="margin-top:20px;display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#16a34a;">
          보기 <span style="font-size:14px;">→</span>
        </div>
      </div>
    </a>

  </div>
</div>
</div>

<script is:inline>
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function tryUnlock() {
  const pw = document.getElementById('pwInput').value;
  const h = await sha256(pw);
  if (h === HASH) {
    sessionStorage.setItem(SESSION_KEY, '1');
    document.getElementById('lockScreen').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
  } else {
    document.getElementById('pwErr').textContent = '비밀번호가 올바르지 않습니다.';
    document.getElementById('pwInput').value = '';
  }
}
document.getElementById('unlockBtn').addEventListener('click', tryUnlock);
document.getElementById('pwInput').addEventListener('keydown', e => { if(e.key==='Enter') tryUnlock(); });
if (sessionStorage.getItem(SESSION_KEY) === '1') {
  document.getElementById('lockScreen').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';
}
</script>
</BaseLayout>
