---
import BaseLayout from "../../layouts/BaseLayout.astro";
import propertyData from "../../data/property.json";
const data = JSON.stringify(propertyData);
---
<BaseLayout title="Property" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property"}]}>
<style>
/* ── Light Frost Blue Theme ─────────────────────── */
#prop-root {
  background: #f0f7ff;
  color: #0d1e3a;
  min-height: 100vh;
  margin: -20px -24px;
  padding: 28px 28px 56px;
}

/* ── Lock Screen (dark, elegant) ─────────────────── */
#lockScreen {
  position: fixed; inset: 0; z-index: 9999;
  background: radial-gradient(ellipse at 30% 40%, rgba(20,60,130,0.6), transparent 65%),
              radial-gradient(ellipse at 75% 70%, rgba(10,40,100,0.45), transparent 60%),
              #060d1e;
  display: flex; align-items: center; justify-content: center;
}
.lock-card {
  background: rgba(12,28,65,0.88);
  border: 1px solid rgba(130,200,255,0.35);
  border-radius: 24px; padding: 52px 48px; width: 400px; text-align: center;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 80px rgba(50,120,255,0.15), 0 8px 48px rgba(0,0,0,0.7);
  position: relative; overflow: hidden;
}
.lock-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background: linear-gradient(90deg, transparent, rgba(130,200,255,0.7), transparent);
}
.lock-icon { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,0.6)); }
.lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
.lock-sub { font-size:13px; color:#92bfdf; margin-bottom:32px; }
.lock-input {
  width:100%; padding:14px 18px; box-sizing:border-box;
  background:rgba(8,22,58,0.9); border:1px solid rgba(130,200,255,0.35);
  border-radius:12px; color:#d8eeff; font-size:16px;
  outline:none; text-align:center; letter-spacing:3px;
  transition: border-color .2s, box-shadow .2s;
}
.lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,0.2); }
.lock-btn {
  width:100%; margin-top:14px; padding:14px;
  background:linear-gradient(135deg,#1a60d0,#0d3d9e);
  border:1px solid rgba(80,170,255,0.4); border-radius:12px;
  color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer;
  transition:all .2s; letter-spacing:0.5px;
}
.lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px); box-shadow:0 4px 24px rgba(30,100,255,0.4); }
.lock-err { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
.lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

/* ── Dashboard ───────────────────────────────────── */
#dashboard { display:none; }
.view { padding-bottom:0; }

/* Snapshot Tabs */
.snap-tabs { display:flex; gap:8px; margin-bottom:28px; flex-wrap:wrap; }
.snap-tab {
  padding:9px 20px; border-radius:10px; cursor:pointer; font-size:13px; font-weight:600;
  border:1px solid rgba(100,160,240,0.3); color:#4a789e;
  background:#ffffff; transition:all .2s;
  box-shadow:0 1px 4px rgba(80,140,220,0.06);
}
.snap-tab.active {
  background:linear-gradient(135deg,#2574e4,#1a5cc8);
  border-color:#2574e4; color:#ffffff;
  box-shadow:0 4px 14px rgba(37,116,228,0.25);
}
.snap-tab:hover:not(.active) { border-color:rgba(100,160,240,0.5); color:#0d1e3a; background:#f4f9ff; }
.snap-delta { display:inline-block; font-size:10px; font-weight:700; padding:2px 6px; border-radius:5px; margin-left:6px; vertical-align:middle; }
.snap-delta.pos { background:rgba(22,163,74,0.12); color:#16a34a; }
.snap-delta.neg { background:rgba(220,38,38,0.1); color:#dc2626; }

/* Cards */
.card {
  background:#ffffff;
  border:1px solid rgba(100,160,240,0.2);
  border-radius:16px; padding:24px;
  box-shadow:0 2px 16px rgba(80,140,220,0.06);
  transition:box-shadow .2s, border-color .2s;
}
.card:hover { border-color:rgba(80,140,220,0.3); box-shadow:0 4px 24px rgba(80,140,220,0.1); }
.card-label {
  font-size:11px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase;
  color:#4a789e; margin-bottom:12px; display:flex; align-items:center; gap:8px;
}
.card-label::before { content:''; display:inline-block; width:3px; height:13px; background:#2574e4; border-radius:2px; }

/* Grid */
.g3  { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:20px; }
.g2  { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:20px; }
.g12 { display:grid; grid-template-columns:1fr 1.8fr; gap:18px; margin-bottom:20px; }
.g21 { display:grid; grid-template-columns:1.8fr 1fr; gap:18px; margin-bottom:20px; }
@media(max-width:900px){.g3,.g2,.g12,.g21{grid-template-columns:1fr;}}

/* Hero Goal */
.goal-hero {
  background:linear-gradient(135deg,#ddeeff,#e8f4ff);
  border:1px solid rgba(100,160,240,0.35);
  border-radius:20px; padding:32px; margin-bottom:20px;
  position:relative; overflow:hidden;
  box-shadow:0 4px 24px rgba(80,140,220,0.1);
}
.goal-hero::before {
  content:''; position:absolute; top:-100px; right:-80px;
  width:350px; height:350px;
  background:radial-gradient(circle,rgba(37,116,228,0.07),transparent 65%);
  border-radius:50%;
}
.goal-grid { display:grid; grid-template-columns:160px 1fr 220px; gap:36px; align-items:center; position:relative; }
@media(max-width:900px){.goal-grid{grid-template-columns:1fr;text-align:center;}}

.gauge-wrap { position:relative; width:160px; height:160px; }
.gauge-wrap canvas { width:160px!important; height:160px!important; }
.gauge-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.gauge-pct  { font-size:28px; font-weight:900; color:#d97706; line-height:1; }
.gauge-lbl  { font-size:11px; color:#4a789e; margin-top:3px; }

.goal-main h3 { font-size:11px; color:#7a9fb8; letter-spacing:1.2px; text-transform:uppercase; margin-bottom:6px; font-weight:700; }
.goal-networth { font-size:42px; font-weight:900; letter-spacing:-2px; color:#0d1e3a; line-height:1; }
.goal-target { font-size:14px; color:#4a789e; margin-top:8px; }
.goal-target strong { color:#d97706; }
.goal-bar-wrap { margin-top:16px; }
.goal-bar-bg { height:8px; background:rgba(100,160,240,0.2); border-radius:99px; overflow:hidden; }
.goal-bar-fill { height:100%; border-radius:99px; background:linear-gradient(90deg,#2574e4,#d97706); transition:width 1s ease; }
.goal-bar-labels { display:flex; justify-content:space-between; font-size:11px; color:#7a9fb8; margin-top:6px; }
.goal-pills { display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; }
.gpill { display:inline-flex; align-items:center; gap:5px; background:rgba(37,116,228,0.07); border:1px solid rgba(100,160,240,0.3); border-radius:8px; padding:4px 10px; font-size:11px; color:#3d6b98; }
.dot { width:6px; height:6px; border-radius:50%; display:inline-block; }

.goal-stats { display:flex; flex-direction:column; gap:12px; }
.gstat { background:rgba(255,255,255,0.8); border:1px solid rgba(100,160,240,0.2); border-radius:12px; padding:14px 16px; }
.gstat-label { font-size:11px; color:#4a789e; margin-bottom:4px; font-weight:600; }
.gstat-val   { font-size:17px; font-weight:800; color:#0d1e3a; }

/* Stat cards */
.stat-card .big { font-size:26px; font-weight:900; letter-spacing:-1px; color:#0d1e3a; }
.stat-card .sub { font-size:12px; color:#4a789e; margin-top:4px; }
.stat-card .accent-bar { height:3px; border-radius:99px; margin-bottom:16px; }

/* Stacked bar (flex-grow based) */
.sbar-wrap { margin-top:14px; }
.sbar { display:flex; height:14px; border-radius:7px; overflow:hidden; border:1px solid rgba(100,160,240,0.15); }
.sbar div { height:100%; transition:flex .6s ease; }
.sbar-legend { display:flex; gap:12px; margin-top:8px; flex-wrap:wrap; }
.sbar-lbl { font-size:11px; color:#4a789e; display:flex; align-items:center; gap:5px; font-weight:500; }
.sbar-dot { width:9px; height:9px; border-radius:3px; display:inline-block; flex-shrink:0; }

/* Mini bar */
.mbar { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.mbar-lbl { font-size:11px; color:#4a789e; min-width:68px; font-weight:500; }
.mbar-bg { flex:1; height:5px; background:rgba(100,160,240,0.15); border-radius:99px; overflow:hidden; }
.mbar-fill { height:100%; border-radius:99px; }
.mbar-val { font-size:11px; min-width:38px; text-align:right; font-variant-numeric:tabular-nums; color:#0d1e3a; }

/* Badge */
.badge { display:inline-block; padding:2px 8px; border-radius:6px; font-size:11px; font-weight:700; }
.badge-green  { background:rgba(22,163,74,0.12);  color:#16a34a; }
.badge-red    { background:rgba(220,38,38,0.1);   color:#dc2626; }
.badge-blue   { background:rgba(37,116,228,0.1);  color:#2574e4; }
.badge-gold   { background:rgba(217,119,6,0.12);  color:#d97706; }
.badge-purple { background:rgba(124,58,237,0.1);  color:#7c3aed; }

/* Table */
.dtable { width:100%; border-collapse:collapse; font-size:13px; color:#0d1e3a; }
.dtable th {
  padding:9px 12px; font-size:10px; font-weight:700; letter-spacing:0.8px;
  text-transform:uppercase; color:#7a9fb8;
  border-bottom:1px solid rgba(100,160,240,0.2); text-align:left;
  background:rgba(240,247,255,0.6);
}
.dtable th.r { text-align:right; }
.dtable td { padding:11px 12px; border-bottom:1px solid rgba(100,160,240,0.1); vertical-align:middle; color:#0d1e3a; }
.dtable td.r { text-align:right; font-variant-numeric:tabular-nums; }
.dtable tbody tr:hover { background:rgba(37,116,228,0.04); }
.dtable tbody tr:last-child td { border-bottom:none; }
.dtable tfoot tr td { border-top:1px solid rgba(100,160,240,0.25); background:rgba(37,116,228,0.04); font-weight:700; color:#0d1e3a; }

/* Chart */
.chart-wrap { position:relative; height:260px; }
.chart-sm   { position:relative; height:220px; }

/* Loan card */
.loan-item { background:#f4f9ff; border:1px solid rgba(100,160,240,0.2); border-radius:12px; padding:16px 20px; margin-bottom:12px; }
.loan-item:last-child { margin-bottom:0; }
.loan-top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; }
.loan-name   { font-weight:700; font-size:14px; color:#0d1e3a; }
.loan-bank   { font-size:11px; color:#4a789e; margin-top:2px; }
.loan-amount { font-size:20px; font-weight:900; color:#dc2626; }
.loan-meta   { display:flex; gap:16px; font-size:12px; color:#4a789e; margin:8px 0; flex-wrap:wrap; }

/* Delta */
.delta { font-size:12px; font-weight:700; }
.delta.pos  { color:#16a34a; }
.delta.neg  { color:#dc2626; }
.delta.zero { color:#4a789e; }

/* Section heading */
.sh { font-size:16px; font-weight:800; color:#0d1e3a; margin-bottom:20px; display:flex; align-items:center; gap:10px; }
.sh::before { content:''; display:block; width:4px; height:18px; background:linear-gradient(180deg,#2574e4,rgba(37,116,228,0.2)); border-radius:2px; }

/* Debt segment bar */
.debt-seg-bar { display:flex; height:12px; border-radius:6px; overflow:hidden; margin-top:12px; margin-bottom:14px; border:1px solid rgba(100,160,240,0.15); }
.debt-seg-bar div { height:100%; }
.debt-loan-row { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid rgba(100,160,240,0.12); }
.debt-loan-row:last-child { border-bottom:none; margin-bottom:0; padding-bottom:0; }
.debt-loan-name   { font-size:12px; color:#0d1e3a; font-weight:700; margin-bottom:2px; }
.debt-loan-bank   { font-size:10px; color:#7a9fb8; }
.debt-loan-meta   { font-size:11px; color:#4a789e; margin-top:3px; }
.debt-loan-amount { font-size:14px; font-weight:900; color:#dc2626; text-align:right; }
.debt-loan-int    { font-size:10px; color:#4a789e; text-align:right; margin-top:2px; }

/* Return gauge (semi-circle) */
.return-gauge-wrap { position:relative; width:160px; height:80px; margin:10px auto 0; }
.return-gauge-wrap canvas { width:160px!important; height:80px!important; }
.return-gauge-center { position:absolute; bottom:0; left:0; right:0; text-align:center; }
.return-gauge-pct { font-size:22px; font-weight:900; line-height:1; }
.return-amounts { display:flex; justify-content:space-around; margin-top:10px; }
.return-amt-item  { text-align:center; }
.return-amt-label { font-size:10px; color:#7a9fb8; margin-bottom:3px; }
.return-amt-val   { font-size:13px; font-weight:700; }

/* Top 5 bar */
.top5-chart-wrap { position:relative; height:220px; margin-bottom:16px; }

/* AI 투자 의견 */
.ai-opinion { background:rgba(37,116,228,0.04); border:1px solid rgba(37,116,228,0.15); border-radius:12px; padding:18px 20px; margin-top:18px; }
.ai-opinion-title { font-size:12px; font-weight:700; color:#2574e4; letter-spacing:0.8px; text-transform:uppercase; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
.ai-opinion-title::before { content:'🤖'; font-size:14px; }
.ai-row { display:flex; gap:8px; margin-bottom:8px; font-size:12px; }
.ai-row-label { color:#7a9fb8; min-width:90px; font-weight:600; flex-shrink:0; }
.ai-row-val   { color:#0d1e3a; flex:1; }
.ai-comment   { font-size:12px; color:#4a789e; margin-top:10px; line-height:1.7; border-top:1px solid rgba(100,160,240,0.2); padding-top:10px; }

/* ── Snapshot Comparison ─────────────────────────── */
.cmp-date-btn {
  padding:6px 14px; border-radius:8px; cursor:pointer; font-size:12px; font-weight:600;
  border:1px solid rgba(100,160,240,0.3); color:#4a789e;
  background:#ffffff; transition:all .18s;
}
.cmp-date-btn.active { background:#2574e4; border-color:#2574e4; color:#ffffff; box-shadow:0 2px 8px rgba(37,116,228,0.25); }
.cmp-date-btn:hover:not(.active) { border-color:#2574e4; color:#2574e4; }

.cmp-panel { display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:center; margin-top:16px; padding:22px; background:#f4f9ff; border-radius:14px; border:1px solid rgba(100,160,240,0.22); }
.cmp-snap-label { font-size:10px; color:#7a9fb8; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; margin-bottom:4px; }
.cmp-snap-nw  { font-size:28px; font-weight:900; color:#0d1e3a; letter-spacing:-0.5px; }
.cmp-snap-sub { font-size:12px; color:#4a789e; margin-top:5px; }
.cmp-arrow-col { display:flex; flex-direction:column; align-items:center; gap:6px; }
.cmp-arrow-icon { font-size:22px; color:#2574e4; }
.cmp-arrow-val  { font-size:14px; font-weight:800; }
.cmp-arrow-pct  { font-size:11px; font-weight:700; }

.cmp-metrics { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:16px; }
.cmp-met-card { background:#f4f9ff; border:1px solid rgba(100,160,240,0.2); border-radius:10px; padding:12px 14px; }
.cmp-met-label { font-size:10px; color:#7a9fb8; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; margin-bottom:6px; }
.cmp-met-row { display:flex; align-items:center; gap:6px; font-size:12px; }
.cmp-met-from  { color:#4a789e; }
.cmp-met-arr   { color:#7a9fb8; font-size:10px; }
.cmp-met-to    { font-weight:700; color:#0d1e3a; }
.cmp-met-delta { font-size:11px; font-weight:800; margin-left:auto; }

.growth-chart-wrap { position:relative; height:240px; margin-top:20px; }
</style>

<div id="prop-root">

<!-- Lock Screen -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Private — Property</div>
    <div class="lock-sub">자산 현황에 접근하려면 비밀번호를 입력하세요.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / property</div>
  </div>
</div>

<!-- Dashboard -->
<div id="dashboard">
<div class="view">

  <!-- Snapshot Tabs -->
  <div class="snap-tabs" id="snapTabs"></div>

  <!-- Goal Hero -->
  <div class="goal-hero">
    <div class="goal-grid">
      <div>
        <div class="gauge-wrap">
          <canvas id="gaugeChart"></canvas>
          <div class="gauge-center">
            <div class="gauge-pct" id="gaugePct">0%</div>
            <div class="gauge-lbl">달성</div>
          </div>
        </div>
      </div>
      <div class="goal-main">
        <h3>현재 순자산</h3>
        <div class="goal-networth" id="heroNetWorth">—</div>
        <div class="goal-target">목표: <strong>5억원</strong> &nbsp;·&nbsp; <span style="color:#2574e4">2027년 2월까지</span></div>
        <div class="goal-bar-wrap">
          <div class="goal-bar-bg"><div class="goal-bar-fill" id="goalBarFill" style="width:0%"></div></div>
          <div class="goal-bar-labels"><span>0</span><span id="goalBarMid" style="color:#d97706"></span><span style="color:#d97706">5억 목표</span></div>
        </div>
        <div class="goal-pills" id="goalPills"></div>
      </div>
      <div class="goal-stats" id="goalStats"></div>
    </div>
  </div>

  <!-- Top 3 stat cards -->
  <div class="g3">
    <!-- 총 자산 -->
    <div class="card stat-card">
      <div class="accent-bar" style="background:linear-gradient(90deg,#2574e4,rgba(37,116,228,0.1))"></div>
      <div class="card-label">총 자산</div>
      <div class="big" id="statTotal">—</div>
      <div class="sub" id="statTotalSub"></div>
      <div class="sbar-wrap" id="statTotalBars"></div>
    </div>
    <!-- 총 부채 -->
    <div class="card stat-card">
      <div class="accent-bar" style="background:linear-gradient(90deg,#dc2626,rgba(220,38,38,0.1))"></div>
      <div class="card-label">총 부채</div>
      <div class="big" id="statDebt" style="color:#dc2626">—</div>
      <div class="sub" id="statDebtSub"></div>
      <div id="statDebtItems"></div>
    </div>
    <!-- 투자 수익 -->
    <div class="card stat-card">
      <div class="accent-bar" style="background:linear-gradient(90deg,#16a34a,rgba(22,163,74,0.1))"></div>
      <div class="card-label">투자 수익</div>
      <div class="big" id="statGain">—</div>
      <div class="sub" id="statGainSub"></div>
      <div class="return-gauge-wrap" style="margin-top:10px;">
        <canvas id="returnGaugeChart"></canvas>
        <div class="return-gauge-center">
          <div class="return-gauge-pct" id="returnGaugePct">—</div>
          <div style="font-size:10px;color:#7a9fb8;margin-top:2px;">수익률</div>
        </div>
      </div>
      <div class="return-amounts" id="returnAmounts"></div>
    </div>
  </div>

  <!-- Trend + Donut -->
  <div class="g12">
    <div class="card">
      <div class="sh">순자산 추이</div>
      <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
    </div>
    <div class="card">
      <div class="sh">자산 구성</div>
      <div class="chart-sm"><canvas id="donutChart"></canvas></div>
      <div id="donutLegend" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;justify-content:center;"></div>
    </div>
  </div>

  <!-- Investment Portfolio -->
  <div class="card" style="margin-bottom:20px;">
    <div class="sh">투자 포트폴리오</div>
    <div class="top5-chart-wrap"><canvas id="top5Chart"></canvas></div>
    <div style="overflow-x:auto;">
      <table class="dtable">
        <thead>
          <tr>
            <th>종목</th><th>증권사</th>
            <th class="r">투자원금</th><th class="r">현재 평가액</th>
            <th class="r">손익</th><th class="r">수익률</th><th style="min-width:100px">비중</th>
          </tr>
        </thead>
        <tbody id="invTable"></tbody>
        <tfoot>
          <tr>
            <td colspan="2" style="padding:12px;">합계</td>
            <td class="r" id="invTotalCost" style="padding:12px;"></td>
            <td class="r" id="invTotalEval" style="padding:12px;color:#2574e4"></td>
            <td class="r" id="invTotalGain" style="padding:12px;"></td>
            <td class="r" id="invTotalRate" style="padding:12px;"></td>
            <td style="padding:12px;"></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="ai-opinion" id="aiOpinion"></div>
  </div>

  <!-- Return Bar Chart -->
  <div class="card" style="margin-bottom:20px;">
    <div class="sh">종목별 수익률</div>
    <div class="chart-wrap"><canvas id="returnChart"></canvas></div>
  </div>

  <!-- Snapshot Comparison + Loan -->
  <div class="g21">
    <div class="card">
      <div class="sh">스냅샷 비교</div>
      <div style="margin-bottom:14px;">
        <div style="font-size:11px;color:#7a9fb8;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:10px;">비교 기준 날짜 선택</div>
        <div id="cmpBtns" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
      </div>
      <div id="cmpPanel"></div>
      <div class="growth-chart-wrap"><canvas id="growthChart"></canvas></div>
    </div>
    <div class="card">
