      <div id="loanSection"></div>
    </div>
  </div>

</div>
</div><!-- /dashboard -->
</div><!-- /#prop-root -->

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script is:inline define:vars={{ data: propertyData }}>
// ── Auth ──────────────────────────────────────────
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function tryUnlock() {
  const pw = document.getElementById('pwInput').value;
  const h = await sha256(pw);
  if (h === HASH) {
    sessionStorage.setItem(SESSION_KEY, '1');
    document.getElementById('lockScreen').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
    init();
  } else {
    document.getElementById('pwErr').textContent = '비밀번호가 올바르지 않습니다.';
    document.getElementById('pwInput').value = '';
  }
}
document.getElementById('unlockBtn').addEventListener('click', tryUnlock);
document.getElementById('pwInput').addEventListener('keydown', e => { if(e.key==='Enter') tryUnlock(); });
if (sessionStorage.getItem(SESSION_KEY) === '1') {
  document.getElementById('lockScreen').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';
}

// ── Helpers ───────────────────────────────────────
const fmt = v => {
  if (Math.abs(v) >= 1e8) return (v/1e8).toFixed(2)+'억';
  if (Math.abs(v) >= 1e4) return Math.round(v/1e4).toLocaleString()+'만';
  return v.toLocaleString();
};
const fmtPct = v => (v>=0?'+':'')+v.toFixed(1)+'%';
const deltaClass = v => v>0?'pos':v<0?'neg':'zero';
const dSign = v => v>0?'+':'';
const dColor = v => v>=0?'#16a34a':'#dc2626';

// ── Chart color constants (light theme) ──────────
const CLR = {
  grid: 'rgba(100,160,220,0.12)',
  tick: '#7a9fb8',
  tip:  { bg:'rgba(255,255,255,0.98)', border:'rgba(100,160,220,0.4)', title:'#0d1e3a', body:'#4a789e' },
};

let gaugeInst, trendInst, donutInst, returnInst, returnGaugeInst, topBarInst, growthInst;
let curIdx = data.snapshots.length - 1;
let cmpFromIdx = 0;
if (cmpFromIdx === curIdx) cmpFromIdx = curIdx > 0 ? 0 : (data.snapshots.length > 1 ? 1 : 0);

// ── Init ──────────────────────────────────────────
function init() {
  if (typeof Chart === 'undefined') { setTimeout(init, 100); return; }
  buildTabs();
  buildTrendChart();
  render(curIdx);
}

// ── Snapshot Date Selector (single dropdown) ──────
function buildTabs() {
  const el = document.getElementById('snapTabs');
  el.style.cssText = 'position:relative;margin-bottom:28px;display:inline-block;';

  const s = data.snapshots[curIdx];
  const prev = curIdx > 0 ? data.snapshots[curIdx-1] : null;
  const delta = prev ? s.summary.netWorth - prev.summary.netWorth : null;
  let deltaHtml = '';
  if (delta !== null) {
    const col = delta >= 0 ? '#16a34a' : '#dc2626';
    const bg  = delta >= 0 ? 'rgba(22,163,74,0.12)' : 'rgba(220,38,38,0.1)';
    deltaHtml = `<span style="font-size:11px;font-weight:700;padding:3px 8px;border-radius:6px;background:${bg};color:${col};margin-left:8px;">${delta>=0?'+':''}${fmt(delta)}</span>`;
  }

  const opts = data.snapshots.map((ss, i) => {
    const sprev = i > 0 ? data.snapshots[i-1] : null;
    const sdelta = sprev ? ss.summary.netWorth - sprev.summary.netWorth : null;
    const isActive = i === curIdx;
    let sdeltaHtml = '';
    if (sdelta !== null) {
      const c2 = sdelta >= 0 ? '#16a34a' : '#dc2626';
      const b2 = sdelta >= 0 ? 'rgba(22,163,74,0.12)' : 'rgba(220,38,38,0.1)';
      sdeltaHtml = `<span style="font-size:10px;font-weight:700;padding:2px 6px;border-radius:5px;background:${b2};color:${c2};margin-left:8px;">${sdelta>=0?'+':''}${fmt(sdelta)}</span>`;
    }
    const itemBg = isActive ? 'rgba(37,116,228,0.08)' : 'transparent';
    const itemColor = isActive ? '#2574e4' : '#0d1e3a';
    const itemFW = isActive ? '700' : '500';
    return `<div onclick="selectDate(${i})"
      onmouseover="this.style.background='rgba(37,116,228,0.06)'"
      onmouseout="this.style.background='${itemBg}'"
      style="display:flex;align-items:center;padding:10px 14px;cursor:pointer;border-radius:8px;background:${itemBg};">
      <span style="font-size:13px;font-weight:${itemFW};color:${itemColor};">${ss.snapshotDate}</span>
      ${sdeltaHtml}
      ${isActive?'<span style="margin-left:auto;color:#2574e4;font-size:12px;padding-left:8px;">✓</span>':''}
    </div>`;
  }).join('');

  el.innerHTML = `
    <button id="datePickerBtn" onclick="toggleDateDropdown()"
      style="display:inline-flex;align-items:center;gap:10px;padding:10px 20px;background:#ffffff;border:1.5px solid rgba(100,160,240,0.4);border-radius:12px;cursor:pointer;font-size:14px;font-weight:700;color:#0d1e3a;box-shadow:0 2px 12px rgba(80,140,220,0.1);font-family:inherit;">
      <span>📅</span>
      <span>${s.snapshotDate}</span>
      ${deltaHtml}
      <span style="color:#4a789e;font-size:13px;margin-left:4px;">▾</span>
    </button>
    <div id="dateDropdown" style="display:none;position:absolute;top:calc(100% + 6px);left:0;background:#ffffff;border:1px solid rgba(100,160,240,0.25);border-radius:14px;box-shadow:0 8px 32px rgba(80,140,220,0.18);z-index:200;min-width:280px;padding:8px;">
      ${opts}
    </div>
  `;

  if (!el._outsideClickAdded) {
    document.addEventListener('click', function(ev) {
      const dd = document.getElementById('dateDropdown');
      const btn = document.getElementById('datePickerBtn');
      if (dd && btn && !btn.contains(ev.target) && !dd.contains(ev.target)) {
        dd.style.display = 'none';
      }
    });
    el._outsideClickAdded = true;
  }
}

// ── Trend Line Chart ──────────────────────────────
function buildTrendChart() {
  const labels = data.snapshots.map(s => s.snapshotDate);
  const ctx = document.getElementById('trendChart').getContext('2d');
  const g1 = ctx.createLinearGradient(0,0,0,260);
  g1.addColorStop(0,'rgba(37,116,228,0.15)'); g1.addColorStop(1,'rgba(37,116,228,0)');
  const g2 = ctx.createLinearGradient(0,0,0,260);
  g2.addColorStop(0,'rgba(22,163,74,0.12)');  g2.addColorStop(1,'rgba(22,163,74,0)');
  trendInst = new Chart(ctx, {
    type:'line',
    data: {
      labels,
      datasets: [
        { label:'총자산', data:data.snapshots.map(s=>s.summary.totalAssets), borderColor:'#2574e4', backgroundColor:g1, borderWidth:2.5, pointBackgroundColor:'#2574e4', pointRadius:5, tension:0.35, fill:true },
        { label:'순자산', data:data.snapshots.map(s=>s.summary.netWorth),    borderColor:'#16a34a', backgroundColor:g2, borderWidth:2.5, pointBackgroundColor:'#16a34a', pointRadius:5, tension:0.35, fill:true },
        { label:'총부채', data:data.snapshots.map(s=>s.summary.totalDebt),   borderColor:'#dc2626', backgroundColor:'transparent', borderWidth:2, borderDash:[5,3], pointBackgroundColor:'#dc2626', pointRadius:4, tension:0.35 },
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins: {
        legend:{ labels:{ color:CLR.tick, font:{size:11}, boxWidth:12, padding:16 } },
        tooltip:{ backgroundColor:CLR.tip.bg, borderColor:CLR.tip.border, borderWidth:1, titleColor:CLR.tip.title, bodyColor:CLR.tip.body,
          callbacks:{ label: c => ` ${c.dataset.label}: ${(c.raw/1e8).toFixed(3)}억원` } }
      },
      scales: {
        x:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, font:{size:11}} },
        y:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, font:{size:11}, callback:v=>(v/1e8).toFixed(1)+'억'} }
      }
    }
  });
}

// ── Main render ───────────────────────────────────
function render(idx) {
  curIdx = idx;
  const s  = data.snapshots[idx];
  const sm = s.summary;
  const prev = idx > 0 ? data.snapshots[idx-1] : null;
  const pct  = (sm.netWorth / data.goal.target * 100).toFixed(1);

  // ── Goal Hero
  document.getElementById('heroNetWorth').textContent = fmt(sm.netWorth);
  document.getElementById('gaugePct').textContent = pct+'%';
  document.getElementById('goalBarFill').style.width = Math.min(pct,100)+'%';
  document.getElementById('goalBarMid').textContent = `현재 ${fmt(sm.netWorth)} (${pct}%)`;

  const remain = data.goal.target - sm.netWorth;
  const months = Math.round((new Date(data.goal.deadline) - new Date(s.snapshotDate)) / (1000*60*60*24*30.5));
  const _pill = (color, text) => `<span style="display:inline-flex;align-items:center;gap:5px;background:rgba(37,116,228,0.07);border:1px solid rgba(100,160,240,0.3);border-radius:8px;padding:4px 10px;font-size:11px;color:#3d6b98;"><span style="width:6px;height:6px;border-radius:50%;display:inline-block;background:${color}"></span>${text}</span>`;
  document.getElementById('goalPills').innerHTML =
    _pill('#2574e4','총자산 '+fmt(sm.totalAssets)) +
    _pill('#dc2626','총부채 '+fmt(sm.totalDebt)) +
    _pill('#d97706','목표까지 '+fmt(remain));
  const monthlyNeed = months > 0 ? Math.round(remain/months) : 0;
  const _gs = 'background:rgba(255,255,255,0.85);border:1px solid rgba(100,160,240,0.2);border-radius:12px;padding:14px 16px;';
  const _gl = 'font-size:11px;color:#4a789e;margin-bottom:4px;font-weight:600;';
  const _gv = 'font-size:17px;font-weight:800;';
  document.getElementById('goalStats').innerHTML = `
    <div style="${_gs}"><div style="${_gl}">목표까지 남은 금액</div><div style="${_gv}color:#dc2626;">−${fmt(remain)}</div></div>
    <div style="${_gs}"><div style="${_gl}">목표 기간 (2027-02)</div><div style="${_gv}color:#4a789e;">${months>0?`약 ${months}개월`:'마감 지남'}</div></div>
    <div style="${_gs}"><div style="${_gl}">월 필요 증가액</div><div style="${_gv}color:#2574e4;">${fmt(monthlyNeed)}/월</div></div>
  `;

  // Gauge
  if (gaugeInst) gaugeInst.destroy();
  gaugeInst = new Chart(document.getElementById('gaugeChart').getContext('2d'), {
    type:'doughnut',
    data:{ datasets:[{ data:[parseFloat(pct),100-parseFloat(pct)],
      backgroundColor:['#d97706','rgba(200,220,255,0.4)'], borderWidth:0, cutout:'78%', circumference:270, rotation:225 }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false},tooltip:{enabled:false}} }
  });

  // ── Stat: 총자산
  const taD = prev ? sm.totalAssets - prev.summary.totalAssets : null;
  document.getElementById('statTotal').innerHTML = `<span style="font-size:26px;font-weight:900;letter-spacing:-1px;color:#0d1e3a;">${fmt(sm.totalAssets)}</span>` +
    (taD!==null?` <span style="font-size:14px;font-weight:700;color:${taD>=0?'#16a34a':'#dc2626'}">${dSign(taD)}${fmt(taD)}</span>`:'');
  document.getElementById('statTotalSub').textContent = `순자산 ${fmt(sm.netWorth)}`;

  const rePct  = sm.realEstate/sm.totalAssets*100;
  const invPct = sm.investmentTotal/sm.totalAssets*100;
  const cashPct= (sm.cash+sm.savings)/sm.totalAssets*100;
  const _dot = (c) => `<span style="width:9px;height:9px;border-radius:3px;display:inline-block;flex-shrink:0;background:${c};"></span>`;
  const _lbl = (c,t) => `<span style="font-size:11px;color:#4a789e;display:flex;align-items:center;gap:5px;font-weight:500;">${_dot(c)}${t}</span>`;
  document.getElementById('statTotalBars').innerHTML = `
    <div style="display:flex;height:14px;border-radius:7px;overflow:hidden;border:1px solid rgba(100,160,240,0.15);margin-top:14px;">
      <div style="flex:${rePct};background:#2574e4;"></div>
      <div style="flex:${invPct};background:#d97706;"></div>
      <div style="flex:${cashPct};background:#16a34a;"></div>
    </div>
    <div style="display:flex;gap:12px;margin-top:8px;flex-wrap:wrap;">
      ${_lbl('#2574e4','부동산 '+rePct.toFixed(1)+'%')}
      ${_lbl('#d97706','투자 '+invPct.toFixed(1)+'%')}
      ${_lbl('#16a34a','현금 '+cashPct.toFixed(1)+'%')}
    </div>
  `;

  // ── Stat: 총부채
  const tdD = prev ? sm.totalDebt - prev.summary.totalDebt : null;
  document.getElementById('statDebt').innerHTML = `<span style="font-size:26px;font-weight:900;letter-spacing:-1px;color:#dc2626;">${fmt(sm.totalDebt)}</span>` +
    (tdD!==null&&tdD!==0?` <span style="font-size:14px;font-weight:700;color:${tdD<=0?'#16a34a':'#dc2626'}">${dSign(tdD)}${fmt(tdD)}</span>`:'');
  document.getElementById('statDebtSub').textContent = `부채비율 ${(sm.totalDebt/sm.totalAssets*100).toFixed(1)}%`;

  const loanColors = ['#ef4444','#f59e0b','#8b5cf6','#3b82f6'];
  const totalInterest = s.loans.reduce((a,l) => a + l.balance*(l.rate||0)/100/12, 0);
  const debtSegs = s.loans.map((l,i) =>
    `<div style="flex:${l.balance};background:${loanColors[i%loanColors.length]};height:100%;"></div>`).join('');
  const debtRows = s.loans.map((l,i) => {
    const monthInt = Math.round(l.balance*(l.rate||0)/100/12);
    const nm = l.name.length>14?l.name.slice(0,14)+'…':l.name;
    return `<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid rgba(100,160,240,0.12);">
      <div>
        <div style="font-size:12px;font-weight:700;margin-bottom:2px;color:${loanColors[i%loanColors.length]}">${nm}</div>
        <div style="font-size:10px;color:#7a9fb8;">${l.bank} · ${l.type}</div>
        <div style="font-size:11px;color:#4a789e;margin-top:3px;">${l.rate?`금리 <strong style="color:#d97706">${l.rate}%</strong>`:''}</div>
      </div>
      <div>
        <div style="font-size:14px;font-weight:900;color:#dc2626;text-align:right;">${fmt(l.balance)}</div>
        <div style="font-size:10px;color:#4a789e;text-align:right;margin-top:2px;">월이자 ${monthInt.toLocaleString()}원</div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('statDebtItems').innerHTML = `
    <div style="display:flex;height:12px;border-radius:6px;overflow:hidden;margin-top:12px;margin-bottom:14px;border:1px solid rgba(100,160,240,0.15);">${debtSegs}</div>
    ${debtRows}
    <div style="font-size:11px;color:#4a789e;margin-top:8px;text-align:right;">월 이자 합계: <strong style="color:#dc2626">${Math.round(totalInterest).toLocaleString()}원</strong></div>
  `;

  // ── Stat: 투자수익 (semi-circle gauge)
  const isPos = sm.investmentGain >= 0;
  const gainColor = isPos ? '#16a34a' : '#dc2626';
  document.getElementById('statGain').innerHTML = `<span style="color:${gainColor}">${dSign(sm.investmentGain)}${fmt(sm.investmentGain)}</span>`;
  document.getElementById('statGainSub').innerHTML = `수익률 <span style="color:${gainColor}">${fmtPct(sm.investmentGainRate)}</span>`;

  const gRate   = parseFloat(sm.investmentGainRate)||0;
  const gaugeN  = Math.min(Math.max((gRate+100)/300*100, 0), 100);
  if (returnGaugeInst) returnGaugeInst.destroy();
  returnGaugeInst = new Chart(document.getElementById('returnGaugeChart').getContext('2d'), {
    type:'doughnut',
    data:{ datasets:[{ data:[gaugeN,100-gaugeN],
      backgroundColor:[gainColor,'rgba(200,220,255,0.4)'], borderWidth:0, circumference:180, rotation:-90, cutout:'72%' }] },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false},tooltip:{enabled:false}} }
  });
  document.getElementById('returnGaugePct').innerHTML = `<span style="color:${gainColor}">${fmtPct(gRate)}</span>`;
  document.getElementById('returnAmounts').innerHTML = `
    <div style="text-align:center;"><div style="font-size:10px;color:#7a9fb8;margin-bottom:3px;">투자원금</div><div style="font-size:13px;font-weight:700;color:#4a789e;">${fmt(sm.investmentCost)}</div></div>
    <div style="text-align:center;"><div style="font-size:10px;color:#7a9fb8;margin-bottom:3px;">현재 평가</div><div style="font-size:13px;font-weight:700;color:${gainColor};">${fmt(sm.investmentTotal)}</div></div>
  `;

  // ── Donut Chart
  if (donutInst) donutInst.destroy();
  const dd = [
    { label:'부동산', val:sm.realEstate,     color:'#2574e4' },
    { label:'주식·투자', val:sm.investmentTotal, color:'#d97706' },
    { label:'저축',   val:sm.savings,        color:'#16a34a' },
    { label:'현금',   val:sm.cash,           color:'#8b5cf6' },
  ];
  donutInst = new Chart(document.getElementById('donutChart').getContext('2d'), {
    type:'doughnut',
    data:{ labels:dd.map(d=>d.label), datasets:[{ data:dd.map(d=>d.val), backgroundColor:dd.map(d=>d.color), borderWidth:3, borderColor:'#ffffff', hoverOffset:6 }] },
    options:{
      responsive:true, maintainAspectRatio:false, cutout:'68%',
      plugins:{ legend:{display:false},
        tooltip:{ backgroundColor:CLR.tip.bg, borderColor:CLR.tip.border, borderWidth:1, titleColor:CLR.tip.title, bodyColor:CLR.tip.body,
          callbacks:{ label:c=>`  ${c.label}: ${(c.raw/1e8).toFixed(3)}억 (${(c.raw/sm.totalAssets*100).toFixed(1)}%)` } }
      }
    }
  });
  document.getElementById('donutLegend').innerHTML = dd.map(d =>
    `<span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#4a789e;background:#f4f9ff;border:1px solid rgba(100,160,240,0.2);border-radius:7px;padding:4px 10px;"><span class="dot" style="background:${d.color}"></span>${d.label} ${(d.val/sm.totalAssets*100).toFixed(1)}%</span>`
  ).join('');

  // ── Investment Table
  const invs = s.investments;
  const totalEval = invs.reduce((a,x)=>a+x.eval,0);
  const totalCost = invs.reduce((a,x)=>a+x.cost,0);
  const _badge = (pos) => pos
    ? 'display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(22,163,74,0.12);color:#16a34a;'
    : 'display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(220,38,38,0.1);color:#dc2626;';
  const _blueB = 'display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(37,116,228,0.1);color:#2574e4;';
  const _td = 'padding:11px 12px;border-bottom:1px solid rgba(100,160,240,0.1);vertical-align:middle;';
  document.getElementById('invTable').innerHTML = invs.map(inv => {
    const pnl = inv.eval-inv.cost, pos = pnl>=0;
    const w = (inv.eval/totalEval*100).toFixed(1);
    return `<tr>
      <td style="${_td}color:#0d1e3a;"><strong>${inv.name}</strong></td>
      <td style="${_td}"><span style="${_blueB}">${inv.broker}</span></td>
      <td style="${_td}text-align:right;color:#4a789e;font-variant-numeric:tabular-nums;">${inv.cost.toLocaleString()}</td>
      <td style="${_td}text-align:right;font-variant-numeric:tabular-nums;"><strong style="color:#2574e4">${inv.eval.toLocaleString()}</strong></td>
      <td style="${_td}text-align:right;font-variant-numeric:tabular-nums;"><span style="color:${pos?'#16a34a':'#dc2626'}">${pnl>=0?'+':''}${Math.round(pnl).toLocaleString()}</span></td>
      <td style="${_td}text-align:right;"><span style="${_badge(pos)}">${fmtPct(inv.rate)}</span></td>
      <td style="${_td}"><div style="display:flex;align-items:center;gap:8px;"><div style="flex:1;height:5px;background:rgba(100,160,240,0.15);border-radius:99px;overflow:hidden;"><div style="height:100%;width:${w}%;background:${pos?'#16a34a':'#dc2626'};border-radius:99px;"></div></div><span style="font-size:11px;min-width:38px;text-align:right;color:#0d1e3a;">${w}%</span></div></td>
    </tr>`;
  }).join('');

  const totalGain = totalEval-totalCost;
  const totalRate = totalCost>0?totalGain/totalCost*100:0;
  const gp = totalGain>=0;
  document.getElementById('invTotalCost').textContent = totalCost.toLocaleString();
  document.getElementById('invTotalEval').textContent = totalEval.toLocaleString();
  document.getElementById('invTotalGain').innerHTML = `<span style="color:${gp?'#16a34a':'#dc2626'}">${totalGain>=0?'+':''}${Math.round(totalGain).toLocaleString()}</span>`;
  document.getElementById('invTotalRate').innerHTML = `<span style="${_badge(gp)}">${fmtPct(totalRate)}</span>`;

  // ── Top 5 Bar Chart
  const top5 = [...invs].sort((a,b)=>b.eval-a.eval).slice(0,5);
  if (topBarInst) topBarInst.destroy();
  topBarInst = new Chart(document.getElementById('top5Chart').getContext('2d'), {
    type:'bar',
    data:{
      labels:top5.map(x=>x.name),
      datasets:[{ label:'평가금액', data:top5.map(x=>x.eval),
        backgroundColor:top5.map(x=>x.eval-x.cost>=0?'rgba(37,116,228,0.75)':'rgba(220,38,38,0.65)'),
        borderRadius:6, borderSkipped:false }]
    },
    options:{
      indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false},
        tooltip:{ backgroundColor:CLR.tip.bg, borderColor:CLR.tip.border, borderWidth:1, titleColor:CLR.tip.title, bodyColor:CLR.tip.body,
          callbacks:{ label:c=>{ const inv=top5[c.dataIndex]; return [` 평가액: ${c.raw.toLocaleString()}원`,` 수익률: ${fmtPct(inv.rate)}`]; } } }
      },
      scales:{
        x:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, font:{size:10}, callback:v=>(v/1e8).toFixed(2)+'억'} },
        y:{ grid:{display:false}, ticks:{color:'#0d1e3a', font:{size:12, weight:'600'}} }
      }
    }
  });

  // ── AI Opinion (personalized: 만31세, work 2023-01-01, goal 5억 2027-02)
  const sortedEval = [...invs].sort((a,b)=>b.eval-a.eval);
  const top = sortedEval[0];
  const topW = totalEval>0?(top.eval/totalEval*100):0;
  const worst = [...invs].sort((a,b)=>a.rate-b.rate)[0];
  const best  = [...invs].sort((a,b)=>b.rate-a.rate)[0];
  const conc  = topW>=50;
  const loss  = worst&&worst.rate<-30;

  const workStart = new Date('2023-01-01');
  const snapDt    = new Date(s.snapshotDate);
  const workDays  = Math.floor((snapDt - workStart) / (1000*60*60*24));
  const workYrs   = Math.floor(workDays / 365);
  const workRemMs = Math.floor((workDays % 365) / 30);
  const goalPctNum = sm.netWorth / data.goal.target * 100;
  const deadlineDt = new Date(data.goal.deadline);
  const remainMos  = Math.max(0, Math.round((deadlineDt - snapDt) / (1000*60*60*24*30.5)));
  const monthlyNeedGoal = remainMos > 0 ? Math.round((data.goal.target - sm.netWorth) / remainMos) : 0;
  const firstSnap = data.snapshots[0];
  const firstDt   = new Date(firstSnap.snapshotDate);
  const elapsedMos = Math.max(1, Math.round((snapDt - firstDt) / (1000*60*60*24*30.5)));
  const avgMonthlyGrowth = idx > 0 ? Math.round((sm.netWorth - firstSnap.summary.netWorth) / elapsedMos) : 0;

  let encourageMsg;
  if (goalPctNum >= 70) {
    encourageMsg = `목표의 ${goalPctNum.toFixed(1)}% 달성! 🚀 만 31세, 투자 경력 ${workYrs}년 ${workRemMs}개월 만에 이룬 놀라운 성과입니다. 이 페이스라면 목표 기간보다 빠른 달성도 충분히 가능합니다. 지금의 기여도를 유지하면서 리스크 관리에 집중하세요.`;
  } else if (goalPctNum >= 50) {
    encourageMsg = `목표 절반을 돌파했습니다! 만 31세에 이 수준의 자산 형성 속도는 동세대 상위권입니다. 월 평균 ${fmt(avgMonthlyGrowth)}씩 성장 중 — 현 페이스를 유지하면 목표가 충분히 가능합니다.`;
  } else if (goalPctNum >= 30) {
    encourageMsg = `투자 ${workYrs}년 ${workRemMs}개월 차, 착실한 자산 성장 중입니다. 현재 월 평균 ${fmt(avgMonthlyGrowth)} 성장 — 목표 달성을 위해 월 ${fmt(monthlyNeedGoal)}의 자산 증가가 필요합니다. 꾸준함이 최대의 무기입니다.`;
  } else {
    encourageMsg = `${workYrs}년 ${workRemMs}개월 동안 꾸준히 자산을 쌓아왔습니다. 투자는 복리의 게임입니다. 지금의 포트폴리오가 미래 5억의 기반이 됩니다.`;
  }

  let riskMsg;
  if (conc && loss) {
    riskMsg = `${top.name} 집중(${topW.toFixed(1)}%) + ${worst.name} 깊은 손실(${fmtPct(worst.rate)}) 동시 발생 — 분산 확대 및 손절 기준 재정비 시급`;
  } else if (conc) {
    riskMsg = `${top.name} 비중 ${topW.toFixed(1)}% — 단일 종목 집중 리스크. 반도체 사이클 변동성 주시 권장`;
  } else if (loss) {
    riskMsg = `${worst.name} 손실 ${fmtPct(worst.rate)} — 추가 매수 전 실적 확인 필수. 손절 기준 사전 설정 권장`;
  } else {
    riskMsg = `리스크 적정 수준. 최고 수익 ${best?best.name+' '+fmtPct(best.rate):''} — 정기 리밸런싱으로 목표 비중 유지`;
  }

  const investDir = sm.investmentGainRate >= 0
    ? `+${sm.investmentGainRate.toFixed(2)}% 수익 — 원금 ${fmt(sm.investmentCost)} → 평가 ${fmt(sm.investmentTotal)} (+${fmt(sm.investmentGain)})`
    : `${sm.investmentGainRate.toFixed(2)}% 손실 — 원금 ${fmt(sm.investmentCost)} → 평가 ${fmt(sm.investmentTotal)} (${fmt(sm.investmentGain)})`;

  const onPace = avgMonthlyGrowth >= monthlyNeedGoal;

  const _aiRow = (lbl, val, color) =>
    `<div style="display:flex;gap:8px;margin-bottom:9px;font-size:12px;"><span style="color:#7a9fb8;min-width:100px;font-weight:700;flex-shrink:0;">${lbl}</span><span style="color:${color};flex:1;line-height:1.5;">${val}</span></div>`;
  document.getElementById('aiOpinion').innerHTML = `
    <div style="font-size:12px;font-weight:700;color:#2574e4;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:6px;"><span>🤖</span>AI 투자 의견 · ${s.snapshotDate} 기준</div>
    ${_aiRow('투자 경력', `${workYrs}년 ${workRemMs}개월 (2023.01 시작, 만 31세)`, '#4a789e')}
    ${_aiRow('목표 달성률', `${goalPctNum.toFixed(1)}% · 잔여 ${remainMos}개월 · 월 ${fmt(monthlyNeedGoal)} 필요`, goalPctNum>=60?'#16a34a':goalPctNum>=40?'#d97706':'#dc2626')}
    ${_aiRow('월 성장 추이', `평균 ${fmt(avgMonthlyGrowth)}/월 ${onPace?'✅ 목표 페이스 이상':'⚠️ 목표 페이스 미달'}`, onPace?'#16a34a':'#d97706')}
    ${_aiRow('투자 현황', investDir, sm.investmentGainRate>=0?'#16a34a':'#dc2626')}
    ${_aiRow('리스크 분석', riskMsg, conc||loss?'#d97706':'#16a34a')}
    <div style="font-size:12px;color:#3d6b98;margin-top:12px;line-height:1.8;border-top:1px solid rgba(100,160,240,0.2);padding-top:12px;">${encourageMsg}</div>
  `;

  // ── Return Chart
  if (returnInst) returnInst.destroy();
  const sorted = [...invs].sort((a,b)=>b.rate-a.rate);
  returnInst = new Chart(document.getElementById('returnChart').getContext('2d'), {
    type:'bar',
    data:{
      labels:sorted.map(x=>x.name),
      datasets:[{ label:'수익률(%)', data:sorted.map(x=>x.rate),
        backgroundColor:sorted.map(x=>x.rate>=0?'rgba(22,163,74,0.75)':'rgba(220,38,38,0.65)'), borderRadius:6 }]
    },
    options:{
      indexAxis:'y', responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false},
        tooltip:{ backgroundColor:CLR.tip.bg, borderColor:CLR.tip.border, borderWidth:1, titleColor:CLR.tip.title, bodyColor:CLR.tip.body,
          callbacks:{ label:c=>`  ${c.raw>0?'+':''}${c.raw.toFixed(1)}%` } }
      },
      scales:{
        x:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, callback:v=>v+'%', font:{size:11}} },
        y:{ grid:{display:false}, ticks:{color:'#4a789e', font:{size:12}} }
      }
    }
  });

  // ── Loan Section
  const loanEl = document.getElementById('loanSection');
  const loanTotal2 = s.loans.reduce((a,l)=>a+l.balance,0);
  loanEl.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.15);border-radius:12px;margin-bottom:16px;">
      <div><div style="font-size:11px;color:#4a789e;font-weight:600">총 대출 잔액</div><div style="font-size:26px;font-weight:900;color:#dc2626">${fmt(loanTotal2)}</div></div>
      <div style="text-align:right"><div style="font-size:11px;color:#4a789e;font-weight:600">월 이자 합계</div><div style="font-size:18px;font-weight:700;color:#dc2626">${Math.round(totalInterest).toLocaleString()}원</div></div>
    </div>
    ${s.loans.map(l => {
      const repaid = l.principal-l.balance;
      const repaidPct = (repaid/l.principal*100).toFixed(1);
      const monthInt  = Math.round(l.balance*(l.rate||0)/100/12);
      return `<div style="background:#f4f9ff;border:1px solid rgba(100,160,240,0.2);border-radius:12px;padding:16px 20px;margin-bottom:12px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
          <div>
            <div style="font-weight:700;font-size:14px;color:#0d1e3a;">${l.name.slice(0,20)}${l.name.length>20?'…':''}</div>
            <div style="font-size:11px;color:#4a789e;margin-top:2px;">${l.bank} · ${l.type}</div>
          </div>
          <div style="font-size:20px;font-weight:900;color:#dc2626;">${fmt(l.balance)}</div>
        </div>
        <div style="display:flex;gap:16px;font-size:12px;color:#4a789e;margin:8px 0;flex-wrap:wrap;">
          <span>원금: <strong style="color:#0d1e3a;">${fmt(l.principal)}</strong></span>
          ${l.rate?`<span style="color:#d97706;font-weight:700">금리 ${l.rate}%</span>`:''}
          ${l.maturityDate?`<span>만기 <strong style="color:#d97706">${l.maturityDate}</strong></span>`:''}
        </div>
        <div style="font-size:12px;color:#4a789e;">월 이자: <strong style="color:#dc2626">${monthInt.toLocaleString()}원</strong></div>
        <div style="height:5px;margin-top:8px;background:rgba(100,160,240,0.15);border-radius:99px;overflow:hidden;"><div style="height:100%;width:${100-parseFloat(repaidPct)}%;background:#dc2626;border-radius:99px;"></div></div>
        <div style="font-size:11px;color:#4a789e;margin-top:4px;">상환 진행 ${repaidPct}% (${fmt(repaid)} 상환)</div>
      </div>`;
    }).join('')}
  `;

  // ── Snapshot Comparison
  buildSnapCmp();

  // ── Growth Chart (all snapshots)
  if (growthInst) growthInst.destroy();
  growthInst = new Chart(document.getElementById('growthChart').getContext('2d'), {
    type:'bar',
    data:{
      labels:data.snapshots.map(ss=>ss.snapshotDate),
      datasets:[
        { label:'순자산',    data:data.snapshots.map(ss=>ss.summary.netWorth),        backgroundColor:'rgba(22,163,74,0.7)',   borderRadius:5, borderSkipped:false },
        { label:'총자산',    data:data.snapshots.map(ss=>ss.summary.totalAssets),     backgroundColor:'rgba(37,116,228,0.55)', borderRadius:5, borderSkipped:false },
        { label:'투자 평가', data:data.snapshots.map(ss=>ss.summary.investmentTotal), backgroundColor:'rgba(217,119,6,0.7)',   borderRadius:5, borderSkipped:false },
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{ labels:{ color:CLR.tick, font:{size:11}, boxWidth:10, padding:14 } },
        tooltip:{ backgroundColor:CLR.tip.bg, borderColor:CLR.tip.border, borderWidth:1, titleColor:CLR.tip.title, bodyColor:CLR.tip.body,
          callbacks:{ label:c=>` ${c.dataset.label}: ${(c.raw/1e8).toFixed(3)}억원` } }
      },
      scales:{
        x:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, font:{size:11}} },
        y:{ grid:{color:CLR.grid}, ticks:{color:CLR.tick, font:{size:11}, callback:v=>(v/1e8).toFixed(1)+'억'} }
      }
    }
  });
}

// ── Snapshot Comparison Panel ─────────────────────
function buildSnapCmp() {
  const btnsEl  = document.getElementById('cmpBtns');
  const panelEl = document.getElementById('cmpPanel');

  if (data.snapshots.length < 2) {
    panelEl.innerHTML = '<div style="color:#7a9fb8;font-size:13px;text-align:center;padding:20px;">비교할 데이터가 없습니다.</div>';
    btnsEl.innerHTML  = '';
    return;
  }

  if (cmpFromIdx === curIdx || cmpFromIdx >= data.snapshots.length) {
    cmpFromIdx = curIdx > 0 ? 0 : 1;
  }

  // Buttons — all inline styles, no CSS class dependency
  const _btnBase = 'padding:6px 14px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;border:1px solid;transition:all .18s;';
  btnsEl.innerHTML = data.snapshots.map((ss, i) => {
    if (i === curIdx) return '';
    const act = i === cmpFromIdx;
    const st = act
      ? _btnBase + 'color:#fff;background:#2574e4;border-color:#2574e4;box-shadow:0 2px 8px rgba(37,116,228,0.25);'
      : _btnBase + 'color:#4a789e;background:#fff;border-color:rgba(100,160,240,0.3);';
    return `<button style="${st}" onclick="setCmpFrom(${i})">${ss.snapshotDate}</button>`;
  }).join('');

  const from = data.snapshots[cmpFromIdx];
  const to   = data.snapshots[curIdx];
  const nwD  = to.summary.netWorth        - from.summary.netWorth;
  const taD  = to.summary.totalAssets     - from.summary.totalAssets;
  const tdD  = to.summary.totalDebt       - from.summary.totalDebt;
  const invD = to.summary.investmentTotal - from.summary.investmentTotal;
  const nwPct = from.summary.netWorth > 0 ? nwD/from.summary.netWorth*100 : 0;

  const _dc = v => v >= 0 ? '#16a34a' : '#dc2626';
  const _ds = v => v >= 0 ? '+' : '';

  const _metCard = (label, fromV, toV, diff, invertGood) => {
    const c = invertGood ? _dc(-diff) : _dc(diff);
    return `<div style="background:#f4f9ff;border:1px solid rgba(100,160,240,0.2);border-radius:10px;padding:14px;">
      <div style="font-size:10px;color:#7a9fb8;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;margin-bottom:8px;">${label}</div>
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <span style="font-size:13px;color:#4a789e;">${fmt(fromV)}</span>
        <span style="color:#7a9fb8;font-size:11px;">→</span>
        <span style="font-size:13px;font-weight:700;color:#0d1e3a;">${fmt(toV)}</span>
        <span style="font-size:12px;font-weight:800;margin-left:auto;color:${c}">${_ds(diff)}${fmt(diff)}</span>
      </div>
    </div>`;
  };

  panelEl.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;padding:22px;background:#f4f9ff;border-radius:14px;border:1px solid rgba(100,160,240,0.22);margin-bottom:12px;">
      <div>
        <div style="font-size:10px;color:#7a9fb8;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:6px;">기준 스냅샷</div>
        <div style="font-size:26px;font-weight:900;color:#0d1e3a;letter-spacing:-0.5px;">${fmt(from.summary.netWorth)}</div>
        <div style="font-size:12px;color:#4a789e;margin-top:5px;">${from.snapshotDate}</div>
        <div style="font-size:12px;color:#4a789e;">총자산 ${fmt(from.summary.totalAssets)}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:0 8px;">
        <span style="font-size:22px;color:#2574e4;">→</span>
        <div style="font-size:15px;font-weight:800;color:${_dc(nwD)}">${_ds(nwD)}${fmt(nwD)}</div>
        <div style="font-size:11px;font-weight:700;color:${_dc(nwD)}">(${_ds(nwPct)}${nwPct.toFixed(1)}%)</div>
      </div>
      <div>
        <div style="font-size:10px;color:#7a9fb8;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:6px;display:flex;align-items:center;gap:6px;">현재 선택 <span style="background:#2574e4;color:#fff;font-size:9px;padding:1px 7px;border-radius:4px;">NOW</span></div>
        <div style="font-size:26px;font-weight:900;color:#2574e4;letter-spacing:-0.5px;">${fmt(to.summary.netWorth)}</div>
        <div style="font-size:12px;color:#4a789e;margin-top:5px;">${to.snapshotDate}</div>
        <div style="font-size:12px;color:#4a789e;">총자산 ${fmt(to.summary.totalAssets)}</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      ${_metCard('총자산',    from.summary.totalAssets,     to.summary.totalAssets,     taD,  false)}
      ${_metCard('순자산',    from.summary.netWorth,        to.summary.netWorth,        nwD,  false)}
      ${_metCard('총부채',    from.summary.totalDebt,       to.summary.totalDebt,       tdD,  true)}
      ${_metCard('투자 평가', from.summary.investmentTotal, to.summary.investmentTotal, invD, false)}
    </div>
  `;
}

window.toggleDateDropdown = function() {
  const dd = document.getElementById('dateDropdown');
  if (!dd) return;
  dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
};

window.selectDate = function(i) {
  curIdx = i;
  if (cmpFromIdx === curIdx) {
    cmpFromIdx = curIdx > 0 ? 0 : (data.snapshots.length > 1 ? 1 : 0);
  }
  buildTabs();
  render(i);
};

window.setCmpFrom = function(i) {
  cmpFromIdx = i;
  buildSnapCmp();
};

if (sessionStorage.getItem(SESSION_KEY) === '1') init();
</script>
</BaseLayout>
