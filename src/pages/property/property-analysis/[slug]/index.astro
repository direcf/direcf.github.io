---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const files = import.meta.glob('../../../../data/properties/*.json', { eager: true });
  const distFiles = import.meta.glob('../../../../data/districts/*.json', { eager: true });
  const allDist: Record<string, any> = {};
  for (const [path, mod] of Object.entries(distFiles)) {
    const s = path.match(/\/(\w+)\.json$/)?.[1];
    if (s) allDist[s] = (mod as any).default || mod;
  }
  return (Object.entries(files) as [string, any][]).map(([path, mod]) => {
    const slug = path.match(/\/(\w[\w-]*)\.json$/)?.[1] || '';
    const p = (mod as any).default || mod;
    return { params: { slug }, props: { p, districtInfo: allDist[p.district] || null } };
  });
}

const { p, districtInfo } = Astro.props;

function gradeBg(g: string) {
  const u = (g || '').toUpperCase();
  if (u.startsWith('S')) return { bg:'rgba(167,139,250,.12)', border:'rgba(167,139,250,.3)', text:'#c4b5fd' };
  if (u.startsWith('A')) return { bg:'rgba(52,211,153,.1)',  border:'rgba(52,211,153,.3)',  text:'#6ee7b7' };
  if (u.startsWith('B')) return { bg:'rgba(79,195,247,.1)',  border:'rgba(79,195,247,.25)', text:'#7dd8ff' };
  if (u.startsWith('C')) return { bg:'rgba(251,191,36,.1)',  border:'rgba(251,191,36,.25)', text:'#fbbf24' };
  return { bg:'rgba(248,113,113,.1)', border:'rgba(248,113,113,.25)', text:'#fca5a5' };
}

function scoreColor(s: number) {
  if (s >= 5) return '#4fc3f7';
  if (s >= 4) return '#34d399';
  if (s >= 3) return '#fbbf24';
  return '#f87171';
}

// 지역 연동: 구 단지 비교
function parseAeokLocal(s: string | null | undefined): number | null {
  if (!s || s === '—') return null;
  const v = parseFloat(String(s).replace('억', ''));
  return isNaN(v) ? null : v;
}
const distComplexes = districtInfo
  ? (districtInfo.complexAnalysis || []).map((c: any) => {
      const sale = parseAeokLocal(c.sale);
      const lease = parseAeokLocal(c.lease);
      const gap = (sale && lease) ? +(sale - lease).toFixed(2) : null;
      const rate = (sale && lease) ? Math.round(lease / sale * 100) : null;
      return { ...c, saleNum: sale, leaseNum: lease, gap, rate };
    })
  : [];
const sortedDistPlans = districtInfo
  ? [...(districtInfo.developmentPlans || [])].sort((a: any, b: any) => (a.year || 9999) - (b.year || 9999)).slice(0, 4)
  : [];
const supply3yr = districtInfo?.quickStats?.supply3yr ?? null;
const supplyColor = (supply3yr !== null && supply3yr < 1000) ? '#f87171' : '#4fc3f7';
const incomeRank = districtInfo?.quickStats?.incomeRankAddress ?? null;

const gapRateNum = p.gapRate || 0;
const gapBarFill = Math.min(gapRateNum, 100);
const districtHref = p.district === 'dongdaemun'
  ? '/property/region-analysis/dongdaemun/'
  : `/property/region-analysis/${p.district}/`;
---

<BaseLayout
  title={`${p.name} 분석 보고서`}
  activeSlug="property"
  crumbs={[
    {label:"Personal"},
    {label:"Property",href:"/property/"},
    {label:"매물 분석",href:"/property/property-analysis/"},
    {label:p.name}
  ]}
>

<style>
:root {
  /* 사이트 테마 변수에 연결 — light/dark 자동 추종 */
  --fb-bg:    var(--bg);
  --fb-card:  var(--bg-card);
  --fb-card2: var(--bg-soft);
  --fb-border: var(--border);
  --fb-border2: rgba(79,195,247,0.22);
  --fb-glow:  rgba(79,195,247,0.07);
  --fb-400:   #4fc3f7;
  /* light 기본값 — dark 모드에서 is:global이 덮어씀 */
  --fb-300:   var(--accent-2);
  --fb-200:   var(--text-2);
  --fb-100:   var(--text);
  --fb-muted: var(--muted);
  --fb-text:  var(--text-2);
  --fb-up:    #059669;
  --fb-dn:    #dc2626;
  --fb-gold:  #b45309;
  /* surface tokens */
  --fb-hero-bg:    var(--bg-soft);
  --fb-kpi-bg:     var(--bg);
  --fb-verdict-bg: var(--bg-soft);
}
/* ── LOCK ────────────────────────────────────────────────────── */
#lockScreen{position:fixed;inset:0;z-index:9999;
  background:radial-gradient(ellipse at 25% 35%,rgba(30,58,138,.45),transparent 55%),
             radial-gradient(ellipse at 75% 70%,rgba(15,30,70,.4),transparent 55%),
             #0b1220;
  display:flex;align-items:center;justify-content:center;}
.lock-grid{position:absolute;inset:0;
  background-image:linear-gradient(rgba(79,195,247,.025) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(79,195,247,.025) 1px,transparent 1px);
  background-size:48px 48px;pointer-events:none;}
.lock-card{position:relative;z-index:1;width:380px;
  background:rgba(13,20,40,.96);border:1px solid var(--fb-border2);
  border-radius:24px;padding:52px 44px 44px;text-align:center;
  backdrop-filter:blur(32px);-webkit-backdrop-filter:blur(32px);
  box-shadow:0 0 80px rgba(79,195,247,.08),0 24px 80px rgba(0,0,0,.65);}
.lock-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(79,195,247,.6),transparent);border-radius:24px 24px 0 0;}
.lock-logo{width:64px;height:64px;margin:0 auto 24px;border-radius:50%;
  background:rgba(79,195,247,.08);border:1px solid rgba(79,195,247,.2);
  display:flex;align-items:center;justify-content:center;font-size:26px;}
.lock-title{font-size:12px;font-weight:800;letter-spacing:.3em;color:var(--fb-200);text-transform:uppercase;margin-bottom:5px;}
.lock-sub{font-size:12px;color:var(--fb-muted);margin-bottom:36px;}
.lock-input{width:100%;padding:14px 4px;background:transparent;border:none;
  border-bottom:1px solid rgba(255,255,255,.12);color:var(--fb-100);
  font-size:20px;text-align:center;letter-spacing:6px;outline:none;
  transition:border-color .2s;caret-color:var(--fb-400);font-family:inherit;}
.lock-input:focus{border-bottom-color:var(--fb-400);}
.lock-input::placeholder{color:rgba(74,122,154,.5);letter-spacing:4px;font-size:16px;}
.lock-btn{width:100%;margin-top:24px;padding:14px;
  background:linear-gradient(135deg,rgba(79,195,247,.2),rgba(29,78,216,.25));
  border:1px solid var(--fb-border2);border-radius:12px;
  color:var(--fb-200);font-size:14px;font-weight:700;cursor:pointer;
  letter-spacing:.05em;transition:all .2s;font-family:inherit;}
.lock-btn:hover{background:linear-gradient(135deg,rgba(79,195,247,.3),rgba(29,78,216,.35));
  border-color:var(--fb-400);color:var(--fb-100);}
.lock-err{font-size:12px;color:#f87171;margin-top:12px;min-height:18px;}
.lock-hint{font-size:10px;color:#2a4a5e;margin-top:20px;letter-spacing:.1em;}

/* ── ROOT ───────────────────────────────────────────────────── */
#dashboard{display:none;}
#prop-root{background:var(--fb-bg);min-height:100vh;padding:28px 32px 80px;}

/* ── BACK BTN ───────────────────────────────────────────────── */
.back-btn{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;
  color:var(--fb-muted);text-decoration:none;padding:7px 14px;
  background:var(--fb-card);border:1px solid var(--fb-border);border-radius:10px;
  transition:all .15s;margin-bottom:20px;}
.back-btn:hover{color:var(--fb-300);border-color:var(--fb-border2);}

/* ── HERO ───────────────────────────────────────────────────── */
.hero{position:relative;border-radius:20px;padding:36px 36px 32px;margin-bottom:20px;overflow:hidden;
  background:var(--fb-hero-bg);
  border:1px solid var(--fb-border2);}
.hero::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,var(--fb-400),rgba(79,195,247,.3),transparent);}
.hero-orb1{position:absolute;top:-60px;right:-60px;width:280px;height:280px;
  background:radial-gradient(circle,rgba(79,195,247,.07),transparent 65%);border-radius:50%;pointer-events:none;}
.hero-orb2{position:absolute;bottom:-80px;right:200px;width:200px;height:200px;
  background:radial-gradient(circle,rgba(29,78,216,.06),transparent 65%);border-radius:50%;pointer-events:none;}
.hero-eyebrow{font-size:10px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;
  color:var(--fb-muted);margin-bottom:12px;}
.hero-title{font-size:34px;font-weight:900;letter-spacing:-1.5px;color:var(--fb-100);margin-bottom:4px;}
.hero-sub{font-size:14px;color:var(--fb-muted);margin-bottom:18px;}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;}
.hero-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 12px;
  background:rgba(79,195,247,.08);border:1px solid var(--fb-border);border-radius:20px;
  font-size:11px;color:var(--fb-text);}
.hero-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
@media(max-width:860px){.hero-kpis{grid-template-columns:repeat(2,1fr);}}
.hero-kpi{background:var(--fb-kpi-bg);border:1px solid var(--fb-border);border-radius:14px;padding:16px 18px;}
.hero-kpi-label{font-size:9px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--fb-muted);margin-bottom:8px;}
.hero-kpi-val{font-size:22px;font-weight:900;letter-spacing:-1px;color:var(--fb-100);font-variant-numeric:tabular-nums;}
.hero-kpi-sub{font-size:11px;color:var(--fb-muted);margin-top:3px;}

/* ── SECTION ────────────────────────────────────────────────── */
.section-grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.section-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px;}
@media(max-width:900px){.section-grid2,.section-grid3{grid-template-columns:1fr;}}
.section-grid-60-40{display:grid;grid-template-columns:3fr 2fr;gap:16px;margin-bottom:16px;}
@media(max-width:900px){.section-grid-60-40{grid-template-columns:1fr;}}

.card{background:var(--fb-card);border:1px solid var(--fb-border);border-radius:18px;padding:24px;
  position:relative;overflow:hidden;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);}
.card-accent{position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--fb-400),rgba(79,195,247,0));}
.card-label{font-size:9px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--fb-muted);margin-bottom:14px;}
.card-title{font-size:15px;font-weight:800;color:var(--fb-200);margin-bottom:16px;}

/* ── CHART ──────────────────────────────────────────────────── */
.chart-wrap{position:relative;height:220px;width:100%;}
.chart-wrap canvas{max-height:220px;}

/* ── LOCATION ITEMS ─────────────────────────────────────────── */
.loc-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--fb-border);}
.loc-item:last-child{border-bottom:none;padding-bottom:0;}
.loc-grade{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:800;flex-shrink:0;border:1.5px solid;}
.loc-cat{font-size:10px;font-weight:700;letter-spacing:.05em;color:var(--fb-muted);margin-bottom:3px;}
.loc-desc{font-size:12px;color:var(--fb-text);line-height:1.6;}

/* ── PROS / CONS ────────────────────────────────────────────── */
.pro-con-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:800px){.pro-con-grid{grid-template-columns:1fr;}}
.pro-list,.con-list{list-style:none;}
.pro-list li,.con-list li{display:flex;align-items:flex-start;gap:10px;
  padding:10px 0;border-bottom:1px solid var(--fb-border);font-size:12px;line-height:1.6;}
.pro-list li:last-child,.con-list li:last-child{border-bottom:none;padding-bottom:0;}
.pro-dot{width:18px;height:18px;border-radius:50%;background:rgba(52,211,153,.15);
  border:1px solid rgba(52,211,153,.3);color:#34d399;
  display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0;margin-top:1px;}
.con-dot{width:18px;height:18px;border-radius:50%;background:rgba(248,113,113,.12);
  border:1px solid rgba(248,113,113,.3);color:#f87171;
  display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0;margin-top:1px;}

/* ── GAP BAR ────────────────────────────────────────────────── */
.gap-section{display:flex;gap:24px;align-items:stretch;}
@media(max-width:700px){.gap-section{flex-direction:column;}}
.gap-metrics{flex:1;display:flex;flex-direction:column;gap:14px;}
.gap-metric-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;
  border-bottom:1px solid var(--fb-border);}
.gap-metric-row:last-child{border-bottom:none;}
.gap-metric-label{font-size:11px;color:var(--fb-muted);}
.gap-metric-val{font-size:14px;font-weight:700;color:var(--fb-100);}
.gap-bar-wrap{margin-top:14px;}
.gap-bar-label{display:flex;justify-content:space-between;font-size:10px;color:var(--fb-muted);margin-bottom:6px;}
.gap-bar-bg{height:10px;background:rgba(255,255,255,.05);border-radius:5px;overflow:hidden;}
.gap-bar-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--fb-400),rgba(79,195,247,.4));
  transition:width 1.2s cubic-bezier(.16,1,.3,1);}
.gap-verdict{font-size:12px;color:var(--fb-text);line-height:1.7;
  background:rgba(79,195,247,.05);border:1px solid var(--fb-border);
  border-radius:12px;padding:14px 16px;margin-top:14px;}

/* ── EXPERT VERDICT ─────────────────────────────────────────── */
.verdict-box{position:relative;padding:28px 28px 28px 36px;
  background:var(--fb-verdict-bg);
  border:1px solid var(--fb-border2);border-radius:18px;overflow:hidden;}
.verdict-box::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(180deg,var(--fb-400),rgba(79,195,247,.2));}
.verdict-box::after{content:'EXPERT VERDICT';position:absolute;top:16px;right:20px;
  font-size:8px;font-weight:800;letter-spacing:2px;color:rgba(79,195,247,.2);}
.verdict-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;
  background:rgba(79,195,247,.1);border:1px solid var(--fb-border2);
  border-radius:20px;font-size:10px;font-weight:700;color:var(--fb-400);
  letter-spacing:.08em;margin-bottom:14px;}
.verdict-text{font-size:13px;line-height:1.8;color:var(--fb-text);}
.verdict-text strong{color:var(--fb-200);}

/* ── DISTRICT LINK ──────────────────────────────────────────── */
.district-link{display:flex;align-items:center;justify-content:space-between;
  padding:20px 24px;background:var(--fb-card);border:1px solid var(--fb-border2);
  border-radius:16px;text-decoration:none;transition:all .2s;margin-bottom:16px;}
.district-link:hover{background:rgba(79,195,247,.07);border-color:var(--fb-400);
  box-shadow:0 0 24px rgba(79,195,247,.1);}
.district-link-left{display:flex;align-items:center;gap:14px;}
.district-link-icon{width:44px;height:44px;border-radius:12px;
  background:rgba(79,195,247,.1);border:1px solid var(--fb-border2);
  display:flex;align-items:center;justify-content:center;font-size:20px;}
.district-link-label{font-size:10px;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;color:var(--fb-muted);margin-bottom:3px;}
.district-link-name{font-size:15px;font-weight:800;color:var(--fb-200);}
.district-link-arrow{font-size:18px;color:var(--fb-400);}

/* ── INFO GRID ──────────────────────────────────────────────── */
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;
  border:1px solid var(--fb-border);border-radius:14px;overflow:hidden;}
@media(max-width:700px){.info-grid{grid-template-columns:1fr;}}
.info-cell{padding:14px 16px;border-right:1px solid var(--fb-border);border-bottom:1px solid var(--fb-border);}
.info-cell:nth-child(3n){border-right:none;}
.info-cell:nth-last-child(-n+3){border-bottom:none;}
@media(max-width:700px){.info-cell{border-right:none;}}
.info-cell-label{font-size:9px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;
  color:var(--fb-muted);margin-bottom:5px;}
.info-cell-val{font-size:13px;font-weight:700;color:var(--fb-200);}

/* ── RADAR WRAP ─────────────────────────────────────────────── */
.radar-wrap{position:relative;height:240px;display:flex;align-items:center;justify-content:center;}
.radar-wrap canvas{max-height:240px;max-width:100%;}

/* ── HOGA TABLE ─────────────────────────────────────────────── */
.hoga-table{width:100%;border-collapse:collapse;margin-top:4px;}
.hoga-table thead th{
  padding:10px 14px;text-align:left;
  font-size:9px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;
  color:var(--fb-muted);border-bottom:1px solid var(--fb-border);
  background:rgba(42,53,80,0.3);white-space:nowrap;}
.hoga-table thead th:first-child{border-radius:8px 0 0 0;}
.hoga-table thead th:last-child{border-radius:0 8px 0 0;text-align:center;}
.hoga-table tbody tr{border-bottom:1px solid rgba(42,53,80,0.6);transition:background .12s;}
.hoga-table tbody tr:last-child{border-bottom:none;}
.hoga-table tbody tr:hover{background:rgba(79,195,247,0.04);}
.hoga-table tbody tr.main-row{background:rgba(79,195,247,0.05);}
.hoga-table tbody tr.main-row:hover{background:rgba(79,195,247,0.09);}
.hoga-table td{padding:13px 14px;font-size:12px;color:var(--fb-text);vertical-align:middle;}
.hoga-size{font-size:13px;font-weight:800;color:var(--fb-200);}
.hoga-sqm{font-size:10px;color:var(--fb-muted);margin-top:2px;}
.hoga-range{font-size:13px;font-weight:700;color:var(--fb-100);font-variant-numeric:tabular-nums;}
.hoga-range-sub{font-size:11px;color:var(--fb-muted);margin-top:2px;}
.hoga-main-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;
  background:rgba(79,195,247,0.12);border:1px solid rgba(79,195,247,0.25);
  border-radius:20px;font-size:9px;font-weight:700;color:var(--fb-400);
  letter-spacing:.05em;white-space:nowrap;}
.hoga-note-cell{text-align:center;font-size:11px;color:var(--fb-muted);}
</style>

<!-- Property data for client-side chart init -->
<div id="propDataEl" data-json={JSON.stringify(p)} style="display:none;"></div>

<div id="prop-root">

<!-- LOCK -->
<div id="lockScreen">
  <div class="lock-grid"></div>
  <div class="lock-card">
    <div class="lock-logo">🔐</div>
    <div class="lock-title">Private — Property</div>
    <div class="lock-sub">매물 분석에 접근하려면 비밀번호를 입력하세요.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / property</div>
  </div>
</div>

<!-- DASHBOARD -->
<div id="dashboard">

  <!-- Back -->
  <a class="back-btn" href="/property/property-analysis/">← 매물 목록</a>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-orb1"></div>
    <div class="hero-orb2"></div>
    <div class="hero-eyebrow">
      {p.districtName} · {p.neighborhood} · {p.completionYear}년 준공 ({p.age}년차)
    </div>
    <div class="hero-title">{p.name}</div>
    <div class="hero-sub">{p.address}</div>
    <div class="hero-meta">
      {(p.tags || []).map((t: string) => (
        <span class="hero-chip">#{t}</span>
      ))}
      <span class="hero-chip">🏢 {p.builder}</span>
      <span class="hero-chip">🚗 {p.parking}</span>
      <span class="hero-chip">🌡 {p.heatType}</span>
      <span class="hero-chip">분석일 {p.analysisDate}</span>
    </div>
    <div class="hero-kpis">
      <div class="hero-kpi">
        <div class="hero-kpi-label">매매가</div>
        <div class="hero-kpi-val" style="color:var(--fb-100)">{p.salePrice}</div>
        <div class="hero-kpi-sub">{p.mainSize}</div>
      </div>
      <div class="hero-kpi">
        <div class="hero-kpi-label">전세가</div>
        <div class="hero-kpi-val" style="color:var(--fb-300)">{p.leasePrice}</div>
        <div class="hero-kpi-sub">전세가율 {p.gapRate}%</div>
      </div>
      <div class="hero-kpi">
        <div class="hero-kpi-label">갭 (투자 필요금)</div>
        <div class="hero-kpi-val" style="color:var(--fb-gold)">{p.gap}</div>
        <div class="hero-kpi-sub">{p.gapRate < 55 ? '갭 부담 있음' : '전세가율 양호'}</div>
      </div>
      <div class="hero-kpi">
        <div class="hero-kpi-label">투자점수</div>
        <div class="hero-kpi-val" style={`color:${scoreColor(p.investmentScore)}`}>{p.investmentScore} <span style="font-size:14px;color:var(--fb-muted)">/5</span></div>
