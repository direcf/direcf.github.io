<!-- Script 1: Auth -->
<script is:inline>
const HASH='ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY='prop:auth';
async function sha256(msg){const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(msg));return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');}
async function tryUnlock(){const pw=document.getElementById('pwInput').value;const h=await sha256(pw);if(h===HASH){sessionStorage.setItem(SESSION_KEY,'1');document.getElementById('lockScreen').style.display='none';document.getElementById('dashboard').style.display='block';if(typeof initCharts==='function')initCharts();}else{document.getElementById('pwErr').textContent='비밀번호가 올바르지 않습니다.';document.getElementById('pwInput').value='';}}
document.getElementById('unlockBtn').addEventListener('click',tryUnlock);
document.getElementById('pwInput').addEventListener('keydown',function(e){if(e.key==='Enter')tryUnlock();});
</script>

<!-- Script 2: Chart.js CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<!-- Script 3: Init + session check (theme-aware charts) -->
<script is:inline>
var propData=JSON.parse(document.getElementById('propDataEl').dataset.json);

function initCharts(){
  var dark=document.documentElement.dataset.theme==='dark';
  var cText  =dark?'rgba(200,232,255,.55)':'rgba(15,31,58,.6)';
  var cGrid  =dark?'rgba(79,195,247,.06)' :'rgba(42,53,80,.08)';
  var tipBg  =dark?'rgba(3,12,32,.95)'    :'rgba(255,255,255,.98)';
  var tipBd  =dark?'rgba(79,195,247,.25)' :'rgba(42,53,80,.18)';
  var tipTtl =dark?'#e0f7ff':'#0f1f3a';
  var tipBdy =dark?'#7dd8ff':'#2c3e5d';
  initPriceChart(cText,cGrid,tipBg,tipBd,tipTtl,tipBdy);
  initRadarChart(cText,cGrid,tipBg,tipBd,tipBdy);
}

function initPriceChart(cText,cGrid,tipBg,tipBd,tipTtl,tipBdy){
  var ctx=document.getElementById('priceChart');
  if(!ctx||ctx._chart||typeof Chart==='undefined')return;
  var hist=propData.priceHistory||[];
  var labels=hist.map(function(h){return h.period;});
  var sales =hist.map(function(h){return h.sale;});
  var leases=hist.map(function(h){return h.lease;});
  var gaps  =hist.map(function(h){return +(h.sale-h.lease).toFixed(2);});
  ctx._chart=new Chart(ctx,{
    type:'line',
    data:{labels:labels,datasets:[
      {label:'매매가(억)',data:sales,borderColor:'#4fc3f7',backgroundColor:'rgba(79,195,247,.08)',
       borderWidth:2.5,pointRadius:4,pointBackgroundColor:'#4fc3f7',tension:.35,fill:true},
      {label:'전세가(억)',data:leases,borderColor:'#34d399',backgroundColor:'rgba(52,211,153,.05)',
       borderWidth:2,pointRadius:3,pointBackgroundColor:'#34d399',tension:.35,fill:true},
      {label:'갭(억)',data:gaps,borderColor:'rgba(251,191,36,.7)',backgroundColor:'transparent',
       borderWidth:1.5,pointRadius:2,pointBackgroundColor:'#fbbf24',tension:.35,borderDash:[4,4]}
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{labels:{color:cText,font:{size:11},boxWidth:14,padding:12}},
        tooltip:{backgroundColor:tipBg,borderColor:tipBd,borderWidth:1,
          titleColor:tipTtl,bodyColor:tipBdy,
          callbacks:{label:function(c){return c.dataset.label+': '+c.parsed.y.toFixed(2)+'억';}}}
      },
      scales:{
        x:{grid:{color:cGrid},ticks:{color:cText,font:{size:10}}},
        y:{grid:{color:cGrid},ticks:{color:cText,font:{size:10},callback:function(v){return v+'억';}},beginAtZero:false}
      }
    }
  });
}

function initRadarChart(cText,cGrid,tipBg,tipBd,tipBdy){
  var ctx=document.getElementById('radarChart');
  if(!ctx||ctx._chart||typeof Chart==='undefined')return;
  var ls=propData.locationScore||{};
  var keys=['transport','school','environment','development','reconstruction'];
  var vals=keys.map(function(k){return ls[k]?ls[k].score||0:0;});
  ctx._chart=new Chart(ctx,{
    type:'radar',
    data:{labels:['교통','학군','환경','개발호재','재건축'],datasets:[{
      label:'입지 점수',data:vals,
      borderColor:'rgba(79,195,247,.8)',backgroundColor:'rgba(79,195,247,.08)',
      pointBackgroundColor:'#4fc3f7',pointBorderColor:'transparent',borderWidth:2,pointRadius:4
    }]},
    options:{responsive:true,maintainAspectRatio:false,
      scales:{r:{min:0,max:100,
        grid:{color:cGrid},angleLines:{color:cGrid},
        pointLabels:{color:cText,font:{size:11}},ticks:{display:false,stepSize:25}
      }},
      plugins:{legend:{display:false},
        tooltip:{backgroundColor:tipBg,borderColor:tipBd,borderWidth:1,titleColor:tipBdy,bodyColor:tipBdy}}
    }
  });
}

if(sessionStorage.getItem(SESSION_KEY)==='1'){
  document.getElementById('lockScreen').style.display='none';
  document.getElementById('dashboard').style.display='block';
  requestAnimationFrame(initCharts);
}
</script>

</BaseLayout>
