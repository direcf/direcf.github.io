    <div>
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#818cf8;margin-bottom:4px;">AI ANALYST</div>
      <div style="font-size:15px;font-weight:700;color:#e0e7ff;">내 자산 기반 갭투자 추천 레포트</div>
      <div style="font-size:12px;color:#6366f1;margin-top:2px;">자산현황 연동 · 30개 단지 갭 분석 · 투자 타임라인</div>
    </div>
    <a href="/property/region-analysis/ai-report/" style="display:inline-block;padding:10px 20px;background:#4f46e5;color:#fff;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;flex-shrink:0;white-space:nowrap;">레포트 보기 →</a>
  </div>

  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:24px 20px 28px;box-shadow:var(--shadow-sm);">

    <!-- Legend — 평당 가격 음영 -->
    <div style="margin-bottom:18px;">
      <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin-bottom:8px;">평당 시세 (복합단지 평균) — 밝을수록 저가, 진할수록 고가</div>
      <div style="display:flex;align-items:center;gap:0;height:16px;border-radius:6px;overflow:hidden;width:260px;box-shadow:var(--shadow-sm);">
        {Array.from({length:20}, (_, i) => (
          <div style={`flex:1;height:100%;background:${blueAt(i/19)};`}></div>
        ))}
      </div>
      <div style="display:flex;justify-content:space-between;width:260px;margin-top:4px;">
        <span style="font-size:10px;color:var(--muted);">{minP.toLocaleString()}만</span>
        <span style="font-size:10px;color:var(--muted);">{q1.toLocaleString()}만</span>
        <span style="font-size:10px;color:var(--muted);">{q2.toLocaleString()}만</span>
        <span style="font-size:10px;color:var(--muted);">{q3.toLocaleString()}만</span>
        <span style="font-size:10px;color:var(--muted);">{maxP.toLocaleString()}만</span>
      </div>
    </div>

    <!-- SVG Map — 실제 GeoJSON 좌표 기반 -->
    <svg
      id="seoulMap"
      viewBox="0 0 720 590"
      xmlns="http://www.w3.org/2000/svg"
      style="width:100%;max-width:860px;height:auto;display:block;margin:0 auto;border-radius:14px;overflow:visible;"
    >
      <defs>
        <!-- 배경 그라디언트 -->
        <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#ddeeff;stop-opacity:1"/>
          <stop offset="100%" style="stop-color:#e8f4fb;stop-opacity:1"/>
        </linearGradient>
        <!-- Hover glow 필터 (파란 구) -->
        <filter id="glowBlue" x="-15%" y="-15%" width="130%" height="130%">
          <feDropShadow dx="0" dy="2" stdDeviation="7" flood-color="#1d4ed8" flood-opacity="0.55"/>
        </filter>
        <!-- Hover glow 필터 (회색 구) -->
        <filter id="glowGrey" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="0" dy="2" stdDeviation="5" flood-color="#334155" flood-opacity="0.25"/>
        </filter>
      </defs>

      <!-- 배경 -->
      <rect x="0" y="0" width="720" height="590" fill="url(#bgGrad)" rx="14"/>

      <!-- Districts — Astro 템플릿으로 정적 렌더링 -->
      {GU_LIST.map((gu) => (
        <g
          class="gu-item gu-pdf"
          data-name={gu.n}
          data-pdf="1"
          data-slug={gu.slug}
          data-color={baseFill(gu.slug)}
          data-hover={hoverFill(gu.slug)}
        >
          <path
            d={gu.d}
            style={`fill:${baseFill(gu.slug)};stroke:#fff;stroke-width:1.2;stroke-linejoin:round;fill-opacity:0.92;transition:fill .2s,fill-opacity .2s`}
          />
          <text
            x={gu.cx}
            y={gu.cy}
            style={`font-size:${gu.sz}px;font-weight:700;fill:${textFill(gu.slug)};pointer-events:none;text-anchor:middle;dominant-baseline:middle;font-family:system-ui,-apple-system,sans-serif;letter-spacing:-0.3px;text-shadow:0 1px 2px rgba(0,0,0,.15)`}
          >{gu.n}</text>
        </g>
      ))}

    </svg>
  </div>
</div>
</div>

<!-- Tooltip -->
<div id="mapTip" style="position:fixed;z-index:9998;pointer-events:none;opacity:0;transition:opacity .12s ease;top:0;left:0;">
  <div id="tipBox" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:16px 18px;box-shadow:var(--shadow-lg);min-width:230px;max-width:290px;"></div>
</div>

<script id="guData" type="application/json" set:html={JSON.stringify(guData)} />

<script is:inline>
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg){const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(msg));return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');}
async function tryUnlock(){
  const pw=document.getElementById('pwInput').value;
  const h=await sha256(pw);
  if(h===HASH){
    sessionStorage.setItem(SESSION_KEY,'1');
    document.getElementById('lockScreen').style.display='none';
    document.getElementById('dashboard').style.display='block';
  } else {
    document.getElementById('pwErr').textContent='비밀번호가 올바르지 않습니다.';
    document.getElementById('pwInput').value='';
  }
}
document.getElementById('unlockBtn').addEventListener('click',tryUnlock);
document.getElementById('pwInput').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
if(sessionStorage.getItem(SESSION_KEY)==='1'){
  document.getElementById('lockScreen').style.display='none';
  document.getElementById('dashboard').style.display='block';
}

// ── 구 데이터 (빌드타임 주입) ──
const GU_DATA = JSON.parse(document.getElementById('guData').textContent || '{}');

const gradeMap = {
  '상':  {bg:'#dcfce7',c:'#166534',stars:'★★★★★'},
  '중상':{bg:'#dbeafe',c:'#1d4ed8',stars:'★★★★☆'},
  '중':  {bg:'#fef9c3',c:'#854d0e',stars:'★★★☆☆'},
  '중하':{bg:'#fee2e2',c:'#991b1b',stars:'★★☆☆☆'},
  '하':  {bg:'#f1f5f9',c:'#475569',stars:'★☆☆☆☆'},
};

const tip    = document.getElementById('mapTip');
const tipBox = document.getElementById('tipBox');

function showTip(name, slug, e){
  const d = GU_DATA[slug];
  if(d){
    const gm = gradeMap[d.attraction] || gradeMap['중'];
    const supplyTxt = d.supply3yr != null ? d.supply3yr.toLocaleString() + '세대' : '—';
    tipBox.innerHTML =
      '<div style="font-size:16px;font-weight:800;color:#0d1e3a;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #e8f0fc;">'+name+'</div>'
      +'<div style="display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;align-items:center;">'
      +'<span style="background:'+gm.bg+';color:'+gm.c+';font-size:11px;font-weight:700;padding:2px 9px;border-radius:8px;">'+gm.stars+' '+d.attraction+'</span>'
      +'<span style="background:#eff6ff;color:#1d4ed8;font-size:10px;font-weight:700;padding:2px 8px;border-radius:8px;">💰 '+d.price+'</span>'
      +'</div>'
      +'<div style="margin-bottom:7px;"><div style="font-size:10px;font-weight:700;color:#4a789e;margin-bottom:2px;">🚇 교통 '+d.trafficGrade+'등급</div></div>'
      +'<div style="margin-bottom:7px;"><div style="font-size:10px;font-weight:700;color:#4a789e;margin-bottom:2px;">🏗️ 3년 내 공급</div><div style="font-size:11px;color:#1e3a5f;">'+supplyTxt+'</div></div>'
      +'<div style="margin-bottom:10px;"><div style="font-size:10px;font-weight:700;color:#4a789e;margin-bottom:2px;">🏠 대장 단지</div><div style="font-size:11px;color:#1e3a5f;">'+d.topComplex+'</div></div>'
      +'<div style="padding-top:10px;border-top:1px solid #e8f0fc;font-size:11px;color:#3b82f6;font-weight:700;">클릭하여 상세 분석 보기 →</div>';
  } else {
    tipBox.innerHTML =
      '<div style="font-size:16px;font-weight:800;color:#0d1e3a;margin-bottom:10px;">'+name+'</div>'
      +'<div style="font-size:12px;color:#94a3b8;text-align:center;padding:8px 0;">분석 자료 없음</div>';
  }
  tip.style.opacity='1';
  moveTip(e);
}

function moveTip(e){
  const margin=16, tw=tipBox.offsetWidth||260, th=tipBox.offsetHeight||200;
  let x=e.clientX+margin, y=e.clientY+margin;
  if(x+tw>window.innerWidth-8) x=e.clientX-tw-margin;
  if(y+th>window.innerHeight-8) y=e.clientY-th-margin;
  tip.style.left=x+'px'; tip.style.top=y+'px';
}
function hideTip(){ tip.style.opacity='0'; }

// ── Map 인터랙션 ──
document.querySelectorAll('.gu-item').forEach(function(g){
  var pathEl = g.querySelector('path');
  var slug   = g.dataset.slug;

  g.addEventListener('mouseenter', function(e){
    pathEl.style.fill = g.dataset.hover;
    pathEl.style.fillOpacity = '1';
    g.style.filter = 'url(#glowBlue)';
    showTip(g.dataset.name, slug, e);
  });
  g.addEventListener('mousemove', moveTip);
  g.addEventListener('mouseleave', function(){
    pathEl.style.fill = g.dataset.color;
    pathEl.style.fillOpacity = '0.92';
    g.style.filter = '';
    hideTip();
  });
  if(slug){
    g.style.cursor = 'pointer';
    g.addEventListener('click', function(){
      window.location.href = '/property/region-analysis/'+slug+'/';
    });
  }
});
</script>
</BaseLayout>
