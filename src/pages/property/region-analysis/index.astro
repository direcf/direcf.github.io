---
<BaseLayout title="지역 분석" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property",href:"/property/"},{label:"지역 분석"}]}>
<style>
#prop-root{background:#f0f7ff;color:#0d1e3a;min-height:100vh;margin:-20px -24px;padding:28px 28px 56px;}
#lockScreen{position:fixed;inset:0;z-index:9999;background:radial-gradient(ellipse at 30% 40%,rgba(20,60,130,.6),transparent 65%),radial-gradient(ellipse at 75% 70%,rgba(10,40,100,.45),transparent 60%),#060d1e;display:flex;align-items:center;justify-content:center;}
.lock-card{background:rgba(12,28,65,.88);border:1px solid rgba(130,200,255,.35);border-radius:24px;padding:52px 48px;width:400px;text-align:center;backdrop-filter:blur(24px);box-shadow:0 0 80px rgba(50,120,255,.15),0 8px 48px rgba(0,0,0,.7);position:relative;overflow:hidden;}
.lock-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(130,200,255,.7),transparent);}
.lock-icon{font-size:48px;margin-bottom:20px;filter:drop-shadow(0 0 14px rgba(80,170,255,.6));}
.lock-title{font-size:20px;font-weight:700;color:#c4e4ff;margin-bottom:6px;}
.lock-sub{font-size:13px;color:#92bfdf;margin-bottom:32px;}
.lock-input{width:100%;padding:14px 18px;box-sizing:border-box;background:rgba(8,22,58,.9);border:1px solid rgba(130,200,255,.35);border-radius:12px;color:#d8eeff;font-size:16px;outline:none;text-align:center;letter-spacing:3px;transition:border-color .2s,box-shadow .2s;}
.lock-input:focus{border-color:#50aaff;box-shadow:0 0 0 3px rgba(80,170,255,.2);}
.lock-btn{width:100%;margin-top:14px;padding:14px;background:linear-gradient(135deg,#1a60d0,#0d3d9e);border:1px solid rgba(80,170,255,.4);border-radius:12px;color:#c4e4ff;font-size:15px;font-weight:700;cursor:pointer;transition:all .2s;}
.lock-btn:hover{background:linear-gradient(135deg,#2070e0,#1050b8);transform:translateY(-1px);box-shadow:0 4px 24px rgba(30,100,255,.4);}
.lock-err{font-size:12px;color:#f87171;margin-top:10px;min-height:18px;}
.lock-hint{font-size:11px;color:#6a96ba;margin-top:20px;}
#dashboard{display:none;}
</style>

<div id="prop-root">

<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Private — Property</div>
    <div class="lock-sub">자산 현황에 접근하려면 비밀번호를 입력하세요.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / property</div>
  </div>
</div>

<div id="dashboard">
  <div style="margin-bottom:24px;">
    <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#4a789e;margin-bottom:8px;">Personal · Private · Property</div>
    <h1 style="font-size:26px;font-weight:900;color:#0d1e3a;letter-spacing:-1px;margin:0 0 6px;">서울 지역 분석</h1>
    <p style="font-size:13px;color:#4a789e;margin:0;">따뜻한부스터 2026 자료 기반 · 파란 구를 클릭하면 상세 분석을 볼 수 있습니다</p>
  </div>

  <div style="background:#fff;border:1px solid rgba(100,160,240,.18);border-radius:20px;padding:24px 20px 28px;box-shadow:0 2px 20px rgba(80,140,220,.07);">

    <!-- Legend -->
    <div style="display:flex;gap:20px;align-items:center;margin-bottom:18px;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#3b82f6;border-radius:3px;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#4a789e;font-weight:600;">분석 자료 있음 (10개구) — 클릭 가능</span>
      </div>
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#d1d9e6;border-radius:3px;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#94a3b8;">자료 없음 (15개구)</span>
      </div>
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#93c5fd;border-radius:3px;opacity:.7;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#94a3b8;">한강</span>
      </div>
    </div>

    <!-- SVG Map — 폴리곤을 Astro 템플릿으로 정적 렌더링 -->
    <svg
      id="seoulMap"
      viewBox="0 0 720 590"
      xmlns="http://www.w3.org/2000/svg"
      style="width:100%;max-width:820px;height:auto;display:block;margin:0 auto;background:linear-gradient(155deg,#eef4fc 0%,#f5f8fd 100%);border-radius:12px;overflow:visible;"
    >
      <!-- Han River -->
      <path
        d="M 28,355 C 80,348 140,344 200,347 C 270,352 332,365 420,375 C 480,381 535,383 582,383 L 716,380 L 716,400 C 582,403 535,403 480,401 C 420,395 332,385 270,372 C 200,367 140,364 80,368 L 28,375 Z"
        fill="#93c5fd"
        opacity="0.55"
      />

      <!-- Districts — Astro template으로 정적 생성 (JS createElementNS 사용 안 함) -->
      {GU_LIST.map((d) => (
        <g
          class={`gu-item ${d.pdf ? 'gu-pdf' : 'gu-grey'}`}
          data-name={d.n}
          data-pdf={d.pdf ? "1" : "0"}
          data-slug={d.slug}
        >
          <polygon
            points={d.p}
            style={`fill:${d.pdf ? '#3b82f6' : '#d1d9e6'};stroke:#fff;stroke-width:1.5;fill-opacity:${d.pdf ? 0.85 : 1};transition:fill .18s,fill-opacity .18s`}
          />
          <text
            x={d.cx}
            y={d.cy}
            style={`font-size:${d.sz}px;font-weight:${d.pdf ? 700 : 500};fill:${d.pdf ? '#fff' : '#6b7a99'};pointer-events:none;text-anchor:middle;dominant-baseline:middle;font-family:system-ui,-apple-system,sans-serif`}
          >{d.n}</text>
        </g>
      ))}
    </svg>
  </div>
</div>
</div>

<!-- Tooltip (fixed, follows cursor) -->
<div id="mapTip" style="position:fixed;z-index:9998;pointer-events:none;opacity:0;transition:opacity .12s ease;top:0;left:0;">
  <div id="tipBox" style="background:#fff;border:1px solid rgba(100,160,240,.28);border-radius:16px;padding:16px 18px;box-shadow:0 8px 36px rgba(37,99,235,.16),0 2px 8px rgba(0,0,0,.08);min-width:230px;max-width:290px;"></div>
</div>

<script is:inline>
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg){const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(msg));return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');}
async function tryUnlock(){
  const pw=document.getElementById('pwInput').value;
  const h=await sha256(pw);
  if(h===HASH){
    sessionStorage.setItem(SESSION_KEY,'1');
    document.getElementById('lockScreen').style.display='none';
    document.getElementById('dashboard').style.display='block';
  } else {
    document.getElementById('pwErr').textContent='비밀번호가 올바르지 않습니다.';
    document.getElementById('pwInput').value='';
  }
}
document.getElementById('unlockBtn').addEventListener('click',tryUnlock);
document.getElementById('pwInput').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
if(sessionStorage.getItem(SESSION_KEY)==='1'){
  document.getElementById('lockScreen').style.display='none';
  document.getElementById('dashboard').style.display='block';
}

// ── Tooltip 데이터 ──
const GU_INFO = {
  '동대문구':{
    투자:'중상',
    입지:'청량리역 동북부 교통·상업 허브\n직장 A · 교통 S- 등급\n동북선(2027.11) · GTX-B/C · 면목선',
    공급:'3년 내 1,112세대\n(청량리롯데캐슬 761 + 제기동역아이파크 351)\n서울 내 심각한 공급 부족',
    소득:'주소지 소득 서울 18위\n원천징수 기준 16위\n종로·광화문·여의도 출퇴근',
    대장:'청량리롯데캐슬SKY-L65\n36평 매매 ≈19.2억 (2026.01)',
    slug:'dongdaemun',
  },
  '강서구':{투자:'중상',입지:'5·9호선, 마곡 업무지구\n김포공항 인근',공급:'마곡지구 입주 완료\n향후 공급 제한적',소득:'소득 서울 중상위\n마곡 직주근접 수요',대장:'추후 업데이트',slug:''},
  '관악구':{투자:'중하',입지:'2호선 봉천·낙성대역\n서울대 인근',공급:'2026년 이후 공급 제한적',소득:'소득 서울 하위권\n실거주 수요 중심',대장:'추후 업데이트',slug:''},
  '구로구':{투자:'중',입지:'1·2·7호선, G밸리(구로디지털단지) 인접',공급:'보통 수준',소득:'소득 서울 중하\nG밸리 직장인 거주',대장:'추후 업데이트',slug:''},
  '노원구':{투자:'중하',입지:'4·7호선, 학군 강점 지역',공급:'과거 대량공급 마무리\n2026년 이후 보통',소득:'소득 서울 중하위\n학군 수요 중심',대장:'추후 업데이트',slug:''},
  '도봉구':{투자:'중하',입지:'1·7호선, 저가 진입 가능',공급:'보통 수준',소득:'소득 서울 하위권',대장:'추후 업데이트',slug:''},
  '서대문구':{투자:'중',입지:'2·5호선, 홍대·신촌·이대 상권',공급:'재개발 진행 중\n향후 공급 보통',소득:'소득 서울 중위\n홍대·신촌 출퇴근',대장:'추후 업데이트',slug:''},
  '성북구':{투자:'중',입지:'4·6호선, 성균관대·고려대 인근',공급:'공급 제한적',소득:'소득 서울 중상위\n성북동 고급 주거 혼재',대장:'추후 업데이트',slug:''},
  '은평구':{투자:'중',입지:'3·6호선, GTX-A 수혜 기대\n은평뉴타운',공급:'뉴타운 일단락\n향후 공급 제한적',소득:'소득 서울 중하\n은평뉴타운 신축 실거주',대장:'추후 업데이트',slug:''},
  '중랑구':{투자:'하',입지:'7호선·경춘선\n저가 매수 접근',공급:'보통 수준',소득:'소득 서울 하위권\n실거주·전세 중심',대장:'추후 업데이트',slug:''},
};

const gradeMap = {
  '상':  {bg:'#dcfce7',c:'#166534',stars:'★★★★★'},
  '중상':{bg:'#dbeafe',c:'#1d4ed8',stars:'★★★★☆'},
  '중':  {bg:'#fef9c3',c:'#854d0e',stars:'★★★☆☆'},
  '중하':{bg:'#fee2e2',c:'#991b1b',stars:'★★☆☆☆'},
  '하':  {bg:'#f1f5f9',c:'#475569',stars:'★☆☆☆☆'},
};

const tip = document.getElementById('mapTip');
const tipBox = document.getElementById('tipBox');

function showTip(name, e){
  const info = GU_INFO[name];
  if(info){
    const g = gradeMap[info.투자] || gradeMap['중'];
    const clickHint = info.slug
      ? '<div style="margin-top:10px;padding-top:10px;border-top:1px solid #e8f0fc;font-size:11px;color:#3b82f6;font-weight:700;">클릭하여 상세 분석 보기 →</div>'
      : '<div style="margin-top:8px;font-size:10px;color:#94a3b8;">상세 분석 준비 중...</div>';
    tipBox.innerHTML =
      '<div style="font-size:16px;font-weight:800;color:#0d1e3a;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #e8f0fc;display:flex;align-items:center;gap:7px;">'
      +'<span style="font-size:10px;background:#3b82f6;color:#fff;padding:2px 7px;border-radius:8px;font-weight:700;flex-shrink:0;">자료있음</span>'+name+'</div>'
      +'<div style="margin-bottom:10px;"><span style="background:'+g.bg+';color:'+g.c+';font-size:11px;font-weight:700;padding:3px 10px;border-radius:8px;">투자매력도 '+g.stars+' '+info.투자+'</span></div>'
      +[['🚇 입지',info.입지],['🏗️ 공급',info.공급],['💰 소득/거주',info.소득],['🏠 대장',info.대장]]
        .map(([l,v])=>'<div style="margin-bottom:8px;"><div style="font-size:10px;font-weight:700;color:#4a789e;margin-bottom:2px;">'+l+'</div><div style="font-size:11px;color:#1e3a5f;line-height:1.5;white-space:pre-line;">'+v+'</div></div>')
        .join('')
      +clickHint;
  } else {
    tipBox.innerHTML =
      '<div style="font-size:16px;font-weight:800;color:#0d1e3a;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #e8f0fc;">'+name+'</div>'
      +'<div style="font-size:12px;color:#94a3b8;text-align:center;padding:8px 0;">분석 자료 없음<br><span style="font-size:11px;">추후 업데이트 예정</span></div>';
  }
  tip.style.opacity='1';
  moveTip(e);
}

function moveTip(e){
  const margin=16;
  const tw=tipBox.offsetWidth||260;
  const th=tipBox.offsetHeight||220;
  let x=e.clientX+margin, y=e.clientY+margin;
  if(x+tw>window.innerWidth-8) x=e.clientX-tw-margin;
  if(y+th>window.innerHeight-8) y=e.clientY-th-margin;
  tip.style.left=x+'px';
  tip.style.top=y+'px';
}

function hideTip(){ tip.style.opacity='0'; }

// ── Map 인터랙션 (정적 렌더링된 SVG 요소에 이벤트 추가) ──
document.querySelectorAll('.gu-item').forEach(function(g){
  var poly = g.querySelector('polygon');
  var isPdf = g.dataset.pdf === '1';
  var slug = g.dataset.slug;

  g.addEventListener('mouseenter', function(e){
    if(isPdf){
      poly.style.fill='#1d4ed8';
      poly.style.fillOpacity='1';
      g.style.filter='drop-shadow(0 3px 14px rgba(29,78,216,.55))';
    } else {
      poly.style.fill='#94a3b8';
      g.style.filter='drop-shadow(0 2px 6px rgba(0,0,0,.15))';
    }
    showTip(g.dataset.name, e);
  });

  g.addEventListener('mousemove', moveTip);

  g.addEventListener('mouseleave', function(){
    poly.style.fill = isPdf ? '#3b82f6' : '#d1d9e6';
    poly.style.fillOpacity = isPdf ? '0.85' : '1';
    g.style.filter = '';
    hideTip();
  });

  if(isPdf && slug){
    g.style.cursor = 'pointer';
    g.addEventListener('click', function(){
      window.location.href = '/property/region-analysis/'+slug+'/';
    });
  }
});
</script>
</BaseLayout>
