---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="지역 분석" activeSlug="property" crumbs={[{label:"Personal"},{label:"Property",href:"/property/"},{label:"지역 분석"}]}>
<style>
#prop-root{background:#f0f7ff;color:#0d1e3a;min-height:100vh;margin:-20px -24px;padding:28px 28px 56px;}
#lockScreen{position:fixed;inset:0;z-index:9999;background:radial-gradient(ellipse at 30% 40%,rgba(20,60,130,.6),transparent 65%),radial-gradient(ellipse at 75% 70%,rgba(10,40,100,.45),transparent 60%),#060d1e;display:flex;align-items:center;justify-content:center;}
.lock-card{background:rgba(12,28,65,.88);border:1px solid rgba(130,200,255,.35);border-radius:24px;padding:52px 48px;width:400px;text-align:center;backdrop-filter:blur(24px);box-shadow:0 0 80px rgba(50,120,255,.15),0 8px 48px rgba(0,0,0,.7);position:relative;overflow:hidden;}
.lock-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(130,200,255,.7),transparent);}
.lock-icon{font-size:48px;margin-bottom:20px;filter:drop-shadow(0 0 14px rgba(80,170,255,.6));}
.lock-title{font-size:20px;font-weight:700;color:#c4e4ff;margin-bottom:6px;}
.lock-sub{font-size:13px;color:#92bfdf;margin-bottom:32px;}
.lock-input{width:100%;padding:14px 18px;box-sizing:border-box;background:rgba(8,22,58,.9);border:1px solid rgba(130,200,255,.35);border-radius:12px;color:#d8eeff;font-size:16px;outline:none;text-align:center;letter-spacing:3px;transition:border-color .2s,box-shadow .2s;}
.lock-input:focus{border-color:#50aaff;box-shadow:0 0 0 3px rgba(80,170,255,.2);}
.lock-btn{width:100%;margin-top:14px;padding:14px;background:linear-gradient(135deg,#1a60d0,#0d3d9e);border:1px solid rgba(80,170,255,.4);border-radius:12px;color:#c4e4ff;font-size:15px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.5px;}
.lock-btn:hover{background:linear-gradient(135deg,#2070e0,#1050b8);transform:translateY(-1px);box-shadow:0 4px 24px rgba(30,100,255,.4);}
.lock-err{font-size:12px;color:#f87171;margin-top:10px;min-height:18px;}
.lock-hint{font-size:11px;color:#6a96ba;margin-top:20px;}
#dashboard{display:none;}
</style>

<div id="prop-root">

<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Private — Property</div>
    <div class="lock-sub">자산 현황에 접근하려면 비밀번호를 입력하세요.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / property</div>
  </div>
</div>

<div id="dashboard">
  <div style="margin-bottom:28px;">
    <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#4a789e;margin-bottom:8px;">Personal · Private · Property</div>
    <h1 style="font-size:26px;font-weight:900;color:#0d1e3a;letter-spacing:-1px;margin:0 0 6px;">서울 지역 분석</h1>
    <p style="font-size:13px;color:#4a789e;margin:0;">따뜻한 부동산 스터디 2026 자료 기반 · 파란 구에 마우스를 올려 상세 정보를 확인하세요</p>
  </div>

  <div style="background:#fff;border:1px solid rgba(100,160,240,.2);border-radius:20px;padding:28px 24px 32px;box-shadow:0 2px 20px rgba(80,140,220,.07);position:relative;">

    <!-- Legend -->
    <div style="display:flex;gap:20px;align-items:center;margin-bottom:20px;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#3b82f6;border-radius:3px;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#4a789e;font-weight:600;">분석 자료 있음 (10개구)</span>
      </div>
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#d1d9e6;border-radius:3px;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#94a3b8;">자료 없음 (15개구)</span>
      </div>
      <div style="display:flex;align-items:center;gap:7px;">
        <div style="width:14px;height:14px;background:#93c5fd;border-radius:3px;opacity:.7;flex-shrink:0;"></div>
        <span style="font-size:12px;color:#94a3b8;">한강</span>
      </div>
    </div>

    <!-- SVG Map Container -->
    <div style="position:relative;">
      <svg id="seoulMap" viewBox="0 0 720 600" xmlns="http://www.w3.org/2000/svg"
        style="width:100%;max-width:800px;height:auto;display:block;margin:0 auto;background:linear-gradient(160deg,#eef4fc 0%,#f5f8fd 100%);border-radius:12px;">
        <defs>
          <linearGradient id="pdfGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#60a5fa"/>
            <stop offset="100%" style="stop-color:#2563eb"/>
          </linearGradient>
          <filter id="guGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="4" result="blur"/>
            <feComposite in="SourceGraphic" in2="blur" operator="over"/>
          </filter>
        </defs>

        <!-- Han River -->
        <path d="M 28,362 C 80,352 140,347 200,350 C 270,355 332,370 415,380 C 480,387 535,390 582,390 L 688,388 L 688,408 C 582,410 535,410 480,407 C 415,400 332,390 270,375 C 200,370 140,367 80,372 L 28,382 Z"
          fill="#93c5fd" opacity="0.58"/>

        <!-- Districts rendered by JS -->
        <g id="guGroup"></g>
      </svg>
    </div>
  </div>
</div><!-- /dashboard -->

</div><!-- /prop-root -->

<!-- Tooltip (fixed, follows cursor) -->
<div id="mapTip" style="position:fixed;z-index:9998;pointer-events:none;opacity:0;transition:opacity .15s ease;top:0;left:0;">
  <div style="background:#fff;border:1px solid rgba(100,160,240,.28);border-radius:16px;padding:18px 20px;box-shadow:0 8px 36px rgba(37,99,235,.16),0 2px 8px rgba(0,0,0,.08);min-width:240px;max-width:300px;">
    <div id="tipName" style="font-size:17px;font-weight:800;color:#0d1e3a;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid #e8f0fc;display:flex;align-items:center;gap:8px;"></div>
    <div id="tipBody"></div>
  </div>
</div>

<script is:inline>
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';

async function sha256(msg){
  const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function tryUnlock(){
  const pw=document.getElementById('pwInput').value;
  const h=await sha256(pw);
  if(h===HASH){
    sessionStorage.setItem(SESSION_KEY,'1');
    document.getElementById('lockScreen').style.display='none';
    document.getElementById('dashboard').style.display='block';
    buildMap();
  } else {
    document.getElementById('pwErr').textContent='비밀번호가 올바르지 않습니다.';
    document.getElementById('pwInput').value='';
  }
}
document.getElementById('unlockBtn').addEventListener('click',tryUnlock);
document.getElementById('pwInput').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
if(sessionStorage.getItem(SESSION_KEY)==='1'){
  document.getElementById('lockScreen').style.display='none';
  document.getElementById('dashboard').style.display='block';
  buildMap();
}

