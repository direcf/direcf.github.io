// ──────────── Build SVG map ────────────
function buildMap(){
  const NS='http://www.w3.org/2000/svg';
  const grp=document.getElementById('guGroup');
  if(!grp||grp.children.length>0) return;

  GU_DATA.forEach(d=>{
    const g=document.createElementNS(NS,'g');
    g.style.cursor='pointer';

    const poly=document.createElementNS(NS,'polygon');
    poly.setAttribute('points',d.p);
    poly.style.stroke='#fff';
    poly.style.strokeWidth='1.5';
    poly.style.strokeLinejoin='round';
    poly.style.transition='fill .18s ease, fill-opacity .18s ease';
    if(d.pdf){
      poly.style.fill='url(#pdfGrad)';
      poly.style.fillOpacity='0.82';
    } else {
      poly.style.fill='#d1d9e6';
      poly.style.fillOpacity='1';
    }

    const txt=document.createElementNS(NS,'text');
    txt.setAttribute('x',d.cx);
    txt.setAttribute('y',d.cy);
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('dominant-baseline','middle');
    txt.textContent=d.n;
    txt.style.fontSize=d.sz+'px';
    txt.style.fontWeight=d.pdf?'700':'500';
    txt.style.fill=d.pdf?'#fff':'#6b7a99';
    txt.style.pointerEvents='none';
    txt.style.letterSpacing='-0.3px';
    txt.style.fontFamily="'Apple SD Gothic Neo',sans-serif";

    g.appendChild(poly);
    g.appendChild(txt);
    grp.appendChild(g);

    g.addEventListener('mouseenter',e=>{ onEnter(g,poly,d,e); });
    g.addEventListener('mousemove',onMove);
    g.addEventListener('mouseleave',()=>{ onLeave(g,poly,d); });
  });
}

// ──────────── Hover effects ────────────
function onEnter(g,poly,d,e){
  if(d.pdf){
    poly.style.fill='#2563eb';
    poly.style.fillOpacity='1';
    g.style.filter='drop-shadow(0 4px 16px rgba(37,99,235,.55))';
  } else {
    poly.style.fill='#a0aec0';
    g.style.filter='drop-shadow(0 2px 8px rgba(0,0,0,.18))';
  }
  showTip(d,e);
}
function onLeave(g,poly,d){
  if(d.pdf){
    poly.style.fill='url(#pdfGrad)';
    poly.style.fillOpacity='0.82';
  } else {
    poly.style.fill='#d1d9e6';
  }
  g.style.filter='';
  hideTip();
}
function onMove(e){ moveTip(e); }

// ──────────── Tooltip ────────────
const tip=document.getElementById('mapTip');
const tipName=document.getElementById('tipName');
const tipBody=document.getElementById('tipBody');

function showTip(d,e){
  tipName.innerHTML=(d.pdf?'<span style="background:#3b82f6;color:#fff;font-size:10px;padding:2px 7px;border-radius:10px;font-weight:600;letter-spacing:.5px;">자료있음</span> ':'')+d.n;
  if(d.pdf && GU_INFO[d.n]){
    const info=GU_INFO[d.n];
    const rows=[
      ['🏗️ 공급',      info.공급],
      ['💰 소득/거주', info.소득거주],
      ['🚇 입지',      info.입지],
      ['🏠 대장단지',  info.대장],
    ];
    const badge=getBadgeHtml(info.투자);
    tipBody.innerHTML=
      '<div style="margin-bottom:10px;">'+badge+'</div>'+
      rows.map(([lbl,val])=>
        '<div style="margin-bottom:10px;">'
        +'<div style="font-size:10px;font-weight:700;color:#4a789e;margin-bottom:3px;">'+lbl+'</div>'
        +'<div style="font-size:12px;color:#1e3a5f;line-height:1.5;white-space:pre-line;">'+val+'</div>'
        +'</div>'
      ).join('');
  } else {
    tipBody.innerHTML='<div style="font-size:12px;color:#94a3b8;text-align:center;padding:8px 0;">분석 자료 없음<br><span style="font-size:11px;">추후 업데이트 예정</span></div>';
  }
  tip.style.opacity='1';
  moveTip(e);
}

function getBadgeHtml(level){
  const map={
    '상':   {bg:'#dcfce7',c:'#166534',label:'투자매력 ★★★★★ 상'},
    '중상': {bg:'#dbeafe',c:'#1d4ed8',label:'투자매력 ★★★★☆ 중상'},
    '중':   {bg:'#fef9c3',c:'#854d0e',label:'투자매력 ★★★☆☆ 중'},
    '중하': {bg:'#fee2e2',c:'#991b1b',label:'투자매력 ★★☆☆☆ 중하'},
    '하':   {bg:'#f1f5f9',c:'#475569',label:'투자매력 ★☆☆☆☆ 하'},
  };
  const s=map[level]||map['중'];
  return '<span style="background:'+s.bg+';color:'+s.c+';font-size:11px;font-weight:700;padding:4px 10px;border-radius:8px;">'+s.label+'</span>';
}

function moveTip(e){
  const margin=16;
  const tw=tip.firstElementChild.offsetWidth||280;
  const th=tip.firstElementChild.offsetHeight||200;
  let x=e.clientX+margin;
  let y=e.clientY+margin;
  if(x+tw>window.innerWidth-8) x=e.clientX-tw-margin;
  if(y+th>window.innerHeight-8) y=e.clientY-th-margin;
  tip.style.left=x+'px';
  tip.style.top=y+'px';
}

function hideTip(){
  tip.style.opacity='0';
}
</script>
</BaseLayout>
