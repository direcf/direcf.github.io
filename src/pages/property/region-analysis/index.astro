import BaseLayout from "../../../layouts/BaseLayout.astro";

// ── 구별 평당가 계산 (complexAnalysis 실거래가 기반) ──
const distFiles = import.meta.glob('../../../data/districts/*.json', { eager: true });
const districtMap: Record<string, any> = {};
for (const mod of Object.values(distFiles)) {
  const d = (mod as any).default || mod;
  if (d.slug) districtMap[d.slug] = d;
}

function parseAeokNum(s: string | null | undefined): number | null {
  if (!s || s === '—') return null;
  const v = parseFloat(String(s).replace('억', ''));
  return isNaN(v) ? null : v;
}

function avgPricePerPyeong(slug: string): number | null {
  if (slug === 'dongdaemun') return 5333; // 청량리롯데캐슬 19.2억/36평
  const d = districtMap[slug];
  if (!d) return null;
  const prices: number[] = [];
  for (const c of (d.complexAnalysis || [])) {
    const sale = parseAeokNum(c.sale);
    const m = (c.size || '33평').match(/(\d+)/);
    if (!sale || !m) continue;
    prices.push(Math.round(sale * 10000 / parseInt(m[1])));
  }
  return prices.length ? Math.round(prices.reduce((a, b) => a + b) / prices.length) : null;
}

// slug → 만원/평
const slugPrice: Record<string, number | null> = {};
for (const key of ['dobong','dongdaemun','dongjak','eunpyeong','gangbuk','gangdong','gangnam','gangseo','geumcheon','guro','gwanak','gwangjin','jongno','jung','jungnang','mapo','nowon','seocho','seodaemun','seongbuk','seongdong','songpa','yangcheon','yeongdeungpo','yongsan']) {
  slugPrice[key] = avgPricePerPyeong(key);
}

const validP = Object.values(slugPrice).filter((p): p is number => p !== null);
const minP = Math.min(...validP);
const maxP = Math.max(...validP);

// blue-200(#bfdbfe) → blue-900(#1e3a8a) 선형 보간
function blueAt(t: number): string {
  const r = Math.round(191 + t * (30  - 191));
  const g = Math.round(219 + t * (58  - 219));
  const b = Math.round(254 + t * (138 - 254));
  return `rgb(${r},${g},${b})`;
}
function pct(slug: string): number {
  const p = slugPrice[slug];
  return p != null ? (p - minP) / (maxP - minP) : 0.5;
}
function baseFill(slug: string)  { return blueAt(pct(slug)); }
function hoverFill(slug: string) { return blueAt(Math.min(1, pct(slug) + 0.18)); }
function textFill(slug: string)  { return pct(slug) > 0.38 ? '#fff' : '#1e3a8a'; }

// 구간 라벨 (범례용)
const q1 = Math.round(minP + (maxP - minP) * 0.25);
const q2 = Math.round(minP + (maxP - minP) * 0.50);
const q3 = Math.round(minP + (maxP - minP) * 0.75);

// JS 툴팁 데이터
const guData: Record<string, any> = {};
for (const [slug, d] of Object.entries(districtMap)) {
  const price = slugPrice[slug];
  const top = (d.complexAnalysis || [])[0];
  guData[slug] = {
    name: d.name,
    attraction: d.attraction || '중',
    price: price ? price.toLocaleString() + '만/평' : '—',
    trafficGrade: d.locationAnalysis?.traffic?.grade || '—',
    supply3yr: d.quickStats?.supply3yr ?? null,
    topComplex: top ? `${top.name} ${top.sale}` : '—',
  };
}
guData['dongdaemun'] = {
  name: '동대문구', attraction: '중상', price: '5,333만/평',
  trafficGrade: 'S', supply3yr: 1112, topComplex: '청량리롯데캐슬SKY-L65 19.2억',
};

