        </div>
      </div>
      <div style="display:flex;align-items:flex-start;gap:14px;">
        <div style="width:38px;height:38px;background:#ede9fe;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:#4c1d95;flex-shrink:0;">S-</div>
