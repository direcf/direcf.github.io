---
import propertyData from "../../../../data/property.json";

const distFiles = import.meta.glob('../../../../data/districts/*.json', { eager: true });
const districts = Object.values(distFiles).map((m) => (m as any).default || m);

// 최신 스냅샷
const snap = [...propertyData.snapshots].sort(
  (a, b) => new Date(b.snapshotDate).getTime() - new Date(a.snapshotDate).getTime()
)[0];

function parseAeok(s: string | null | undefined): number | null {
  if (!s || s === '—') return null;
  const v = parseFloat(String(s).replace('억', ''));
  return isNaN(v) ? null : v;
}

function fmt억(n: number | null, digits = 2): string {
  if (n == null) return '—';
  if (n >= 1) return n.toFixed(digits) + '억';
  return Math.round(n * 10000).toLocaleString() + '만';
}

function fmtWon(n: number): string {
  if (n >= 100000000) return (n / 100000000).toFixed(2) + '억원';
  if (n >= 10000) return Math.round(n / 10000).toLocaleString() + '만원';
  return n.toLocaleString() + '원';
}

const { summary, investments, loans } = snap;
const liquidCash = summary.cash + summary.savings;
const totalInvest = summary.investmentTotal;
const netWorth = summary.netWorth;

// 가용 자금 시나리오 (억 단위)
const scenCash = +(liquidCash / 1e8).toFixed(2);
const scen30 = +((liquidCash + totalInvest * 0.3) / 1e8).toFixed(2);
const scen60 = +((liquidCash + totalInvest * 0.6) / 1e8).toFixed(2);

// SK하이닉스 집중도 (KRW 단위 항목만 — eval >100,000 필터)
const skhEval = investments
  .filter((i) => i.eval > 100000 && (i.name.includes('SK하이닉스') || (i.name.includes('레버리지') && i.name.includes('SK'))))
  .reduce((s, i) => s + i.eval, 0);
const skhRatio = Math.round(skhEval / totalInvest * 100);

// 신한은행 대출 만기 (스냅샷 기준으로 고정)
const shinhan = loans.find((l) => l.bank === '신한은행' && l.maturityDate);
const daysToMaturity = shinhan
  ? Math.round((new Date(shinhan.maturityDate!).getTime() - new Date(snap.snapshotDate).getTime()) / (1000 * 60 * 60 * 24))
  : null;

// 목표 분석
const needed = propertyData.goal.target - netWorth;
const goalPct = Math.round(netWorth / propertyData.goal.target * 100);
const skhGrowthForGoal = needed > 0 ? +(needed / skhEval * 100).toFixed(1) : 0;

// 모든 단지 갭 분석 + 스코어링
const gradeMap: Record<string, number> = { S:5, 'A+':5, A:4, 'B+':4, B:3, 'B-':3, C:2, D:1 };
const allComplexes = (districts as any[]).flatMap((d) => {
  const trafficScore = gradeMap[d.locationAnalysis?.traffic?.grade] || 3;
  const attrScore = d.attractionStars || 1;
  const supplyBonus = (d.quickStats?.supply3yr || 9999) < 1000 ? 1 : 0;
  return (d.complexAnalysis || []).map((c: any) => {
    const sale = parseAeok(c.sale);
    const lease = parseAeok(c.lease);
    const gap = (sale && lease) ? +(sale - lease).toFixed(2) : null;
    const rate = (sale && lease) ? Math.round(lease / sale * 100) : null;
    const score = (attrScore / 5 * 100) * 0.35 + (rate || 0) * 0.35 + (trafficScore / 5 * 100) * 0.15 + supplyBonus * 15;
    return {
      district: d.name, slug: d.slug,
      attraction: d.attractionStars, attractionLabel: d.attraction,
      tier: c.tier, name: c.name, year: c.year, size: c.size,
      sale, lease, gap, rate, score,
      trafficGrade: d.locationAnalysis?.traffic?.grade,
      supply3yr: d.quickStats?.supply3yr,
    };
  }).filter((c: any) => c.gap !== null);
});

// 갭 기준 상위 9개에서 스코어 정렬 → TOP 6
const topTargets: any[] = [...allComplexes]
  .sort((a, b) => a.gap - b.gap)
  .slice(0, 9)
  .sort((a, b) => b.score - a.score)
  .slice(0, 6);

// 시나리오별 가능 여부
const HASH = 'ee6123683515b4605b92a9e8e3db97d3517f607f4a7a95583f821371ddd017a1';
const SESSION_KEY = 'prop:auth';
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI 부동산 투자 레포트</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Apple SD Gothic Neo', sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }

    /* ── 잠금 화면 ── */
    #lockScreen { display:flex; align-items:center; justify-content:center; min-height:100vh; background: linear-gradient(135deg,#0f172a,#1e293b); }
    .lock-card { background:#1e293b; border:1px solid #334155; border-radius:16px; padding:40px; width:100%; max-width:400px; text-align:center; }
    .lock-icon { font-size:48px; margin-bottom:16px; }
    .lock-title { font-size:20px; font-weight:700; color:#f1f5f9; margin-bottom:8px; }
    .lock-sub { font-size:14px; color:#94a3b8; margin-bottom:24px; }
    .lock-input { width:100%; padding:12px 16px; background:#0f172a; border:1px solid #334155; border-radius:8px; color:#f1f5f9; font-size:16px; text-align:center; margin-bottom:12px; outline:none; }
    .lock-input:focus { border-color:#6366f1; }
    .lock-btn { width:100%; padding:12px; background:#6366f1; color:#fff; border:none; border-radius:8px; font-size:16px; font-weight:600; cursor:pointer; }
    .lock-btn:hover { background:#4f46e5; }
    .lock-err { color:#f87171; font-size:13px; margin-top:8px; display:none; }

    /* ── 대시보드 ── */
    #dashboard { display:none; max-width:1100px; margin:0 auto; padding:24px 16px 60px; }

    .report-header { margin-bottom:32px; border-bottom:1px solid #1e3a5f; padding-bottom:24px; }
    .report-badge { display:inline-block; padding:4px 12px; background:#1e3a5f; color:#60a5fa; border-radius:20px; font-size:12px; font-weight:600; letter-spacing:.05em; margin-bottom:12px; }
    .report-title { font-size:28px; font-weight:800; color:#f1f5f9; line-height:1.3; margin-bottom:8px; }
    .report-meta { font-size:13px; color:#64748b; }

    /* stat cards */
    .stat-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:24px; }
    .stat-card { background:#1e293b; border:1px solid #334155; border-radius:12px; padding:20px; }
    .stat-label { font-size:12px; color:#64748b; font-weight:500; margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em; }
    .stat-value { font-size:24px; font-weight:800; color:#f1f5f9; margin-bottom:4px; }
    .stat-sub { font-size:12px; color:#94a3b8; }
    .stat-goal { color:#a78bfa; }
    .stat-warn { color:#fbbf24; }
    .stat-ok { color:#34d399; }
    .stat-bad { color:#f87171; }

    /* 경고 배너 */
    .alert-row { display:flex; flex-direction:column; gap:10px; margin-bottom:28px; }
    .alert { display:flex; align-items:flex-start; gap:12px; padding:14px 16px; border-radius:10px; font-size:14px; line-height:1.5; }
    .alert-warn { background:#451a03; border:1px solid #92400e; }
    .alert-info { background:#0c1a2e; border:1px solid #1d4ed8; }
    .alert-danger { background:#3b0764; border:1px solid #7c3aed; }
    .alert-icon { font-size:18px; flex-shrink:0; }
    .alert-body strong { color:#f1f5f9; display:block; margin-bottom:2px; }
    .alert-body span { color:#94a3b8; }

    /* 시나리오 */
    .section-title { font-size:18px; font-weight:700; color:#f1f5f9; margin-bottom:16px; display:flex; align-items:center; gap:8px; }
    .section-title::before { content:''; display:block; width:4px; height:20px; background:#6366f1; border-radius:2px; }

    .scen-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; margin-bottom:32px; }
    .scen-card { background:#1e293b; border:1px solid #334155; border-radius:12px; padding:20px; }
    .scen-card.active { border-color:#6366f1; background:#1e1b4b; }
    .scen-label { font-size:12px; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:.05em; margin-bottom:8px; }
    .scen-amount { font-size:26px; font-weight:800; color:#f1f5f9; margin-bottom:8px; }
    .scen-desc { font-size:12px; color:#94a3b8; margin-bottom:12px; line-height:1.5; }
    .scen-bar { height:8px; background:#0f172a; border-radius:4px; overflow:hidden; margin-bottom:4px; }
    .scen-fill { height:100%; border-radius:4px; }
    .scen-possible { font-size:11px; font-weight:600; margin-top:6px; }
    .scen-possible.ok { color:#34d399; }
    .scen-possible.partial { color:#fbbf24; }
    .scen-possible.no { color:#f87171; }

    /* 추천 단지 테이블 */
    .target-section { margin-bottom:32px; }
    .target-table { width:100%; border-collapse:collapse; }
    .target-table th { font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:.05em; padding:10px 12px; text-align:left; border-bottom:1px solid #334155; }
    .target-table td { padding:14px 12px; border-bottom:1px solid #1e293b; font-size:13px; vertical-align:middle; }
    .target-table tr:hover td { background:#1e293b40; }
    .rank-badge { display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:50%; font-size:11px; font-weight:800; }
    .rank-1 { background:#fbbf24; color:#000; }
    .rank-2 { background:#94a3b8; color:#000; }
    .rank-3 { background:#b45309; color:#fff; }
    .rank-n { background:#1e293b; color:#64748b; border:1px solid #334155; }
    .tier-badge { display:inline-block; padding:2px 8px; border-radius:4px; font-size:10px; font-weight:700; }
    .tier-대장 { background:#1e3a5f; color:#60a5fa; }
    .tier-중위 { background:#1a2e1a; color:#4ade80; }
    .tier-팔로우 { background:#2e1a2e; color:#c084fc; }
    .gap-bar-wrap { width:90px; }
    .gap-bar { height:6px; background:#0f172a; border-radius:3px; overflow:hidden; display:flex; }
    .gap-bar-lease { height:100%; background:#60a5fa; }
    .gap-bar-gap { height:100%; background:#fbbf24; }
    .gap-tag { display:inline-block; margin-top:4px; padding:1px 6px; border-radius:3px; font-size:10px; font-weight:700; }
    .gap-tag.ok { background:#052e16; color:#4ade80; }
    .gap-tag.caution { background:#451a03; color:#fbbf24; }
    .gap-tag.bad { background:#3b0764; color:#f87171; }
    .scen-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; }
    .dot-green { background:#34d399; }
    .dot-yellow { background:#fbbf24; }
    .dot-red { background:#f87171; }

    /* 전문가 의견 */
    .expert-section { margin-bottom:32px; }
    .expert-box { background:#1e293b; border:1px solid #334155; border-radius:12px; padding:28px; }
    .expert-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
    .expert-avatar { width:44px; height:44px; background:linear-gradient(135deg,#6366f1,#a855f7); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
    .expert-name { font-weight:700; color:#f1f5f9; font-size:15px; }
    .expert-title { font-size:12px; color:#94a3b8; }
    .expert-body p { font-size:14px; color:#cbd5e1; line-height:1.8; margin-bottom:14px; }
    .expert-body p:last-child { margin-bottom:0; }
    .expert-body strong { color:#f1f5f9; }
    .expert-highlight { background:#1e3a5f; border-left:3px solid #6366f1; padding:12px 16px; border-radius:0 8px 8px 0; margin:16px 0; font-size:14px; color:#93c5fd; line-height:1.7; }

    /* 리스크 */
    .risk-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; margin-bottom:32px; }
    .risk-card { background:#1e293b; border:1px solid #334155; border-radius:12px; padding:20px; }
    .risk-level { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; margin-bottom:8px; }
    .risk-high { color:#f87171; }
    .risk-mid { color:#fbbf24; }
    .risk-low { color:#34d399; }
    .risk-title { font-size:15px; font-weight:700; color:#f1f5f9; margin-bottom:8px; }
    .risk-desc { font-size:13px; color:#94a3b8; line-height:1.6; }

    /* 실행 타임라인 */
    .timeline { margin-bottom:32px; }
    .tl-item { display:flex; gap:16px; margin-bottom:20px; }
    .tl-left { display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
    .tl-dot { width:14px; height:14px; border-radius:50%; flex-shrink:0; }
    .tl-dot-now { background:#6366f1; box-shadow:0 0 0 4px #6366f120; }
    .tl-dot-soon { background:#fbbf24; }
    .tl-dot-future { background:#334155; border:2px solid #475569; }
    .tl-line { width:2px; flex:1; background:#1e3a5f; margin:4px auto; }
    .tl-right { padding-bottom:8px; }
    .tl-period { font-size:11px; color:#64748b; font-weight:600; margin-bottom:4px; }
    .tl-action { font-size:14px; font-weight:700; color:#f1f5f9; margin-bottom:4px; }
    .tl-detail { font-size:13px; color:#94a3b8; line-height:1.6; }

    /* 반응형 */
    @media (max-width:640px) {
      .report-title { font-size:22px; }
      .target-table th:nth-child(4), .target-table td:nth-child(4) { display:none; }
    }
  </style>
</head>
<body>

<!-- 잠금 화면 -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔒</div>
    <div class="lock-title">AI 투자 레포트</div>
    <div class="lock-sub">개인 자산 연동 분석 — 비밀번호를 입력하세요</div>
    <input type="password" id="pwInput" class="lock-input" placeholder="비밀번호" />
    <button class="lock-btn" onclick="tryUnlock()">분석 레포트 열기</button>
    <div class="lock-err" id="lockErr">비밀번호가 올바르지 않습니다</div>
  </div>
</div>

<!-- 대시보드 -->
<div id="dashboard">
  <!-- 헤더 -->
  <div class="report-header">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
      <div>
        <div class="report-badge">AI REAL ESTATE ANALYST</div>
        <div class="report-title">서울 10개 구 갭투자<br>개인 맞춤 분석 레포트</div>
        <div class="report-meta">
          📅 분석 기준일: {snap.snapshotDate} &nbsp;|&nbsp; 🏙 분석 대상: 서울 10개 구 30개 단지
        </div>
      </div>
      <a href="/property/region-analysis/" style="font-size:13px;color:#64748b;text-decoration:none;margin-top:4px;">← 지역 분석 목록</a>
    </div>
  </div>

  <!-- 자산 현황 -->
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">순자산 (Net Worth)</div>
      <div class="stat-value stat-ok">{fmtWon(netWorth)}</div>
      <div class="stat-sub">목표 5억 대비 {goalPct}% 달성</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">현금 + 적금</div>
      <div class="stat-value stat-warn">{fmtWon(liquidCash)}</div>
      <div class="stat-sub">즉시 가용 — 투자자산 대비 매우 낮음</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">투자자산 (주식)</div>
      <div class="stat-value">{fmtWon(totalInvest)}</div>
      <div class="stat-sub">수익 +{summary.investmentGainRate.toFixed(1)}% (원가 대비)</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">총 부채 / 월 이자</div>
      <div class="stat-value stat-warn">{fmtWon(summary.totalDebt)}</div>
      <div class="stat-sub">월 {Math.round(summary.monthlyInterest / 10000).toLocaleString()}만원 이자</div>
    </div>
  </div>

  <!-- 경고 배너 -->
  <div class="alert-row">
    <div class="alert alert-danger">
      <div class="alert-icon">⚡</div>
      <div class="alert-body">
        <strong>SK하이닉스 단일종목 집중도 {skhRatio}%</strong>
        <span>투자자산 {fmtWon(totalInvest)} 중 {fmtWon(Math.round(skhEval))}이 SK하이닉스 포지션입니다. 반도체 업황 급변 시 순자산 전체가 흔들릴 수 있는 구조입니다.</span>
      </div>
    </div>
    {daysToMaturity !== null && (
      <div class="alert alert-warn">
        <div class="alert-icon">⏰</div>
        <div class="alert-body">
          <strong>신한은행 1억 대출 만기 {daysToMaturity}일 후 ({shinhan!.maturityDate})</strong>
          <span>만기일시상환 대출 — 만기 전 재연장(롤오버) 또는 상환 결정 필요. 부동산 투자 타이밍과 충돌할 수 있어 사전 계획이 중요합니다.</span>
        </div>
      </div>
    )}
    <div class="alert alert-info">
      <div class="alert-icon">🎯</div>
      <div class="alert-body">
        <strong>목표 5억까지 {fmtWon(needed)} 부족 (2027-02-28 마감)</strong>
        <span>현재 페이스: SK하이닉스 포지션({fmtWon(Math.round(skhEval))})이 {skhGrowthForGoal}% 추가 상승하면 목표 도달 가능. 단, 부동산 투자 시 자산 구성 변경 고려 필요.</span>
      </div>
    </div>
  </div>

  <!-- 투자 가능 자금 시나리오 -->
  <div class="section-title">갭투자 가능 자금 시나리오</div>
  <div class="scen-grid" style="margin-bottom:32px;">
    <div class="scen-card">
      <div class="scen-label">시나리오 A — 보수적</div>
      <div class="scen-amount">{fmt억(scenCash)}</div>
      <div class="scen-desc">현금 + 적금만 활용. 주식 매도 없음. 현재 상태에서 즉시 동원 가능한 최소 자금.</div>
      <div class="scen-bar"><div class="scen-fill" style={`width:${Math.min(scenCash/4*100,100)}%;background:#64748b;`}></div></div>
      <div class="scen-possible no">✗ 서울 갭투자 불가 (최소 1억↑ 필요)</div>
    </div>
    <div class="scen-card active">
      <div class="scen-label">시나리오 B — 중간 ★추천</div>
      <div class="scen-amount">{fmt억(scen30)}</div>
      <div class="scen-desc">투자자산 30% 청산 (SK하이닉스 일부 차익실현) + 현금. SK하이닉스 차익 약 {fmtWon(Math.round(totalInvest * 0.3))} 매도 기준.</div>
      <div class="scen-bar"><div class="scen-fill" style={`width:${Math.min(scen30/4*100,100)}%;background:#6366f1;`}></div></div>
      <div class="scen-possible partial">△ 최소한의 진입 가능권 (구체 단지 분석 필요)</div>
    </div>
    <div class="scen-card">
      <div class="scen-label">시나리오 C — 공격적</div>
      <div class="scen-amount">{fmt억(scen60)}</div>
      <div class="scen-desc">투자자산 60% 청산. SK하이닉스 비중을 40% 이하로 낮추며 자금 확보. 포트폴리오 리밸런싱 효과도 있음.</div>
      <div class="scen-bar"><div class="scen-fill" style={`width:${Math.min(scen60/4*100,100)}%;background:#10b981;`}></div></div>
      <div class="scen-possible ok">✓ 노원·도봉 핵심 단지 진입 가능</div>
    </div>
  </div>

  <!-- 추천 단지 TOP 6 -->
  <div class="target-section">
    <div class="section-title">갭투자 최적 타겟 단지 TOP 6</div>
    <div style="font-size:13px;color:#64748b;margin-bottom:16px;">
