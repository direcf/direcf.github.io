---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import propertyData from "../../../../data/property.json";

const distFiles = import.meta.glob('../../../../data/districts/*.json', { eager: true });
const districts = Object.values(distFiles).map((m) => (m as any).default || m);

const snap = [...propertyData.snapshots].sort(
  (a, b) => new Date(b.snapshotDate).getTime() - new Date(a.snapshotDate).getTime()
)[0];

function parseAeok(s: string | null | undefined): number | null {
  if (!s || s === '—') return null;
  const v = parseFloat(String(s).replace('억', ''));
  return isNaN(v) ? null : v;
}
function fmt억(n: number | null, d = 2): string {
  if (n == null) return '—';
  return n >= 1 ? n.toFixed(d) + '억' : Math.round(n * 10000).toLocaleString() + '만';
}
function fmtWon(n: number): string {
  if (n >= 1e8) return (n / 1e8).toFixed(2) + '억원';
  if (n >= 1e4) return Math.round(n / 1e4).toLocaleString() + '만원';
  return n.toLocaleString() + '원';
}

const { summary, investments, loans } = snap;
const liquidCash = summary.cash + summary.savings;
const totalInvest = summary.investmentTotal;
const netWorth = summary.netWorth;

const scenCash = +(liquidCash / 1e8).toFixed(2);
const scen30   = +((liquidCash + totalInvest * 0.3) / 1e8).toFixed(2);
const scen60   = +((liquidCash + totalInvest * 0.6) / 1e8).toFixed(2);

const skhEval = investments
  .filter((i) => i.eval > 100000 && (i.name.includes('SK하이닉스') || (i.name.includes('레버리지') && i.name.includes('SK'))))
  .reduce((s, i) => s + i.eval, 0);
const skhRatio = Math.round(skhEval / totalInvest * 100);

const shinhan = loans.find((l) => l.bank === '신한은행' && l.maturityDate);
const matDate = shinhan ? shinhan.maturityDate : null;
const daysToMaturity = shinhan
  ? Math.round((new Date(shinhan.maturityDate!).getTime() - new Date(snap.snapshotDate).getTime()) / (1000*60*60*24))
  : null;

const needed = propertyData.goal.target - netWorth;
const goalPct = Math.round(netWorth / propertyData.goal.target * 100);
const skhGrowthForGoal = needed > 0 ? +(needed / skhEval * 100).toFixed(1) : 0;

const gradeMap: Record<string, number> = { S:5,'A+':5,A:4,'B+':4,B:3,'B-':3,C:2,D:1 };
const allComplexes = (districts as any[]).flatMap((d) => {
  const trafficScore = gradeMap[d.locationAnalysis?.traffic?.grade] || 3;
  const attrScore = d.attractionStars || 1;
  const supplyBonus = (d.quickStats?.supply3yr || 9999) < 1000 ? 1 : 0;
  return (d.complexAnalysis || []).map((c: any) => {
    const sale = parseAeok(c.sale);
    const lease = parseAeok(c.lease);
    const gap  = (sale && lease) ? +(sale - lease).toFixed(2) : null;
    const rate = (sale && lease) ? Math.round(lease / sale * 100) : null;
    const score = (attrScore/5*100)*0.35 + (rate||0)*0.35 + (trafficScore/5*100)*0.15 + supplyBonus*15;
    return { district: d.name, slug: d.slug, attraction: d.attractionStars, tier: c.tier,
             name: c.name, year: c.year, size: c.size, sale, lease, gap, rate, score,
             trafficGrade: d.locationAnalysis?.traffic?.grade, supply3yr: d.quickStats?.supply3yr };
  }).filter((c: any) => c.gap !== null);
});

const topTargets: any[] = [...allComplexes]
  .sort((a, b) => a.gap - b.gap).slice(0, 9)
  .sort((a, b) => b.score - a.score).slice(0, 6);

const marketNews = [
  { icon: '🏦', label: '기준금리', value: '2.5% 동결', trend: 'neutral',
    detail: '한국은행 2026년 금리 인하 기대 사실상 종료. 부동산 고금리 환경 장기화 전망.', date: '2026.01' },
  { icon: '🏗', label: '서울 공급', value: '9,600세대', trend: 'up',
    detail: '2026년 서울 입주 물량. 전년(3.7만) 대비 74% 급감 — 공급 부족이 가격 하방 지지.', date: '2026' },
  { icon: '💾', label: 'SK하이닉스 HBM', value: '목표 165~300만', trend: 'up',
    detail: 'HBM 수급 불균형 2028년까지 지속 전망. 씨티증권 영업이익 8.1조 추정치 상향.', date: '2026.06' },
  { icon: '📋', label: '스트레스 DSR 3단계', value: '대출한도 ↓', trend: 'down',
    detail: '수도권 규제지역 스트레스 금리 3%↑ 적용, LTV 80→70% 강화. 갭투자 자금 조달 난이도 상승.', date: '2025.07~' },
];
---

<BaseLayout
  title="AI 투자 레포트"
  description="자산 연동 AI 부동산 투자 분석 레포트"
  activeSlug="property"
  crumbs={[
    {label:"Property", href:"/property/"},
    {label:"지역 분석", href:"/property/region-analysis/"},
    {label:"AI 레포트"}
  ]}
>

<style>
  /* 보조 상태 색상 — light/dark 각각 */
  :root {
    --c-green: #059669; --c-green-bg: #d1fae5; --c-green-bd: #6ee7b7;
    --c-red:   #dc2626; --c-red-bg:   #fee2e2; --c-red-bd:   #fca5a5;
    --c-amber: #b45309; --c-amber-bg: #fef3c7; --c-amber-bd: #fcd34d;
  }
  [data-theme="dark"] {
    --c-green: #10d4a0; --c-green-bg: rgba(16,212,160,.1);  --c-green-bd: rgba(16,212,160,.28);
    --c-red:   #f87171; --c-red-bg:   rgba(248,113,113,.1); --c-red-bd:   rgba(248,113,113,.28);
    --c-amber: #fbbf24; --c-amber-bg: rgba(251,191,36,.1);  --c-amber-bd: rgba(251,191,36,.28);
  }

  /* ── 잠금 화면 (항상 dark overlay) ── */
  #lockScreen { position:fixed; inset:0; z-index:9999;
    background:radial-gradient(ellipse at 30% 40%,rgba(20,60,130,.6),transparent 65%),
               radial-gradient(ellipse at 75% 70%,rgba(10,40,100,.45),transparent 60%),
               #060d1e;
    display:flex; align-items:center; justify-content:center; }
  .lock-card { background:rgba(12,28,65,.88); border:1px solid rgba(130,200,255,.35);
    border-radius:24px; padding:52px 48px; width:400px; text-align:center;
    backdrop-filter:blur(24px);
    box-shadow:0 0 80px rgba(50,120,255,.15),0 8px 48px rgba(0,0,0,.7);
    position:relative; overflow:hidden; }
  .lock-card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px;
    background:linear-gradient(90deg,transparent,rgba(130,200,255,.7),transparent); }
  .lock-icon  { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,.6)); }
  .lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
  .lock-sub   { font-size:13px; color:#92bfdf; margin-bottom:32px; }
  .lock-input { width:100%; padding:14px 18px; box-sizing:border-box;
    background:rgba(8,22,58,.9); border:1px solid rgba(130,200,255,.35); border-radius:12px;
    color:#d8eeff; font-size:16px; outline:none; text-align:center; letter-spacing:3px;
    transition:border-color .2s,box-shadow .2s; }
  .lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,.2); }
  .lock-btn { width:100%; margin-top:14px; padding:14px;
    background:linear-gradient(135deg,#1a60d0,#0d3d9e); border:1px solid rgba(80,170,255,.4);
    border-radius:12px; color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer; transition:all .2s; }
  .lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px);
    box-shadow:0 4px 24px rgba(30,100,255,.4); }
  .lock-err  { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
  .lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

  /* ── 대시보드 ── */
  #dashboard { display:none; }
  .dash-root { max-width:1120px; margin:0 auto; padding:24px 20px 80px; }

  /* Section label */
  .sec-label { font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
    color:var(--muted); margin-bottom:16px; display:flex; align-items:center; gap:8px; }
  .sec-label::before { content:''; display:block; width:3px; height:14px;
    background:var(--accent); border-radius:2px; flex-shrink:0; }

  /* Report header */
  .report-header { position:relative; background:var(--bg-card); border:1px solid var(--border);
    border-radius:20px; padding:36px 40px; margin-bottom:24px; overflow:hidden;
    box-shadow:var(--shadow-md); }
  .report-header::before { content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,var(--accent),#059669,transparent); }
  .report-badge { display:inline-block; padding:3px 10px; border:1px solid var(--border);
    border-radius:20px; font-size:9px; font-weight:700; letter-spacing:.15em;
    color:var(--muted); text-transform:uppercase; margin-bottom:12px; }
  .report-title { font-size:26px; font-weight:900; letter-spacing:-1px; color:var(--text);
    margin-bottom:8px; line-height:1.2; }
  .report-meta { font-size:12px; color:var(--muted); }
  .report-nav { position:absolute; right:40px; top:50%; transform:translateY(-50%);
    font-size:12px; color:var(--muted); text-decoration:none; }
  .report-nav:hover { color:var(--accent); }

  /* KPI cards */
  .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:14px; margin-bottom:20px; }
  .kpi-card { position:relative; background:var(--bg-card); border:1px solid var(--border);
    border-radius:16px; padding:22px 24px; box-shadow:var(--shadow-sm); overflow:hidden; }
  .accent-bar { position:absolute; top:0; left:0; right:0; height:3px; }
  .accent-indigo { background:linear-gradient(90deg,var(--accent),transparent); }
  .accent-teal   { background:linear-gradient(90deg,#059669,transparent); }
  .accent-coral  { background:linear-gradient(90deg,#dc2626,transparent); }
  .accent-gold   { background:linear-gradient(90deg,#d97706,transparent); }
  .kpi-label { font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
    color:var(--muted); margin-bottom:10px; }
  .kpi-big { font-size:24px; font-weight:900; letter-spacing:-1px; color:var(--text); margin-bottom:4px; }
  .kpi-sub { font-size:11px; color:var(--muted); }
  .kpi-green  { color:var(--c-green)  !important; }
  .kpi-red    { color:var(--c-red)    !important; }
  .kpi-amber  { color:var(--c-amber)  !important; }
  .kpi-accent { color:var(--accent)   !important; }

  /* Alert banners */
  .alert-stack { display:flex; flex-direction:column; gap:10px; margin-bottom:24px; }
  .alert { display:flex; align-items:flex-start; gap:12px; padding:14px 18px;
    border-radius:12px; font-size:13px; line-height:1.6; }
  .alert-danger { background:var(--accent-soft); border:1px solid rgba(29,78,216,.25); }
  .alert-warn   { background:var(--c-amber-bg);  border:1px solid var(--c-amber-bd); }
  .alert-info   { background:var(--c-green-bg);  border:1px solid var(--c-green-bd); }
  .alert-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
  .alert strong { color:var(--text); display:block; font-weight:700; margin-bottom:2px; font-size:13px; }
  .alert span { color:var(--text-2); font-size:12px; }

  /* Market news */
  .news-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:14px; margin-bottom:28px; }
  .news-chip { background:var(--bg-card); border:1px solid var(--border);
    border-radius:14px; padding:18px 20px; box-shadow:var(--shadow-sm); }
  .news-chip-icon { font-size:22px; margin-bottom:10px; }
  .news-chip-header { display:flex; align-items:baseline; gap:8px; margin-bottom:6px; flex-wrap:wrap; }
  .news-chip-label { font-size:10px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:var(--muted); }
  .news-chip-value { font-size:14px; font-weight:800; color:var(--text); }
  .news-chip-detail { font-size:11px; color:var(--text-2); line-height:1.6; margin-bottom:8px; }
  .news-chip-date { font-size:10px; color:var(--muted); font-weight:600; }
  .trend-up      { color:var(--c-green)  !important; }
  .trend-down    { color:var(--c-red)    !important; }
  .trend-neutral { color:var(--c-amber)  !important; }

  /* Scenario cards */
  .scen-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
    gap:14px; margin-bottom:28px; }
  .scen-card { position:relative; background:var(--bg-card); border:1px solid var(--border);
    border-radius:16px; padding:22px 24px; box-shadow:var(--shadow-sm); transition:border-color .2s,box-shadow .2s; }
  .scen-card.active { border-color:var(--accent); box-shadow:var(--shadow-md); }
  .scen-tag { display:inline-block; padding:2px 8px; border-radius:4px; font-size:9px;
    font-weight:700; letter-spacing:.1em; text-transform:uppercase; margin-bottom:10px; }
  .tag-grey   { background:var(--bg-soft); color:var(--muted); }
  .tag-indigo { background:var(--accent-soft); color:var(--accent); border:1px solid rgba(29,78,216,.2); }
  .tag-teal   { background:var(--c-green-bg); color:var(--c-green); border:1px solid var(--c-green-bd); }
  .scen-amount { font-size:28px; font-weight:900; letter-spacing:-1.5px; color:var(--text); margin-bottom:6px; }
  .scen-desc { font-size:12px; color:var(--muted); line-height:1.6; margin-bottom:14px; }
  .scen-bar-track { height:5px; background:var(--bg-soft); border-radius:3px; overflow:hidden; margin-bottom:10px; }
  .scen-bar-fill { height:100%; border-radius:3px; }
  .fill-grey   { background:var(--border); }
  .fill-indigo { background:linear-gradient(90deg,var(--accent),#60a5fa); }
  .fill-teal   { background:linear-gradient(90deg,#059669,#34d399); }
  .scen-verdict { font-size:11px; font-weight:600; }
  .verdict-no      { color:var(--c-red); }
  .verdict-partial { color:var(--c-amber); }
  .verdict-ok      { color:var(--c-green); }

  /* Target table */
  .target-wrap { background:var(--bg-card); border:1px solid var(--border);
    border-radius:16px; overflow:hidden; box-shadow:var(--shadow-sm); margin-bottom:28px; }
  .target-table { width:100%; border-collapse:collapse; }
  .target-table th { font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
    color:var(--muted); padding:14px 16px; text-align:left;
    border-bottom:1px solid var(--border); background:var(--bg-soft); }
  .target-table td { padding:14px 16px; border-bottom:1px solid var(--border);
    font-size:13px; vertical-align:middle; color:var(--text); }
  .target-table tr:last-child td { border-bottom:none; }
  .target-table tbody tr:hover td { background:var(--accent-soft); }
  .rank-badge { display:inline-flex; align-items:center; justify-content:center;
    width:22px; height:22px; border-radius:50%; font-size:10px; font-weight:800; }
  .rank-1 { background:linear-gradient(135deg,#d97706,#92400e); color:#fff; }
  .rank-2 { background:var(--bg-soft); color:var(--muted); border:1px solid var(--border); }
  .rank-3 { background:var(--c-amber-bg); color:var(--c-amber); border:1px solid var(--c-amber-bd); }
  .rank-n { background:var(--bg-soft); color:var(--muted); border:1px solid var(--border); }
  .tier-badge { padding:2px 7px; border-radius:4px; font-size:9px; font-weight:700;
    letter-spacing:.05em; text-transform:uppercase; }
  .tier-대장  { background:var(--accent-soft); color:var(--accent); }
  .tier-중위  { background:var(--c-green-bg);  color:var(--c-green); }
  .tier-팔로우 { background:var(--c-amber-bg); color:var(--c-amber); }
  .gap-bar-wrap { width:80px; }
  .gap-bar { height:5px; background:var(--bg-soft); border-radius:3px; overflow:hidden; display:flex; }
  .gap-bar-lease { height:100%; background:var(--accent); }
  .gap-bar-gap   { height:100%; background:var(--c-amber); }
  .rate-pill { display:inline-block; margin-top:4px; padding:1px 6px; border-radius:3px; font-size:9px; font-weight:700; }
  .rate-high { background:var(--c-green-bg); color:var(--c-green); }
  .rate-mid  { background:var(--c-amber-bg); color:var(--c-amber); }
  .rate-low  { background:var(--c-red-bg);   color:var(--c-red); }

  /* Expert section */
  .expert-wrap { position:relative; background:var(--bg-card); border:1px solid var(--border);
    border-radius:18px; padding:32px 36px; box-shadow:var(--shadow-md);
    margin-bottom:24px; overflow:hidden; }
  .expert-wrap::before { content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,var(--accent),#059669,transparent); }
  .expert-header { display:flex; align-items:center; gap:14px; margin-bottom:24px; }
  .expert-avatar { width:46px; height:46px; border-radius:50%;
    background:linear-gradient(135deg,var(--accent),#7c3aed);
    display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
  .expert-name { font-size:14px; font-weight:800; color:var(--text); }
  .expert-role { font-size:11px; color:var(--muted); margin-top:2px; }
  .expert-body p { font-size:13px; color:var(--text-2); line-height:1.9; margin-bottom:14px; }
  .expert-body p:last-child { margin-bottom:0; }
  .expert-body strong { color:var(--text); font-weight:700; }
  .expert-highlight { background:var(--accent-soft); border-left:3px solid var(--accent);
    padding:14px 18px; border-radius:0 10px 10px 0; margin:18px 0;
    font-size:13px; color:var(--text-2); line-height:1.8; }
  .expert-highlight strong { color:var(--accent); }

  /* Risk grid */
  .risk-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:14px; margin-bottom:28px; }
  .risk-card { background:var(--bg-card); border:1px solid var(--border);
    border-radius:14px; padding:20px; box-shadow:var(--shadow-sm); }
  .risk-level-badge { display:inline-block; padding:2px 8px; border-radius:4px; font-size:9px;
    font-weight:700; letter-spacing:.1em; text-transform:uppercase; margin-bottom:10px; }
  .level-high { background:var(--c-red-bg);   color:var(--c-red);   border:1px solid var(--c-red-bd); }
  .level-mid  { background:var(--c-amber-bg); color:var(--c-amber); border:1px solid var(--c-amber-bd); }
  .level-low  { background:var(--c-green-bg); color:var(--c-green); border:1px solid var(--c-green-bd); }
  .risk-title { font-size:13px; font-weight:700; color:var(--text); margin-bottom:8px; }
  .risk-desc  { font-size:12px; color:var(--text-2); line-height:1.7; }

  /* Timeline */
  .timeline-wrap { background:var(--bg-card); border:1px solid var(--border);
    border-radius:16px; padding:28px 32px; box-shadow:var(--shadow-sm); margin-bottom:28px; }
  .tl-item { display:flex; gap:16px; margin-bottom:22px; }
  .tl-item:last-child { margin-bottom:0; }
  .tl-left { display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
  .tl-dot { width:12px; height:12px; border-radius:50%; flex-shrink:0; }
  .tl-dot-now    { background:var(--accent); box-shadow:0 0 0 4px var(--accent-soft); }
  .tl-dot-soon   { background:var(--c-amber); }
  .tl-dot-future { background:var(--bg-soft); border:2px solid var(--border); }
  .tl-line { width:1px; flex:1; background:var(--border); margin:4px auto; }
  .tl-period { font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    color:var(--muted); margin-bottom:4px; }
  .tl-action { font-size:14px; font-weight:700; color:var(--text); margin-bottom:4px; }
  .tl-detail { font-size:12px; color:var(--text-2); line-height:1.7; }

  .disclaimer { text-align:center; padding:32px 0 0; font-size:11px;
    color:var(--muted); border-top:1px solid var(--border); }

  .sub-note { font-size:11px; color:var(--muted); margin-bottom:12px; margin-top:-8px; }

  @media (max-width:640px) {
    .report-header { padding:24px; }
    .report-title { font-size:20px; }
    .report-nav { display:none; }
    .dash-root { padding:16px 14px 60px; }
    .target-table th:nth-child(4), .target-table td:nth-child(4) { display:none; }
    .expert-wrap { padding:22px; }
    .timeline-wrap { padding:20px; }
  }
</style>

<div id="prop-root">

<!-- 잠금 화면 -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">📊</div>
    <div class="lock-title">AI Investment Report</div>
    <div class="lock-sub">개인 자산 연동 — 비밀번호를 입력하세요</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">레포트 열기</button>
