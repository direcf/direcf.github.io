import propertyData from "../../../../data/property.json";

const distFiles = import.meta.glob('../../../../data/districts/*.json', { eager: true });
const districts = Object.values(distFiles).map((m) => (m as any).default || m);

const snap = [...propertyData.snapshots].sort(
  (a, b) => new Date(b.snapshotDate).getTime() - new Date(a.snapshotDate).getTime()
)[0];

function parseAeok(s: string | null | undefined): number | null {
  if (!s || s === '—') return null;
  const v = parseFloat(String(s).replace('억', ''));
  return isNaN(v) ? null : v;
}
function fmt억(n: number | null, d = 2): string {
  if (n == null) return '—';
  return n >= 1 ? n.toFixed(d) + '억' : Math.round(n * 10000).toLocaleString() + '만';
}
function fmtWon(n: number): string {
  if (n >= 1e8) return (n / 1e8).toFixed(2) + '억원';
  if (n >= 1e4) return Math.round(n / 1e4).toLocaleString() + '만원';
  return n.toLocaleString() + '원';
}

const { summary, investments, loans } = snap;
const liquidCash = summary.cash + summary.savings;
const totalInvest = summary.investmentTotal;
const netWorth = summary.netWorth;

const scenCash = +(liquidCash / 1e8).toFixed(2);
const scen30   = +((liquidCash + totalInvest * 0.3) / 1e8).toFixed(2);
const scen60   = +((liquidCash + totalInvest * 0.6) / 1e8).toFixed(2);

const skhEval = investments
  .filter((i) => i.eval > 100000 && (i.name.includes('SK하이닉스') || (i.name.includes('레버리지') && i.name.includes('SK'))))
  .reduce((s, i) => s + i.eval, 0);
const skhRatio = Math.round(skhEval / totalInvest * 100);

const shinhan = loans.find((l) => l.bank === '신한은행' && l.maturityDate);
const matDate = shinhan ? shinhan.maturityDate : null;
const daysToMaturity = shinhan
  ? Math.round((new Date(shinhan.maturityDate!).getTime() - new Date(snap.snapshotDate).getTime()) / (1000*60*60*24))
  : null;

const needed = propertyData.goal.target - netWorth;
const goalPct = Math.round(netWorth / propertyData.goal.target * 100);
const skhGrowthForGoal = needed > 0 ? +(needed / skhEval * 100).toFixed(1) : 0;

const gradeMap: Record<string, number> = { S:5,'A+':5,A:4,'B+':4,B:3,'B-':3,C:2,D:1 };
const allComplexes = (districts as any[]).flatMap((d) => {
  const trafficScore = gradeMap[d.locationAnalysis?.traffic?.grade] || 3;
  const attrScore = d.attractionStars || 1;
  const supplyBonus = (d.quickStats?.supply3yr || 9999) < 1000 ? 1 : 0;
  return (d.complexAnalysis || []).map((c: any) => {
    const sale = parseAeok(c.sale);
    const lease = parseAeok(c.lease);
    const gap = (sale && lease) ? +(sale - lease).toFixed(2) : null;
    const rate = (sale && lease) ? Math.round(lease / sale * 100) : null;
    const score = (attrScore/5*100)*0.35 + (rate||0)*0.35 + (trafficScore/5*100)*0.15 + supplyBonus*15;
    return { district: d.name, slug: d.slug, attraction: d.attractionStars, tier: c.tier,
             name: c.name, year: c.year, size: c.size, sale, lease, gap, rate, score,
             trafficGrade: d.locationAnalysis?.traffic?.grade, supply3yr: d.quickStats?.supply3yr };
  }).filter((c: any) => c.gap !== null);
});

const topTargets: any[] = [...allComplexes]
  .sort((a, b) => a.gap - b.gap).slice(0, 9)
  .sort((a, b) => b.score - a.score).slice(0, 6);

// 최신 시장 뉴스 (빌드타임 고정 — region-analysis skill로 갱신)
const marketNews = [
  { icon: '🏦', label: '기준금리', value: '2.5% 동결', trend: 'neutral',
    detail: '한국은행 2026년 금리 인하 기대 사실상 종료. 부동산 고금리 환경 장기화 전망.', date: '2026.01' },
  { icon: '🏗', label: '서울 공급', value: '9,600세대', trend: 'up',
    detail: '2026년 서울 입주 물량. 전년(3.7만) 대비 74% 급감 — 공급 부족이 가격 하방 지지.', date: '2026' },
  { icon: '💾', label: 'SK하이닉스 HBM', value: '목표 165~300만', trend: 'up',
    detail: 'HBM 수급 불균형 2028년까지 지속 전망. 씨티증권 영업이익 8.1조 추정치 상향.', date: '2026.06' },
  { icon: '📋', label: '스트레스 DSR 3단계', value: '대출한도 ↓', trend: 'down',
    detail: '수도권 규제지역 스트레스 금리 3%↑ 적용, LTV 80→70% 강화. 갭투자 자금 조달 난이도 상승.', date: '2025.07~' },
];
