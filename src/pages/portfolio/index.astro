        </div>
        <div class="p-jobdate"><span class="p-kr">2023.01 – 현재</span><span class="p-en">Jan 2023 – Present</span></div>
      </div>

      <!-- ORBIT -->
      <div class="p-card">
        <div class="p-chead"><div class="p-cname">ORBIT — Physical AI</div><div class="p-cdate">2026.08 – 2026.12</div></div>
        <div class="p-crole"><span class="p-kr">메인 개발자 · Enterprise 사업본부 / Enterprise 기술지원팀</span><span class="p-en">Lead Developer · Enterprise Division / Enterprise Tech Support</span></div>
        <ul class="p-b">
