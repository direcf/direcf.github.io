          <span class="badge">Kubernetes</span>
          <span class="badge">NVIDIA Triton</span>
          <span class="badge">Redis</span>
          <span class="badge">Kafka</span>
        </div>
      </div>
    </div>

    <!-- Publications -->
    <div class="r-section">
      <div class="r-section-title">Publications</div>
      <p style="font-size:13px;color:var(--text-muted,#6b7280);font-style:italic;">
        In preparation — targeting CVPR / ICCV 2027.
