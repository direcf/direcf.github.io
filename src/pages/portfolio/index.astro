      <img class="r-avatar" src="/favicon.ico" alt="Seungjun Lee" />
      <div class="r-header-info">
        <h1 class="r-name">Seungjun Lee</h1>
        <p class="r-title">AI / Vision Research Engineer</p>
        <div class="r-contact">
          <span>hackon7120@gmail.com</span>
          <span>Seoul, South Korea</span>
          <span><a href="https://github.com/direcf" target="_blank">github.com/direcf</a></span>
          <span><a href="https://direcf.github.io" target="_blank">direcf.github.io</a></span>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <div class="r-section">
