---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Portfolio" activeSlug="portfolio" crumbs={[{label:"Personal"},{label:"Portfolio"}]}>
<style>
/* ── Lock Screen ───────────────────────────────────────────────── */
#lockScreen {
  position: fixed; inset: 0; z-index: 9999;
  background: radial-gradient(ellipse at 30% 40%, rgba(20,60,130,0.6), transparent 65%),
              radial-gradient(ellipse at 75% 70%, rgba(10,40,100,0.45), transparent 60%),
              #060d1e;
  display: flex; align-items: center; justify-content: center;
}
.lock-card {
  background: rgba(12,28,65,0.88);
  border: 1px solid rgba(130,200,255,0.35);
  border-radius: 24px; padding: 52px 48px; width: 400px; text-align: center;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 80px rgba(50,120,255,0.15), 0 8px 48px rgba(0,0,0,0.7);
  position: relative; overflow: hidden;
}
.lock-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background: linear-gradient(90deg, transparent, rgba(130,200,255,0.7), transparent);
}
.lock-icon { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,0.6)); }
.lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
.lock-sub { font-size:13px; color:#92bfdf; margin-bottom:32px; }
.lock-input {
  width:100%; padding:14px 18px; box-sizing:border-box;
  background:rgba(8,22,58,0.9); border:1px solid rgba(130,200,255,0.35);
  border-radius:12px; color:#d8eeff; font-size:16px;
  outline:none; text-align:center; letter-spacing:3px;
  transition: border-color .2s, box-shadow .2s;
}
.lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,0.2); }
.lock-btn {
  width:100%; margin-top:14px; padding:14px;
  background:linear-gradient(135deg,#1a60d0,#0d3d9e);
  border:1px solid rgba(80,170,255,0.4); border-radius:12px;
  color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer;
  transition:all .2s; letter-spacing:0.5px;
}
.lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px); box-shadow:0 4px 24px rgba(30,100,255,0.4); }
.lock-err { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
.lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

/* ── Resume ────────────────────────────────────────────────────── */
#resume { display:none; }

.resume-wrap {
  max-width: 860px;
  margin: 0 auto;
  padding: 48px 32px 80px;
  font-family: 'Pretendard', 'Georgia', serif;
  color: var(--text);
  line-height: 1.6;
}

/* Header */
.r-header {
  display: flex;
  align-items: flex-start;
  gap: 32px;
  padding-bottom: 28px;
  border-bottom: 2px solid var(--accent, #3b82f6);
  margin-bottom: 36px;
}
.r-avatar {
  width: 88px; height: 88px;
  border-radius: 50%;
  border: 2px solid var(--accent, #3b82f6);
  object-fit: cover;
  flex-shrink: 0;
}
.r-header-info { flex: 1; }
.r-name {
  font-size: 32px; font-weight: 800; letter-spacing: -0.5px;
  color: var(--text);
  margin: 0 0 4px;
}
.r-title {
  font-size: 15px; color: var(--text-muted, #6b7280);
  font-weight: 500; margin: 0 0 12px;
  text-transform: uppercase; letter-spacing: 1px;
}
.r-contact {
  display: flex; flex-wrap: wrap; gap: 6px 18px;
  font-size: 13px; color: var(--text-muted, #6b7280);
}
.r-contact a { color: inherit; text-decoration: none; }
.r-contact a:hover { color: var(--accent, #3b82f6); }
.r-contact span::before { content: '· '; }
.r-contact span:first-child::before { content: ''; }

/* Sections */
.r-section { margin-bottom: 36px; }
.r-section-title {
  font-size: 11px; font-weight: 700; letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent, #3b82f6);
  margin: 0 0 16px;
  padding-bottom: 6px;
  border-bottom: 1px solid rgba(59,130,246,0.25);
}

/* Education / Experience blocks */
.r-block { margin-bottom: 22px; }
.r-block-header {
  display: flex; justify-content: space-between; align-items: baseline;
  flex-wrap: wrap; gap: 4px;
}
.r-block-name { font-size: 16px; font-weight: 700; }
.r-block-date { font-size: 12px; color: var(--text-muted, #6b7280); white-space: nowrap; }
.r-block-sub { font-size: 13px; color: var(--text-muted, #6b7280); margin: 2px 0 8px; font-style: italic; }
.r-block ul {
  margin: 6px 0 0 0; padding-left: 18px;
  font-size: 13.5px; color: var(--text);
}
.r-block ul li { margin-bottom: 5px; }

/* Badges */
.r-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.badge {
  font-size: 11.5px; font-weight: 600;
  padding: 4px 10px; border-radius: 6px;
  background: rgba(59,130,246,0.12);
  border: 1px solid rgba(59,130,246,0.25);
  color: var(--accent, #3b82f6);
}

/* Projects grid */
.r-projects { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.r-proj-card {
  border: 1px solid rgba(59,130,246,0.2);
  border-radius: 12px; padding: 18px 20px;
  background: rgba(59,130,246,0.04);
}
.r-proj-name { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
.r-proj-partner { font-size: 11px; color: var(--text-muted, #6b7280); margin-bottom: 8px; }
.r-proj-desc { font-size: 12.5px; line-height: 1.55; }

/* Patents / Challenges */
.r-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.r-pill {
  font-size: 12px; padding: 5px 12px; border-radius: 20px;
  background: rgba(16,185,129,0.1);
  border: 1px solid rgba(16,185,129,0.3);
  color: #10b981;
}
.r-pill.accent {
  background: rgba(245,158,11,0.1);
  border-color: rgba(245,158,11,0.3);
  color: #f59e0b;
}

/* Print */
@media print {
  #lockScreen { display: none !important; }
  #resume { display: block !important; }
  .resume-wrap { padding: 0; }
}
@media (max-width: 600px) {
  .r-projects { grid-template-columns: 1fr; }
  .r-header { flex-direction: column; gap: 16px; }
}
</style>

<!-- Lock Screen -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Portfolio</div>
    <div class="lock-sub">비공개 포트폴리오입니다.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / portfolio</div>
  </div>
</div>

<!-- Resume Content -->
<div id="resume">
  <div class="resume-wrap">

    <!-- Header -->
