---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Portfolio" activeSlug="portfolio" crumbs={[{label:"Personal"},{label:"Portfolio"}]}>
<style>
/* ── Lock Screen (unchanged) ───────────────────────────────────── */
#lockScreen {
  position: fixed; inset: 0; z-index: 9999;
  background: radial-gradient(ellipse at 30% 40%, rgba(20,60,130,0.6), transparent 65%),
              radial-gradient(ellipse at 75% 70%, rgba(10,40,100,0.45), transparent 60%),
              #060d1e;
  display: flex; align-items: center; justify-content: center;
}
.lock-card {
  background: rgba(12,28,65,0.88);
  border: 1px solid rgba(130,200,255,0.35);
  border-radius: 24px; padding: 52px 48px; width: 400px; text-align: center;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 80px rgba(50,120,255,0.15), 0 8px 48px rgba(0,0,0,0.7);
  position: relative; overflow: hidden;
}
.lock-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background: linear-gradient(90deg, transparent, rgba(130,200,255,0.7), transparent);
}
.lock-icon { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,0.6)); }
.lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
.lock-sub { font-size:13px; color:#92bfdf; margin-bottom:32px; }
.lock-input {
  width:100%; padding:14px 18px; box-sizing:border-box;
  background:rgba(8,22,58,0.9); border:1px solid rgba(130,200,255,0.35);
  border-radius:12px; color:#d8eeff; font-size:16px;
  outline:none; text-align:center; letter-spacing:3px;
  transition: border-color .2s, box-shadow .2s;
}
.lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,0.2); }
.lock-btn {
  width:100%; margin-top:14px; padding:14px;
  background:linear-gradient(135deg,#1a60d0,#0d3d9e);
  border:1px solid rgba(80,170,255,0.4); border-radius:12px;
  color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer;
  transition:all .2s; letter-spacing:0.5px;
}
.lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px); box-shadow:0 4px 24px rgba(30,100,255,0.4); }
.lock-err { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
.lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

/* ── Resume · Light Editorial ──────────────────────────────────── */
#resume {
  display:none;
  --bg:#f7f5f0; --ink:#1a1a1a; --muted:#6b665c; --faint:#8a8578;
  --accent:#b5762a; --line:#e2dccd; --card:#fffdf8;
  background:var(--bg); color:var(--ink);
  font-family:'Pretendard',-apple-system,system-ui,'Segoe UI',sans-serif;
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
.p-serif { font-family:'Georgia','Times New Roman',serif; }
.p-wrap { max-width:840px; margin:0 auto; padding:56px 40px 96px; }

.p-label { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--accent); font-weight:700; }
.p-name { font-size:56px; font-weight:700; letter-spacing:-1.2px; line-height:1.0; margin:22px 0 0; color:var(--ink); }
.p-role { font-size:19px; color:var(--muted); margin:14px 0 0; font-style:italic; }
.p-rule { height:2px; background:var(--ink); width:64px; margin:26px 0; }
.p-summary { font-size:15.5px; line-height:1.75; color:#33302a; max-width:640px; }
.p-summary b { color:var(--ink); }
.p-cta { margin-top:28px; display:flex; gap:12px; flex-wrap:wrap; }
.p-btn { padding:12px 22px; border-radius:7px; font-size:13.5px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:8px; cursor:pointer; border:none; }
.p-btnp { background:var(--ink); color:var(--bg); }
.p-btns { border:1px solid var(--line); color:var(--ink); background:var(--card); }
.p-meta { margin-top:26px; display:flex; gap:20px; flex-wrap:wrap; font-size:12.5px; color:var(--faint); }
.p-meta a { color:var(--faint); text-decoration:none; border-bottom:1px solid var(--line); }

.p-sec { margin-top:64px; }
.p-sech { font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:var(--faint); font-weight:700; padding-bottom:10px; border-bottom:1px solid var(--line); margin-bottom:26px; }

.p-jobhead { display:flex; justify-content:space-between; align-items:baseline; gap:16px; }
.p-jobco { font-family:'Georgia',serif; font-size:22px; font-weight:700; }
.p-jobrole { font-size:13.5px; color:var(--muted); margin-top:2px; }
.p-jobdate { font-size:12.5px; color:var(--accent); font-weight:700; white-space:nowrap; }
.p-proj { margin-top:26px; padding-left:20px; border-left:2px solid var(--line); transition:border-color .2s; }
.p-proj:hover { border-left-color:var(--accent); }
.p-projhead { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
.p-projname { font-size:15.5px; font-weight:700; }
.p-projdate { font-size:11.5px; color:var(--faint); white-space:nowrap; }
.p-b { margin:10px 0 0; padding-left:18px; }
.p-b li { font-size:13.5px; line-height:1.65; color:#3a3833; margin-bottom:6px; }
.p-b li b { color:var(--ink); }
.p-cls { margin-top:8px; display:flex; flex-wrap:wrap; gap:6px; }
.p-cls span { font-size:11px; background:#f2ead9; border:1px solid var(--line); color:#6b5a34; padding:4px 9px; border-radius:5px; font-family:'SF Mono','JetBrains Mono',monospace; }

.p-skrow { margin-bottom:16px; }
.p-skcat { font-size:12px; font-weight:700; color:var(--muted); margin-bottom:8px; }
.p-tags { display:flex; flex-wrap:wrap; gap:7px; }
.p-tags span { font-size:12px; background:var(--card); border:1px solid var(--line); color:#403c34; padding:6px 12px; border-radius:20px; }

.p-edu { display:flex; justify-content:space-between; gap:16px; margin-bottom:22px; }
.p-edusch { font-family:'Georgia',serif; font-size:17px; font-weight:700; }
.p-edudeg { font-size:13px; color:var(--muted); margin-top:3px; }
.p-eduth { font-size:12px; color:var(--faint); font-style:italic; margin-top:5px; max-width:520px; }
.p-edur { text-align:right; white-space:nowrap; }
.p-edudate { font-size:12px; color:var(--accent); font-weight:700; }
.p-edugpa { font-size:12.5px; color:var(--ink); font-weight:700; margin-top:4px; }
.p-eduhon { font-size:11px; color:var(--faint); font-style:italic; margin-top:2px; }

.p-patlead { font-size:14.5px; line-height:1.7; color:#33302a; margin-bottom:24px; }
.p-patlead b { color:var(--ink); }
.p-patbig { font-family:'Georgia',serif; font-size:19px; font-weight:700; color:var(--accent); }
.p-parea { display:flex; gap:16px; padding:14px 0; border-top:1px solid var(--line); }
.p-parea:last-child { border-bottom:1px solid var(--line); }
.p-pareanm { flex:0 0 190px; font-size:14px; font-weight:700; color:var(--ink); }
.p-pareanm .cnt { display:inline-block; margin-left:6px; font-size:11px; color:var(--accent); font-weight:700; }
.p-pdesc { font-size:13px; color:var(--muted); line-height:1.6; }

.p-cert { display:flex; gap:14px; align-items:flex-start; }
.p-certt { font-size:14.5px; font-weight:700; }
.p-certs { font-size:12.5px; color:var(--muted); margin-top:2px; }
.p-certy { margin-left:auto; font-size:12px; color:var(--accent); font-weight:700; white-space:nowrap; }

.p-aw { display:flex; gap:14px; align-items:flex-start; margin-bottom:16px; }
.p-awic { font-size:18px; line-height:1.3; }
.p-awt { font-size:14.5px; font-weight:700; }
.p-aws { font-size:12.5px; color:var(--muted); margin-top:2px; }
.p-awy { margin-left:auto; font-size:12px; color:var(--accent); font-weight:700; white-space:nowrap; }

.p-foot { margin-top:72px; padding-top:28px; border-top:1px solid var(--line); text-align:center; }
.p-footbig { font-family:'Georgia',serif; font-size:24px; font-weight:700; }
.p-footcl { margin-top:12px; font-size:13px; color:var(--muted); }
.p-footcl a { color:var(--accent); text-decoration:none; }
.p-footnote { margin-top:20px; font-size:11px; color:var(--faint); }

/* Floating download button */
.p-fab {
  position:fixed; right:28px; bottom:28px; z-index:50;
  background:var(--ink); color:var(--bg);
  padding:12px 18px; border-radius:30px; border:none; cursor:pointer;
  font-size:13px; font-weight:700; box-shadow:0 6px 24px rgba(0,0,0,.25);
  display:inline-flex; align-items:center; gap:8px;
}
.p-fab:hover { transform:translateY(-1px); }

@media (max-width:600px) {
  .p-wrap { padding:36px 22px 72px; }
  .p-name { font-size:40px; }
  .p-jobhead, .p-projhead, .p-edu { flex-direction:column; gap:4px; align-items:flex-start; }
  .p-edur { text-align:left; }
  .p-parea { flex-direction:column; gap:4px; }
  .p-pareanm { flex-basis:auto; }
}

/* ── Print → clean A4 resume ───────────────────────────────────── */
@media print {
  :global(.sidebar), :global(.sidebar-toggle), :global(.sb-backdrop), :global(.header) { display:none !important; }
  :global(.main) { margin:0 !important; }
  :global(.app) { display:block !important; }
  #lockScreen { display:none !important; }
  #resume { display:block !important; margin:0 !important; min-height:0; background:#fff !important; }
  .p-fab, .p-cta { display:none !important; }
  .p-wrap { max-width:none; padding:0 8px; }
  .p-sec { margin-top:30px; }
  .p-name { font-size:40px; }
  .p-sec, .p-proj, .p-edu, .p-parea, .p-aw, .p-cert, .p-jobhead { break-inside:avoid; }
  a { color:var(--ink) !important; }
}
</style>

