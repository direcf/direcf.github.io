---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Portfolio" activeSlug="portfolio" crumbs={[{label:"Personal"},{label:"Portfolio"}]}>
<style>
/* ── Lock Screen (unchanged) ───────────────────────────────────── */
#lockScreen {
  position: fixed; inset: 0; z-index: 9999;
  background: radial-gradient(ellipse at 30% 40%, rgba(20,60,130,0.6), transparent 65%),
              radial-gradient(ellipse at 75% 70%, rgba(10,40,100,0.45), transparent 60%),
              #060d1e;
  display: flex; align-items: center; justify-content: center;
}
.lock-card {
  background: rgba(12,28,65,0.88);
  border: 1px solid rgba(130,200,255,0.35);
  border-radius: 24px; padding: 52px 48px; width: 400px; text-align: center;
  backdrop-filter: blur(24px);
  box-shadow: 0 0 80px rgba(50,120,255,0.15), 0 8px 48px rgba(0,0,0,0.7);
  position: relative; overflow: hidden;
}
.lock-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background: linear-gradient(90deg, transparent, rgba(130,200,255,0.7), transparent);
}
.lock-icon { font-size:48px; margin-bottom:20px; filter:drop-shadow(0 0 14px rgba(80,170,255,0.6)); }
.lock-title { font-size:20px; font-weight:700; color:#c4e4ff; margin-bottom:6px; }
.lock-sub { font-size:13px; color:#92bfdf; margin-bottom:32px; }
.lock-input {
  width:100%; padding:14px 18px; box-sizing:border-box;
  background:rgba(8,22,58,0.9); border:1px solid rgba(130,200,255,0.35);
  border-radius:12px; color:#d8eeff; font-size:16px;
  outline:none; text-align:center; letter-spacing:3px;
  transition: border-color .2s, box-shadow .2s;
}
.lock-input:focus { border-color:#50aaff; box-shadow:0 0 0 3px rgba(80,170,255,0.2); }
.lock-btn {
  width:100%; margin-top:14px; padding:14px;
  background:linear-gradient(135deg,#1a60d0,#0d3d9e);
  border:1px solid rgba(80,170,255,0.4); border-radius:12px;
  color:#c4e4ff; font-size:15px; font-weight:700; cursor:pointer;
  transition:all .2s; letter-spacing:0.5px;
}
.lock-btn:hover { background:linear-gradient(135deg,#2070e0,#1050b8); transform:translateY(-1px); box-shadow:0 4px 24px rgba(30,100,255,0.4); }
.lock-err { font-size:12px; color:#f87171; margin-top:10px; min-height:18px; }
.lock-hint { font-size:11px; color:#6a96ba; margin-top:20px; }

/* ── Resume · Frost Card (site-native blue) ───────────────────────── */
#resume {
  display:none;
  /* local light palette — independent of global light/dark theme */
  --bg:#eef4fb; --card:#ffffff; --soft:#dde8f3; --border:#cfdbe8;
  --text:#0f1f3a; --text2:#2c3e5d; --muted:#6a7a92;
  --accent:#1d4ed8; --accent-soft:#dbeafe; --accent2:#0891b2;
  background:var(--bg); color:var(--text);
  font-family:-apple-system,"Apple SD Gothic Neo","Pretendard","SF Pro Text",sans-serif;
  -webkit-font-smoothing:antialiased;
  min-height:100vh; line-height:1.65;
}
.p-wrap { max-width:820px; margin:0 auto; padding:48px 40px 80px; }

/* small updated stamp (top) */
.p-updated { font-size:11px; color:var(--muted); font-weight:600; letter-spacing:.3px; margin-bottom:14px; }

/* language toggle */
#resume.lang-kr .p-en { display:none; }
#resume.lang-en .p-kr { display:none; }
.p-toggle { display:inline-flex; margin-top:18px; border:1px solid var(--border); border-radius:20px; overflow:hidden; font-size:12px; font-weight:700; background:#fff; }
.p-toggle button { padding:5px 15px; color:var(--muted); background:none; border:0; cursor:pointer; font:inherit; }
.p-toggle button.on { background:var(--accent); color:#fff; }

/* hero */
.p-label { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--accent); font-weight:800; }
.p-name { font-size:42px; font-weight:800; letter-spacing:-1.2px; margin-top:10px; line-height:1.05; }
.p-role { font-size:15px; color:var(--muted); margin-top:6px; }
.p-summary { font-size:14px; line-height:1.8; color:var(--text2); margin-top:18px; max-width:650px; }
.p-summary b { color:var(--text); }
.p-cta { margin-top:22px; display:flex; gap:10px; flex-wrap:wrap; }
.p-btn { padding:11px 20px; border-radius:8px; font-size:13px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:7px; cursor:pointer; border:none; }
.p-btnp { background:var(--accent); color:#fff; }
.p-btns { border:1px solid var(--border); color:var(--text); background:var(--card); }
.p-meta { margin-top:18px; display:flex; gap:18px; flex-wrap:wrap; font-size:12px; color:var(--muted); }
.p-meta a { color:var(--accent); text-decoration:none; }

/* sections */
.p-sec { margin-top:40px; }
.p-sech { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--muted); font-weight:800; padding-bottom:9px; border-bottom:2px solid var(--accent); display:inline-block; margin-bottom:16px; }

/* education */
.p-edu { display:flex; justify-content:space-between; gap:16px; margin-bottom:14px; }
.p-edusch { font-size:15px; font-weight:800; }
.p-edudeg { font-size:12.5px; color:var(--muted); margin-top:2px; }
.p-eduth { font-size:11.5px; color:var(--muted); font-style:italic; margin-top:3px; max-width:520px; }
.p-edur { text-align:right; white-space:nowrap; }
.p-edudate { font-size:12px; color:var(--accent); font-weight:700; }
.p-edugpa { font-size:12px; font-weight:700; margin-top:2px; }
.p-eduhon { font-size:11px; color:var(--muted); font-style:italic; }

/* career */
.p-jobhead { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:4px; gap:12px; }
.p-jobco { font-size:18px; font-weight:800; }
.p-jobrole { font-size:12.5px; color:var(--muted); margin-top:2px; }
.p-jobdate { font-size:12px; color:var(--accent); font-weight:700; white-space:nowrap; }
.p-card { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:16px 18px 15px; box-shadow:0 1px 2px rgba(30,58,138,.06); margin-top:12px; transition:border-color .15s; }
.p-card:hover { border-color:var(--accent); }
.p-chead { display:flex; justify-content:space-between; align-items:baseline; gap:10px; }
.p-cname { font-size:14.5px; font-weight:800; }
.p-cdate { font-size:11.5px; color:var(--accent); font-weight:700; white-space:nowrap; }
.p-crole { font-size:11.5px; color:var(--muted); margin-top:2px; }
.p-b { margin:9px 0 0; padding-left:16px; }
.p-b li { font-size:12.6px; line-height:1.62; color:var(--text2); margin-bottom:5px; }
.p-b li b { color:var(--text); }
.p-m { display:inline-block; background:var(--accent-soft); color:var(--accent); font-weight:700; font-size:11px; padding:1px 7px; border-radius:5px; }
.p-out { font-size:11.5px; color:var(--accent2); font-weight:700; margin-top:8px; padding-top:7px; border-top:1px dashed var(--border); }

/* skills */
.p-skrow { margin-bottom:13px; }
.p-skcat { font-size:12px; font-weight:800; color:var(--text); margin-bottom:7px; }
.p-tags { display:flex; flex-wrap:wrap; gap:6px; }
.p-tags span { font-size:11.5px; background:#fff; border:1px solid var(--border); color:var(--text2); padding:4px 10px; border-radius:16px; }

/* publications */
.p-pub { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:15px 18px; display:flex; justify-content:space-between; gap:12px; box-shadow:0 1px 2px rgba(30,58,138,.06); }
.p-pubt { font-size:13.5px; font-weight:700; }
.p-pubt i { font-weight:500; color:var(--muted); font-style:normal; }
.p-pubv { font-size:11.5px; color:var(--accent2); font-weight:700; white-space:nowrap; text-align:right; }

/* patents */
.p-plead { font-size:13px; color:var(--text2); margin-bottom:14px; }
.p-plead b { color:var(--accent); font-size:14.5px; }
.p-plead .prim { color:var(--accent2); font-weight:700; }
.p-area { border:1px solid var(--border); border-radius:12px; padding:13px 16px; margin-bottom:10px; background:var(--card); box-shadow:0 1px 2px rgba(30,58,138,.06); }
.p-ahead { display:flex; justify-content:space-between; align-items:baseline; }
.p-aname { font-size:13.5px; font-weight:800; }
.p-acnt { font-size:11px; color:var(--accent); font-weight:700; white-space:nowrap; }
.p-acnt .prim { color:var(--accent2); }
.p-reps { margin:8px 0 0; padding:0; list-style:none; }
.p-reps li { font-size:12px; color:var(--text2); padding:3px 0 3px 15px; position:relative; }
.p-reps li::before { content:''; position:absolute; left:0; top:10px; width:5px; height:5px; border-radius:50%; background:var(--accent2); box-shadow:0 0 0 3px rgba(8,145,178,.14); }
.p-reps li.plain::before { background:var(--muted); box-shadow:none; }
.p-more { font-size:11px; color:var(--muted); margin-top:6px; padding-left:15px; }

/* year rows (awards / certs) */
.p-row { display:grid; grid-template-columns:72px 1fr; gap:18px; align-items:baseline; padding:13px 0; border-bottom:1px solid var(--border); }
.p-row:last-child { border-bottom:none; }
.p-yr { font-size:13px; font-weight:800; color:var(--accent); font-variant-numeric:tabular-nums; letter-spacing:.3px; }
.p-it-t { font-size:13.5px; font-weight:700; color:var(--text); }
.p-it-s { font-size:12px; color:var(--muted); margin-top:2px; }
.p-rtag { font-size:10.5px; font-weight:700; color:var(--accent2); border:1px solid var(--border); border-radius:4px; padding:1px 6px; margin-left:7px; vertical-align:1px; }

/* footer */
.p-foot { margin-top:46px; padding-top:22px; border-top:1px solid var(--border); text-align:center; }
.p-footbig { font-size:20px; font-weight:800; }
.p-footcl { margin-top:8px; font-size:12px; color:var(--muted); }
.p-footcl a { color:var(--accent); text-decoration:none; }
.p-footnote { margin-top:16px; font-size:11px; color:var(--muted); }

/* floating download button */
.p-fab {
  position:fixed; right:28px; bottom:28px; z-index:50;
  background:var(--accent); color:#fff;
  padding:12px 18px; border-radius:30px; border:none; cursor:pointer;
  font-size:13px; font-weight:700; box-shadow:0 6px 24px rgba(30,58,138,.3);
  display:inline-flex; align-items:center; gap:8px;
}
.p-fab:hover { transform:translateY(-1px); }

@media (max-width:600px) {
  .p-wrap { padding:34px 22px 68px; }
  .p-name { font-size:34px; }
  .p-jobhead, .p-chead, .p-edu, .p-ahead { flex-direction:column; gap:3px; align-items:flex-start; }
  .p-edur { text-align:left; }
}

/* ── Print → compact A4 resume (~2 pages) ──────────────────────── */
@media print {
  @page { size:A4; margin:9mm 10mm; }
  :global(.sidebar), :global(.sidebar-toggle), :global(.sb-backdrop), :global(.header) { display:none !important; }
  :global(.main) { margin:0 !important; }
  :global(.app) { display:block !important; }
  #lockScreen { display:none !important; }
  #resume { display:block !important; margin:0 !important; min-height:0; background:#fff !important; line-height:1.4; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .p-fab, .p-cta, .p-toggle { display:none !important; }
  .p-wrap { max-width:none; padding:0; }

  /* hero */
  .p-updated { font-size:9px; margin-bottom:5px; }
  .p-label { font-size:9.5px; letter-spacing:1.5px; }
  .p-name { font-size:26px; margin-top:3px; }
  .p-role { font-size:11.5px; margin-top:2px; }
  .p-summary { font-size:10px; line-height:1.5; margin-top:8px; max-width:none; }
  .p-meta { margin-top:8px; font-size:9.5px; gap:12px; }

  /* sections */
  .p-sec { margin-top:14px; }
  .p-sech { font-size:9.5px; margin-bottom:8px; padding-bottom:5px; letter-spacing:1.5px; }

  /* education */
  .p-edu { margin-bottom:7px; }
  .p-edusch { font-size:12px; }
  .p-edudeg { font-size:10px; }
  .p-eduth { font-size:9px; margin-top:1px; }
  .p-edudate { font-size:9.5px; }
  .p-edugpa { font-size:9.5px; }
  .p-eduhon { font-size:9px; }

  /* career */
  .p-jobco { font-size:14px; }
  .p-jobrole { font-size:10px; }
  .p-jobdate { font-size:10px; }
  .p-card { padding:8px 11px; margin-top:7px; box-shadow:none; border-color:#dbe4ef; }
  .p-cname { font-size:12px; }
  .p-cdate { font-size:10px; }
  .p-crole { font-size:9.5px; }
  .p-b { margin-top:5px; padding-left:15px; }
  .p-b li { font-size:10px; line-height:1.42; margin-bottom:2px; }
  .p-out { font-size:9.5px; margin-top:5px; padding-top:4px; }
  .p-m { font-size:9.5px; padding:0 5px; }

  /* skills */
  .p-skrow { margin-bottom:6px; }
  .p-skcat { font-size:10px; margin-bottom:4px; }
  .p-tags { gap:5px; }
  .p-tags span { font-size:9.5px; padding:2px 8px; }

  /* publications */
  .p-pub { padding:8px 11px; }
  .p-pubt { font-size:11px; }
  .p-pubv { font-size:10px; }

  /* patents → 2-column grid */
  .p-plead { font-size:10px; margin-bottom:8px; }
  .p-areas { display:grid; grid-template-columns:1fr 1fr; gap:7px; align-items:start; }
  .p-area { padding:8px 11px; margin-bottom:0; box-shadow:none; border-color:#dbe4ef; }
  .p-aname { font-size:11px; }
  .p-acnt { font-size:9.5px; }
  .p-reps { margin-top:6px; }
  .p-reps li { font-size:9.5px; padding:2px 0 2px 12px; }
  .p-more { font-size:9px; margin-top:4px; padding-left:12px; }

  /* awards / certs rows */
  .p-row { padding:6px 0; grid-template-columns:58px 1fr; gap:12px; }
  .p-yr { font-size:11px; }
  .p-it-t { font-size:10.5px; }
  .p-it-s { font-size:9.5px; }
  .p-rtag { font-size:9px; }

  /* footer */
  .p-foot { margin-top:16px; padding-top:10px; }
  .p-footbig { font-size:14px; }
  .p-footcl { font-size:9.5px; }
  .p-footnote { font-size:9px; margin-top:6px; }

  .p-sec, .p-card, .p-edu, .p-area, .p-row, .p-jobhead, .p-pub { break-inside:avoid; }
  a { color:var(--text) !important; }
}
</style>

<!-- Lock Screen -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🔐</div>
    <div class="lock-title">Portfolio</div>
    <div class="lock-sub">비공개 포트폴리오입니다.</div>
    <input id="pwInput" class="lock-input" type="password" placeholder="••••••••" autocomplete="off" />
    <button class="lock-btn" id="unlockBtn">잠금 해제</button>
    <div class="lock-err" id="pwErr"></div>
    <div class="lock-hint">direcf.github.io / personal / portfolio</div>
  </div>
</div>

<!-- Resume -->
<div id="resume" class="lang-kr">
  <div class="p-wrap">

    <!-- Hero -->
    <div class="p-updated"><span class="p-kr">업데이트 2026.10.19</span><span class="p-en">Updated 2026.10.19</span></div>
    <div class="p-label">AI · Vision · Multimodal</div>
    <h1 class="p-name"><span class="p-kr">이승준</span><span class="p-en">Seungjun Lee</span></h1>
    <p class="p-role"><span class="p-kr">Vision AI Engineer · SK Telecom (Enterprise 기술지원팀)</span><span class="p-en">Vision AI Engineer · SK Telecom (Enterprise Tech Support)</span></p>
    <div class="p-toggle">
      <button type="button" class="on" data-lang="kr">KR</button>
      <button type="button" data-lang="en">EN</button>
    </div>
    <p class="p-summary">
      <span class="p-kr">한양대학교 <b>전자공학</b> 학사, KAIST <b>전기및전자공학</b> 석사. 현재 SK텔레콤에서 <b>컴퓨터비전·멀티모달·Agentic AI</b> 시스템을 연구·개발하며, 연구 프로토타입을 전국 단위 <b>상용 서비스</b>까지 출시해 왔습니다. 행동인식·영상이해부터 VLM/VLA Agentic 파이프라인, Physical AI까지 다루며 — <b>Vision AI Research &amp; Development</b>를 지향합니다.</span>
      <span class="p-en">B.S. in Electronic Engineering (<b>Hanyang University</b>) and M.S. in Electrical Engineering (<b>KAIST</b>). At <b>SK Telecom</b> I research and build <b>computer-vision, multimodal, and agentic-AI</b> systems, taking research prototypes all the way to <b>nationwide commercial service</b>. My work spans action recognition and video understanding to VLM/VLA agentic pipelines and Physical AI — I'm focused on <b>Vision AI Research &amp; Development</b>.</span>
    </p>
    <div class="p-cta">
      <a class="p-btn p-btnp" href="#career"><span class="p-kr">경력 보기</span><span class="p-en">View Career</span></a>
      <button class="p-btn p-btns" id="dlPdf" type="button">↓ <span class="p-kr">PDF 이력서 다운로드</span><span class="p-en">Download PDF Resume</span></button>
    </div>
    <div class="p-meta">
      <span>direcf1520@naver.com</span>
      <span>Seoul, South Korea</span>
      <a href="https://github.com/direcf" target="_blank">github.com/direcf</a>
      <a href="https://direcf.github.io" target="_blank">direcf.github.io</a>
    </div>

    <!-- Education -->
    <div class="p-sec">
      <div class="p-sech">Education</div>
      <div class="p-edu">
        <div>
          <div class="p-edusch"><span class="p-kr">KAIST — 한국과학기술원</span><span class="p-en">KAIST — Korea Advanced Institute of Science and Technology</span></div>
          <div class="p-edudeg"><span class="p-kr">전기및전자공학 석사 · RITL Lab (지도교수 김종환)</span><span class="p-en">M.S. in Electrical Engineering · RITL Lab (Adv. Jong-Hwan Kim)</span></div>
          <div class="p-eduth"><span class="p-kr">Thesis: CAL-ODWC — 날씨 변화 하 객체탐지 지속적응학습</span><span class="p-en">Thesis: CAL-ODWC — Continual Adaptation Learning for Object Detection under Weather Changes</span></div>
        </div>
        <div class="p-edur"><div class="p-edudate">2020.09 – 2022.08</div><div class="p-edugpa">GPA 4.15 / 4.3</div></div>
      </div>
      <div class="p-edu">
        <div>
          <div class="p-edusch"><span class="p-kr">한양대학교</span><span class="p-en">Hanyang University</span></div>
          <div class="p-edudeg"><span class="p-kr">전자공학 학사</span><span class="p-en">B.S. in Electronic Engineering</span></div>
        </div>
        <div class="p-edur"><div class="p-edudate">2014.03 – 2020.08</div><div class="p-edugpa">GPA 4.04 / 4.5</div><div class="p-eduhon">Cum Laude</div></div>
      </div>
    </div>

    <!-- Career -->
    <div class="p-sec" id="career">
      <div class="p-sech">Career</div>
      <div class="p-jobhead">
        <div>
          <div class="p-jobco">SK Telecom</div>
