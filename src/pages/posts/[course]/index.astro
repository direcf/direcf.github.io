---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { COURSES, chapterSlug, type Course } from "../../../lib/courses";

export function getStaticPaths() {
  return Object.entries(COURSES).map(([slug, course]) => ({
    params: { course: slug },
    props: { course: course as Course, slug },
  }));
}

const { course, slug } = Astro.props;
const cheatsheetCover = `/posts/${slug}/cheatsheets/chapter-01.png`;
---
<BaseLayout
  title={course.topic}
  description={course.description}
  ogImage={cheatsheetCover}
  activeSlug={course.categorySlug || "home"}
  crumbs={[
    { label: course.topicKr || course.topic },
  ]}
>
  <div class="chapter-wrap">
    <div class="syl-hero">
      <span class="kicker">📚 SYLLABUS</span>
      <h1>{course.topic}</h1>
      <p class="sub">{course.topicKr}</p>
      <p style="font-size:14.5px;color:var(--text-2);line-height:1.7;margin:14px 0 18px;">{course.description}</p>
      <div class="badges">
        {course.level && <span class="badge">{course.level.toUpperCase()}</span>}
        {course.codeLanguage && <span class="badge">{course.codeLanguage.toUpperCase()}</span>}
        <span class="badge">{course.chapters.length} CHAPTERS</span>
      </div>
    </div>

    {course.heroImage && (
      <figure class="course-hero-img">
        <img src={course.heroImage} alt={course.heroImageAlt || course.topic} loading="lazy" />
        {course.heroImageAlt && <figcaption>{course.heroImageAlt}</figcaption>}
      </figure>
    )}

    <div class="ch-list">
      {course.chapters.map((ch) => (
        <a class="ch-row" href={`/posts/${slug}/${chapterSlug(ch.number)}/`}>
          <div class="ch-num">CH {String(ch.number).padStart(2, "0")}</div>
          <div class="ch-body">
            <div class="ch-title">
              <span class="emoji">{ch.emoji}</span>
              <span>{ch.title}</span>
            </div>
            <div class="ch-kr">{ch.titleKr}</div>
            <div class="ch-tldr">{ch.tldr}</div>
            {ch.topics && ch.topics.length > 0 && (
              <div class="ch-tags">
                {ch.topics.slice(0, 4).map((t) => <span class="ch-tag">{t}</span>)}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
