---
import BaseLayout from "../../layouts/BaseLayout.astro";
import posts from "../../data/posts.json";

const catBy = (slug: string) => posts.categories.find((c) => c.slug === slug)!;

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split("-");
  const month = ["", "JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"][parseInt(m, 10)];
  return `${month} ${d}, ${y}`;
};

// Group all posts by category, keeping category display order from posts.json
const groups = posts.categories
  .map((c) => ({
    cat: c,
    list: posts.posts
      .filter((p) => p.category === c.slug)
      .sort((a, b) => (a.date < b.date ? 1 : -1)),
  }))
  .filter((g) => g.list.length > 0);
---
<BaseLayout
  title="Archive"
  description="direcf.github.io의 모든 글과 코스를 한눈에. AI·컴퓨터 비전·시스템 디자인 등 카테고리별 전체 아카이브."
  activeSlug="archive"
  crumbs={[{ label: "Archive" }]}
>
  <div class="view">
    <span class="kicker">ARCHIVE — ALL POSTS</span>
    <h1 class="page-title">전체 아카이브</h1>
    <p class="page-sub">지금까지 쓴 모든 글과 코스 {posts.posts.length}편. 카테고리별로 정리했다.</p>

    {groups.map((g) => (
      <>
        <div class="section-hdr">
          <h2>{g.cat.icon} {g.cat.name}</h2>
          <span class="meta">{g.list.length} POSTS</span>
        </div>
        <div class="post-list">
          {g.list.map((p) => (
            <a class="post-row" href={p.url}>
              <div class="date">{fmtDate(p.date)}</div>
              <div>
                <div class="post-ttl">{p.title}</div>
                <div class="post-excerpt">{p.excerpt}</div>
              </div>
              <div class="post-tag">{p.type === "course" ? `${p.chapters} chapters` : p.type}</div>
            </a>
          ))}
        </div>
      </>
    ))}
  </div>
</BaseLayout>
