---
import BaseLayout from "../layouts/BaseLayout.astro";
import posts from "../data/posts.json";

const sorted = [...posts.posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const top3 = sorted.slice(0, 3);
const rest = sorted.slice(3, 10);

const catBy = (slug: string) => posts.categories.find((c) => c.slug === slug)!;

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split("-");
  const month = ["", "JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"][parseInt(m, 10)];
  return `${month} ${d}, ${y}`;
};
---
<BaseLayout title="direcf" activeSlug="home">
  <div class="view">
    <span class="kicker">WELCOME — DIRECF.GITHUB.IO</span>
    <h1 class="page-title">direct fun, deep study</h1>
    <p class="page-sub">AI 시대를 살아가며 공부한 것들과 가끔의 사적인 단상. 좌측 카테고리에서 영역별로 글을 탐색할 수 있다.</p>

    <div class="section-hdr">
      <h2>최신 글</h2>
      <span class="meta">LATEST 3</span>
    </div>
    <div class="hero-grid">
      {top3.map((p) => {
        const c = catBy(p.category);
        return (
          <a class="hero-card" href={p.url}>
            {p.cover
              ? <img class="cover" src={p.cover} alt="" />
              : <div class="cover-fallback">{c.icon}</div>}
            <div class="pad">
              <div class="cat">{c.name.toUpperCase()}</div>
              <div class="ttl">{p.title}</div>
              <div class="excerpt">{p.excerpt}</div>
              <div class="meta">
                {p.type === "course"
                  ? <><span>{p.chapters} chapters</span><span>·</span><span>{fmtDate(p.date)}</span></>
                  : <><span>{p.type.toUpperCase()}</span><span>·</span><span>{fmtDate(p.date)}</span></>}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    {rest.length > 0 && (
      <>
        <div class="section-hdr">
          <h2>그 외 글</h2>
          <span class="meta">SWIPE →</span>
        </div>
        <div class="carousel-wrap">
          <button class="scroll-btn left" data-dir="-1" aria-label="prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="carousel" id="carousel">
            {rest.map((p) => {
              const c = catBy(p.category);
              return (
                <a class="card" href={p.url}>
                  {p.cover
                    ? <img class="cover" src={p.cover} alt="" />
                    : <div class="cover-fallback">{c.icon}</div>}
                  <div class="pad">
                    <div class="cat">{c.name.toUpperCase()}</div>
                    <div class="ttl">{p.title}</div>
                    <div class="meta">{fmtDate(p.date)}</div>
                  </div>
                </a>
              );
            })}
          </div>
          <button class="scroll-btn right" data-dir="1" aria-label="next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </>
    )}
  </div>

  <script is:inline>
    document.querySelectorAll(".scroll-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const carousel = document.getElementById("carousel");
        const dir = parseInt(btn.dataset.dir, 10);
        carousel.scrollBy({ left: dir * 320, behavior: "smooth" });
      });
    });
  </script>
</BaseLayout>
