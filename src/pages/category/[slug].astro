---
import BaseLayout from "../../layouts/BaseLayout.astro";
import posts from "../../data/posts.json";

export function getStaticPaths() {
  return posts.categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const list = posts.posts
  .filter((p) => p.category === category.slug)
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split("-");
  const month = ["", "JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"][parseInt(m, 10)];
  return `${month} ${d}, ${y}`;
};
---
<BaseLayout
  title={category.name}
  description={category.tagline}
  activeSlug={category.slug}
  crumbs={[{ label: category.name }]}
>
  <div class="view">
    <div class="cat-head">
      <div class="cat-icon">{category.icon}</div>
      <div>
        <span class="kicker">CATEGORY</span>
        <h1 class="page-title" style="margin-top:4px;">{category.name}</h1>
      </div>
    </div>
    <p class="page-sub">{category.tagline}</p>

    {list.length > 0 ? (
      <div class="post-list">
        {list.map((p) => (
          <a class="post-row" href={p.url}>
            <div class="date">{fmtDate(p.date)}</div>
            <div>
              <div class="post-ttl">{p.title}</div>
              <div class="post-excerpt">{p.excerpt}</div>
            </div>
            <div class="post-tag">{p.type === "course" ? `${p.chapters} chapters` : p.type}</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="big-icon">{category.icon}</div>
        <h3>Coming soon</h3>
        <p>이 카테고리의 글은 아직 준비 중이야. {category.tagline}을(를) 다룰 예정.</p>
      </div>
    )}
  </div>
</BaseLayout>
